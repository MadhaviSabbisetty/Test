import React, {
  useEffect,
  useState,
  useCallback,
  useMemo,
  useRef,
} from "react";
import { Box, Fab, IconButton, Tooltip, Typography } from "@mui/material";
import AddIcon from "@mui/icons-material/Add";
import { DataGrid } from "@mui/x-data-grid";
import OnlinePredictionIcon from "@mui/icons-material/OnlinePrediction";
import EditIcon from "@mui/icons-material/Edit";
import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import CustomChip from "../../utils/CustomChip";
import CGLDialog from "./CGLDialog";
import TrendingUpIcon from "@mui/icons-material/TrendingUp";
import TrendingDownIcon from "@mui/icons-material/TrendingDown";
import BookmarkAddedIcon from "@mui/icons-material/BookmarkAdded";
import BookmarkRemoveIcon from "@mui/icons-material/BookmarkRemove";
import DatasetIcon from "@mui/icons-material/Dataset";
import AccountBalanceWalletIcon from "@mui/icons-material/AccountBalanceWallet";
import GppGoodIcon from "@mui/icons-material/GppGood";
import GppBadIcon from "@mui/icons-material/GppBad";
import NoteIcon from "@mui/icons-material/Note";
import CheckCircleIcon from "@mui/icons-material/CheckCircle";
import CancelIcon from "@mui/icons-material/Cancel";
import { useSelector } from "react-redux";
import { getPermissions } from "../../utils/CommonUtilities";
import ErrorOutlineIcon from "@mui/icons-material/ErrorOutline";
import styled from "@emotion/styled";

/* ================= CONSTANTS ================= */

const ACCOUNT_CLASSIFICATIONS = [
  {
    value: "A",
    label: "Asset",
    icon: <DatasetIcon fontSize="small" />,
  },
  {
    value: "L",
    label: "Liability",
    icon: <AccountBalanceWalletIcon fontSize="small" />,
  },
  { value: "I", label: "Income", icon: <TrendingUpIcon fontSize="small" /> },
  { value: "E", label: "Expense", icon: <TrendingDownIcon fontSize="small" /> },
  { value: "M", label: "Memo A/c", icon: <NoteIcon fontSize="small" /> },
];

const OverlayBox = styled(Box)(() => ({
  display: "flex",
  flexDirection: "column",
  height: "100%",
  justifyContent: "center",
  alignItems: "center",
}));

const CustomNoRowsOverlay = () => (
  <OverlayBox>
    <ErrorOutlineIcon fontSize="large" />
    <Typography fontSize="1.1rem">Data is not available</Typography>
  </OverlayBox>
);

/* ================= COMPONENT ================= */

export default function CGLMasterTab() {
  const selectedMenuItem = useSelector((s) => s.menus.selectedMenuItem);
  const requestType = selectedMenuItem?.requestType || "";
  const permissions = getPermissions(selectedMenuItem);

  const { callApi } = useApi();
  const snackbar = useCustomSnackbar();

  const [rows, setRows] = useState([]);
  const [rowCount, setRowCount] = useState(0);
  const [loading, setLoading] = useState(false);

  const [openDialog, setOpenDialog] = useState(false);
  const [editRow, setEditRow] = useState(null);

  /* ===== SERVER GRID STATE ===== */

  const [paginationModel, setPaginationModel] = useState({
    page: 0,
    pageSize: 20,
  });

  const [sortModel, setSortModel] = useState([]);
  const [filterModel, setFilterModel] = useState({ items: [] });

  /* ===== REFS TO PREVENT DOUBLE CALLS ===== */

  const lastFilterRef = useRef("");
  const lastQueryRef = useRef("");

  /* ================= FETCH DATA ================= */

  const fetchRows = useCallback(async () => {
    if (!requestType) return;

    const sortField = sortModel[0]?.field;
    const sortOrder = sortModel[0]?.sort;

    const filters = filterModel.items
      .filter(
        (f) =>
          f.operator &&
          f.value !== undefined &&
          f.value !== null &&
          f.value !== "",
      )
      .map((f) => ({
        field: f.field,
        operator: f.operator,
        value: f.value,
      }));

    const querySignature = JSON.stringify({
      page: paginationModel.page,
      size: paginationModel.pageSize,
      sortField,
      sortOrder,
      filters,
    });

    // PREVENT DUPLICATE API CALL
    if (lastQueryRef.current === querySignature) return;
    lastQueryRef.current = querySignature;

    try {
      setLoading(true);
      const payload = {
        // requestType,
        page: paginationModel.page,
        size: paginationModel.pageSize,
        sortField: sortField || "cglNumber",
        sortOrder: sortOrder || "asc",
        filters,
      };
      const resp = await callApi("/CM/common-master/cgls", payload, "POST");

      setRows(resp?.data?.data || []);
      setRowCount(resp?.data?.totalElements || 0);
    } catch (err) {
      snackbar(err?.message || "Failed to load CGLs", "error");
      setRows([]);
      setRowCount(0);
    } finally {
      setLoading(false);
    }
  }, [callApi, requestType, snackbar, paginationModel, sortModel, filterModel]);

  /* ================= EFFECTS ================= */

  // Main fetch
  useEffect(() => {
    fetchRows();
  }, [fetchRows]);

  // Reset page ONLY when filter meaningfully changes
  useEffect(() => {
    const current = JSON.stringify(filterModel.items || []);
    if (current === lastFilterRef.current) return;

    lastFilterRef.current = current;

    setPaginationModel((p) => (p.page === 0 ? p : { ...p, page: 0 }));
  }, [filterModel]);

  /* ================= DIALOG ================= */

  const handleOpenCreate = () => {
    setEditRow(null);
    setOpenDialog(true);
  };

  const handleOpenEdit = (row) => {
    setEditRow(row);
    setOpenDialog(true);
  };

  const handleSaved = () => {
    setOpenDialog(false);
    setEditRow(null);
    lastQueryRef.current = ""; // force reload
    fetchRows();
  };

  /* ================= COLUMNS ================= */

  const columns = useMemo(
    () => [
      // { field: "cglNumber", headerName: "CGL Code", flex: 1 },
      {
        field: "cglNumber",
        headerName: "CGL Code",
        flex: 1,
        minWidth: 150,
        renderCell: (params) => (
          <Box
            // sx={{
            //   fontFamily: "Monospace",
            //   letterSpacing: "0.08em",
            //   fontWeight: 700,
            // }}
          >
            {params.value}
          </Box>
        ),
      },

      {
        field: "description",
        headerName: "Description",
        flex: 2,
        minWidth: 300,
      },

      {
        field: "acClassification",
        headerName: "Account Classification",
        flex: 1.2,
        minWidth: 210,
        type: "singleSelect",
        valueOptions: ACCOUNT_CLASSIFICATIONS.map((a) => ({
          value: a.value, // A, L, I, E, M
          label: a.label,
        })),
        renderCell: (params) => {
          const found = ACCOUNT_CLASSIFICATIONS.find(
            (x) => x.value === params.value,
          );
          return (
            <CustomChip
              label={found?.label}
              icon={found?.icon}
              variant="outlined"
            />
          );
        },
      },

      {
        field: "balCompare",
        headerName: "Balance Compare",
        flex: 1,
        minWidth: 150,
        headerAlign: "center",
        align: "center",
        filterable: false,
        sortable: false,
        disableColumnMenu: true,
        renderCell: (params) => (
          <CustomChip
            size="small"
            variant="outlined"
            icon={
              params.row.balCompare ? (
                <BookmarkAddedIcon />
              ) : (
                <BookmarkRemoveIcon />
              )
            }
            label={params.row.balCompare ? "Include" : "Exclude"}
            row={params.row}
          />
        ),
      },

      {
        field: "manualPosting",
        headerName: "Manual Posting",
        flex: 1,
        minWidth: 150,
        headerAlign: "center",
        align: "center",
        filterable: false,
        sortable: false,
        disableColumnMenu: true,
        renderCell: (params) => (
          <CustomChip
            size="small"
            variant="outlined"
            icon={params.row.manualPosting ? <GppGoodIcon /> : <GppBadIcon />}
            label={params.row.manualPosting ? "Allowed" : "Not Allowed"}
            row={params.row}
          />
        ),
      },
      {
        field: "balFwd",
        headerName: "Balance Forward",
        flex: 1,
        minWidth: 150,
        headerAlign: "center",
        align: "center",
        filterable: false,
        sortable: false,
        disableColumnMenu: true,
        renderCell: (params) => (
          <CustomChip
            size="small"
            variant="outlined"
            icon={params.row.balFwd ? <CheckCircleIcon /> : <CancelIcon />}
            label={params.row.balFwd ? "Yes" : "No"}
            row={params.row}
          />
        ),
      },

      {
        field: "status",
        headerName: "Status",
        flex: 0.7,
        minWidth: 150,
        headerAlign: "center",
        align: "center",
        type: "singleSelect",
        // sortable: false,
        valueOptions: [
          { value: 1, label: "Active" },
          { value: 0, label: "In Active" },
        ],

        renderCell: (params) => (
          <CustomChip
            icon={<OnlinePredictionIcon />}
            label={params.value === 1 ? "Active" : "In Active"}
            color={params.value === 1 ? "success" : "error"}
            variant="outlined"
          />
        ),
      },

      {
        field: "actions",
        headerName: "Actions",
        flex: 0.6,
        minWidth: 150,
        headerAlign: "center",
        align: "center",
        filterable: false,
        sortable: false,
        disableColumnMenu: true,

        renderCell: (params) => (
          <Tooltip title="Edit">
            <IconButton
              onClick={() => handleOpenEdit(params.row)}
              color="primary"
            >
              <EditIcon />
            </IconButton>
          </Tooltip>
        ),
      },
    ],
    [],
  );

  const filteredColumns = useMemo(() => {
    if (permissions.modify || permissions.block || permissions.unblock) {
      return columns;
    }
    return columns.filter((c) => c.field !== "actions");
  }, [columns, permissions]);

  /* ================= RENDER ================= */

  return (
    <Box>
      <DataGrid
        rows={rows}
        columns={filteredColumns}
        getRowId={(row) => row.cglNumber}
        loading={loading}
        paginationMode="server"
        sortingMode="server"
        filterMode="server"
        rowCount={rowCount}
        paginationModel={paginationModel}
        onPaginationModelChange={setPaginationModel}
        sortModel={sortModel}
        onSortModelChange={setSortModel}
        filterModel={filterModel}
        onFilterModelChange={setFilterModel}
        pageSizeOptions={[10, 20, 50, 100]}
        disableRowSelectionOnClick
        slots={{
          noRowsOverlay: CustomNoRowsOverlay,
        }}
         sx={{
          minHeight: 520,
          width: "100%",
         "& .MuiDataGrid-columnHeaders": {
          backgroundColor: "#f5f5f5 !important",
          fontWeight: 700,
          borderBottom: "2px solid rgba(88, 70, 159, 0.2)",
          position: 'sticky',
          top: 0,
          zIndex: 1,
        },
        }}
      />

      {permissions?.create && !loading && (
        <Fab
          color="primary"
          variant="extended"
          onClick={handleOpenCreate}
          sx={{
             position: "fixed",
             borderRadius: "8px",
             fontSize: "15px",
             bottom: 15,
             right: 30,
             zIndex: 1000,
          }}
        >
          <AddIcon />
          Create
        </Fab>
      )}

      <CGLDialog
        open={openDialog}
        onClose={() => setOpenDialog(false)}
        onSaved={handleSaved}
        editInitialData={editRow}
        accountClassifications={ACCOUNT_CLASSIFICATIONS}
        permissions={permissions}
      />
    </Box>
  );
}
