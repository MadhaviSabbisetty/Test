export const formatDuration = (startTime, endTime) => {
  const start = new Date(startTime).getTime();
  const end = new Date(endTime).getTime();

  if (isNaN(start) || isNaN(end) || end < start) return null;
  // Calculate the absolute difference in milliseconds
  const diff = end - start;
  const s = Math.floor(diff / 1000) % 60;
  const m = Math.floor(diff / (1000 * 60)) % 60;
  const h = Math.floor(diff / (1000 * 60 * 60));

  const formattedDiff = [h && `${h} hr`, m && `${m} min`, s && `${s} sec`]
    .filter(Boolean)
    .join(", ");

  return formattedDiff || "less than 1 sec";
};

export const capitalizeAfterUnderscore = (str) => {
  // Split the string into an array of words using '_' as the separator
  const words = str.split("_");

  // Map over the words array to capitalize the first letter of each word
  const capitalizedWords = words.map((word) => {
    // Check if the word is not empty to prevent errors with consecutive underscores
    if (word.length > 0) {
      // Capitalize the first letter and concatenate with the rest of the word
      return word.charAt(0).toUpperCase() + word.slice(1);
    }
    return ""; // Return empty string for empty words (from consecutive underscores)
  });

  // Join the array back into a single string using a space as the separator
  return capitalizedWords.join("_");
};




// Returns Menu from ID
export const findMenuById = (menus, targetId) => {
  if (!menus) return null;

  for (const item of menus) {
    // 1. Check if the current item matches
    if (item.id === targetId) {
      return item;
    }

    // 2. If not, recursively search inside its children
    if (item.children && item.children.length > 0) {
      const found = findMenuById(item.children, targetId);
      if (found) return found;
    }
  }

  return null;
};

/**
 * Generates available date filter options based on a base date and minimum allowed date.
 */
export const getAvailableFilters = (baseDate, minLimit) => {
  const isValid = (calcDate) => !calcDate.isBefore(minLimit, "day");

  return [
    { value: "custom", label: "Custom Range", show: true },
    { value: "currentDay", label: "Current Day", show: isValid(baseDate) },
    {
      value: "previousDay",
      label: "Previous Day",
      show: isValid(baseDate.subtract(1, "day")),
    },
    {
      value: "currentWeek",
      label: "Current Week",
      show: isValid(baseDate.startOf("week")),
    },
    {
      value: "previousWeek",
      label: "Previous Week",
      show: isValid(baseDate.subtract(1, "week").startOf("week")),
    },
    {
      value: "currentMonth",
      label: "Current Month",
      show: isValid(baseDate.startOf("month")),
    },
    {
      value: "previousMonth",
      label: "Previous Month",
      show: isValid(baseDate.subtract(1, "month").startOf("month")),
    },
    {
      value: "last3Months",
      label: "Last 3 Months",
      show: isValid(baseDate.subtract(3, "month")),
    },
    {
      value: "last6Months",
      label: "Last 6 Months",
      show: isValid(baseDate.subtract(6, "month")),
    },
    {
      value: "currentYear",
      label: "Current Year",
      show: isValid(baseDate.startOf("year")),
    },
    {
      value: "previousYear",
