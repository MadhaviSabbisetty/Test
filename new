/* Hide the complete sort button for Requested Date */
"& .MuiDataGrid-columnHeader[data-field='reqDate'] .MuiDataGrid-iconButtonContainer": {
  visibility: "hidden",
  opacity: 0,
  width: 0,
  transition: "opacity 0.2s ease",
},

/* Show the complete sort button only when hovering */
"& .MuiDataGrid-columnHeader[data-field='reqDate']:hover .MuiDataGrid-iconButtonContainer": {
  visibility: "visible",
  opacity: 1,
  width: "auto",
},
