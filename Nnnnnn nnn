/* ---------------------------------------------------------------------- */
/*  TotalDepositsTrendPanel.jsx                                            */
/*  LEVEL 0 — "totalDeposits" section: for EACH DATE the 8 product values  */
/*  are summed by subType into Demand and Time -> two bars per day (left   */
/*  axis) + a Total line (right axis). Clicking a bar type drills into     */
/*  LEVEL 1 (that type's 7-day breakdown via DateWiseBarPanel), which has  */
/*  its own single-day drill-down (LEVEL 2).                              */
/* ---------------------------------------------------------------------- */

import React, { useMemo, useState } from "react";
import { Box, Stack, Typography } from "@mui/material";
import { alpha, useTheme } from "@mui/material/styles";
import {
  Bar,
  CartesianGrid,
  ComposedChart,
  Line,
  ResponsiveContainer,
  Tooltip,
  XAxis,
  YAxis,
} from "recharts";
import { glass } from "../../theme/themePrimitives"; // adjust path to match your project structure
import { GlassPanel, PanelHeader, RADIUS, textSecondarySx } from "./Common";
import { formatAmount, formatDateLabel } from "./Utils";
import DateWiseBarPanel from "./DateWiseBarPanel";

const DEMAND_COLOR = "#2a78d6";
const TIME_COLOR = "#6250d6";
const TOTAL_LINE_COLOR = "#eb6834";

const DEMAND_LABEL = "Demand Deposits";
const TIME_LABEL = "Time Deposits";

/** "demand" | "time" | null, from the product's subType (falls back to type). */
function bucketFor(product) {
  const tag = String(product?.subType || product?.type || "").toLowerCase();
  if (tag.includes("demand")) return "demand";
  if (tag.includes("time") || tag.includes("term")) return "time";
  return null;
}

/** Sub-section with only one bucket's products — fallback for the Level 1
 * drill-down if the API omits demandDeposits/timeDeposits. */
function subSectionFor(section, bucket, title) {
  if (!section) return undefined;
  const products = Array.isArray(section.products) ? section.products : [];
  const idx = products
    .map((p, i) => (bucketFor(p) === bucket ? i : -1))
    .filter((i) => i >= 0);
  return {
    key: `${section.key || "total"}-${bucket}`,
    title,
    products: idx.map((i) => products[i]),
    data: (Array.isArray(section.data) ? section.data : []).map((row) => ({
      date: row.date,
      values: idx.map((i) => row.values?.[i] ?? 0),
    })),
  };
}

function TotalTooltip({ active, payload, label, theme }) {
  if (!active || !payload || !payload.length) return null;
  const seen = new Set();
  const uniquePayload = payload.filter((p) => {
    if (seen.has(p.dataKey)) return false;
    seen.add(p.dataKey);
    return true;
  });
  return (
    <Box
      sx={{
        background: glass.panel(0.92),
        backdropFilter: "blur(16px) saturate(160%)",
        border: `1px solid ${glass.border}`,
        borderRadius: RADIUS.sm,
        px: 1.5,
        py: 1,
        boxShadow: theme.shadows[8],
      }}
    >
      <Typography
        sx={{
          fontSize: 11.5,
          fontWeight: 600,
          color: "text.secondary",
          mb: 0.5,
        }}
      >
        {label}
      </Typography>
      {uniquePayload.map((p) => (
        <Stack
          key={p.dataKey}
          direction="row"
          spacing={0.75}
          alignItems="center"
          sx={{ mb: 0.25 }}
        >
          <Box
            sx={{
              width: 7,
              height: 7,
              borderRadius: "2px",
              bgcolor: p.color,
              flexShrink: 0,
            }}
          />
          <Typography sx={{ fontSize: 11.5, color: "text.primary" }}>
            {p.dataKey}: <b>{formatAmount(p.value)}</b>
          </Typography>
        </Stack>
      ))}
    </Box>
  );
}

function LegendItem({ color, label }) {
  return (
    <Stack direction="row" spacing={0.75} alignItems="center">
      <Box sx={{ width: 8, height: 8, borderRadius: "2px", bgcolor: color }} />
      <Typography sx={{ ...textSecondarySx, fontSize: 11, fontWeight: 500 }}>
        {label}
      </Typography>
    </Stack>
  );
}

export default function TotalDepositsTrendPanel({
  totalTrendSection,
  demandSection,
  timeSection,
  icon,
  panelId,
  selectedPanel,
  onSelectPanel,
}) {
  const theme = useTheme();
  const gridStrokeColor = alpha(theme.palette.text.primary, 0.08);

  // null = Level 0. "demand" | "time" = Level 1/2 (DateWiseBarPanel).
  const [drillTarget, setDrillTarget] = useState(null);

  // Per date: sum Demand-subType values and Time-subType values; Total = both.
  const rows = useMemo(() => {
    const products = Array.isArray(totalTrendSection?.products)
      ? totalTrendSection.products
      : [];
    if (!Array.isArray(totalTrendSection?.data)) return [];
    const buckets = products.map(bucketFor);
    return totalTrendSection.data.map((row) => {
      let demand = 0;
      let time = 0;
      buckets.forEach((bucket, i) => {
        const v = Number(row.values?.[i]) || 0;
        if (bucket === "demand") demand += v;
        else if (bucket === "time") time += v;
      });
      return {
        date: formatDateLabel(row.date),
        [DEMAND_LABEL]: demand,
        [TIME_LABEL]: time,
        Total: demand + time,
      };
    });
  }, [totalTrendSection]);

  const hasData = rows.length > 0;

  if (drillTarget) {
    const section =
      drillTarget === "demand"
        ? demandSection ||
          subSectionFor(totalTrendSection, "demand", DEMAND_LABEL)
        : timeSection || subSectionFor(totalTrendSection, "time", TIME_LABEL);
    return (
      <DateWiseBarPanel
        section={section}
        icon={icon}
        titleOverride={drillTarget === "demand" ? DEMAND_LABEL : TIME_LABEL}
        onBackToParent={() => setDrillTarget(null)}
        panelId={panelId}
        selectedPanel={selectedPanel}
        onSelectPanel={onSelectPanel}
      />
    );
  }

  return (
    <GlassPanel
      sx={{ p: 3 }}
      selected={selectedPanel === panelId}
      onClick={() => onSelectPanel?.(panelId)}
    >
      <PanelHeader
        icon={icon}
        title={totalTrendSection?.title || "Total Deposits"}
      />

      {hasData ? (
        <Box
          sx={{
            width: "100%",
            height: 240,
            "& svg:focus, & svg *:focus": { outline: "none" },
          }}
        >
          <ResponsiveContainer>
            <ComposedChart
              data={rows}
              margin={{ top: 20, right: 8, left: -4, bottom: 6 }}
              barCategoryGap="30%"
              barGap={2}
            >
              <CartesianGrid
                vertical={false}
                stroke={gridStrokeColor}
                strokeDasharray="3 5"
              />
              <XAxis
                dataKey="date"
                tick={{ fontSize: 10, fill: theme.palette.text.secondary }}
                axisLine={{ stroke: gridStrokeColor }}
                tickLine={false}
                interval={0}
                height={30}
              />
              <YAxis
                yAxisId="left"
                tick={{ fontSize: 11, fill: theme.palette.text.secondary }}
                axisLine={false}
                tickLine={false}
                width={32}
              />
              <YAxis
                yAxisId="right"
                orientation="right"
                tick={{ fontSize: 11, fill: TOTAL_LINE_COLOR }}
                axisLine={false}
                tickLine={false}
                width={36}
              />
              <Tooltip
                cursor={{ fill: alpha(theme.palette.text.primary, 0.05) }}
                content={(props) => <TotalTooltip {...props} theme={theme} />}
              />
              <Bar
                yAxisId="left"
                dataKey={DEMAND_LABEL}
                fill={DEMAND_COLOR}
                radius={[4, 4, 0, 0]}
                maxBarSize={26}
                cursor="pointer"
                onClick={() => setDrillTarget("demand")}
              />
              <Bar
                yAxisId="left"
                dataKey={TIME_LABEL}
                fill={TIME_COLOR}
                radius={[4, 4, 0, 0]}
                maxBarSize={26}
                cursor="pointer"
                onClick={() => setDrillTarget("time")}
              />
              <Line
                yAxisId="right"
                type="monotone"
                dataKey="Total"
                stroke={TOTAL_LINE_COLOR}
                strokeWidth={2}
                dot={{ r: 3, fill: TOTAL_LINE_COLOR, strokeWidth: 0 }}
                isAnimationActive={false}
              />
            </ComposedChart>
          </ResponsiveContainer>
        </Box>
      ) : (
        <Typography sx={{ ...textSecondarySx, fontSize: 12.5 }}>
          No data available.
        </Typography>
      )}

      <Stack direction="row" spacing={2} sx={{ mt: 1.5 }}>
        <LegendItem color={DEMAND_COLOR} label={DEMAND_LABEL} />
        <LegendItem color={TIME_COLOR} label={TIME_LABEL} />
        <LegendItem color={TOTAL_LINE_COLOR} label="Total (right axis)" />
      </Stack>
    </GlassPanel>
  );
}
