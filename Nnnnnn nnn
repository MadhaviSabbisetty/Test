                              backgroundColor: "rgba(0,0,0,0.04)",
                              opacity: 0.45,
                              textDecoration: "line-through",
                            },
                          },
                        },
                        monthButton: {
                          sx: {
                            fontWeight: 700,
                            "&.Mui-selected": {
                              backgroundColor: "#58469f !important",
                              color: "#fff !important",
                            },
                            "&.Mui-disabled": {
                              color: "rgba(0,0,0,0.25) !important",
                              opacity: 0.45,
                              textDecoration: "line-through",
                              backgroundColor: "rgba(0,0,0,0.04)",
                            },
                          },
                        },
                        yearButton: {
                          sx: {
                            fontWeight: 700,
                            "&.Mui-selected": {
                              backgroundColor: "#58469f !important",
                              color: "#fff !important",
                            },
                            "&.Mui-disabled": {
                              color: "rgba(0,0,0,0.25) !important",
                              opacity: 0.45,
                              textDecoration: "line-through",
                              backgroundColor: "rgba(0,0,0,0.04)",
                            },
                          },
                        },
                      }}
                    />
                  </Box>
                </Stack>
              </Paper>
            </Grid>
          </Grid>

          <Grid size={{ xs: 12 }}>
            {validationMessages.length > 0 && (
              <Paper
                sx={{
                  mt: 1,
                  p: 1.5,
                  borderRadius: 2,
                  border: "1px solid",
                  borderColor: "#ff4d4f",
                  bgcolor: "#fff1f0",
                }}
              >
                <Stack spacing={0.5}>
                  {validationMessages.map((msg, index) => (
                    <Typography
                      key={index}
                      variant="body2"
                      sx={{ color: "#d32f2f", fontWeight: 600 }}
                    >
                      • {msg}
                    </Typography>
                  ))}
                </Stack>
              </Paper>
            )}
          </Grid>

          {/* UPDATED ACTION BUTTONS: Flex adjustments so buttons span full width on tiny screens */}
          <Box
            sx={{
              mt: 3,
              position: "sticky",
              bottom: 12,
              zIndex: 20,
              display: "flex",
              flexDirection: { xs: "column-reverse", sm: "row" },
              justifyContent: "flex-end",
              gap: 2,
            }}
          >
            <Button
              variant="outlined"
              startIcon={<RestartAltIcon />}
              onClick={onReset}
              sx={{
                borderRadius: 2,
                textTransform: "none",
                fontWeight: 700,
                width: { xs: "100%", sm: "auto" },
                "&:hover":
                {
                  color:"#fff",
                },
              }}
            >
              Reset
            </Button>
            <Button
              variant="contained"
              startIcon={<SearchIcon />}
              onClick={onFetch}
              disabled={
                !filters.circle ||
                filters.currencies.length === 0 ||
                filters.cgl.length === 0 ||
                !filters.balanceDate ||
                balanceDateError
              }
              loading={fetchLoading}
              sx={{
                borderRadius: 2,
                px: { xs: 2, sm: 4 },
                textTransform: "none",
                fontWeight: 800,
                width: { xs: "100%", sm: "auto" },
              }}
            >
              Search
            </Button>
          </Box>
        </CardContent>
      </Card>
    </Box>
  );
};

export default BalanceLedgerForm;
