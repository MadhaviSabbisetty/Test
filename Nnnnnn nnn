export default function RoleManagementTab1(props) {
  const screenActions = props?.permissions || {};
  const { callApi } = useApi();
  const snackbar = useCustomSnackbar();
  const emptyForm = {
    roleId: "",
    roleName: "",
    description: "",
    roleAccess: null,
    roleStatus: "ACTIVE",
    permissions: [],
  };
  const [rows, setRows] = useState([]);
  const [form, setForm] = useState(emptyForm);
  const [initialForm, setInitialForm] = useState(emptyForm);
  const [dialogOpen, setDialogOpen] = useState(false);
  const [permDialogOpen, setPermDialogOpen] = useState(false);
  const [isLoading, setIsLoading] = useState(false);
  const [roleAccessList, setRoleAccessList] = useState([]);

  const fetchRoles = useCallback(async () => {
    setIsLoading(true);
    setPermDialogOpen(false);
    setDialogOpen(false);
    try {
      const data = await callApi(
        "/UM/role/get-roles",
        { permissions: true },
        "GET",
      );

      const roles = data?.result?.roles ?? [];
      setRows(roles);
    } catch (e) {
      console.error(e);
      setRows([]);
      snackbar("Failed to fetch roles. Check API or network.", "error");
    } finally {
      setIsLoading(false);
    }
  }, [callApi, snackbar]);

  const fetchRoleAccessList = useCallback(async () => {
    try {
      const response = await callApi(
        "/UM/role/get-role-access-list",
        {},
        "GET",
      );
      const list = response?.result?.roleAccessList ?? [];
      setRoleAccessList(list);
    } catch (error) {
      console.error("Failed to fetch role access list:", error);
      setRoleAccessList([]);
    }
  }, [callApi]);

  useEffect(() => {
    fetchRoles();
    fetchRoleAccessList();
  }, [fetchRoles, fetchRoleAccessList]);

  const handleEditRow = (row, isEdit) => {
    setForm({ ...row });
    setInitialForm({ ...row });
    isEdit ? setDialogOpen(true) : setPermDialogOpen(true);
  };

  const handleSavePermissionOrder = async (ordered, original) => {
    const isSameOrder = _.isEqual(original, ordered);

    if (isSameOrder) {
      snackbar("Kindly Change the order before saving it", "warning");
      return;
    }

    try {
      const payload = {
        selectedRole: form?.roleId,
        permissions: ordered,
      };
      console.log(payload);
      const response = await callApi(
        "/UM/role/save-permission-order",
        payload,
        "PATCH",
      );
      snackbar(response?.message, "success");
    } catch (err) {
      console.error(err);
      snackbar("Error while processing request", "error");
    }
    fetchRoles();
  };

  return (
    <Box>
      <RolesTable
        rows={rows}
        isLoading={isLoading}
        onEditRow={(row, isEdit) => handleEditRow(row, isEdit)}
        screenActions={screenActions}
        roleAccessList={roleAccessList}
      />

      <RolesDialog
        open={dialogOpen}
        form={form}
        setForm={setForm}
        fetchRoles={fetchRoles}
        initialForm={initialForm}
        screenActions={screenActions}
        onClose={() => setDialogOpen(false)}
        roles={rows}
        roleAccessList={roleAccessList}
      />

      <PermissionsDialog
        open={permDialogOpen}
        handleSavePermissionOrder={(ordered, original) =>
          handleSavePermissionOrder(ordered, original)
        }
        onClose={() => {
          setPermDialogOpen(false);
        }}
        permissions={form?.permissions || []}
        roleName={form?.roleName || ""}
      />

      {screenActions.create && (
      
      <Box
          sx={{
            height:64,
            flexShrink:0,
            display:"flex",
            justifyContent:"flex-end",
            alignItems:"center",
            px:1,
            pb:1,
          }}
      >
        <Box
        className="fab-hover-area"
        sx={{
          position:"relative",
          width:180,
          height:48,
          flexShrink:0,
          transform:"translateY(8px)",
        }}>
        <FabStyle
          onClick={() => {
            setForm(emptyForm);
            setDialogOpen(true);
          }}
          color="primary"
        >

          <span className="create-circle-text">
            Create Role
          </span>
          
          <RollTab1Addicon />
          
        </FabStyle>
        </Box>
      </Box>
      )}
    </Box>
  );
}
