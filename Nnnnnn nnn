import React, { useEffect, useRef, useState } from "react";
import {
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Button,
  Typography,
  Grid,
  Box,
  Divider,
  Stack,
  IconButton,
} from "@mui/material";
import * as MuiIcons from "@mui/icons-material";
import {
  timeStampFormatter,
  toPascalKebabCase,
  formatKeyForDisplay,
} from "../../../utils/CommonUtilities";
import CustomChip from "../../../utils/CustomChip";
import CloseIcon from "@mui/icons-material/Close";

// returns icon component based on the string name from payload
const getIcon = (iconName) => {
  if (!iconName) return null;
  const IconComp = MuiIcons[iconName];
  return IconComp ? <IconComp fontSize="small" /> : null;
};

const RoleRequestView = ({ open, handleClose, data }) => {
  const [position, setPosition] = useState({ x: 0, y: 0 });
  const [dragging, setDragging] = useState(false);

  const dragRef = useRef({
    startX: 0,
    startY: 0,
    startPositionX: 0,
    startPositionY: 0,
    width: 0,
    height: 0,
    initialLeft: 0,
    initialTop: 0,
  });

  const handleDragStart = (event) => {
    if (event.pointerType === "mouse" && event.button !== 0) return;
    if (event.target.closest("button")) return;

    const paper = event.currentTarget.closest(".MuiDialog-paper");
    if (!paper) return;

    const rect = paper.getBoundingClientRect();

    event.preventDefault();

    dragRef.current = {
      startX: event.clientX,
      startY: event.clientY,
      startPositionX: position.x,
      startPositionY: position.y,
      width: rect.width,
      height: rect.height,
      initialLeft: rect.left,
      initialTop: rect.top,
    };

    setDragging(true);
  };

  useEffect(() => {
    if (!dragging) return;

    const handlePointerMove = (event) => {
      const {
        startX,
        startY,
        startPositionX,
        startPositionY,
        width,
        height,
        initialLeft,
        initialTop,
      } = dragRef.current;

      const margin = 30;

      let newX = startPositionX + (event.clientX - startX);
      let newY = startPositionY + (event.clientY - startY);

      const minX = margin - initialLeft + startPositionX;
      const maxX =
        window.innerWidth - margin - width - initialLeft + startPositionX;

      const minY = margin - initialTop + startPositionY;
      const maxY =
        window.innerHeight - margin - height - initialTop + startPositionY;

      newX = Math.max(minX, Math.min(newX, maxX));
      newY = Math.max(minY, Math.min(newY, maxY));

      setPosition({ x: newX, y: newY });
    };

    const handlePointerUp = () => {
      setDragging(false);
    };

    document.addEventListener("pointermove", handlePointerMove);
    document.addEventListener("pointerup", handlePointerUp);

    return () => {
      document.removeEventListener("pointermove", handlePointerMove);
      document.removeEventListener("pointerup", handlePointerUp);
    };
  }, [dragging]);

  useEffect(() => {
    if (open) {
      setPosition({ x: 0, y: 0 });
      setDragging(false);
    }
  }, [open]);

  if (!data || !data.requestPayload) return null;

  const payload = JSON.parse(data.requestPayload) || {};

  const { roleName, description, permissions } = payload;

  const roleAccess = data
    ? `${data.accessName || "NA"} (${data.accessDescription || "NA"})`
    : "NA";

  const viewData = {
    roleName: roleName || "NA",
    roleAccess,
    roleDescription: description || "NA",
    permissions: permissions || [],
  };

  const mainDetails = [
    { label: "Requestor ID", value: data.requestorUserId, size: 2 },
    {
      label: "Request Type",
      value: data.requestType === "CREATE" ? "Created" : "Modified",
      size: 2.5,
    },
    {
      label: "Request Status",
      value: toPascalKebabCase(data.requestStatus),
      size: 2.5,
    },
    {
      label: "Requested Date",
      value: timeStampFormatter(data.requestDate),
      size: 5,
    },
  ];

  return (
    <Dialog
      open={open}
      onClose={(event, reason) => {
        if (reason === "backdropClick") return;
        handleClose();
      }}
      maxWidth="md"
      fullWidth
      slotProps={{
        paper: {
          sx: {
            transform: `translate(${position.x}px, ${position.y}px)`,
            transition: dragging ? "none" : "transform 0.15s ease",
            maxHeight: "90vh",
          },
        },
      }}
    >
      <DialogTitle
        onPointerDown={handleDragStart}
        sx={{
          display: "flex",
          alignItems: "center",
          justifyContent: "space-between",
          pr: 1,
          cursor: dragging ? "grabbing" : "grab",
          userSelect: "none",
          touchAction: "none",
        }}
      >
        <Typography variant="h6" fontWeight={700}>
          Request Details - <b>ID: {data.REQUEST_ID}</b>
        </Typography>

        <IconButton
          size="small"
          onPointerDown={(event) => {
            event.stopPropagation();
          }}
          onClick={handleClose}
        >
          <CloseIcon />
        </IconButton>
      </DialogTitle>

      <Divider />

      <DialogContent>
        {/* Main Details */}
        <Grid container spacing={2}>
          {mainDetails.map(
            (item) =>
              item.label !== "roleId" && (
                <Grid xs={12} size={{ xs: 12, sm: item.size }} key={item.label}>
                  <Box sx={{ display: "flex", flexDirection: "column" }}>
                    <Typography
                      variant="subtitle2"
                      sx={{
                        fontWeight: 800,
                        color: "text.secondary",
                      }}
                    >
                      {item.label}
                    </Typography>
                    <Typography variant="body1" sx={{ color: "text.primary" }}>
                      {item.value ?? "N/A"}
                    </Typography>
                  </Box>
                </Grid>
              ),
          )}
        </Grid>

        {data.requestStatus !== "PENDING" && (
          <Grid container spacing={2} sx={{ mt: 1.5 }}>
            <Grid size={{ xs: 12, md: 2 }}>
              <Box sx={{ display: "flex", flexDirection: "column" }}>
                <Typography
                  variant="subtitle2"
                  sx={{
                    fontWeight: 800,
                    color: "text.secondary",
                  }}
                >
                  {`${toPascalKebabCase(data.requestStatus)} By`}
                </Typography>
                <Typography variant="body1" sx={{ color: "text.primary" }}>
                  {data.approverId ?? "N/A"}
                </Typography>
              </Box>
            </Grid>
            <Grid size={{ xs: 12, md: 5 }}>
              <Box sx={{ display: "flex", flexDirection: "column" }}>
                <Typography
                  variant="subtitle2"
                  sx={{
                    fontWeight: 800,
                    color: "text.secondary",
                  }}
                >
                  {`${toPascalKebabCase(data.requestStatus)} Date`}
                </Typography>
                <Typography variant="body1" sx={{ color: "text.primary" }}>
                  {timeStampFormatter(data.approvalDate) || "N/A"}
                </Typography>
              </Box>
            </Grid>
            {data.requestStatus === "REJECTED" && (
              <Grid size={{ xs: 12, md: 5 }}>
                <Box sx={{ display: "flex", flexDirection: "column" }}>
                  <Typography
                    variant="subtitle2"
                    sx={{
                      fontWeight: 800,
                      color: "text.secondary",
                    }}
                  >
                    Rejection Remarks
                  </Typography>
                  <Typography variant="body1" sx={{ color: "text.primary" }}>
                    {data.rejectionReason || "N/A"}
                  </Typography>
                </Box>
              </Grid>
            )}
          </Grid>
        )}

        <Divider sx={{ my: 2 }} />

        {/* PAYLOAD VIEW */}

        <Grid container spacing={2}>
          {Object.entries(viewData).map(([key, value]) => (
            <Grid
              xs={12}
              size={key === "permissions" ? {} : { xs: 12, sm: 6 }}
              key={key}
            >
              <Box sx={{ display: "flex", flexDirection: "column" }}>
                <Typography
                  variant="subtitle2"
                  sx={{
                    fontWeight: 800,
                    color: "text.secondary",
                    whiteSpace: "nowrap",
                    overflow: "hidden",
                    textOverflow: "ellipsis",
                  }}
                >
                  {formatKeyForDisplay(key)}
                </Typography>

                {/* SPECIAL CASE: PERMISSIONS LIST  */}
                {key === "permissions" && Array.isArray(value) ? (
                  <Stack
                    direction="row"
                    gap={0.5}
                    spacing={1}
                    flexWrap="wrap"
                    sx={{ p: 1 }}
                  >
                    {value.map((p) => (
                      <CustomChip
                        key={p.id}
                        icon={getIcon(p.icon)}
                        size="small"
                        color="default"
                        label={`${p.title}${
                          p.menuSubmenu ? " (" + p.menuSubmenu + ")" : ""
                        }`}
                        variant="outlined"
                      />
                    ))}
                  </Stack>
                ) : (
                  <Typography
                    variant="body1"
                    sx={{ color: "text.primary", wordBreak: "break-word" }}
                  >
                    {Array.isArray(value)
                      ? JSON.stringify(value)
                      : typeof value === "object" && value !== null
                        ? JSON.stringify(value, null, 2)
                        : String(value ?? "N/A")}
                  </Typography>
                )}
              </Box>
            </Grid>
          ))}
        </Grid>
      </DialogContent>
    </Dialog>
  );
};

export default RoleRequestView;
import React, { useState, useEffect, useCallback, useMemo } from "react";
import {
  Box,
  Card,
  Divider,
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  TextField,
  Typography,
  Button,
  Stack,
  Tooltip,
  IconButton,
} from "@mui/material";
import { DataGrid } from "@mui/x-data-grid";
import { Check, Clear, Visibility } from "@mui/icons-material";
import AddBoxIcon from "@mui/icons-material/AddBox";
import InfoIcon from "@mui/icons-material/Info";
import AutoDeleteIcon from "@mui/icons-material/AutoDelete";
import EditDocumentIcon from "@mui/icons-material/EditDocument";
import AccountCircleIcon from "@mui/icons-material/AccountCircle";
import SecurityIcon from "@mui/icons-material/Security"; // Imported Security Icon
import { useSelector } from "react-redux";

import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import RequestAnalytics from "../common/RequestAnalytics";
import {
  timeStampFormatter,
  toPascalKebabCase,
} from "../../utils/CommonUtilities";
import CustomChip from "../../utils/CustomChip";
import { styles } from "../common/CommonRequestScreenStyles";
import LoadingOverlay from "../../utils/LoadingOverlay";
import RoleRequestView from "./components/RoleRequestView";

const REMARKS_REGEX = /^(?!.* {2})[a-zA-Z0-9\s/&(),.-]*$/;

export default function RoleApprovals() {
  const selectedMenuItem = useSelector((s) => s.menus.selectedMenuItem);
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();

  const [rows, setRows] = useState([]);
  const [roleAccessList, setRoleAccessList] = useState([]); // State for Access Level mapping
  const [remarks, setRemarks] = useState("");
  const [viewOpen, setViewOpen] = useState(false);
  const [viewData, setViewData] = useState(null);
  const [loading, setLoading] = useState(false);
  const [dataGridLoading, setDataGridLoading] = useState(true);
  const [confirmDialog, setConfirmDialog] = useState(false);
  const [selectedType, setSelectedType] = useState(null);
  const [selectedRequestId, setSelectedRequestId] = useState(null);

  const fetchData = useCallback(async () => {
    try {
      const response = await callApi(
        "/UM/role/pending-role-requests",
        {},
        "GET",
      );
      const result = response?.result?.pendingRequests || [];
      const processedResult = result.map((row) => {
        const parsed = JSON.parse(row?.requestPayload || "") || {};
        const status =
          row.requestType === "CREATE"
            ? "ADD"
            : row.requestType === "MODIFY"
              ? "UPDATE"
              : row.requestType;
        return {
          ...row,
          ...parsed,
          changeType: status,
          reqStatus: row.requestStatus,
          reqDate: row.requestDate,
        };
      });
      setRows(processedResult);
    } catch (err) {
      console.error(err);
      showSnackBar(err.message || "Error fetching data", "error");
    } finally {
      setDataGridLoading(false);
    }
  }, [callApi, showSnackBar]);

  const fetchRoleAccessList = useCallback(async () => {
    try {
      const response = await callApi(
        "/UM/role/get-role-access-list",
        {},
        "GET",
      );
      const list = response?.result?.roleAccessList ?? [];
      setRoleAccessList(list);
    } catch (error) {
      console.error("Something went wrong", error);
      setRoleAccessList([]);
    }
  }, [callApi]);

  useEffect(() => {
    fetchData();
    fetchRoleAccessList(); // Trigger API call
  }, [fetchData, fetchRoleAccessList]);

  const handleViewClick = useCallback(
    (data) => {
      // Robust string mapping for Access Level
      const access = roleAccessList?.find(
        (item) =>
          String(item.accessFlag).trim() === String(data.roleAccess).trim(),
      );
      const newData = { ...data, ...access };
      setViewData(newData);
      setViewOpen(true);
    },
    [roleAccessList],
  );

  const closeConfirmDialog = useCallback(() => {
    setRemarks("");
    setConfirmDialog(false);
  }, []);

  const handleConfirm = async () => {
    if (selectedType === "reject" && remarks.trim().length < 5) {
      showSnackBar(
        "Please provide minimum 5 characters remarks before rejecting",
        "warning",
      );
      return;
    }
    setLoading(true);

    try {
      const payload = {
        requestId: selectedRequestId,
        actionFlag: selectedType,
        remarks: selectedType === "reject" ? remarks.trim() : "No Remarks",
      };

      console.log(payload);

      const res = await callApi(
        "/UM/role/role-request-action",
        payload,
        "POST",
      );

      if (res?.result?.status) {
        showSnackBar(
          `Request Id ${selectedRequestId} ${
            selectedType === "reject" ? "Rejected" : "Approved"
          } Successfully`,
          "success",
        );
        fetchData();
      } else {
        showSnackBar("Failed to process request", "error");
      }
    } catch (err) {
      console.error(err);
      showSnackBar("Error while processing request", "error");
    } finally {
      closeConfirmDialog();
      setLoading(false);
    }
  };

  const openConfirmDialog = useCallback((type, rowId) => {
    setSelectedType(type);
    setSelectedRequestId(rowId);
    setConfirmDialog(true);
  }, []);

  const handleRemarksChange = useCallback(
    (e) => {
      const value = e.target.value;

      if (value && !/^[A-Za-z0-9]$/.test(value[0])) {
        showSnackBar("Should not start with a special character", "error");
        return;
      }

      const error = REMARKS_REGEX.test(value)
        ? ""
        : "Only alphabets, spaces (single spaces only between words) and ,()&,/-. are allowed!";

      if (error) {
        showSnackBar(error, "error");
        return;
      }

      setRemarks(value);
    },
    [showSnackBar],
  );

  const columns = useMemo(
    () => [
      {
        field: "requestId",
        headerName: "Request Id",
        flex: 0.5,
        minWidth: 130,
      },
      { field: "roleName", headerName: "Role Name", flex: 0.5, minWidth: 150 },
      {
        field: "description",
        headerName: "Role Description",
        flex: 1.2,
        minWidth: 220,
      },
      {
        field: "roleAccess",
        headerName: "Access Level",
        flex: 0.7,
        minWidth: 140,
        headerAlign: "center",
        align: "center",
        sortable: true,
        filterable: false,
        disableColumnMenu: true,
        renderCell: (params) => {
          // Robust mapping
          const access = roleAccessList?.find(
            (item) =>
              String(item.accessFlag).trim() ===
              String(params.row.roleAccess).trim(),
          );

          return (
            <Tooltip title={access?.accessDescription || ""} placement="top">
              <span>
                <CustomChip
                  variant="outlined"
                  size="sm"
                  icon={<SecurityIcon sx={{ width: 15, height: 15 }} />}
                  label={access?.accessName || params.row.roleAccess || "NA"}
                />
              </span>
            </Tooltip>
          );
        },
      },
      {
        field: "requestType",
        headerName: "Type",
        flex: 0.6,
        minWidth: 120,
        headerAlign: "center",
        align: "center",
        renderCell: (params) => {
          const val = params.value;
          return (
            <CustomChip
              icon={
                val === "CREATE" ? (
                  <AddBoxIcon />
                ) : val === "DELETE" ? (
                  <AutoDeleteIcon />
                ) : (
                  <EditDocumentIcon />
                )
              }
              label={toPascalKebabCase(val)}
              color={
                val === "CREATE"
                  ? "success"
                  : val === "DELETE"
                    ? "error"
                    : "warning"
              }
              size="small"
              variant="outlined"
            />
          );
        },
      },
      {
        field: "requestorUserId",
        headerName: "Creator",
        flex: 0.8,
        minWidth: 150,
        headerAlign: "center",
        align: "center",
        filterable: false,
        sortable: false,
        disableColumnMenu: true,
        renderCell: (params) => (
          <CustomChip
            icon={<AccountCircleIcon />}
            size="small"
            color="info"
            label={params.value}
            variant="outlined"
          />
        ),
      },
      {
        field: "requestDate",
        headerName: "Requested Date",
        flex: 1,
        minWidth: 210,
        disableColumnMenu: true,
        renderCell: (p) => (
          <Typography variant="body1" component="span" sx={styles.requestDate}>
            {timeStampFormatter(p.value)}
          </Typography>
        ),
      },
      {
        field: "actions",
        headerName: "Actions",
        flex: 0.7,
        minWidth: 160,
        headerAlign: "center",
        align: "center",
        filterable: false,
        sortable: false,
        disableColumnMenu: true,
        renderCell: (p) => (
          <Stack
            direction="row"
            spacing={1}
            alignItems="center"
            justifyContent="center"
            sx={{ height: "100%" }}
          >
            <Tooltip title="View">
              <IconButton onClick={() => handleViewClick(p.row)}>
                <Visibility />
              </IconButton>
            </Tooltip>

            <Tooltip title="Approve">
              <IconButton
                color="success"
                onClick={() => openConfirmDialog("accept", p.row.requestId)}
              >
                <Check />
              </IconButton>
            </Tooltip>

            <Tooltip title="Reject">
              <IconButton
                color="error"
                onClick={() => openConfirmDialog("reject", p.row.requestId)}
              >
                <Clear />
              </IconButton>
            </Tooltip>
          </Stack>
        ),
      },
    ],
    [openConfirmDialog, handleViewClick, roleAccessList], // Fixed dependencies
  );

  return (
    <Box sx={styles.container}>
      <Card
        sx={{
          width: "100%",
          height: "calc(100vh - 125px)",
          minHeight: 0,
          boxShadow: 3,
          borderRadius: 2,
          bgcolor: "background.paper",
          overflow: "hidden",
        }}
      >
        <RequestAnalytics data={rows} />

        <Divider />

        <DataGrid
          rows={rows}
          columns={columns}
          loading={dataGridLoading}
          disableRowSelectionOnClick
          pageSizeOptions={[5, 10, 25, 50]}
          initialState={{
            pagination: { paginationModel: { pageSize: 5, page: 0 } },
            sorting: { sortModel: [{ field: "reqDate", sort: "desc" }] },
          }}
          getRowId={(row) => row.requestId}
          sx={{
            ...styles.dataGrid,
            border: "none",
            "& .MuiDataGrid-columnHeaders": {
              borderTop: "none",
            },
          }}
          slots={{
            noRowsOverlay: () => (
              <Stack height="100%" alignItems="center" justifyContent="center">
                <InfoIcon
                  sx={{ fontSize: 48, color: "text.secondary", mb: 2 }}
                />
                <Typography variant="h6">No Pending Requests Found</Typography>
                <Typography>
                  All {selectedMenuItem?.title} have been processed.
                </Typography>
              </Stack>
            ),
          }}
        />
      </Card>

      <RoleRequestView
        open={viewOpen}
        handleClose={() => setViewOpen(false)}
        data={viewData}
      />

      <Dialog
        open={confirmDialog}
        onClose={closeConfirmDialog}
        maxWidth="sm"
        fullWidth
      >
        <DialogTitle sx={{ fontWeight: 600 }}>
          {selectedType === "accept" ? "Confirm Approval" : "Confirm Rejection"}
        </DialogTitle>
        <DialogContent>
          <Typography sx={{ p: 1 }}>
            {selectedType === "accept"
              ? "Are you sure you want to approve this request?"
              : "Are you sure you want to reject this request? Please enter remarks."}
          </Typography>
          {selectedType === "reject" && (
            <TextField
              fullWidth
              label="Rejection Remarks *"
              value={remarks}
              onChange={handleRemarksChange}
              multiline
              rows={2}
              margin="dense"
              slotProps={{
                htmlInput: {
                  maxLength: 100,
                },
              }}
              helperText={
                remarks?.length > 0 && remarks?.length < 5
                  ? "Enter at least 5 characters"
                  : "Allowed 5-100 characters (alphabets, numbers, spaces,()&,/-.)"
              }
              error={remarks?.length > 0 && remarks?.length < 5}
            />
          )}
        </DialogContent>
        <DialogActions>
          <Button onClick={closeConfirmDialog} variant="outlined"
          sx=
          {{
            "&:hover":
            {
              color:"#fff",
            },
            }}>
            Cancel
          </Button>
          <Button
            onClick={handleConfirm}
            color={selectedType === "accept" ? "success" : "error"}
            variant="contained"
          >
            {selectedType === "accept" ? "Approve" : "Reject"}
          </Button>
        </DialogActions>
      </Dialog>

      <LoadingOverlay loading={loading} />
    </Box>
  );
}
