import React, { useState, useCallback, useEffect, useMemo } from "react";
import { useSelector } from "react-redux";
import { Box } from "@mui/material";
import { LocalizationProvider } from "@mui/x-date-pickers";
import { AdapterDayjs } from "@mui/x-date-pickers/AdapterDayjs";
import dayjs from "dayjs";
import debounce from "lodash/debounce";
import LedgerForm from "./components/LedgerForm";
import LedgerDataGrid from "./components/LedgerDataGrid";
import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import downloadFile from "../../utils/DownloadUtils";

const DEFAULT_PAGE_SIZE = 20;
const FOREIGN_CIRCLE_CODE = "021";

const CIRCLE_GROUPS = {
  ALL: "ALL",
  DOMESTIC: "DOMESTIC",
  FOREIGN: "FOREIGN",
};

const LedgerWiseEnquiry = () => {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();
  const user = useSelector((state) => state.auth.user);
  const menu = useSelector((state) => state.menus.selectedMenuItem);

  const MIN_ALLOWED_DATE = dayjs("2026-03-31");
  const DATE_FORMAT = "DD/MM/YYYY";

  const hasWholeBank = user?.roleAccess === "W";
  const hasCircle = user?.roleAccess === "C";
  const isCircleUser = user?.roleAccess === "C";

  const [circles, setCircles] = useState([]);
  const [initialState, setInitialState] = useState({
    level: "BRANCH",
    circle: "ALL",
    branches: ["ALL"],
    currencies: ["ALL"], // FIXED: Initialized as Array
    sourceFlags: [],
    cgl: "",
    fromDate: null,
    toDate: null,
  });
  const [currencies, setCurrencies] = useState([]);
  const [sourceOptions, setSourceOptions] = useState([]);
  const [etlDate, setEtlDate] = useState(null);

  const [rows, setRows] = useState(null);
  const [rowCount, setRowCount] = useState(0);

  const [loading, setLoading] = useState(false);
  const [exporting, setExporting] = useState(false);

  const [paginationModel, setPaginationModel] = useState({
    page: 0,
    pageSize: DEFAULT_PAGE_SIZE,
  });

  const [sortModel, setSortModel] = useState([
    {
      field: "transactionDate",
      sort: "desc",
    },
  ]);

  const [filterModel, setFilterModel] = useState({
    items: [],
  });

  /* INITIAL FILTERS */
  const initialDetails = useMemo(() => {
    return {
      level: hasWholeBank ? "BANK" : isCircleUser ? "CIRCLE" : "BRANCH",
      circle: hasWholeBank ? "ALL" : user?.circleCode,
      branches:
        user?.roleAccess === "B"
          ? [`${user?.branch}-${user?.branchName}`]
          : ["ALL"],

      currencies: ["ALL"], // FIXED: Initialized as Array
      sourceFlags: sourceOptions || [],
      cgl: "",
      fromDate: null,
      toDate: null,
    };
  }, [
    hasWholeBank,
    isCircleUser,
    user?.circleCode,
    user?.roleAccess,
    user?.branch,
    user?.branchName,
    sourceOptions,
  ]);

  useEffect(() => {
    setInitialState(initialDetails);
    setFilters(initialDetails);
  }, [initialDetails]);

  const [filters, setFilters] = useState(initialState);
  const [searchQuery, setSearchQuery] = useState(null);

  /* FETCH MASTERS */
  const fetchMasters = useCallback(async () => {
    try {
      const [dateRes, currRes, flagRes] = await Promise.all([
        callApi("/PS/file/fincore-date", {}, "GET"),
        callApi("/CM/common-master/currency-code-name-only", null, "GET"),
        callApi("/CM/common-master/source-flag", null, "GET"),
      ]);

      /* ETL DATE */
      if (dateRes?.data?.userDate) {
        setEtlDate(dayjs(dateRes.data.userDate, "YYYY-MM-DD"));
      }

      /* CURRENCIES */
      const formattedCurrencies =
        currRes?.data?.map((c) => `${c.currencyCode} - ${c.currencyName}`) ||
        [];

      const sortedCurrencies = formattedCurrencies.sort((a, b) => {
        const aCode = a.split(" ")[0];
        const bCode = b.split(" ")[0];

        // INR always on top
        if (aCode === "INR") return -1;
        if (bCode === "INR") return 1;

        // Remaining alphabetical
        return a.localeCompare(b);
      });

      setCurrencies(sortedCurrencies);

      /* SOURCE FLAGS */
      if (flagRes?.data) {
        setSourceOptions(flagRes.data);
        setFilters((prev) => ({
          ...prev,
          sourceFlags: flagRes.data,
        }));
      }

      /* CIRCLES */
      if (hasWholeBank) {
        const circleRes = await callApi(
          "/CM/common-master/circle-codes",
          null,
          "GET",
        );
        setCircles(circleRes?.data || []);
      }
    } catch (error) {
      console.error(error);
      showSnackBar(
        "Failed to load master configuration, Something went wrong Kindly try again after sometime",
        "error",
      );
    }
  }, [callApi, hasWholeBank, showSnackBar]);

  useEffect(() => {
    fetchMasters();
  }, [fetchMasters]);

  /* FILTERED SOURCE OPTIONS */
  const selectedSourceOptions = useMemo(() => {
    if (!filters?.sourceFlags?.length) {
      return sourceOptions;
    }
    const selectedIds = new Set(filters.sourceFlags.map((f) => f.flagId));
    return sourceOptions.filter((option) => selectedIds.has(option.flagId));
  }, [filters.sourceFlags, sourceOptions]);

  /* BRANCH OPTIONS */
  const selectedBranchOptions = useMemo(() => {
    if (!filters.branches?.length || filters.branches.includes("ALL")) {
      return [];
    }
    return filters.branches.map((branch) => ({
      value: branch.split("-")[0],
      label: branch,
    }));
  }, [filters.branches]);

  /* CIRCLE OPTIONS */
  const selectedCircleOptions = useMemo(() => {
    const formattedCircles = circles.map((circle) => ({
      value: circle.circleCode,
      label:
        circle.circleCode === FOREIGN_CIRCLE_CODE
          ? `${circle.circleCode} - Foreign`
          : `${circle.circleCode} - ${circle.circleName}`,
    }));

    if (
      filters.circle === CIRCLE_GROUPS.ALL ||
      filters.circle === CIRCLE_GROUPS.DOMESTIC ||
      filters.circle === CIRCLE_GROUPS.FOREIGN
    ) {
      return formattedCircles;
    }

    return formattedCircles.filter((circle) => circle.value === filters.circle);
  }, [filters.circle, circles]);

  /* CURRENCY OPTIONS */
  const selectedCurrencyOptions = useMemo(() => {
    // FIXED: safely handle arrays
    if (!filters.currencies?.length || filters.currencies.includes("ALL")) {
      return currencies.map((currency) => ({
        value: currency.split(" (")[0],
        label: currency,
      }));
    }
    return filters.currencies.map((currency) => ({
      value: currency.split(" (")[0],
      label: currency,
    }));
  }, [filters.currencies, currencies]);

  /* PAYLOAD */
  const buildPayload = useCallback(() => {
    if (!searchQuery) return null;

    const gridFilters =
      filterModel.items
        ?.filter(
          (item) =>
            item.field &&
            item.operator &&
            item.value !== undefined &&
            item.value !== null &&
            item.value !== "",
        )
        .map((item) => ({
          field: item.field,
          operator: item.operator,
          value: item.value,
        })) || [];

    return {
      // Main Filters
      circle: searchQuery.circle,
      cgl: searchQuery.cgl.split(" - ")[0],
      cglName: searchQuery.cgl.split(" - ")[1],

      // FIXED: Safely map array to code-only array
      currencies: searchQuery.currencies?.includes("ALL")
        ? ["ALL"]
        : searchQuery.currencies.map((c) => c.split(" (")[0]),

      branches: searchQuery.branches.includes("ALL")
        ? ["ALL"]
        : searchQuery.branches.map((b) => b.split("-")[0]),

      sourceFlags: searchQuery.sourceFlags?.map((f) => f.flagId) || [],
      fromDate: dayjs(searchQuery.fromDate).format("DD/MM/YYYY"),
      toDate: dayjs(searchQuery.toDate).format("DD/MM/YYYY"),

      // Pagination
      page: paginationModel.page,
      size: paginationModel.pageSize,

      // Sorting
      sortField: sortModel?.[0]?.field || "transactionDate",
      sortOrder: sortModel?.[0]?.sort || "desc",

      // Grid Filters
      gridFilters,
    };
  }, [searchQuery, paginationModel, sortModel, filterModel]);

  /* FETCH ROWS */
  const fetchRows = useCallback(async () => {
    const payload = buildPayload();
    if (!payload) return;
    try {
      setLoading(true);
      console.log(payload);
      const res = await callApi("/ES/ledger-enquiries/search", payload, "POST");
      setRows(res?.data?.content || []);
      setRowCount(res?.data?.page?.totalElements || 0);
    } catch (error) {
      console.error(error);
      showSnackBar(error?.message || "Enquiry failed", "error");
    } finally {
      setLoading(false);
    }
  }, [callApi, buildPayload, showSnackBar]);

  /* DEBOUNCED FETCH */
  const debouncedFetch = useMemo(
    () =>
      debounce(() => {
        fetchRows();
      }, 300),
    [fetchRows],
  );

  useEffect(() => {
    if (!searchQuery) return;
    debouncedFetch();
    return () => {
      debouncedFetch.cancel();
    };
  }, [paginationModel, sortModel, filterModel, searchQuery, debouncedFetch]);

  const handleSearch = useCallback(() => {
    const { cgl, fromDate, toDate } = filters;

    if (!cgl || !fromDate || !toDate) {
      showSnackBar("Please fill all required fields", "warning");
      return;
    }

    if (!fromDate?.isValid?.() || !toDate?.isValid?.()) {
      showSnackBar("Invalid date selected", "warning");
      return;
    }

    if (fromDate.isBefore(MIN_ALLOWED_DATE, "day")) {
      showSnackBar(
        `From date cannot be earlier than ${MIN_ALLOWED_DATE.format(
          DATE_FORMAT,
        )}`,
        "warning",
      );
      return;
    }

    if (toDate.isBefore(MIN_ALLOWED_DATE, "day")) {
      showSnackBar(
        `To date cannot be earlier than ${MIN_ALLOWED_DATE.format(
          DATE_FORMAT,
        )}`,
        "warning",
      );
      return;
    }

    if (fromDate.isAfter(toDate, "day")) {
      showSnackBar("From date cannot be greater than To date", "warning");
      return;
    }

    if (toDate.isAfter(fromDate.add(1, "year"), "day")) {
      showSnackBar("Date range cannot exceed 12 months", "warning");
      return;
    }

    if (etlDate?.isValid?.() && toDate.isAfter(etlDate, "day")) {
      showSnackBar(
        `To date cannot exceed ETL date ${etlDate.format(DATE_FORMAT)}`,
        "warning",
      );
      return;
    }

    setPaginationModel({
      page: 0,
      pageSize: paginationModel.pageSize,
    });

    setSortModel([
      {
        field: "transactionDate",
        sort: "desc",
      },
    ]);

    setFilterModel({
      items: [],
    });

    setSearchQuery({
      ...filters,
    });
  }, [
    filters,
    etlDate,
    MIN_ALLOWED_DATE,
    DATE_FORMAT,
    paginationModel.pageSize,
    showSnackBar,
  ]);

  /* RESET */
  const handleReset = useCallback(() => {
    setFilters(initialState);
    setSearchQuery(null);
    setRows(null);
    setRowCount(0);
    setPaginationModel({
      page: 0,
      pageSize: DEFAULT_PAGE_SIZE,
    });
    setSortModel([
      {
        field: "transactionDate",
        sort: "desc",
      },
    ]);
    setFilterModel({
      items: [],
    });
  }, [initialState]);

  /* EXPORT */
  const handleExcelExport = useCallback(async () => {
    const payload = { ...buildPayload(), menuId: menu.id };
    if (!payload) return;
    try {
      setExporting(true);
      console.log(payload);
      const response = await callApi(
        "/ES/ledger-enquiries/export-excel",
        payload,
        "POST",
        "arraybuffer",
      );
      const fileName = `GL_Account_${searchQuery.cgl.split(" - ")[0]}`;
      if (response?.byteLength) {
        downloadFile(response, "excel", fileName);
      } else {
        showSnackBar(
          "Failed to download, Something went wrong Kindly try again",
          "error",
        );
      }
    } catch (error) {
      showSnackBar(
        error?.message ||
          "Failed to export, Something went wrong Kindly try again",
        "error",
      );
    } finally {
      setExporting(false);
    }
  }, [buildPayload, callApi, searchQuery, showSnackBar, menu.id]);

  return (
    <LocalizationProvider dateAdapter={AdapterDayjs}>
      <Box
        sx={{
          p: 2.5,
        }}
      >
        <LedgerForm
          filters={filters}
          onFilterChange={(field, value) =>
            setFilters((prev) => ({
              ...prev,
              [field]: value,
            }))
          }
          onReset={handleReset}
          onFetch={handleSearch}
          permissions={{
            hasWholeBank,
            hasCircle,
          }}
          user={user}
          circles={circles}
          currencies={currencies}
          sourceOptions={sourceOptions}
          FOREIGN_CIRCLE_CODE={FOREIGN_CIRCLE_CODE}
          CIRCLE_GROUPS={CIRCLE_GROUPS}
          minLimit={MIN_ALLOWED_DATE}
          maxLimit={etlDate || dayjs()}
          fetchLoading={loading}
        />

        {rows && (
          <LedgerDataGrid
            rows={rows}
            loading={loading}
            rowCount={rowCount}
            paginationModel={paginationModel}
            setPaginationModel={setPaginationModel}
            sortModel={sortModel}
            setSortModel={setSortModel}
            filterModel={filterModel}
            setFilterModel={setFilterModel}
            onExcelExport={handleExcelExport}
            exporting={exporting}
            selectedCurrency={searchQuery?.currencies || ["ALL"]}
            selectedCircle={searchQuery?.circle || "ALL"}
            sourceOptions={selectedSourceOptions}
            branchOptions={selectedBranchOptions}
            circleOptions={selectedCircleOptions}
            currencyOptions={selectedCurrencyOptions}
            searchPerformed={!!searchQuery}
            selectedCgl={searchQuery?.cgl || ""}
          />
        )}
      </Box>
    </LocalizationProvider>
  );
};

export default React.memo(LedgerWiseEnquiry);
import React, { useState, useCallback, useMemo, useEffect } from "react";
import {
  Card,
  CardContent,
  TextField,
  Button,
  Autocomplete,
  Checkbox,
  Typography,
  Stack,
  Box,
  IconButton,
  Grid,
  InputAdornment,
  Paper,
  Collapse,
  Chip,
  MenuItem,
} from "@mui/material";
import { DatePicker } from "@mui/x-date-pickers";

// Icons
import RestartAltIcon from "@mui/icons-material/RestartAlt";
import SearchIcon from "@mui/icons-material/Search";
import VisibilityIcon from "@mui/icons-material/Visibility";
import VisibilityOffIcon from "@mui/icons-material/VisibilityOff";
import DeleteSweepIcon from "@mui/icons-material/DeleteSweep";
import AccountBalanceIcon from "@mui/icons-material/AccountBalance";
import DateRangeIcon from "@mui/icons-material/DateRange";
import CalendarMonthIcon from "@mui/icons-material/CalendarMonth";
import ReceiptLongIcon from "@mui/icons-material/ReceiptLong";
import { createFilterOptions } from "@mui/material/Autocomplete";

// Utilities & Hooks
import { debounce } from "lodash";
import useApi from "../../../hooks/useApi";
import CustomChip from "../../../utils/CustomChip";
import dayjs from "dayjs";
import {
  calculateQuickFilterDates,
  getAvailableFilters,
} from "../../../utils/CommonUtilities";

const LedgerForm = ({
  filters,
  onFilterChange,
  onReset,
  onFetch,
  user,
  circles,
  currencies,
  sourceOptions,
  FOREIGN_CIRCLE_CODE,
  CIRCLE_GROUPS,
  minLimit,
  maxLimit,
  fetchLoading,
}) => {
  const { callApi } = useApi();
  const filter = createFilterOptions();

  // Search States
  const [branchSearch, setBranchSearch] = useState(null);
  const [branches, setBranches] = useState([]);
  const [cgls, setCgls] = useState([]);
  const [loading, setLoading] = useState({ branch: false, cgl: false });
  const req = { branch: true, cgl: true };

  // Dynamic Tray State: "NONE", "BRANCHES", "CURRENCIES"
  const [activeTray, setActiveTray] = useState("NONE");

  // Validation States
  const [fromDateError, setFromDateError] = useState(null);
  const [toDateError, setToDateError] = useState(null);
  const [quickFilter, setQuickFilter] = useState("custom");

  // Conditional Rendering Booleans

  const hasWholeBank = user?.roleAccess === "W";
  const isCircleVisible = !!hasWholeBank;
  const isBranchVisible = user?.roleAccess !== "B";

  const hasSelectedBranches =
    !filters.branches?.includes("ALL") && filters.branches?.length > 0;

  const hasSelectedCurrencies =
    !filters.currencies?.includes("ALL") && filters.currencies?.length > 0;

  // Auto-close tray if its list becomes empty
  useEffect(() => {
    if (activeTray === "BRANCHES" && !hasSelectedBranches)
      setActiveTray("NONE");
    if (activeTray === "CURRENCIES" && !hasSelectedCurrencies)
      setActiveTray("NONE");
  }, [activeTray, hasSelectedBranches, hasSelectedCurrencies]);

  // ================= DYNAMIC DATE FILTERS =================
  const baseDate = maxLimit?.isValid?.() ? maxLimit : dayjs();

  const availableFilters = useMemo(() => {
    return getAvailableFilters(baseDate, minLimit);
  }, [minLimit, baseDate]);

  const handleQuickFilter = (e) => {
    const option = e.target.value;
    setQuickFilter(option);

    if (option === "custom") return;

    const { newStart, newEnd } = calculateQuickFilterDates(
      option,
      baseDate,
      minLimit,
    );

    onFilterChange("fromDate", newStart);
    onFilterChange("toDate", newEnd);
  };

  // ================= CENTRALIZED DATE VALIDATION =================
  useEffect(() => {
    let fromErr = null;
    let toErr = null;

    const start = filters?.fromDate;
    const end = filters?.toDate;

    // 1. Validate From Date
    if (start) {
      if (!start.isValid?.()) fromErr = "invalidDate";
      else if (minLimit?.isValid?.() && start.isBefore(minLimit, "day"))
        fromErr = "minDate";
      else if (maxLimit?.isValid?.() && start.isAfter(maxLimit, "day"))
        fromErr = "maxDate";
    }

    // 2. Validate To Date
    if (end) {
      if (!end.isValid?.()) toErr = "invalidDate";
      else if (minLimit?.isValid?.() && end.isBefore(minLimit, "day"))
        toErr = "minDate";
      else if (maxLimit?.isValid?.() && end.isAfter(maxLimit, "day"))
        toErr = "afterEtlDate";
    }

    // 3. Cross-field Validation
    if (start?.isValid?.() && end?.isValid?.() && !fromErr && !toErr) {
      if (start.isAfter(end, "day")) {
        fromErr = "fromGreaterThanTo";
      } else if (end.isAfter(start.clone().add(1, "year"), "day")) {
        toErr = "rangeExceeds12Months";
      }
    }

    setFromDateError(fromErr);
    setToDateError(toErr);
  }, [filters?.fromDate, filters?.toDate, minLimit, maxLimit]);

  // ================= API & SEARCH LOGIC =================
  const searchLogic = useCallback(
    async (type, term) => {
      if (!term || term.length < 3) return;
      try {
        setLoading((p) => ({ ...p, [type]: true }));
        let cp = "";

        if (hasWholeBank) {
          if (
            filters.circle !== CIRCLE_GROUPS.ALL &&
            filters.circle !== CIRCLE_GROUPS.DOMESTIC &&
            filters.circle !== CIRCLE_GROUPS.FOREIGN
          ) {
            cp = `&circleCode=${filters.circle}`;
          } else if (filters.circle === CIRCLE_GROUPS.FOREIGN) {
            cp = `&circleCode=${FOREIGN_CIRCLE_CODE}`;
          } else if (filters.circle === CIRCLE_GROUPS.DOMESTIC) {
            cp = `&circleCode=${CIRCLE_GROUPS.DOMESTIC}`;
          } else {
            cp = `&circleCode=${CIRCLE_GROUPS.ALL}`;
          }
        } else if (!hasWholeBank) {
          cp = `&circleCode=${user.circleCode}`;
        }

        const url =
          type === "branch"
            ? `/CM/common-master/branches-code-name-only?q=${encodeURIComponent(
                term,
              )}${cp}`
            : `/CM/common-master/cgl-code-description-only?q=${encodeURIComponent(
                term,
              )}`;

        const res = await callApi(url, null, "GET");
        if (res?.data) {
          const opts = res.data.map((i) =>
            type === "branch"
              ? `${i.code}-${i.name}`
              : `${i.cglNumber} - ${i.description}`,
          );
          type === "branch" ? setBranches(opts) : setCgls(opts);
        }
      } catch (e) {
        console.error(e);
      } finally {
        setLoading((p) => ({ ...p, [type]: false }));
      }
    },
    [
      hasWholeBank,
      callApi,
      filters.circle,
      CIRCLE_GROUPS.ALL,
      CIRCLE_GROUPS.DOMESTIC,
      CIRCLE_GROUPS.FOREIGN,
      FOREIGN_CIRCLE_CODE,
      user.circleCode,
    ],
  );

  const fetchSearchData = useMemo(
    () => debounce((t, v) => searchLogic(t, v), 300),
    [searchLogic],
  );
  useEffect(() => () => fetchSearchData.cancel(), [fetchSearchData]);

  // ================= HANDLERS =================
  const handleBranchChange = (val) => {
    const clickedAll = val.includes("ALL") && !filters.branches.includes("ALL");
    const isEmpty = val.length === 0;

    if (clickedAll || isEmpty) {
      onFilterChange("branches", ["ALL"]);
      if (activeTray === "BRANCHES") setActiveTray("NONE");
      return;
    }
    const valWithoutAll = val.filter((v) => v !== "ALL");
    onFilterChange("branches", valWithoutAll);
  };

  const removeBranch = (branchToRemove) => {
    const updated = filters.branches.filter((b) => b !== branchToRemove);
    if (updated.length === 0) {
      onFilterChange("branches", ["ALL"]);
      setActiveTray("NONE");
    } else {
      onFilterChange("branches", updated);
    }
  };

  const removeCurrency = (currencyToRemove) => {
    const updated = filters.currencies.filter((c) => c !== currencyToRemove);
    if (updated.length === 0) {
      onFilterChange("currencies", ["ALL"]);
      setActiveTray("NONE");
    } else {
      onFilterChange("currencies", updated);
    }
  };

  const handleCircleChange = (value) => {
    onFilterChange("branches", ["ALL"]);
    setBranches([]);
    if (activeTray === "BRANCHES") setActiveTray("NONE");
    onFilterChange("circle", value?.value || null);
  };

  const handleLocalReset = () => {
    setQuickFilter("custom");
    setFromDateError(null);
    setToDateError(null);
    setActiveTray("NONE");
    onReset();
  };

  // ================= HELPERS =================
  const SectionHeader = ({ icon, title }) => (
    <Stack direction="row" spacing={1} alignItems="center" sx={{ mb: 2 }}>
      <Box
        sx={{
          p: 0.5,
          bgcolor: "primary.main",
          borderRadius: 1,
          color: "white",
          display: "flex",
        }}
      >
        {icon}
      </Box>
      <Typography
        variant="subtitle2"
        sx={{ fontWeight: 800, color: "text.primary", letterSpacing: 1 }}
      >
        {title}
      </Typography>
    </Stack>
  );

  const getDateErrorMessage = (field, error) => {
    switch (error) {
      case "invalidDate":
        return `Please enter a valid ${field}`;
      case "minDate":
        return `${field} cannot be earlier than ${minLimit?.format(
          "DD-MM-YYYY",
        )}`;
      case "maxDate":
        return `${field} cannot exceed ${maxLimit?.format("DD-MM-YYYY")}`;
      case "fromGreaterThanTo":
        return "From Date cannot be greater than To Date";
      case "toLessThanFrom":
        return "To Date cannot be less than From Date";
      case "rangeExceeds12Months":
        return "Date range cannot exceed 12 months";
      case "afterEtlDate":
        return `To Date cannot exceed Fincore ETL Date ${maxLimit?.format(
          "DD-MM-YYYY",
        )}`;
      default:
        return "";
    }
  };

  const validationMessages = [
    fromDateError && getDateErrorMessage("From Date", fromDateError),
    toDateError && getDateErrorMessage("To Date", toDateError),
  ].filter(Boolean);

  // ================= DYNAMIC TRAY CONTENT =================
  const trayTitle =
    activeTray === "BRANCHES" ? "SELECTED BRANCHES" : "SELECTED CURRENCIES";
  const trayItems =
    activeTray === "BRANCHES" ? filters.branches : filters.currencies;
  const trayRemoveHandler =
    activeTray === "BRANCHES" ? removeBranch : removeCurrency;
  const trayClearAllHandler = () => {
    if (activeTray === "BRANCHES") onFilterChange("branches", ["ALL"]);
    if (activeTray === "CURRENCIES") onFilterChange("currencies", ["ALL"]);
    setActiveTray("NONE");
  };

  const handleInputChange = (e, value, reason) => {
    onFilterChange("cgl", value);

    if (reason === "input") {
      if (value?.length >= 3) {
        fetchSearchData("cgl", value);
      }
    } else if (reason === "blur") {
      setCgls([]);
    } else if (reason === "clear") {
      setCgls([]);
    }
  };

  // ================= UI =================
  return (
    <Box sx={{ position: "relative", mb: 2 }}>
      <Card
        sx={{
          borderRadius: "24px",
          boxShadow: "0 20px 50px rgba(0,0,0,0.1)",
          border: "1px solid rgba(255,255,255,0.3)",
        }}
      >
        <CardContent sx={{ p: 4 }}>
          <Stack
            direction="row"
            justifyContent="space-between"
            sx={{ mb: 1.5 }}
          >
            <Box>
              <Typography variant="h4" sx={{ fontWeight: 900 }}>
                Ledger Explorer
              </Typography>
              <Typography variant="body2" color="text.secondary">
                Hierarchical data filtering & enquiry
              </Typography>
            </Box>
          </Stack>

          <Grid container spacing={4}>
            {/* 1. HIERARCHY ZONE */}
            {(isCircleVisible || isBranchVisible) && (
              <Grid size={{ xs: 12, md: 6 }}>
                <Paper
                  variant="outlined"
                  sx={{
                    p: 3,
                    borderRadius: "20px",
                    bgcolor: "rgba(0,0,0,0.01)",
                    borderStyle: "dashed",
                    position: "relative",
                    height: "100%",
                  }}
                >
                  <SectionHeader
                    icon={<AccountBalanceIcon fontSize="small" />}
                    title="Hierarchy"
                  />
                  <Grid container spacing={2}>
                    {isCircleVisible && (
                      <Grid
                        size={{
                          xs: 12,
                          sm: isCircleVisible && filters.circle ? 6 : 12,
                        }}
                      >
                        <Autocomplete
                          size="small"
                          autoHighlight
                          options={[
                            { value: CIRCLE_GROUPS.ALL, label: "All Circles" },
                            {
                              value: CIRCLE_GROUPS.DOMESTIC,
                              label: "Domestic Circles",
                            },
                            {
                              value: CIRCLE_GROUPS.FOREIGN,
                              label: "Foreign Circles",
                            },
                            ...circles.map((c) => ({
                              value: c.circleCode,
                              label:
                                c.circleCode === FOREIGN_CIRCLE_CODE
                                  ? `${c.circleCode} - Foreign`
                                  : `${c.circleCode} - ${c.circleName}`,
                            })),
                          ]}
                          value={(() => {
                            if (filters.circle === CIRCLE_GROUPS.ALL)
                              return {
                                value: CIRCLE_GROUPS.ALL,
                                label: "All Circles",
                              };
                            if (filters.circle === CIRCLE_GROUPS.DOMESTIC)
                              return {
                                value: CIRCLE_GROUPS.DOMESTIC,
                                label: "Domestic Circles",
                              };
                            if (filters.circle === CIRCLE_GROUPS.FOREIGN)
                              return {
                                value: CIRCLE_GROUPS.FOREIGN,
                                label: "Foreign Circles",
                              };

                            const matched = circles.find(
                              (c) => c.circleCode === filters.circle,
                            );
                            return matched
                              ? {
                                  value: matched.circleCode,
                                  label:
                                    matched.circleCode === FOREIGN_CIRCLE_CODE
                                      ? `${matched.circleCode} - Foreign`
                                      : `${matched.circleCode} - ${matched.circleName}`,
                                }
                              : null;
                          })()}
                          isOptionEqualToValue={(option, value) =>
                            option?.value === value?.value
                          }
                          onChange={(_, value) => handleCircleChange(value)}
                          renderInput={(params) => (
                            <TextField
                              {...params}
                              sx={{ mt: 1 ,gap:0.5,
                                "& .MuiAutocomplete-clearIndicator":{
                                        marginRight:0.5,
                                        mb:1,
                                      },
                                      
                                "& .MuiAutocomplete-popupIndicator":{
                                        mb:1,
                                      }
                              }}
                              label="Select Circle"
                              required
                              variant="standard"
                              inputProps={{
                                ...params.inputProps,
                                maxLength: 30,
                              }}
                            />
                          )}
                        />
                      </Grid>
                    )}
                    {filters.circle && (
                      <Grid
                        size={{
                          xs: 12,
                          sm: isCircleVisible && filters.circle ? 6 : 12,
                        }}
                      >
                        <Autocomplete
                          multiple
                          size="small"
                          disableCloseOnSelect
                          options={["ALL", ...branches]}
                          loading={loading.branch}
                          value={filters.branches}
                          inputValue={branchSearch}
                          onClose={(e, reason) => {
                            if (reason === "blur") {
                              setBranches([]);
                              setBranchSearch("");
                            }
                          }}
                          onInputChange={(event, newInputValue, reason) => {
                            if (newInputValue.length > 30) return;
                            setBranchSearch(newInputValue);

                            if (
                              reason === "input" &&
                              newInputValue.length >= 3
                            ) {
                              fetchSearchData("branch", newInputValue);
                            } else if (reason === "blur") {
                              setBranches([]);
                            }
                          }}
                          onChange={(_, val) => {
                            handleBranchChange(val);
                            setBranchSearch("");
                          }}
                          renderTags={() => null}
                          renderOption={(props, option, { selected }) => (
                            <li {...props} key={option}>
                              <Checkbox
                                size="small"
                                style={{ marginRight: 8 }}
                                checked={selected}
                              />
                              <Typography variant="body2">{option}</Typography>
                            </li>
                          )}
                          renderInput={(p) => (
                            <TextField
                              {...p}
                              label="Select Branches"
                              variant="standard"
                              required
                              placeholder={"Enter atleast 3 digits..."}
                              InputProps={{
                                ...p.InputProps,
                                maxLength: 30,
                                endAdornment: (
                                  <InputAdornment
                                    position="end"
                                    sx={{ 
                                      mb: 0.5,
                                      gap:0.5,
                                      mr:0.5,

                                      "& .MuiAutocomplete-clearIndicator":{
                                        marginRight:0.5,
                                      },
                                     }}
                                  >
                                    <Stack
                                      direction="row"
                                      alignItems="center"
                                      spacing={1}
                                    >
                                      <CustomChip
                                        label={
                                          filters.branches?.includes("ALL")
                                            ? "All Branches"
                                            : `${filters.branches?.length} Selected`
                                        }
                                        color={
                                          filters.branches?.includes("ALL")
                                            ? "default"
                                            : "primary"
                                        }
                                        sx={{
                                          fontWeight: 700,
                                          fontSize: "0.7rem",
                                        }}
                                      />
                                      {hasSelectedBranches && (
                                        <IconButton
                                          size="small"
                                          onClick={() =>
                                            setActiveTray((prev) =>
                                              prev === "BRANCHES"
                                                ? "NONE"
                                                : "BRANCHES",
                                            )
                                          }
                                          color={
                                            activeTray === "BRANCHES"
                                              ? "primary"
                                              : "default"
                                          }
                                          sx={{
                                            transition: "0.2s",
                                            bgcolor:
                                              activeTray === "BRANCHES"
                                                ? "rgba(25, 118, 210, 0.08)"
                                                : "transparent",
                                          }}
                                        >
                                          {activeTray === "BRANCHES" ? (
                                            <VisibilityOffIcon fontSize="small" />
                                          ) : (
                                            <VisibilityIcon fontSize="small" />
                                          )}
                                        </IconButton>
                                      )}
                                    </Stack>
                                    {p.InputProps.endAdornment}
                                  </InputAdornment>
                                ),
                              }}
                            />
                          )}
                        />
                      </Grid>
                    )}
                  </Grid>
                </Paper>
              </Grid>
            )}

            {/* 2. ACCOUNT ZONE */}
            <Grid
              size={{ xs: 12, md: isCircleVisible || isBranchVisible ? 6 : 12 }}
            >
              <Paper
                variant="outlined"
                sx={{
                  p: 3,
                  borderRadius: "20px",
                  bgcolor: "rgba(0,0,0,0.01)",
                  borderStyle: "dashed",
                  position: "relative",
                  height: "100%",
                }}
              >
                <SectionHeader
                  icon={<SearchIcon fontSize="small" />}
                  title="Account Details"
                />
                <Grid container spacing={2}>
                  <Grid size={{ xs: 12, sm: 6 }}>
                    <Autocomplete
                      forcePopupIcon={false}
                      autoHighlight
                      value={filters.cglValue || null}
                      options={cgls}
                      clearIcon={filters.cgl ? undefined : null}
                      noOptionsText={
                        filters.cgl && filters.cgl.length < 3
                          ? "Please enter at least 3 characters"
                          : "No Options"
                      }
                      inputValue={filters.cgl || ""}
                      loading={!req.cgl && loading.cgl}
                      onClose={(e, reason) => {
                        if (reason === "blur") {
                          setCgls([]);
                        }
                      }}
                      onInputChange={(e, value, reason) => {
                        handleInputChange(e, value, reason);
                      }}
                      onChange={(_, v) => onFilterChange("cglValue", v)}
                      renderInput={(params) => (
                        <TextField
                          {...params}
                          sx={{ mt: 0.7 , 
                                "& .MuiAutocomplete-clearIndicator":{
                                    mb:0.5,
                                },}}
                          label="CGL"
                          required
                          InputLabelProps={{ shrink: true }}
                          placeholder={
                            "Enter atleast 3 characters (eg. 9999999999)"
                          }
                          variant="standard"
                          inputProps={{ ...params.inputProps, maxLength: 30 }}
                        />
                      )}
                      loadingText="Searching Cgls..."
                    />
                  </Grid>

                  {/* CURRENCY FIELD */}
                  <Grid size={{ xs: 12, sm: 6 }}>
                    <Autocomplete
                      multiple
                      size="small"
                      disableCloseOnSelect
                      options={currencies}
                      value={
                        filters.currencies?.includes("ALL")
                          ? currencies
                          : filters.currencies || []
                      }
                      onChange={(_, selectedOptions) => {
                        const isSelectAllClicked =
                          selectedOptions.includes("select-all");

                        if (isSelectAllClicked) {
                          const isAllCurrentlySelected =
                            filters.currencies?.includes("ALL") ||
                            (currencies.length > 0 &&
                              filters.currencies?.length === currencies.length);

                          if (isAllCurrentlySelected) {
                            onFilterChange("currencies", []);
                            if (activeTray === "CURRENCIES")
                              setActiveTray("NONE");
                          } else {
                            onFilterChange("currencies", ["ALL"]);
                            if (activeTray === "CURRENCIES")
                              setActiveTray("NONE");
                          }
                        } else {
                          if (selectedOptions.length === currencies.length) {
                            onFilterChange("currencies", ["ALL"]);
                            if (activeTray === "CURRENCIES")
                              setActiveTray("NONE");
                          } else {
                            const valWithoutAll = selectedOptions.filter(
                              (c) => c !== "ALL" && c !== "select-all",
                            );
                            onFilterChange("currencies", valWithoutAll);
                            if (
                              valWithoutAll.length === 0 &&
                              activeTray === "CURRENCIES"
                            )
                              setActiveTray("NONE");
                          }
                        }
                      }}
                      filterOptions={(options) => ["select-all", ...options]}
                      renderTags={() => null}
                      renderOption={(props, option, { selected }) => {
                        const isAllSelected =
                          filters.currencies?.includes("ALL") ||
                          (currencies.length > 0 &&
                            filters.currencies?.length === currencies.length);

                        const isChecked =
                          option === "select-all"
                            ? isAllSelected
                            : filters.currencies?.includes("ALL")
                              ? true
                              : selected;

                        return (
                          <li {...props} key={option}>
                            <Checkbox
                              size="small"
                              style={{ marginRight: 8 }}
                              checked={isChecked}
                            />
                            <Typography
                              variant="body2"
                              sx={{
                                fontWeight: option === "select-all" ? 700 : 400,
                              }}
                            >
                              {option === "select-all"
                                ? "All Currencies"
                                : option}
                            </Typography>
                          </li>
                        );
                      }}
                      renderInput={(p) => {
                        const isAll =
                          filters.currencies?.includes("ALL") ||
                          (currencies.length > 0 &&
                            filters.currencies?.length === currencies.length);
                        return (
                          <TextField
                            {...p}
                            label="Currency"
                            required
                            variant="standard"
                            InputProps={{
                              ...p.InputProps,
                              maxLength: 30,
                              endAdornment: (
                                <InputAdornment position="end" sx={{ mb: 0.5,
                                      gap:0.5,
                                      mr:0.5,

                                      "& .MuiAutocomplete-clearIndicator":{
                                        marginRight:0.5,
                                      }, }}>
                                  <Stack
                                    direction="row"
                                    alignItems="center"
                                    spacing={1}
                                  >
                                    <CustomChip
                                      label={
                                        isAll
                                          ? "All Currencies"
                                          : `${filters.currencies?.length} Selected`
                                      }
                                      color={isAll ? "default" : "primary"}
                                      sx={{
                                        fontWeight: 700,
                                        fontSize: "0.7rem",
                                      }}
                                    />
                                    {!isAll &&
                                      filters.currencies?.length > 0 && (
                                        <IconButton
                                          size="small"
                                          onClick={() =>
                                            setActiveTray((prev) =>
                                              prev === "CURRENCIES"
                                                ? "NONE"
                                                : "CURRENCIES",
                                            )
                                          }
                                          color={
                                            activeTray === "CURRENCIES"
                                              ? "primary"
                                              : "default"
                                          }
                                          sx={{
                                            transition: "0.2s",
                                            bgcolor:
                                              activeTray === "CURRENCIES"
                                                ? "rgba(25, 118, 210, 0.08)"
                                                : "transparent",
                                          }}
                                        >
                                          {activeTray === "CURRENCIES" ? (
                                            <VisibilityOffIcon fontSize="small" />
                                          ) : (
                                            <VisibilityIcon fontSize="small" />
                                          )}
                                        </IconButton>
                                      )}
                                  </Stack>
                                  {p.InputProps.endAdornment}
                                </InputAdornment>
                              ),
                            }}
                          />
                        );
                      }}
                    />
                  </Grid>
                </Grid>
              </Paper>
            </Grid>

            {/* SHARED DYNAMIC TRAY */}
            {activeTray !== "NONE" && (
              <Grid size={{ xs: 12 }}>
                <Collapse in={activeTray !== "NONE"}>
                  <Paper
                    variant="outlined"
                    sx={{
                      borderRadius: "12px",
                      bgcolor: "#fff",
                      border: "1px solid #e0e6ed",
                      overflow: "hidden",
                      boxShadow: "0 4px 20px rgba(0,0,0,0.05)",
                    }}
                  >
                    <Stack
                      direction="row"
                      justifyContent="space-between"
                      alignItems="center"
                      sx={{
                        p: 1.5,
                        borderBottom: "1px solid #f0f0f0",
                        bgcolor: "rgba(25, 118, 210, 0.02)",
                      }}
                    >
                      <Stack direction="row" spacing={1} alignItems="center">
                        <Typography
                          variant="caption"
                          sx={{
                            fontWeight: 800,
                            color: "primary.main",
                            letterSpacing: 1,
                          }}
                        >
                          {trayTitle}
                        </Typography>
                        <CustomChip
                          label={trayItems?.length || 0}
                          color="primary"
                          sx={{ height: 20 }}
                        />
                      </Stack>
                      <Stack direction="row" spacing={1}>
                        <Button
                          size="small"
                          color="error"
                          variant="text"
                          startIcon={<DeleteSweepIcon />}
                          onClick={trayClearAllHandler}
                          sx={{
                            p: 0.5,
                            fontWeight: 700,
                            "&:hover": {
                              color: "white",
                              background: "#9f0400",
                            },
                          }}
                        >
                          Clear All
                        </Button>
                        <IconButton
                          size="small"
                          onClick={() => setActiveTray("NONE")}
                          sx={{ color: "text.secondary" }}
                        >
                          <VisibilityOffIcon fontSize="small" />
                        </IconButton>
                      </Stack>
                    </Stack>
                    <Box
                      sx={{
                        p: 1.5,
                        maxHeight: "180px",
                        overflowY: "auto",
                        display: "flex",
                        flexWrap: "wrap",
                        gap: 1,
                        "&::-webkit-scrollbar": { width: "6px" },
                        "&::-webkit-scrollbar-track": { background: "#f1f1f1" },
                        "&::-webkit-scrollbar-thumb": {
                          background: "#ccc",
                          borderRadius: "10px",
                        },
                      }}
                    >
                      {trayItems?.map((item) => (
                        <Chip
                          key={item}
                          label={item}
                          color="primary"
                          variant="outlined"
                          onDelete={() => trayRemoveHandler(item)}
                          sx={{
                            borderRadius: "8px",
                            bgcolor: "white",
                            fontWeight: 500,
                            "& .MuiChip-deleteIcon": {
                              transition: "0.2s",
                              "&:hover": {
                                transform: "scale(1.2)",
                              },
                            },
                            "&:hover": {
                              bgcolor: "#f5f9ff",
                              borderColor: "primary.main",
                            },
                          }}
                        />
                      ))}
                    </Box>
                  </Paper>
                </Collapse>
              </Grid>
            )}

            {/* 3. TIMELINE & FLAGS ZONE */}
            <Grid size={{ xs: 12 }}>
              <Paper
                sx={{
                  p: 2.5,
                  borderRadius: "20px",
                  background: "#58469f",
                  color: "white",
                }}
              >
                <Grid container spacing={3} alignItems="flex-end">
                  {/* Quick Filters */}
                  <Grid size={{ xs: 12, sm: 6, md: 3 }}>
                    <Stack spacing={1}>
                      <Stack direction="row" spacing={1} alignItems="center">
                        <CalendarMonthIcon fontSize="small" />
                        <Typography sx={{ fontWeight: 700 }}>
                          Date Range
                        </Typography>
                      </Stack>
                      <TextField
                        select
                        size="small"
                        value={quickFilter}
                        onChange={handleQuickFilter}
                        fullWidth
                        sx={{ bgcolor: "white", borderRadius: 1 }}
                      >
                        {availableFilters.map((opt) => (
                          <MenuItem key={opt.value} value={opt.value}>
                            {opt.label}
                          </MenuItem>
                        ))}
                      </TextField>
                    </Stack>
                  </Grid>

                  {/* From Date */}
                  <Grid size={{ xs: 12, sm: 6, md: 3 }}>
                    <Stack spacing={1}>
                      <Stack direction="row" spacing={1} alignItems="center">
                        <DateRangeIcon fontSize="small" />
                        <Typography sx={{ fontWeight: 700 }}>
                          From Date *
                        </Typography>
                      </Stack>
                      <DatePicker
                        value={filters.fromDate}
                        format="DD-MM-YYYY"
                        minDate={minLimit}
                        maxDate={maxLimit}
                        views={["year", "month", "day"]}
                        disableHighlightToday
                        onChange={(value) => {
                          onFilterChange("fromDate", value);
                          setQuickFilter("custom");
                        }}
                        slotProps={{
                          textField: {
                            size: "small",
                            fullWidth: true,
                            placeholder: "DD-MM-YYYY",
                            error: !!fromDateError,
                            sx: {
                              bgcolor: "white",
                              borderRadius: 1,
                              "& .MuiPickersInputBase-sectionsContainer": {
                                opacity: "1",
                              },
                            },
                          },
                        }}
                      />
                    </Stack>
                  </Grid>

                  {/* To Date */}
                  <Grid size={{ xs: 12, sm: 6, md: 3 }}>
                    <Stack spacing={1}>
                      <Stack direction="row" spacing={1} alignItems="center">
                        <DateRangeIcon fontSize="small" />
                        <Typography sx={{ fontWeight: 700 }}>
                          To Date *
                        </Typography>
                      </Stack>
                      <DatePicker
                        value={filters.toDate}
                        format="DD-MM-YYYY"
                        minDate={filters?.fromDate || minLimit}
                        maxDate={maxLimit}
                        disableHighlightToday
                        views={["year", "month", "day"]}
                        disabled={!filters.fromDate}
                        onChange={(value) => {
                          onFilterChange("toDate", value);
                          setQuickFilter("custom");
                        }}
                        slotProps={{
                          textField: {
                            size: "small",
                            fullWidth: true,
                            placeholder: "DD-MM-YYYY",
                            error: !!toDateError,
                            sx: {
                              bgcolor: "white",
                              borderRadius: 1,
                              "& .MuiPickersInputBase-sectionsContainer": {
                                opacity: "1",
                              },
                            },
                          },
                        }}
                      />
                    </Stack>
                  </Grid>

                  {/* Transaction Type */}
                  <Grid size={{ xs: 12, sm: 6, md: 3 }}>
                    <Stack spacing={1}>
                      <Stack direction="row" spacing={1} alignItems="center">
                        <ReceiptLongIcon fontSize="small" />
                        <Typography sx={{ fontWeight: 700 }}>
                          Transaction Type *
                        </Typography>
                      </Stack>
                      <Autocomplete
                        multiple
                        size="small"
                        autoHighlight
                        disableCloseOnSelect
                        options={sourceOptions}
                        value={filters.sourceFlags}
                        getOptionLabel={(o) => o.flagName || ""}
                        isOptionEqualToValue={(option, value) =>
                          option.flagId === value.flagId
                        }
                        onChange={(_, selectedOptions) => {
                          const isSelectAllClicked = selectedOptions.some(
                            (option) => option.flagId === "select-all",
                          );
                          if (isSelectAllClicked) {
                            if (
                              filters.sourceFlags.length ===
                              sourceOptions.length
                            ) {
                              onFilterChange("sourceFlags", []);
                            } else {
                              onFilterChange("sourceFlags", sourceOptions);
                            }
                          } else {
                            onFilterChange("sourceFlags", selectedOptions);
                          }
                        }}
                        filterOptions={(options, params) => {
                          const filtered = filter(options, params);

                          if (params.inputValue) {
                            return filtered;
                          }

                          return [
                            { flagId: "select-all", flagName: "Select All" },
                            ...filtered,
                          ];
                        }}
                        renderTags={(v) => (
                          <CustomChip
                            label={
                              v.length === sourceOptions.length
                                ? "All Types"
                                : `${v.length} Types`
                            }
                            color="default"
                            sx={{ bgcolor: "white" }}
                          />
                        )}
                        renderOption={(props, option, { selected }) => {
                          const isAllSelected =
                            filters.sourceFlags.length === sourceOptions.length;
                          const isChecked =
                            option.flagId === "select-all"
                              ? isAllSelected
                              : selected;
                          return (
                            <li {...props} key={option.flagId}>
                              <Checkbox
                                size="small"
                                style={{ marginRight: 8 }}
                                checked={isChecked}
                              />
                              <Typography
                                variant="body2"
                                sx={{
                                  fontWeight:
                                    option.flagId === "select-all" ? 700 : 400,
                                }}
                              >
                                {option.flagName}
                              </Typography>
                            </li>
                          );
                        }}
                        renderInput={(p) => (
                          <TextField
                            {...p}
                            placeholder="Transaction Types"
                            sx={{
                              bgcolor: "white",
                              borderRadius: 1,
                              "& .MuiOutlinedInput-root": { borderRadius: 1 },
                                      gap:0.5,
                                      mr:0.5,

                                      "& .MuiAutocomplete-clearIndicator":{
                                        marginRight:0.5,
                                      },
                            }}
                            inputProps={{ ...p.inputProps, maxLength: 30 }}
                          />
                        )}
                      />
                    </Stack>
                  </Grid>
                </Grid>
              </Paper>
            </Grid>
          </Grid>

          {/* Validation Messages Bottom Block */}
          <Grid size={{ xs: 12 }}>
            {validationMessages.length > 0 && (
              <Paper
                sx={{
                  mt: 2,
                  p: 1.5,
                  borderRadius: 2,
                  border: "1px solid",
                  borderColor: "#ff4d4f",
                  bgcolor: "#fff1f0",
                }}
              >
                <Stack spacing={0.5}>
                  {validationMessages.map((msg, index) => (
                    <Typography
                      key={index}
                      variant="body2"
                      sx={{ color: "#d32f2f", fontWeight: 600 }}
                    >
                      • {msg}
                    </Typography>
                  ))}
                </Stack>
              </Paper>
            )} 
          </Grid>

          {/* Action Buttons */}
          <Box
            sx={{
              mt: 2,
              position: "sticky",
              bottom: 12,
              zIndex: 20,
              display: "flex",
              justifyContent: "flex-end",
              gap: 2,
            }}
          >
            <Button
              variant="outlined"
              startIcon={<RestartAltIcon />}
              onClick={handleLocalReset}
              sx={{ borderRadius: 2, textTransform: "none", fontWeight: 700, 
              "&:hover":
                {
                  color:"#fff",
                }, }}
            >
              Reset
            </Button>
            <Button
              variant="contained"
              startIcon={<SearchIcon />}
              onClick={onFetch}
              disabled={
                !filters.circle ||
                !filters.cgl ||
                !filters.fromDate ||
                !filters.toDate ||
                fromDateError !== null ||
                toDateError !== null ||
                !filters.currencies?.length
              }
              loading={fetchLoading}
              sx={{
                borderRadius: 2,
                px: 4,
                textTransform: "none",
                fontWeight: 800,
              }}
            >
              Search
            </Button>
          </Box>
        </CardContent>
      </Card>
    </Box>
  );
};

export default LedgerForm;
import React, { useMemo } from "react";
import {
  Box,
  Typography,
  Button,
  CircularProgress,
  Stack,
  Chip,
} from "@mui/material";
import { DataGrid, GridToolbar } from "@mui/x-data-grid";
import ErrorOutlineIcon from "@mui/icons-material/ErrorOutline";
import FileDownloadIcon from "@mui/icons-material/FileDownload";
import AccountBalanceWalletIcon from "@mui/icons-material/AccountBalanceWallet";
import dayjs from "dayjs";
import { useTheme, useMediaQuery } from "@mui/material";

const LedgerDataGrid = ({
  rows,
  loading,
  rowCount,
  paginationModel,
  setPaginationModel,
  sortModel,
  setSortModel,
  filterModel,
  setFilterModel,
  onExcelExport,
  exporting,
  selectedCurrency,
  selectedCircle,
  sourceOptions,
  branchOptions,
  circleOptions,
  currencyOptions,
  selectedCgl,
}) => {
  const theme = useTheme();
  const isMobile = useMediaQuery(theme.breakpoints.down("sm"));
  const isTablet = useMediaQuery(theme.breakpoints.between("sm", "lg"));

  // Format CGL for display (Splitting "9999999999 - Name" into distinct parts)
  const [cglCode, ...cglNameParts] = (selectedCgl || "").split(" - ");
  const cglName = cglNameParts.join(" - ");

  const transactionColumns = useMemo(() => {
    const cols = [
      {
        field: "transactionDate",
        headerName: "Date",
        flex: 0.6,
        minWidth: 120,
        filterable: false,
        valueFormatter: (v) => (v ? dayjs(v).format("DD-MM-YYYY") : "-"),
      },
      {
        field: "branchCode",
        headerName: "Branch",
        flex: 1,
        minWidth: 180,
        ...(branchOptions?.length
          ? { type: "singleSelect", valueOptions: branchOptions }
          : { type: "string" }),
        renderCell: (params) => (
          <Box sx={{ lineHeight: "1.2", py: 0.5 }}>
            <Typography
              variant="body2"
              sx={{ fontWeight: 700, fontSize: "0.8rem" }}
            >
              {params.row.branchCode}
            </Typography>
            <Typography
              variant="caption"
              sx={{ color: "text.secondary", fontSize: "0.7rem" }}
            >
              {params.row.branchName}
            </Typography>
          </Box>
        ),
      },
      { field: "narration", headerName: "Narration", flex: 1.5, minWidth: 250 },

      {
        field: "debitAmount",
        headerName: "Debit",
        flex: 1,
        minWidth: 160,
        headerAlign: "right",
        align: "right",
        filterable: false,
        renderCell: (params) => {
          const val = Number(params.value);
          // if (!val || val === 0) return "-";

          const formattedAmount = new Intl.NumberFormat("en-IN", {
            minimumFractionDigits: 4,
            maximumFractionDigits: 4,
          }).format(Math.abs(val || 0));

          return (
            <Box
              sx={{
                display: "flex",
                alignItems: "center",
                justifyContent: "flex-end",
                height: "100%",
                width: "100%",
              }}
            >
              <Typography
                variant="body2"
                sx={{ color: "#d32f2f", fontWeight: 600 }}
              >
                {formattedAmount}
              </Typography>
            </Box>
          );
        },
      },
      {
        field: "creditAmount",
        headerName: "Credit",
        flex: 1,
        minWidth: 160,
        headerAlign: "right",
        align: "right",
        filterable: false,
        renderCell: (params) => {
          const val = Number(params.value);
          // if (!val || val === 0) return "-";

          const formattedAmount = new Intl.NumberFormat("en-IN", {
            minimumFractionDigits: 4,
            maximumFractionDigits: 4,
          }).format(Math.abs(val || 0));

          return (
            <Box
              sx={{
                display: "flex",
                alignItems: "center",
                justifyContent: "flex-end",
                height: "100%",
                width: "100%",
              }}
            >
              <Typography
                variant="body2"
                sx={{ color: "#2e7d32", fontWeight: 600 }}
              >
                {formattedAmount}
              </Typography>
            </Box>
          );
        },
      },
      {
        field: "sourceFlag",
        headerName: "Source",
        flex: 0.8,
        minWidth: 150,
        type: "singleSelect",
        valueOptions:
          sourceOptions?.map((flag) => ({
            value: flag.flagId,
            label: flag.flagName,
          })) || [],
        valueFormatter: (value) => {
          const matchedFlag = sourceOptions?.find(
            (flag) => flag.flagId === value,
          );
          return matchedFlag?.flagName || value || "-";
        },
      },
    ];

    if (selectedCircle === "ALL") {
      cols.splice(1, 0, {
        field: "circleCode",
        headerName: "Circle",
        flex: 1,
        minWidth: 150,
        type: "singleSelect",
        valueOptions: circleOptions,
        renderCell: (params) => (
          <Box sx={{ lineHeight: "1.2", py: 0.5 }}>
            <Typography
              variant="body2"
              sx={{ fontWeight: 700, fontSize: "0.8rem" }}
            >
              {params.row.circleCode}
            </Typography>
            <Typography
              variant="caption"
              sx={{ color: "text.secondary", fontSize: "0.7rem" }}
            >
              {params.row.circleName}
            </Typography>
          </Box>
        ),
      });
    }

    // CHECK IF CURRENCY COLUMN SHOULD RENDER
    const shouldShowCurrency = Array.isArray(selectedCurrency)
      ? selectedCurrency.includes("ALL") || selectedCurrency.length > 1
      : selectedCurrency === "All Currencies" || selectedCurrency === "ALL";

    if (shouldShowCurrency) {
      // Find where "Source" column is to insert Currency right before it dynamically
      const sourceIndex = cols.findIndex((c) => c.field === "sourceFlag");
      const insertIndex = sourceIndex !== -1 ? sourceIndex : cols.length;

      cols.splice(insertIndex, 0, {
        field: "currency",
        headerName: "Currency",
        flex: 1,
        minWidth: 150,
        type: "singleSelect",
        valueOptions: currencyOptions,
        renderCell: (params) => (
          <Box sx={{ lineHeight: "1.2", py: 0.5 }}>
            <Typography
              variant="body2"
              sx={{ fontWeight: 700, fontSize: "0.8rem" }}
            >
              {params.row.currency}
            </Typography>
            <Typography
              variant="caption"
              sx={{ color: "text.secondary", fontSize: "0.7rem" }}
            >
              {params.row.currencyName}
            </Typography>
          </Box>
        ),
      });
    }
    return cols;
  }, [
    branchOptions,
    sourceOptions,
    selectedCircle,
    selectedCurrency,
    circleOptions,
    currencyOptions,
  ]);

  const columnVisibilityModel = useMemo(
    () => ({
      branchName: false,
      circleName: false,
      ...(isMobile && {
        narration: false,
        sourceFlag: false,
        circleCode: false,
      }),
      ...(isTablet && { narration: false }),
    }),
    [isMobile, isTablet],
  );

  const CustomNoRowsOverlay = () => (
    <Box
      sx={{
        display: "flex",
        flexDirection: "column",
        height: "100%",
        justifyContent: "center",
        alignItems: "center",
      }}
    >
      <ErrorOutlineIcon fontSize="large" color="action" />
      <Typography variant="h5" fontSize="1.2rem" color="text.secondary">
        No transactions available for the selected criteria
      </Typography>
    </Box>
  );

  return (
    <Box sx={{ width: "100%", height: "100%", mt: 3 }}>
      {/* SEPARATE HEADER SECTION */}
      <Box
        sx={{
          p: 2.5,
          mb: 3,
          borderRadius: "20px",
          background: "rgba(255, 255, 255, 0.4)",
          backdropFilter: "blur(12px)",
          border: "1px solid rgba(255, 255, 255, 0.3)",
          boxShadow: "0 8px 32px rgba(0,0,0,0.05)",
          display: "flex",
          flexDirection: "column",
          gap: 2.5,
        }}
      >
        <Stack
          direction={{ xs: "column", sm: "row" }}
          spacing={2}
          justifyContent="space-between"
          alignItems={{ xs: "stretch", sm: "center" }}
        >
          <Box
            sx={{
              display: "flex",
              flexDirection: "row",
              alignItems: "center",
              gap: 1.5,
              flexWrap: "wrap",
            }}
          >
            <Typography
              variant="h6"
              fontWeight={800}
              sx={{ color: "#1a1a1a", letterSpacing: "-0.5px" }}
            >
              Transactions Ledger
            </Typography>

            {/* NEW CGL BADGE */}
            {selectedCgl && (
              <Box
                sx={{
                  display: "flex",
                  alignItems: "center",
                  bgcolor: "rgba(88, 70, 159, 0.06)",
                  px: 1.5,
                  py: 0.5,
                  borderRadius: 2,
                  border: "1px solid rgba(88, 70, 159, 0.15)",
                }}
              >
                <AccountBalanceWalletIcon
                  sx={{ fontSize: 18, color: "#58469f", mr: 1 }}
                />
                <Typography
                  variant="body2"
                  sx={{ fontWeight: 800, color: "#58469f", mr: 0.5 }}
                >
                  {cglCode}
                </Typography>
                {cglName && (
                  <Typography
                    variant="caption"
                    sx={{
                      color: "text.secondary",
                      fontWeight: 600,
                      borderLeft: "1px solid rgba(0,0,0,0.1)",
                      pl: 0.5,
                    }}
                  >
                    {cglName}
                  </Typography>
                )}
              </Box>
            )}

            <Chip
              label={
                rowCount > 0
                  ? `${rowCount.toLocaleString("en-IN")} Records Found`
                  : "No Records"
              }
              size="small"
              sx={{
                fontWeight: 700,
                color: "#58469f",
                bgcolor: "rgba(88, 70, 159, 0.1)",
                borderRadius: "8px",
              }}
            />
          </Box>
          <Button
            variant="contained"
            size={isMobile ? "medium" : "small"}
            startIcon={
              exporting ? (
                <CircularProgress size={16} color="inherit" />
              ) : (
                <FileDownloadIcon />
              )
            }
            onClick={onExcelExport}
            disabled={!rowCount || loading || exporting}
            sx={{
              textTransform: "none",
              bgcolor: "#58469f",
              fontWeight: 700,
              borderRadius: "8px",
              px: 3,
              "&:hover": { bgcolor: "#45357a" },
            }}
          >
            {exporting ? "Preparing..." : "Export"}
          </Button>
        </Stack>

        {/* DATA GRID SECTION */}
        <Box
          sx={{
            width: "100%",
            overflowX: "auto",
            height: { xs: "65vh", sm: "70vh", md: 600 },
          }}
        >
          <DataGrid
            rows={rows}
            columns={transactionColumns}
            rowCount={rowCount}
            loading={loading}
            getRowId={(row) => row.transactionId}
            pagination
            paginationMode="server"
            sortingMode="server"
            filterMode="server"
            pageSizeOptions={[10, 20, 50, 100]}
            paginationModel={paginationModel}
            onPaginationModelChange={setPaginationModel}
            sortModel={sortModel}
            onSortModelChange={setSortModel}
            filterModel={filterModel}
            onFilterModelChange={setFilterModel}
            rowHeight={50}
            disableRowSelectionOnClick
            slots={{ noRowsOverlay: CustomNoRowsOverlay }}
            initialState={{
              columns: { columnVisibilityModel },
            }}
            sx={{
              borderRadius: "20px",
              backgroundColor: "rgba(255,255,255,0.4)",
              border: "1px solid rgba(255,255,255,0.3)",
              "& .MuiDataGrid-columnHeaders": {
                bgcolor: "#f8f9fa",
                fontWeight: 700,
              },
            }}
          />
        </Box>
      </Box>
    </Box>
  );
};

export default LedgerDataGrid;
