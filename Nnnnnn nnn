import React, { useState, useEffect } from "react";
import CountdownPage from "./components/CountdownPage";
import CelebrationOverlay from "./components/CelebrationOverlay";
import Login from "../../features/auth/Login";
import PageLoadingOverlay from "../../utils/PageLoadingOverlay";
import { resolveConfig } from "../../config/EnvironmentConfig";
import { useDispatch } from "react-redux";
import { setAppConfig } from "../../store/slices/appConfigSlice";
import useCustomSnackbar from "../../utils/useCustomSnackbar";

const LaunchScreen = () => {
  const dispatch = useDispatch();
  const showSnackbar = useCustomSnackbar();
  const [launchData, setLaunchData] = useState(null);
  const [isLoading, setIsLoading] = useState(true);
  const [showCelebration, setShowCelebration] = useState(false);
  const [isLaunched, setIsLaunched] = useState(false);

  useEffect(() => {
    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), 8000); // 8s safety timeout

    const checkLaunchStatus = async () => {
      try {
        const API_URL = resolveConfig("/LS") + "/auth/init";

        const response = await fetch(API_URL, {
          method: "GET",
          signal: controller.signal,
          headers: {
            Accept: "application/json",
            "Cache-Control": "no-cache",
          },
        });

        clearTimeout(timeoutId);

        if (!response.ok) throw new Error(`HTTP ${response.status}`);

        const data = await response.json();

        // Inside the fetch success block:
        dispatch(
          setAppConfig({
            appVersion: data.version || "1.0.0",
            publicKey: data.publicKey || null,
          }),
        );

        // Standardize incoming data with defaults
        const prodDate =
          data.prodDate || new Date().toISOString().split("T")[0];
        const launchTime = data.launchTime || "00:00:00";

        // Convert to IST Date Object (+05:30)
        const target = new Date(`${prodDate}T${launchTime}+05:30`);

        if (target.getTime() <= Date.now()) {
          setIsLaunched(true);
        } else {
          setLaunchData({
            ...data,
            targetDate: target,
            appName: data.appName || "Fincore",
            version: data.version || "1.0.0",
          });
        }
      } catch (error) {
        if (error.name !== "AbortError") {
          console.error("Launch Check Failed:", error);
        }
        if (error.response?.status === 429) {
          // Note: Axios lowercases all header names automatically.
          const retryTime =
            error.response.headers["retry-after"] || "a few minutes";
          console.log(
            `Maximum login attempts exceeded. Please retry after ${retryTime} seconds.`,
          );
          showSnackbar(
            "Too Many Requests, Maximum login attempts exceeded. Please try after sometime.",
            "error",
          );
          return;
        }
        setIsLaunched(true); // Fallback to Login on API failure
      } finally {
        // Small buffer to let the "Cool" loader finish its shimmer
        setTimeout(() => setIsLoading(false), 5000);
      }
    };

    checkLaunchStatus();
    return () => {
      clearTimeout(timeoutId);
      controller.abort();
    };
  }, [dispatch, showSnackbar]);

  const handleCountdownComplete = () => setShowCelebration(true);

  const handleCelebrationComplete = () => {
    setShowCelebration(false);
    setIsLaunched(true);
  };

  // 1. Loading State (Your Glassmorphism Overlay)
  if (isLoading && !isLaunched)
    return <PageLoadingOverlay loading={isLoading} />;

  // 2. Post-Launch State (Login Screen)
  if (isLaunched) return <Login />;

  // 3. Countdown / Celebration State
  return (
    <>
      {showCelebration ? (
        <CelebrationOverlay
          version={launchData?.version}
          onComplete={handleCelebrationComplete}
        />
      ) : (
        <CountdownPage
          targetDate={launchData?.targetDate}
          appName={launchData?.appName}
          version={launchData?.version}
          onCountdownComplete={handleCountdownComplete}
        />
      )}
    </>
  );
};

export default LaunchScreen;
