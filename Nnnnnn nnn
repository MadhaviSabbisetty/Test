import React, {
  useState,
  useCallback,
  useEffect,
  useMemo,
  useRef,
} from "react";
import { useSelector } from "react-redux";
import { Box } from "@mui/material";
import { LocalizationProvider } from "@mui/x-date-pickers";
import { AdapterDayjs } from "@mui/x-date-pickers/AdapterDayjs";
import dayjs from "dayjs";
import debounce from "lodash/debounce";
import LedgerForm from "./components/BalanceLedgerForm";
import LedgerDataGrid from "./components/BalanceLedgerDataGrid";
import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import downloadFile from "../../utils/DownloadUtils";

const DEFAULT_PAGE_SIZE = 20;
const FOREIGN_CIRCLE_CODE = "021";

const CIRCLE_GROUPS = {
  ALL: "ALL",
  DOMESTIC: "DOMESTIC",
  FOREIGN: "FOREIGN",
};

const LedgerWiseBalanceEnquiry = () => {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();
  const user = useSelector((state) => state.auth.user);
  const menu = useSelector((state) => state.menus.selectedMenuItem);

  const MIN_ALLOWED_DATE = dayjs("2026-03-31");
  const DATE_FORMAT = "DD/MM/YYYY";

  const hasWholeBank = user?.roleAccess === "W";
  const isCircleUser = user?.roleAccess === "C";

  const [circles, setCircles] = useState([]);
  const [initialState, setInitialState] = useState({
    enquiryType: "COLLATION",
    level: "BRANCH",
    circle: "ALL",
    branches: ["All Branches"],
    currencies: ["All Currencies"],
    cgl: [],
    balanceDate: null,
  });

  const [currencies, setCurrencies] = useState([]);
  const [etlDate, setEtlDate] = useState(null);

  const [rows, setRows] = useState(null);
  const [rowCount, setRowCount] = useState(0);

  const [loading, setLoading] = useState(false);
  const [exporting, setExporting] = useState(false);

  const [paginationModel, setPaginationModel] = useState({
    page: 0,
    pageSize: DEFAULT_PAGE_SIZE,
  });

  const [sortModel, setSortModel] = useState([
    {
      field: "balanceDate",
      sort: "desc",
    },
  ]);

  const [filterModel, setFilterModel] = useState({
    items: [],
  });

  /* INITIAL FILTERS */
  const initialDetails = useMemo(() => {
    return {
      enquiryType: "COLLATION",
      level: hasWholeBank ? "BANK" : isCircleUser ? "CIRCLE" : "BRANCH",
      circle: hasWholeBank ? "ALL" : user?.circleCode,
      branches:
        user?.roleAccess === "B"
          ? [`${user?.branch}-${user?.branchName}`]
          : ["All Branches"],
      currencies: ["All Currencies", ...(currencies || [])],
      cgl: ["All CGLs"],
      fromDate: null,
      toDate: null,
    };
  }, [
    hasWholeBank,
    isCircleUser,
    user?.circleCode,
    user?.roleAccess,
    user?.branch,
    user?.branchName,
    currencies,
  ]);

  const [filters, setFilters] = useState(initialState);
  const [searchQuery, setSearchQuery] = useState(null);

  useEffect(() => {
    setInitialState(initialDetails);
    setFilters(initialDetails);
  }, [initialDetails]);

  const isCollationMode = !hasWholeBank || filters.enquiryType === "COLLATION";

  /* FETCH MASTERS */
  const fetchMasters = useCallback(async () => {
    try {
      const [dateRes, currRes] = await Promise.all([
        callApi("/PS/file/fincore-date", {}, "GET"),
        callApi("/CM/common-master/currency-code-name-only", null, "GET"),
      ]);

      /* ETL DATE */
      if (dateRes?.data?.userDate) {
        setEtlDate(dayjs(dateRes.data.userDate, "YYYY-MM-DD"));
      }

      /* CURRENCIES */
      const formattedCurrencies =
        currRes?.data?.map((c) => `${c.currencyCode} - ${c.currencyName}`) ||
        [];

      const sortedCurrencies = formattedCurrencies.sort((a, b) => {
        const aCode = a.split(" ")[0];
        const bCode = b.split(" ")[0];

        // INR always on top
        if (aCode === "INR") return -1;
        if (bCode === "INR") return 1;

        // Remaining alphabetical
        return a.localeCompare(b);
      });

      setCurrencies(sortedCurrencies);

      /* CIRCLES */
      if (hasWholeBank) {
        const circleRes = await callApi(
          "/CM/common-master/circle-codes",
          null,
          "GET",
        );
        setCircles(circleRes?.data || []);
      }
    } catch (error) {
      console.error(error);
      showSnackBar("Failed to load master configuration", "error");
    }
  }, [callApi, hasWholeBank, showSnackBar]);

  useEffect(() => {
    fetchMasters();
  }, [fetchMasters]);

  /* BRANCH OPTIONS */
  const selectedBranchOptions = useMemo(() => {
    if (
      !filters.branches?.length ||
      filters.branches.includes("All Branches")
    ) {
      return [];
    }
    return filters.branches.map((branch) => ({
      value: branch.split("-")[0],
      label: branch,
    }));
  }, [filters.branches]);

  /* CIRCLE OPTIONS */
  const selectedCircleOptions = useMemo(() => {
    const formattedCircles = circles.map((circle) => ({
      value: circle.circleCode,
      label:
        circle.circleCode === FOREIGN_CIRCLE_CODE
          ? `${circle.circleCode} - Foreign`
          : `${circle.circleCode} - ${circle.circleName}`,
    }));

    // ALL/GROUP OPTIONS
    if (
      filters.circle === CIRCLE_GROUPS.ALL ||
      filters.circle === CIRCLE_GROUPS.DOMESTIC ||
      filters.circle === CIRCLE_GROUPS.FOREIGN
    ) {
      return formattedCircles;
    }

    return formattedCircles.filter((circle) => circle.value === filters.circle);
  }, [filters.circle, circles]);

  /* CURRENCY OPTIONS */
  const selectedCurrencyOptions = useMemo(() => {
    if (
      !filters.currencies?.length ||
      filters.currencies.includes("All Currencies")
    ) {
      return currencies.map((currency) => ({
        value: currency.split(" (")[0],
        label: currency,
      }));
    }
    return (filters.currencies || []).map((currency) => ({
      value: currency.split(" (")[0],
      label: currency,
    }));
  }, [filters.currencies, currencies]);

  /* PAYLOAD */
  const buildPayload = useCallback(() => {
    if (!searchQuery) return null;

    const gridFilters =
      filterModel.items
        ?.filter(
          (item) =>
            item.field &&
            item.operator &&
            item.value !== undefined &&
            item.value !== null &&
            item.value !== "",
        )
        .map((item) => ({
          field: item.field,
          operator: item.operator,
          value: item.value,
        })) || [];

    return {
      enquiryType: searchQuery.enquiryType,
      circle: searchQuery.circle,
      cgls: searchQuery.cgl?.includes("All CGLs")
        ? ["ALL"]
        : searchQuery.cgl?.map((c) => c.split("-")[0].trim()) || [],
      cglName: searchQuery.cgl?.includes("All CGLs")
        ? ["ALL"]
        : searchQuery.cgl?.map((c) => c.split("-")[1]) || [],
      currencies: searchQuery.currencies?.includes("All Currencies")
        ? ["ALL"]
        : searchQuery.currencies?.map((currency) => currency.split("(")[0]) ||
          [],
      branches:
        searchQuery.enquiryType === "CONSOLIDATED"
          ? []
          : searchQuery.branches.includes("All Branches")
            ? ["ALL"]
            : searchQuery.branches.map((b) => b.split("-")[0]),
      balanceDate: dayjs(searchQuery.balanceDate).format("DD/MM/YYYY"),
      page: paginationModel.page,
      size: paginationModel.pageSize,
      sortField: sortModel?.[0]?.field || "balanceDate",
      sortOrder: sortModel?.[0]?.sort || "desc",
      gridFilters,
    };
  }, [searchQuery, paginationModel, sortModel, filterModel]);

  /* FETCH ROWS */
  const fetchRows = useCallback(async () => {
    const payload = buildPayload();
    console.log("payload", payload);
    if (!payload) return;
    try {
      setLoading(true);
      console.log(payload);
      const res = await callApi(
        "/ES/ledger-wise-balances/search",
        payload,
        "POST",
      );
      console.log("api response", res);
      setRows(res?.data?.content || []);
      setRowCount(res?.data?.page?.totalElements || 0);
    } catch (error) {
      console.error(error);
      showSnackBar(error?.message || "Enquiry failed", "error");
    } finally {
      setLoading(false);
    }
  }, [callApi, buildPayload, showSnackBar]);

  /* --- NEW DEBOUNCE IMPLEMENTATION --- */
  const fetchRowsRef = useRef(fetchRows);
  useEffect(() => {
    fetchRowsRef.current = fetchRows;
  }, [fetchRows]);

  /* DEBOUNCED FETCH */
  const debouncedFetch = useMemo(
    () =>
      debounce(() => {
        if (fetchRowsRef.current) fetchRowsRef.current();
      }, 300),
    [], // Empty dependency array ensures the debounce instance is never recreated
  );

  useEffect(() => {
    if (!searchQuery) return;
    debouncedFetch();
    return () => {
      debouncedFetch.cancel();
    };
  }, [paginationModel, sortModel, filterModel, searchQuery, debouncedFetch]);

  const handleSearch = useCallback(() => {
    const { cgl, balanceDate } = filters;

    if (cgl.length === 0 || filters.currencies.length === 0 || !balanceDate) {
      showSnackBar("Please fill all required fields", "warning");
      return;
    }

    if (!balanceDate?.isValid?.()) {
      showSnackBar("Invalid date selected", "warning");
      return;
    }

    if (balanceDate.isBefore(MIN_ALLOWED_DATE, "day")) {
      showSnackBar(
        `Date cannot be earlier than ${MIN_ALLOWED_DATE.format(DATE_FORMAT)}`,
        "warning",
      );
      return;
    }

    if (etlDate?.isValid?.() && balanceDate.isAfter(etlDate, "day")) {
      showSnackBar(
        `Date cannot exceed ETL date ${etlDate.format(DATE_FORMAT)}`,
        "warning",
      );
      return;
    }

    setPaginationModel({
      page: 0,
      pageSize: paginationModel.pageSize,
    });

    setSortModel([
      {
        field: "balanceDate",
        sort: "desc",
      },
    ]);

    setFilterModel({
      items: [],
    });

    setSearchQuery({
      ...filters,
    });
  }, [
    filters,
    etlDate,
    MIN_ALLOWED_DATE,
    DATE_FORMAT,
    paginationModel.pageSize,
    showSnackBar,
  ]);

  /* RESET */
  const handleReset = useCallback(() => {
    setFilters(initialState);
    setSearchQuery(null);
    setRows(null);
    setRowCount(0);
    setPaginationModel({
      page: 0,
      pageSize: DEFAULT_PAGE_SIZE,
    });
    setSortModel([
      {
        field: "balanceDate",
        sort: "desc",
      },
    ]);
    setFilterModel({
      items: [],
    });
  }, [initialState]);

  /* EXPORT */
  const handleExcelExport = useCallback(async () => {
    const payload = { ...buildPayload(), menuId: menu.id };
    if (!payload) return;
    try {
      setExporting(true);
      console.log(payload);
      const response = await callApi(
        "/ES/ledger-wise-balances/export-excel",
        payload,
        "POST",
        "arraybuffer",
      );
      const fileName = `GL_Balance_${payload?.enquiryType === "COLLATION" ? "Collation" : "Consolidation"}_Report`;
      if (response?.byteLength) {
        downloadFile(response, "excel", fileName);
      } else {
        showSnackBar(
          "Failed to download, Something went wrong Kindly try again",
          "error",
        );
      }
    } catch (error) {
      showSnackBar(
        error?.message ||
          "Failed to export, Something went wrong Kindly try again",
        "error",
      );
    } finally {
      setExporting(false);
    }
  }, [buildPayload, callApi, showSnackBar, menu.id]);

  return (
    <LocalizationProvider dateAdapter={AdapterDayjs}>
      <Box
        sx={{
          p: { xs: 1, sm: 2, md: 2.5 },
          width: "100%",
          boxSizing: "border-box",
        }}
      >
        <LedgerForm
          filters={filters}
          onFilterChange={(field, value) => {
            if (field === "enquiryType") {
              setRows(null);
              setRowCount(0);
              setSearchQuery(null);
              setFilters({
                ...initialDetails,
                enquiryType: value,
              });
              return;
            }
            setFilters((prev) => ({
              ...prev,
              [field]: value,
            }));
          }}
          onReset={handleReset}
          onFetch={handleSearch}
          user={user}
          circles={circles}
          currencies={currencies}
          FOREIGN_CIRCLE_CODE={FOREIGN_CIRCLE_CODE}
          CIRCLE_GROUPS={CIRCLE_GROUPS}
          minLimit={MIN_ALLOWED_DATE}
          maxLimit={etlDate || dayjs()}
          fetchLoading={loading}
          isCollationMode={isCollationMode}
        />

        {searchQuery && rows && (
          <LedgerDataGrid
            rows={rows}
            loading={loading}
            rowCount={rowCount}
            paginationModel={paginationModel}
            setPaginationModel={setPaginationModel}
            sortModel={sortModel}
            setSortModel={setSortModel}
            filterModel={filterModel}
            setFilterModel={setFilterModel}
            onExcelExport={handleExcelExport}
            exporting={exporting}
            selectedCurrency={searchQuery?.currencies || "ALL"}
            selectedCircle={searchQuery?.circle || "ALL"}
            branchOptions={selectedBranchOptions}
            circleOptions={selectedCircleOptions}
            currencyOptions={selectedCurrencyOptions}
            searchPerformed={!!searchQuery}
            enquiryType={filters.enquiryType}
            selectedCgl={filters.cgl}
          />
        )}
      </Box>
    </LocalizationProvider>
  );
};

export default React.memo(LedgerWiseBalanceEnquiry);
import React, { useState, useCallback, useMemo, useEffect } from "react";
import {
  Card,
  CardContent,
  TextField,
  Button,
  Autocomplete,
  Checkbox,
  Typography,
  Stack,
  Box,
  IconButton,
  Grid,
  InputAdornment,
  Paper,
  Collapse,
  Chip,
  ToggleButton,
  ToggleButtonGroup,
} from "@mui/material";
import { DatePicker } from "@mui/x-date-pickers";

// Icons
import RestartAltIcon from "@mui/icons-material/RestartAlt";
import SearchIcon from "@mui/icons-material/Search";
import VisibilityIcon from "@mui/icons-material/Visibility";
import VisibilityOffIcon from "@mui/icons-material/VisibilityOff";
import DeleteSweepIcon from "@mui/icons-material/DeleteSweep";
import AccountBalanceIcon from "@mui/icons-material/AccountBalance";
import DateRangeIcon from "@mui/icons-material/DateRange";
import SummarizeIcon from "@mui/icons-material/Summarize";

// Utilities & Hooks
import { debounce } from "lodash";
import useApi from "../../../hooks/useApi";
import CustomChip from "../../../utils/CustomChip";

const BalanceLedgerForm = ({
  filters,
  onFilterChange,
  onReset,
  onFetch,
  user,
  circles,
  currencies,
  FOREIGN_CIRCLE_CODE,
  CIRCLE_GROUPS,
  minLimit,
  maxLimit,
  fetchLoading,
}) => {
  const { callApi } = useApi();

  const [branchSearch, setBranchSearch] = useState(null);
  const [branches, setBranches] = useState([]);
  const [cgls, setCgls] = useState(["All CGLs"]);
  const [loading, setLoading] = useState({
    branch: false,
    cgl: false,
    currency: false,
  });
  const [viewList, setViewList] = useState(null);
  const [balanceDateError, setBalanceDateError] = useState(null);
  const [currencyOptions, setCurrencyOptions] = useState([
    "All Currencies",
    ...(currencies || []),
  ]);

  useEffect(() => {
    const allCurrencies = ["All Currencies", ...(currencies || [])];

    setCurrencyOptions(allCurrencies);

    if (filters.currencies?.includes("All Currencies")) {
      onFilterChange("currencies", allCurrencies);
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [currencies]);

  const hasWholeBank = user?.roleAccess === "W";
  const isCircleVisible = !!hasWholeBank;
  const isBranchVisible = !hasWholeBank || filters.enquiryType === "COLLATION";

  const isBranchUser = user?.roleAccess === "B";
  const isCircleUser = user?.roleAccess === "C";

  const branch = filters.branches || [];
  const hasSelectedBranches =
    !branch.includes("All Branches") && branch.length > 0;

  const cgl = filters.cgl || [];
  const hasSelectedCgls = !cgl.includes("All CGLs") && cgl.length > 0;

  const currency = filters.currencies || [];
  const hasSelectedCurrencies =
    !currency.includes("All Currencies") && currency.length > 0;

  const searchLogic = useCallback(
    async (type, term) => {
      if (!term || term.length < 3) return;
      try {
        setLoading((p) => ({ ...p, [type]: true }));
        let cp = "";

        if (hasWholeBank) {
          if (
            filters.circle !== CIRCLE_GROUPS.ALL &&
            filters.circle !== CIRCLE_GROUPS.DOMESTIC &&
            filters.circle !== CIRCLE_GROUPS.FOREIGN
          ) {
            cp = `&circleCode=${filters.circle}`;
          } else if (filters.circle === CIRCLE_GROUPS.FOREIGN) {
            cp = `&circleCode=${FOREIGN_CIRCLE_CODE}`;
          } else if (filters.circle === CIRCLE_GROUPS.DOMESTIC) {
            cp = `&circleCode=${CIRCLE_GROUPS.DOMESTIC}`;
          } else {
            cp = `&circleCode=${CIRCLE_GROUPS.ALL}`;
          }
        } else if (!hasWholeBank) {
          cp = `&circleCode=${user.circleCode}`;
        }

        const url =
          type === "branch"
            ? `/CM/common-master/branches-code-name-only?q=${encodeURIComponent(term)}${cp}`
            : type === "cgl"
              ? `/CM/common-master/cgl-code-description-only?q=${encodeURIComponent(term)}`
              : `/CM/common-master/currency-code-name-only?q=${encodeURIComponent(term)}`;

        const res = await callApi(url, null, "GET");

        if (res?.data) {
          let opts = [];
          if (type === "branch") {
            opts = res.data.map((i) => `${i.code}-${i.name}`);
            setBranches(opts);
          } else if (type === "cgl") {
            opts = res.data.map((i) => `${i.cglNumber} - ${i.description}`);
            setCgls(opts);
          } else if (type === "currency") {
            opts = res.data.map((i) => `${i.currencyCode} (${i.currencyName})`);
            setCurrencyOptions(opts);
          }
        }
      } catch (e) {
        console.error(e);
      } finally {
        setLoading((p) => ({ ...p, [type]: false }));
      }
    },
    [
      hasWholeBank,
      callApi,
      filters.circle,
      CIRCLE_GROUPS.ALL,
      CIRCLE_GROUPS.DOMESTIC,
      CIRCLE_GROUPS.FOREIGN,
      FOREIGN_CIRCLE_CODE,
      user.circleCode,
    ],
  );

  const fetchSearchData = useMemo(
    () => debounce((t, v) => searchLogic(t, v), 300),
    [searchLogic],
  );

  useEffect(() => () => fetchSearchData.cancel(), [fetchSearchData]);

  const handleBranchChange = (val) => {
    const clickedAll =
      val.includes("All Branches") &&
      !filters.branches.includes("All Branches");
    const isEmpty = val.length === 0;

    if (clickedAll || isEmpty) {
      onFilterChange("branches", ["All Branches"]);
      setViewList(null);
      return;
    }

    const valWithoutAll = val.filter((v) => v !== "All Branches");
    onFilterChange("branches", valWithoutAll);
  };

  const removeBranch = (branchToRemove) => {
    const updated = filters.branches.filter((b) => b !== branchToRemove);

    if (updated.length === 0) {
      onFilterChange("branches", ["All Branches"]);
      setViewList(null);
    } else {
      onFilterChange("branches", updated);
    }
  };

  const handleCglChange = (val) => {
    const clickedAll =
      val.includes("All CGLs") && !filters.cgl.includes("All CGLs");
    const isEmpty = val.length === 0;

    if (clickedAll || isEmpty) {
      onFilterChange("cgl", ["All CGLs"]);
      setViewList(null);
      return;
    }

    onFilterChange(
      "cgl",
      val.filter((v) => v !== "All CGLs"),
    );
  };

  const removeCgl = (item) => {
    const updated = filters.cgl.filter((c) => c !== item);

    if (updated.length === 0) {
      onFilterChange("cgl", ["All CGLs"]);
      setViewList(null);
    } else {
      onFilterChange("cgl", updated);
    }
  };

  const handleCurrencyChange = (val) => {
    const hadAll = filters.currencies.includes("All Currencies");
    const hasAll = val.includes("All Currencies");

    // User clicked "All Currencies" -> select everything
    if (!hadAll && hasAll) {
      onFilterChange("currencies", [
        "All Currencies",
        ...currencies.filter((c) => c !== "All Currencies"),
      ]);
      setViewList(null);
      return;
    }

    // User unchecked "All Currencies" -> clear everything
    if (hadAll && !hasAll) {
      onFilterChange("currencies", []);
      setViewList(null);
      return;
    }

    // Normal selection

    const updated = val.filter((v) => v !== "All Currencies");

    const actualCurrencies = currencyOptions.filter(
      (c) => c !== "All Currencies",
    );

    if (
      updated.length === actualCurrencies.length &&
      actualCurrencies.every((c) => updated.includes(c))
    ) {
      onFilterChange("currencies", ["All Currencies", ...actualCurrencies]);
      return;
    }

    onFilterChange("currencies", updated);
  };

  const removeCurrency = (item) => {
    const updated = filters.currencies.filter((c) => c !== item);

    if (updated.length === 0) {
      onFilterChange("currencies", ["All Currencies"]);
      setViewList(null);
    } else {
      onFilterChange("currencies", updated);
    }
  };

  const handleCircleChange = (value) => {
    onFilterChange("branches", ["All Branches"]);
    setBranches([]);
    setViewList(null);
    onFilterChange("circle", value?.value || null);
  };

  const SectionHeader = ({ icon, title }) => (
    <Stack direction="row" spacing={1} alignItems="center" sx={{ mb: 2 }}>
      <Box
        sx={{
          p: 0.5,
          bgcolor: "primary.main",
          borderRadius: 1,
          color: "white",
          display: "flex",
        }}
      >
        {icon}
      </Box>
      <Typography
        variant="subtitle2"
        sx={{ fontWeight: 800, color: "text.primary", letterSpacing: 1 }}
      >
        {title}
      </Typography>
    </Stack>
  );

  const getDateErrorMessage = (field, error) => {
    switch (error) {
      case "maxDate":
        return `${field} cannot be in future`;
      case "minDate":
        return `${field} cannot be before ${minLimit.format("DD/MM/YYYY")}`;
      case "invalidDate":
        return `Please enter a valid ${field}`;
      default:
        return "";
    }
  };

  const validationMessages = [
    balanceDateError && getDateErrorMessage("Balance Date", balanceDateError),
  ].filter(Boolean);

  return (
    <Box sx={{ position: "relative", mb: 2 }}>
      <Card
        sx={{
          borderRadius: "24px",
          boxShadow: "0 20px 50px rgba(0,0,0,0.1)",
          border: "1px solid rgba(255,255,255,0.3)",
        }}
      >
        <CardContent sx={{ p: { xs: 2, sm: 3, md: 4 } }}>
          {/* UPDATED HEADER: Responsive stacking to prevent overlap on mobile */}
          <Stack
            direction={{ xs: "column", lg: "row" }}
            justifyContent="space-between"
            alignItems={{ xs: "flex-start", lg: "center" }}
            spacing={{ xs: 3, lg: 0 }}
            sx={{ mb: 2 }}
          >
            <Box>
              <Typography
                variant="h4"
                sx={{
                  fontWeight: 900,
                  // fontSize: { xs: "1.75rem", md: "2.125rem" },
                }}
              >
                Ledger Balance Insights
              </Typography>
              <Typography variant="body2" color="text.secondary">
                Ledger Balance search and analysis
              </Typography>
            </Box>
            {!isBranchUser && (
              <Paper
                elevation={3}
                sx={{
                  px: { xs: 2, sm: 4 },
                  py: 1,
                  borderRadius: "50px",
                  display: "flex",
                  flexDirection: { xs: "column", sm: "row" },
