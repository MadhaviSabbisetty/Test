import React, { useEffect, useState } from "react";
import { Box, Chip, Typography, Paper } from "@mui/material";
import GLRectificationTable from "./GLRectificationTable";
import useApi from "../../hooks/useApi";
import downloadFile from "../../utils/DownloadUtils";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import GLRectificationSummary from "./GLRectificationSummary";
import GLInvalidGroups from "./GLInvalidGroups";
import { Button, Dialog, DialogTitle, DialogContent } from "@mui/material";

import FilterListIcon from "@mui/icons-material/FilterList";

const GLRectificationPage = () => {
  const { callApi } = useApi();
  const [summary, setSummary] = useState({});
  const showSnackBar = useCustomSnackbar();

  const [rows, setRows] = useState([]);
  const [page, setPage] = useState(0);
  const [pageSize, setPageSize] = useState(25);
  const [totalElements, setTotalElements] = useState(0);
  const [groups, setGroups] = useState({});
  const [groupDialogOpen, setGroupDialogOpen] = useState(false);

  const [selectedGroup, setSelectedGroup] = useState(null);

  const fetchData = async (
    pageNo = 0,
    size = pageSize,
    filter = selectedGroup,
  ) => {
    try {
      let url = `/CM/gl-invalid?page=${pageNo}&size=${size}`;

      if (filter) {
        url += `&type=${filter.type}` + `&value=${filter.invalidValue}`;
      }

      const res = await callApi(url, null, "GET");

      const data = res?.data;

      setRows(data?.data || []);

      setPage(data?.currentPage || 0);

      setTotalElements(data?.totalElements || 0);
    } catch {
      showSnackBar("Failed to fetch data");
    }
  };

  const fetchGroups = async () => {
    try {
      const res = await callApi("/CM/gl-invalid/groups", null, "GET");

      setGroups(res || {});
    } catch {
      showSnackBar("Failed to load groups");
    }
  };

  const fetchSummary = async () => {
    try {
      const res = await callApi("/CM/gl-invalid/summary", null, "GET");

      setSummary(res || {});
    } catch {
      showSnackBar("Failed to fetch summary");
    }
  };
  const handleDownload = async () => {
    try {
      const res = await callApi(
        "/CM/gl-invalid/download",
        null,
        "POST",
        "arraybuffer",
      );

      if (res?.byteLength) {
        downloadFile(res, "excel", "gl_rectification");
      }
    } catch {
      showSnackBar("Failed to download excel");
    }
  };

  useEffect(() => {
    fetchData(0);

    fetchSummary();

    fetchGroups();
  }, []);

  return (
      <Paper
        elevation={0}
        sx={{
          flex:1,
          minHeight:0,
          widows:"100%",
          overflow:"hidden",
          display:"flex",
          flexDirection:"column",
          borderRadius:3,
        }}
      > 
    <Box
      sx={{
        p: 2,
        display: "flex",
        flexDirection: "column",
        gap: 1,
        height: "100%",
        overflow: "hidden",
        minHeight:0,
        boxSizing:"border-box",
      }}
    >
      <GLRectificationSummary summary={summary} />
      <Box
        sx={{
          display: "flex",
          justifyContent: "space-between",
          alignItems: "center",
          gap:1,
          mb: 0,
          flexDirection:0,
        }}
      >
        <Button
          variant="outlined"
          startIcon={<FilterListIcon />}
          onClick={() => setGroupDialogOpen(true)}
          sx={{
            borderRadius: 3,
            textTransform: "none",
            fontWeight: 700,
            "&:hover":
            {
              color:"#fff",
            },
          }}
        >
          Filter Invalid Groups
        </Button>

        <Button variant="contained" onClick={handleDownload}>
          Download Excel
        </Button>

        {selectedGroup && (
          <Chip
            label={`${selectedGroup.type} : ${selectedGroup.invalidValue}`}
            color="primary"
            onDelete={() => {
              setSelectedGroup(null);

              fetchData(0, pageSize, null);
            }}
          />
        )}
      </Box>

      <GLRectificationTable
        rows={rows}
        page={page}
        setPage={setPage}
        pageSize={pageSize}
        setPageSize={setPageSize}
        totalElements={totalElements}
        fetchData={fetchData}
        fetchSummary={fetchSummary}
        fetchGroups={fetchGroups}
        selectedGroup={selectedGroup}
        groups={groups}
      />

      <Dialog
        open={groupDialogOpen}
        onClose={() => setGroupDialogOpen(false)}
        maxWidth="lg"
        fullWidth
      >
        <DialogTitle
          sx={{
            fontWeight: 800,
          }}
        >
          Invalid Groups
        </DialogTitle>

        <DialogContent>
          <GLInvalidGroups
            groups={groups}
            selectedGroup={selectedGroup}
            setSelectedGroup={(group) => {
              setSelectedGroup(group);

              fetchData(0, pageSize, group);

              setGroupDialogOpen(false);
            }}
          />
        </DialogContent>
      </Dialog>
    </Box>
    </Paper>
  );
};

export default GLRectificationPage;
