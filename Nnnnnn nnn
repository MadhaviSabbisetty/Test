        @PostMapping("/download")
        public ResponseEntity<StreamingResponseBody> downloadReport(
                @RequestHeader("Authorization") String token,
                @Valid @RequestBody ReportDownloadRequest request) {

        log.info(
                "Received report download request: fileName={}, date={}, branchCode={}, format={}",
                request.getFileName(),
                request.getDate(),
                request.getBranchCode(),
                request.getFormat()
        );

        ReportStreamResponse response =
                reportService.downloadReportStream(
                        request.getFileName(),
                        request.getDate(),
                        jwtUtil.getUserRoleFromToken(token),
                        jwtUtil.getUserIdFromToken(token),
                        request.getBranchCode(),
                        request.getFormat()
                );

        return ResponseEntity.ok()
                .header(
                        HttpHeaders.CONTENT_DISPOSITION,
                        ContentDisposition
                                .attachment()
                                .filename(response.getDownloadFileName())
                                .build()
                                .toString()
                )
                .contentType(
                        MediaType.parseMediaType(
                                response.getContentType()
                        )
                )
                .body(response.getStreamBody());
