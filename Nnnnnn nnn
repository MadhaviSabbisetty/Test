export default function RolesTable({
  rows,
  isLoading,
  onEditRow,
  screenActions,
  roleAccessList = [],
}) {
  const columns = useMemo(
    () => [
      {
        field: "roleName",
        headerName: "Role",
        flex: 0.8,
        minWidth: 120,
        align: "left",
        headerAlign: "left",
      },
      {
        field: "description",
        headerName: "Role Description",
        flex: 3,
        minWidth: 300,
      },
      {
        field: "roleAccess",
        headerName: "Access Level",
        flex: 0.7,
        minWidth: 120,
        headerAlign: "center",
        align: "center",
        sortable: true,
        filterable: false,
        disableColumnMenu: true,
        renderCell: (params) => {
          const access = roleAccessList?.find(
            (item) =>
              String(item.accessFlag).trim() ===
              String(params.row.roleAccess).trim(),
          );

          return (
            <Tooltip title={access?.accessDescription || ""} placement="top">
              <span>
                <CustomChip
                sx={{
                    width: access?.accessName ? 140 : 60,
                    justifyContent:"flex-start",
                  }}
                  variant="outlined"
                  size="sm"
                  icon={<SecurityIcon sx={{ width: 15, height: 15 }} />}
                  label={access?.accessName || params.row.roleAccess || "NA"}
                />
              </span>
            </Tooltip>
          );
        },
      },
      {
        field: "action",
        headerName: "Actions",
        flex: 0.7,
        minWidth: 120,
        headerAlign: "center",
        align: "center",
        filterable: false,
        sortable: false,
        disableColumnMenu: true,
        renderCell: (params) => (
          <Stack
            direction="row"
            spacing={1}
            justifyContent="center"
            alignItems="center"
            sx={{ height: "100%" }}
          >
            <Tooltip title="View Permissions">
              <IconButton
                onClick={() => {
                  onEditRow(params.row, false);
                }}
              >
                <VisibilityIcon fontSize="inherit" />
              </IconButton>
            </Tooltip>

            {screenActions.modify && (
              <Tooltip title="Edit Role">
                <IconButton
                  color="primary"
                  onClick={() => onEditRow(params.row, true)}
                >
                  <EditIcon fontSize="inherit" />
                </IconButton>
              </Tooltip>
            )}
          </Stack>
        ),
      },
    ],
    [onEditRow, roleAccessList, screenActions.modify],
  );

  const filteredColumns = useMemo(() => {
    if (screenActions.modify) {
      return columns;
    }
    return columns.filter((column) => column.field !== "action");
  }, [screenActions.modify, columns]); // Added columns to dependencies to prevent stale state

  return (
      <DataGrid
        rows={rows}
        columns={filteredColumns}
        disableRowSelectionOnClick
        pageSizeOptions={[5, 10, 25, 50]}
        getRowId={(row) => row.roleId}
        loading={isLoading}
        autoHeight
        initialState={{
          pagination: { paginationModel: { pageSize: 10, page: 0 } },
          sorting: { sortModel: [{ field: "roleId", sort: "asc" }] },
        }}
        slots={{
          noRowsOverlay: CustomNoRowsOverlay,
        }}
        slotProps={{
          loadingOverlay: {
            variant: "skeleton",
          },
        }}
        sx={{
          height:"100%",
          width: "100%",
         "& .MuiDataGrid-columnHeaders": {
          backgroundColor: "#f5f5f5 !important",
          fontWeight: 700,
          borderBottom: "2px solid rgba(88, 70, 159, 0.2)",
          position: 'sticky',
          top: 0,
          zIndex: 1,
        },
        }}
      />
  );
}
