if (isDateWise) {

    // Recon Run Date -> Column D
    Cell dateCell =
            summaryRow.createCell(summaryStartColumn);

    dateCell.setCellValue(
            Date.valueOf(fromDate)
    );

    dateCell.setCellStyle(dateStyle);


    // Branch Code -> Column E
    Cell branchCell =
            summaryRow.createCell(summaryStartColumn + 1);

    branchCell.setCellValue(
            ExcelExportUtil.safeString(branchCode)
    );

    branchCell.setCellStyle(centerStyle);


    // Currency -> Column F
    Cell currencyCell =
            summaryRow.createCell(summaryStartColumn + 2);

    currencyCell.setCellValue(
            ExcelExportUtil.safeString(currency)
    );

    currencyCell.setCellStyle(centerStyle);


    // CGL -> Column G
    Cell cglCell =
            summaryRow.createCell(summaryStartColumn + 3);

    cglCell.setCellValue(
            ExcelExportUtil.safeString(cgl)
    );

    cglCell.setCellStyle(centerStyle);

} else {

    // From Date -> Column D
    Cell fromDateCell =
            summaryRow.createCell(summaryStartColumn);

    fromDateCell.setCellValue(
            Date.valueOf(fromDate)
    );

    fromDateCell.setCellStyle(dateStyle);


    // To Date -> Column E
    Cell toDateCell =
            summaryRow.createCell(summaryStartColumn + 1);

    toDateCell.setCellValue(
            Date.valueOf(toDate)
    );

    toDateCell.setCellStyle(dateStyle);


    // Branch Code -> Column F
    Cell branchCell =
            summaryRow.createCell(summaryStartColumn + 2);

    branchCell.setCellValue(
            ExcelExportUtil.safeString(branchCode)
    );

    branchCell.setCellStyle(centerStyle);


    // Currency -> Column G
    Cell currencyCell =
            summaryRow.createCell(summaryStartColumn + 3);

    currencyCell.setCellValue(
            ExcelExportUtil.safeString(currency)
    );

    currencyCell.setCellStyle(centerStyle);


    // CGL -> Column H
    Cell cglCell =
            summaryRow.createCell(summaryStartColumn + 4);

    cglCell.setCellValue(
            ExcelExportUtil.safeString(cgl)
    );

    cglCell.setCellStyle(centerStyle);
}
