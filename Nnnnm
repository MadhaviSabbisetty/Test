package com.fincore.enquiry_service.controller;

// import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.data.domain.Page;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.WebDataBinder;
import org.springframework.web.bind.annotation.*;

import com.fincore.enquiry_service.dto.ApiResponse;
import com.fincore.enquiry_service.dto.DifferenceDTO;
import com.fincore.enquiry_service.dto.DifferenceHistoryDTO;
import com.fincore.enquiry_service.dto.DifferenceSearchDto;
import com.fincore.enquiry_service.dto.GlccRequestBodyDto;
import com.fincore.enquiry_service.service.DifferenceService;

import jakarta.validation.Valid;

import org.springframework.http.HttpHeaders;
import org.springframework.http.MediaType;
import com.fincore.commonutilities.jwt.JwtUtil;
import lombok.RequiredArgsConstructor;

@RestController
@RequiredArgsConstructor
@RequestMapping("/api/differences")
public class DifferenceController {

    // @Autowired
    private final DifferenceService service;
    private final JwtUtil jwtUtil;

    // --- SECURITY FIX: Explicitly disallow mass assignment on sensitive internal fields ---
    @InitBinder
    public void initBinder(WebDataBinder binder) {
        binder.setDisallowedFields("class.*", "Class.*", "*.class.*", "*.Class.*", "classLoader.*");
    }

    // GET All with ApiResponse
    @GetMapping
    public ResponseEntity<ApiResponse<Page<DifferenceDTO>>> getDifferences(
            @RequestParam(defaultValue = "0") int page,
            @RequestParam(defaultValue = "100") int size) {
        Page<DifferenceDTO> result = service.getAllDifferences(page, size);
        return ResponseEntity.ok(ApiResponse.success(result, "Differences retrieved successfully"));
    }

    // POST Search with ApiResponse
    @PostMapping("/search")
    public ResponseEntity<ApiResponse<Page<DifferenceDTO>>> searchDifferences(
            @Valid @RequestBody DifferenceSearchDto criteria,
            @RequestParam(defaultValue = "0") int page,
            @RequestParam(defaultValue = "100") int size) {

        Page<DifferenceDTO> result = service.searchDifferences(criteria, page, size);

        if (result.isEmpty()) {
            return ResponseEntity.ok(ApiResponse.error("No differences found for the given criteria"));
        }

        return ResponseEntity.ok(ApiResponse.success(result, "Differences retrieved successfully"));
    }

    // GET History for a specific GLCC lifecycle
    @PostMapping("/history")
    public ResponseEntity<ApiResponse<Page<DifferenceHistoryDTO>>> getGlccHistory(
            @RequestBody GlccRequestBodyDto dto,
            @RequestParam(defaultValue = "0") int page,
            @RequestParam(defaultValue = "100") int size) {

        Page<DifferenceHistoryDTO> result = service.getGlccHistory(dto.getBranchCode(), dto.getCgl(), page, size);

        if (result.isEmpty()) {
            return ResponseEntity.ok(ApiResponse.error("No historical records found for the provided Branch and CGL"));
        }

        return ResponseEntity.ok(ApiResponse.success(result, "GLCC History retrieved successfully"));
    }


    @PostMapping("/export")
    public ResponseEntity<byte[]> exportBalance(
            @RequestHeader("Authorization") String token,
            @RequestBody DifferenceDTO request) {
            String userId = jwtUtil.getUserIdFromToken(token);
            byte[] bytes = service.exportBalanceCompareToExcel(
                    request,
                    userId);
            return ResponseEntity.ok()
                    .header(
                            HttpHeaders.CONTENT_DISPOSITION,
                            "attachment; filename=Balance_Compare_Difference.xlsx")
                    .contentType(
                            MediaType.parseMediaType(
                                    "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"))
                    .body(bytes);
    }
}
