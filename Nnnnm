 @PostMapping("/export")
    public ResponseEntity<byte[]> exportBalance(
            @RequestHeader("Authorization") String token,
            @RequestBody JsonNode request) {
            String userId = jwtUtil.getUserIdFromToken(token);
            byte[] bytes;
            String fileName;
            if(request.has("reconRunDate")){
                DifferenceDTO differenceRequest = new ObjectMapper().treeToValue(request, DifferenceDTO.class);

                bytes = service.exportBalanceCompareToExcel(
                    differenceRequest,
                    userId);
                filename = "Balance_Compare_Difference_"+differenceRequest.getReconRunDate()+".xlsx";
            }

        else if (request.has("fromDate") && request.has("toDate")){
            DifferenceSearchDto searchRequest = new ObjectMapper().treeToValue(request, DifferenceSearchDto.class);

                bytes = service.exportBalanceCompareToExcel(
                    searchRequest,
                    userId);
                filename = "Balance_Compare_Difference_"+searchRequest.getFromDate()+"_to_"+searchRequest.getToDate()+".xlsx";
        }

        else{
            log.info("Invalid export request");
            throw new IllegalArgumentException("Invalid export request");
        }
             
            return ResponseEntity.ok()
                    .header(
                            HttpHeaders.CONTENT_DISPOSITION,
                            "attachment; filename="+fileName)
                    .contentType(
                            MediaType.parseMediaType(
                                    "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"))
                    .body(bytes);
    }
