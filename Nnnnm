    @PostMapping("/export")
    public ResponseEntity<byte[]> exportBalance(
            @RequestHeader("Authorization") String token,
            @RequestBody Map<String, Object> request) throws Exception {

        String userId = jwtUtil.getUserIdFromToken(token);
         ObjectMapper objectMapper = new ObjectMapper();
        // objectMapper.registerModule(new JavaTimeModule());

        byte[] bytes;
        String fileName;

        if (request.containsKey("reconRunDate")) {

            DifferenceDTO differenceRequest =
                    objectMapper.convertValue(
                            request,
                            DifferenceDTO.class
                    );

            bytes = service.exportBalanceCompareToExcel(
                    differenceRequest,
                    userId
            );

            fileName =
                    "Balance_Compare_Difference_"
                            + differenceRequest.getReconRunDate()
                            + ".xlsx";

        } else if (
                request.containsKey("fromDate")
                        && request.containsKey("toDate")) {

            DifferenceSearchDto searchRequest =
                    objectMapper.convertValue(
                            request,
                            DifferenceSearchDto.class
                    );

            bytes = service.exportBalanceCompareToExcel(
                    searchRequest,
                    userId
            );

            fileName =
                    "Balance_Compare_Difference_"
                            + searchRequest.getFromDate()
                            + "_to_"
                            + searchRequest.getToDate()
                            + ".xlsx";

        } else {

            throw new IllegalArgumentException(
                    "Invalid export request"
            );
        }

        return ResponseEntity.ok()
                .header(
                        HttpHeaders.CONTENT_DISPOSITION,
                        "attachment; filename=\"" + fileName + "\""
                )
                .contentType(
                        MediaType.parseMediaType(
                                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                        )
                )
                .body(bytes);
    }
