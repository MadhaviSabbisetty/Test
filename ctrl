        const vouchersResponse = await callApi(`/JS/voucher/active?roleId=${currentRoleId}`, null, "GET");
        setVoucherList(vouchersResponse?.data || vouchersResponse || []);
      } finally {
        setIsPageLoading(false);
      }
    } else {
      setActiveStep((prevStep) => prevStep + 1);
    }
