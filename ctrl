        }).catch(() => {}); // Catch prevents console errors as the window dies
      }

      // 2. THE WARNING: If they are on Step 3 and haven't clicked submit
      if (activeStep === 3 && !isFinalizing) {
        e.preventDefault();
        e.returnValue = "You have an unfinalized batch. If you leave, it will not be sent for approval!";
      }
    };

    window.addEventListener("beforeunload", handleBeforeUnload);

    return () => {
      window.removeEventListener("beforeunload", handleBeforeUnload);
    };
  }, [activeStep, isFinalizing]); 



  useEffect(() => {
