    public ReportGenerationResponseDTO generateReports(ReportGenerationDTO parameters) throws IOException {

        ReportGenerationResponseDTO reportGenerationResponseDTO = new ReportGenerationResponseDTO();
        reportGenerationResponseDTO.setProcessRunId(parameters.getProcessRunId());
        reportGenerationResponseDTO.setRunId(parameters.getRunId());
        reportGenerationResponseDTO.setStageId(parameters.getStageId());
        LocalDate reportDate = parameters.getDate();

        if (reportDate == null) {
            reportDate = controlDateService.getEtlDate();
        }

        reportGenerationResponseDTO.setDate(reportDate);
        String formattedDate = reportDate.format(DateTimeFormatter.ofPattern("yyyy-MM-dd"));
        String jasperFormattedDate = reportDate.format(DateTimeFormatter.ofPattern("dd/MM/yyyy"));
        String datePrefix = reportDate.format(DateTimeFormatter.ofPattern("ddMMyyyy"));
        String runId = String.valueOf(parameters.getRunId());

        if(!(runId != null && runId.matches("-?\\d+")))
        {
            throw  new IllegalArgumentException("Invalid Run ID");
        }
        Path dateDir = new Path(tempReportsBasepath, formattedDate);
        Path reportDir = new Path(dateDir, runId);
        if(!jasperTemplateRegistry.getAllReportNames().contains(parameters.getReportType()))
        {
            throw new IllegalArgumentException("Invalid Report type");
        }
        // jasperTemplateRegistry.getReport(reportName).getName() to skip path manipulation issue
        String reportName =  jasperTemplateRegistry.getReport(parameters.getReportType()).getName();
        Path mainReportDir = new Path(new Path(reportsBasePath, formattedDate),reportName);
        try {
            if (!hdfsFileSystem.exists(reportDir)) {
                hdfsFileSystem.mkdirs(reportDir);
            }if (!hdfsFileSystem.exists(mainReportDir)) {
                hdfsFileSystem.mkdirs(mainReportDir);
            }
        } catch (IOException e) {
            throw new IOException("Failed to Create Folder in HDFS "+e.getMessage());
        }
        String logoPath = null;
        try {
            // logoPath = new
            // ClassPathResource("images/logo.png").getFile().getAbsolutePath();
            logoPath = extractLogoToTemp();
        } catch (ResourceNotFoundException e) {
            log.warn("Logo not found");
        }
        try (Connection connection = dataSource.getConnection()) {
            reportGenerationResponseDTO.setReportName(reportName);
            reportGenerationResponseDTO.setRunId(parameters.getRunId());
            reportGenerationResponseDTO.setExtensions(new ArrayList<>());
            StringBuilder status = new StringBuilder();
            String fileBaseName = reportName + "_" + datePrefix + "_" + "run" + "_" + runId;
            String fileNamePrefix = reportName + "_" + datePrefix.formatted(DateTimeFormatter.ofPattern("ddMMyyyy"));
            try  {
                JasperReport jasperReport = jasperTemplateRegistry.getReport(reportName);
                Map<String, Object> reportParams = new HashMap<>();
                reportParams.put("imagePath", logoPath);
                reportParams.put("date", jasperFormattedDate);
                log.info("Started Filling Jasper for {} Report", parameters.getReportType());
                JasperPrint jasperPrint = JasperFillManager.fillReport(jasperReport, reportParams, connection);
                log.info("Completed Jasper Fill  for {} Report", parameters.getReportType());
                Map<ReportFormat, FormatStatus> formatResults = new LinkedHashMap<>();
                Map<ReportFormat, String> formatErrors = new HashMap<>();
                generateReportFile(ReportFormat.PDF, jasperPrint, reportDir, fileBaseName, hdfsFileSystem,
                        formatResults, formatErrors);
                generateReportFile(ReportFormat.EXCEL, jasperPrint, reportDir, fileBaseName, hdfsFileSystem,
                        formatResults, formatErrors);
                generateReportFile(ReportFormat.PSV, jasperPrint, reportDir, fileBaseName, hdfsFileSystem,
                        formatResults, formatErrors);

                //saving reports parallely in "/reports/date" path
                generateReportFile(ReportFormat.PDF, jasperPrint, mainReportDir, fileNamePrefix, hdfsFileSystem,
                        formatResults, formatErrors);
                generateReportFile(ReportFormat.EXCEL, jasperPrint, mainReportDir, fileNamePrefix, hdfsFileSystem,
                        formatResults, formatErrors);
                generateReportFile(ReportFormat.PSV, jasperPrint, mainReportDir, fileNamePrefix, hdfsFileSystem,
                        formatResults, formatErrors);


                long successCount = formatResults.values()
                        .stream()
                        .filter(v -> v == FormatStatus.GENERATED)
                        .count();
                String finalStatus;
                String remark;
                if (successCount == 0) {
                    finalStatus = Constants.FAILED;
                    remark = "Failed to generate all report formats.";
                } else if (successCount == formatResults.size()) {
                    finalStatus = Constants.SUCCESS;
                    remark = "All formats generated successfully.";
                } else {
                    finalStatus = Constants.PARTIAL_SUCCESS;
                    remark = "Generated: " +
                            formatResults.entrySet().stream()
                                    .filter(e -> e.getValue() == FormatStatus.GENERATED)
                                    .map(e -> e.getKey().name())
                                    .toList()
                            + ", Failed: " +
                            formatErrors.keySet();
                }

                reportGenerationResponseDTO.setStatus(finalStatus);
                reportGenerationResponseDTO.setRemark(remark);
                reportGenerationResponseDTO.setFormatErrors(formatErrors);
                reportGenerationResponseDTO.setFormatResults(formatResults);

            }

            catch (IOException | JRException e) {
                log.error("Error generating {}: {}", reportName, e.getMessage());
            }

        } catch (SQLException  e) {
            throw new RuntimeException(e);
        }
        return reportGenerationResponseDTO;

    }

    public void generateReportFile(
            ReportFormat format,
            JasperPrint jasperPrint,
            Path reportDir,
            String fileBaseName,
            FileSystem hdfsFileSystem,
            Map<ReportFormat, FormatStatus> formatResults,
            Map<ReportFormat, String> formatErrors

    ) throws IOException {
        log.info("Generating File {} with extension {} to place at {} ", fileBaseName, format,reportDir);
        Path outputPath = new Path(reportDir, fileBaseName + format.ext());
        try (FSDataOutputStream out = hdfsFileSystem.create(outputPath, true)) {
            switch (format) {
                case PDF -> {
                    JasperExportManager
                            .exportReportToPdfStream(jasperPrint, out);
                }
                case EXCEL -> {
                    JRXlsxExporter exporter = new JRXlsxExporter();
                    exporter.setExporterInput(
                            new SimpleExporterInput(jasperPrint));
                    exporter.setExporterOutput(
                            new SimpleOutputStreamExporterOutput(out));
                    exporter.exportReport();

                }
                case PSV -> {
                    JRCsvExporter exporter = new JRCsvExporter();
                    exporter.setExporterInput(
                            new SimpleExporterInput(jasperPrint));
                    exporter.setExporterOutput(
                            new SimpleWriterExporterOutput(out));
                    SimpleCsvExporterConfiguration config = new SimpleCsvExporterConfiguration();
                    config.setFieldDelimiter("|");
                    exporter.setConfiguration(config);
                    exporter.exportReport();

                }
            }
            formatResults.put(format, FormatStatus.GENERATED);
        }

        catch (IOException | JRException e) {
            formatResults.put(format, FormatStatus.FAILED);
            formatErrors.put(format, e.getMessage());
        }

    }

    private String extractLogoToTemp() {
        try {
            Resource resource = resourceLoader.getResource("classpath:/images/logo.png");
            if (!resource.exists()) {
                log.warn("Logo not found in classpath");
                return null;
            }
            File tempFile = File.createTempFile("jasper-logo-", ".png");
            tempFile.deleteOnExit();
            try (InputStream in = resource.getInputStream();
                 OutputStream out = new FileOutputStream(tempFile)) {
                FileCopyUtils.copy(in, out);
            }
            return tempFile.getAbsolutePath();
        } catch (ResourceNotFoundException | IOException e) {
            log.error("Failed to extract logo", e);
            return null;
        }
    }

    public ReportBase64ResponseDTO generateReportBase64(
            ReportBase64RequestDTO request) throws IOException {

        ReportBase64ResponseDTO response = new ReportBase64ResponseDTO();

        try {

            if (request.getReportType() == null || request.getReportType().isBlank()) {
                throw new IllegalArgumentException("Report type is mandatory");
            }

            LocalDate reportDate = request.getDate();

            if (reportDate == null) {
                reportDate = controlDateService.getEtlDate();
            }

            // JasperReports reportDetails = jasperReportTypeRepository.findByType(request.getReportType());

            String reportName = request.getReportType();

            if (reportName != null) {
                response.setReportName(reportName);
            }
            response.setReportDate(reportDate);

            JasperPrint jasperPrint = fillJasperReport(
                    request.getReportType(),
                    reportDate,
                    request.getInputParams());

            ByteArrayOutputStream pdfStream = new ByteArrayOutputStream();

            JasperExportManager.exportReportToPdfStream(
                    jasperPrint,
                    pdfStream);

            response.setPdfBase64(
                    Base64.getEncoder().encodeToString(pdfStream.toByteArray()));

            ByteArrayOutputStream excelStream = new ByteArrayOutputStream();

            JRXlsxExporter exporter = new JRXlsxExporter();

            exporter.setExporterInput(new SimpleExporterInput(jasperPrint));
            exporter.setExporterOutput(new SimpleOutputStreamExporterOutput(excelStream));

            exporter.exportReport();

            response.setExcelBase64(
                    Base64.getEncoder().encodeToString(excelStream.toByteArray()));

            response.setStatus(Constants.SUCCESS);
            response.setRemark("Report generated successfully");

        } catch (JRException e) {

            log.error("Jasper report generation error: {}", e.getMessage());

            response.setStatus(Constants.FAILED);
            response.setRemark("Error while generating report");

        } catch (Exception e) {

            log.error("Unexpected error during report generation", e);

            response.setStatus(Constants.FAILED);
            response.setRemark("Unexpected error occurred");
        }

        return response;
    }

    private JasperPrint fillJasperReport(
            String reportType,
            LocalDate reportDate,
            Map<String, Object> inputParams) throws IOException {





        String logoPath = null;
        try {
            logoPath = extractLogoToTemp();
        } catch (ResourceNotFoundException e) {
            log.warn("Logo not found");
        }


        String formattedDate = reportDate.format(DateTimeFormatter.ofPattern("dd/MM/yyyy"));

        try (Connection connection = dataSource.getConnection()) {
            JasperReport jasperReport = jasperTemplateRegistry.getReport(reportType);
            Map<String, Object> reportParams = new HashMap<>();
            log.info("Formatted Date :{}",formattedDate);
            reportParams.put("date", formattedDate);
            reportParams.put("imagePath",logoPath);

            if (inputParams != null) {
                reportParams.putAll(inputParams);
            }

            log.info("Started Filling Jasper for {} Report", reportType);

            JasperPrint jasperPrint = JasperFillManager.fillReport(
                    jasperReport,
                    reportParams,
                    connection);

            log.info("Completed Jasper Fill for {} Report", reportType);

            return jasperPrint;

        } catch (JRException e) {

            log.error("Error filling Jasper report {}", reportType, e);

            throw new RuntimeException(
                    "Failed to generate report for type: " + reportType, e);
        } catch (SQLException e) {

            log.error("Database error while generating report {}", reportType, e);

            throw new RuntimeException(
                    "Database error during report generation", e);
        }
    }

