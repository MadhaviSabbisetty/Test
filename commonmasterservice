              ) : modalMode === "ACCEPTED" ? (
                "Accept"
              ) : (
                "Reject"
              )}
            </Button>
          </DialogActions>
        </Dialog>

        {/* --- Schedule Lapsed Edge Case Modal --- */}
        <Dialog
          open={isScheduleLapseModalOpen}
