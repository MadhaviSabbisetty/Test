            <Button
              onClick={() => handleSubmitAction(true)}
              variant="contained"
              color="primary"
              disabled={isSubmitting}
            >
              {isSubmitting ? (
                <CircularProgress size={20} color="inherit" />
              ) : (
                "Confirm & Proceed"
              )}
            </Button>
