 const validate = () => {
  const temp = {};

  if (!transactionDate) {
    temp.fromDate = " Date is required";
  }

  
  if (
    transactionDate &&
    dayjs(transactionDate).isAfter(
      dayjs(),
      "day"
    )
  ) {
    temp.transactionDate =
      "Future date is not allowed";
  }


  setErrors(temp);

  return (
    Object.keys(temp).length === 0
  );
};


 
 
const handleCLGChange = (e) => {
  const value = e.target.value; 

  if (value.length > 10) {
    setcglError("Maximum 10 numbers allowed");
      setTimeout(()=>{
         setcglError("")
        },1500)
    return;
  }  
  if (    
    !/^[0-9-]*$/.test(value)
  ) {
    setcglError(
      "Only numbers!"
    );

   setTimeout(()=>{
         setcglError("")
        },1500)
    return;
  }
  setErrors({});
  setcglError("");
  setcgl(value);
};

    


