 if (
      selectedIssues.length === 0 &&
      customIssues.length === 0
    ) {
      if (showCustomIssue) {
        newErrors.customIssue =
          "Please add the issue first";
      } else {
        newErrors.issues =
          "Please select at least one issue";
      }
    }

    if (
      showCustomIssue &&
      customIssueInput.trim() &&
      customIssues.length === 0
    ) {
      newErrors.customIssue =
        "Please add this issue first";
    }

    console.log(
      "Validation Errors =>",
      newErrors
    );

    setErrors(newErrors);

    return (
      Object.keys(newErrors)
        .length === 0
    );
  };
  const handleCreate =
    async () => {
      if (!validateForm()) {
        return;
      }

      setLoading(true);

      try {
        const selectedCategory =
          voucherCategories.find(
            (item) =>
              item.id ===
              formData.categoryId
          );

        const payload = {
          categoryId:
            formData.categoryId,

          customCategory:
            selectedCategory?.categoryName ===
              "Other"
              ? formData.otherCategory
              : "",

          description:
            formData.description,

          allowedRole:
            formData.roleId,

          sdReqNo:
            formData.sdRequestNumber,

          createdBy: user.userId,

          issueCategoryIds: selectedIssues.map(
            (item) => item.id
          ),


          customIssueCategories:
            customIssues.filter(
              (item) => item?.trim()
            ),


        };

        console.log(
          "Create Payload =>",
          JSON.stringify(payload, null, 2)
        );

        const response =
          await callApi(
            "/VE/voucher-transactions/create-vid",
            payload,
            "POST"
          );

        console.log(
          "Create Response =>",
          response
        );

        await fetchVoucherCategories();

        const createdVid =
          response?.vid ||
          response?.data?.vid ||
          "";

        setCreatedVID(
          createdVid
        );

        setOpenDialog(true);

        setSnackbar({
          open: true,
          message:
            "Voucher Request Created Successfully",
          severity:
            "success",
        });

        setFormData({
          categoryId: "",
          otherCategory: "",
          description: "",
          roleId: "",
          sdRequestNumber: "",

        });
        setSelectedIssues([]);
        setIssueList([]);
        setCustomIssues([]);
        setCustomIssueInput("");
        setShowCustomIssue(false);
        setIssueOpen(false);

        setErrors({});
      } catch (error) {
        console.error(
          "Create Voucher Error =>",
          error
        );

        setSnackbar({
          open: true,
          message:
            "Failed To Create Voucher",
          severity: "error",
        });
      } finally {
        setLoading(false);
      }
    };

  const handleReset = () => {
    setFormData({
      categoryId: "",
      otherCategory: "",
      description: "",
      roleId: "",
      sdRequestNumber: "",
    });
    setIssueList([]);
    setSelectedIssues([]);
    setCustomIssues([]);
    setCustomIssueInput("");
    setShowCustomIssue(false);
    setIssueOpen(false);
    setErrors({});
  };

  return (
    <Paper
      elevation={2}
      sx={{
        p: 2,
        mb: 4,

        minHeight: 760
      }}
    >
      <Box p={4}>
        <Typography variant="h4" mb={6}>
          Request Voucher
        </Typography>
        <Card
          elevation={3}
          sx={{
            maxWidth: "1100px",
            margin: "40px auto",
            padding: 4,
            borderRadius: 3,
          }}
        >


          <Box
            sx={{
              width: "100%",
              display: "flex",
              flexDirection:
                "column",
              gap: 3,
            }}
          >
            {/* Voucher Category + Other */}
            <Box
              sx={{
                display: "grid",
                gridTemplateColumns:
                  voucherCategories.find(
                    (item) =>
                      item.id ===
                      formData.categoryId &&
                      item.categoryName ===
                      "Other"
                  )
                    ? "1fr 1fr"
                    : "1fr",

                gap: 3,

                "@media (max-width:900px)":
                {
                  gridTemplateColumns:
                    "1fr",
                },
              }}
            >
              {/* Voucher Category */}
              <FormControl
                fullWidth
                error={
                  !!errors.categoryId
                }
              >
                <InputLabel>
                  Voucher Category*
                </InputLabel>

                <Select
                  disabled={loading}
                  name="categoryId"
                  value={
                    formData.categoryId
                  }
                  onChange={
                    handleChange
                  }
                  label="Voucher Category"
                  MenuProps={{
                    PaperProps: {
                      sx: {
                        maxHeight: 400,
                        overflow: "auto",
                      }
                    }
                  }}
                >
                  <MenuItem value="">
                    <em>
                      Select Category
                    </em>
                  </MenuItem>

                  {voucherCategories?.map(
                    (item) => (

                      <MenuItem
                        key={item.id}
                        value={item.id}
                      >
                        {item.categoryName === "Other"
                          ? "+ Other"
                          : item.categoryName}
                      </MenuItem>
                    )
                  )}
                </Select>

                <FormHelperText>
                  {errors.categoryId
                    ? errors.categoryId
                    : "Select the voucher category to create the voucher request."}
                </FormHelperText>
              </FormControl>

              {/* Other Category */}
              {voucherCategories.find(
                (item) =>
                  item.id ===
                  formData.categoryId &&
                  item.categoryName ===
                  "Other"
              ) && (
                  <TextField
                    disabled={loading}
                    fullWidth
                    label="New Category *"
                    name="otherCategory"
                    value={
                      formData.otherCategory
                    }
                    onChange={
                      handleChange
                    }
                    error={
                      !!errors.otherCategory
                    }
                    inputProps={{
                      maxLength: 21,
                    }}
                    helperText={
                      errors.otherCategory
                        ? errors.otherCategory
                        : `Only character, numbers, hyphen and single space allowed.  (${formData.otherCategory.length}/20)`

                    }
                  />
                )}
            </Box>

            <Box
              sx={{
                display: "grid",
                gridTemplateColumns:
                  showCustomIssue
                    ? "0.90fr 0.90fr"
                    : "1fr",
                gap: 3,

                "@media (max-width:900px)": {
                  gridTemplateColumns: "1fr",
                },
              }}
            >
              <Autocomplete
                multiple
                disableCloseOnSelect

                open={issueOpen}

                onOpen={() => {

                  if (!formData.categoryId) {

                    setErrors((prev) => ({
                      ...prev,
                      issues:
                        "Please select Voucher Category first",
                    }));

                    return;
                  }


                  setIssueOpen(true);
                }}
                onClose={() => setIssueOpen(false)}

                options={[
                  ...issueList,

                  ...(formData.categoryId
                    ? [
                      {
                        id: "ADD_NEW",
                        issueCategoryName:
                          "+ Add Issue",
                      },
                    ]
                    : []),
                ]}
                value={selectedIssues}

                onChange={(
                  event,
                  newValue
                ) => {
                  const addIssueClicked =
                    newValue.find(
                      (item) =>
                        item.id ===
                        "ADD_NEW"
                    );


                  if (addIssueClicked) {
                    setShowCustomIssue(true);
                    setIssueOpen(false);

                    setSelectedIssues(
                      newValue.filter(
                        (item) => item.id !== "ADD_NEW"
                      )
                    );

                    return;
                  }
                  setSelectedIssues(
                    newValue
                  );
                  if (newValue.length > 0) {
                    setErrors((prev) => ({
                      ...prev,
                      issues: "",
                    }))
                  }
                }}
                getOptionLabel={(
                  option
                ) =>
                  option.issueCategoryName ||
                  ""
                }
                renderOption={(
                  props,
                  option,
                  { selected }
                ) => (
                  <li {...props}>
                    {option.id !==
                      "ADD_NEW" && (
                        <Checkbox
                          checked={
                            selected
                          }
                          size="small"
                        />
                      )}

                    {
                      option.issueCategoryName
                    }
                  </li>
                )}
                slotProps={{
                  listbox: {
                    sx: {
                      maxHeight: 300,
                      overflowY: "auto"
                    }
                  }
                }}
                renderInput={(params) => (
                  <TextField
                    {...params}
                    label="Search Issues*"
                    placeholder="Search Issues"
                    error={!!errors.issues}
                    helperText={
                      errors.issues
                        ? errors.issues
                        : "Select one or more issues. If not available, choose Add New Issues."
                    }



                  />
                )}
              />


              {showCustomIssue && (
                <Box >



                  <Box
                    sx={{
                      display: "flex",
                      gap: 1,

                    }}
                  >
                    <TextField
                      fullWidth
                      label="Enter New Issue"
                      value={customIssueInput}

                      onChange={(e) => {
                        setCustomIssueInput(
                          e.target.value
                        );

                        setErrors((prev) => ({
                          ...prev,
                          customIssue: "",
                        }));
                      }}
                      error={!!errors.customIssue}
                      inputProps={{
                        maxLength: 100,
                      }}
                      helperText={
                        errors.customIssue
                          ? errors.customIssue
                          : `Enter a new issue if it is not available in the list. All characters are allowed (${customIssueInput.length}/100)`
                      }



                    />

                    <Button size="small" sx={{
                      minWidth: "80px", height: "50px", mt: "4px"
                    }}
                      variant="contained"
                      startIcon={<AddIcon />}
                      onClick={() => {
                        const newIssue =
                          customIssueInput.trim();

                        if (!newIssue) return;

                        const alreadyExistsInMaster =
                          issueList.some(
                            (item) =>
                              item.issueCategoryName
                                ?.trim()
                                .toLowerCase() ===
                              newIssue.toLowerCase()
                          );

                        const alreadyExistsInCustom =
                          customIssues.some(
                            (item) =>
                              item.trim().toLowerCase() ===
                              newIssue.toLowerCase()
                          );

                        if (
                          alreadyExistsInMaster ||
                          alreadyExistsInCustom
                        ) {
                          setErrors((prev) => ({
                            ...prev,
                            customIssue:
                              "Issue already exists",
                          }));

                          return;
                        }

                        setCustomIssues((prev) => [
                          ...prev,
                          newIssue,
                        ]);

                        setErrors((prev) => ({
                          ...prev,
                          issues: "",
                          customIssue: "",
                        }));

                        setCustomIssueInput("");
                      }}

                    >
                      Add
                    </Button>



                  </Box>



                  {customIssues.length >
                    0 && (
                      <Box
                        sx={{
                          mt: 2,
                          display: "flex",
                          flexWrap: "wrap",
                          gap: 1,
                        }}
                      >
                        {customIssues.map(
                          (
                            issue,
                            index
                          ) => (
                            <Chip
                              key={index}
                              label={issue}
                              onDelete={() =>
                                setCustomIssues(
                                  customIssues.filter(
                                    (
                                      _,
                                      i
                                    ) =>
                                      i !==
                                      index
                                  )
                                )
                              }
                            />
                          )
                        )}
                      </Box>
                    )}
                </Box>
              )}
            </Box>


            {/* Allowed Role + SD */}
            <Box
              sx={{
                display: "grid",
                gridTemplateColumns:
                  "1fr 1fr",
                gap: 3,

                "@media (max-width:900px)":
                {
                  gridTemplateColumns:
                    "1fr",
                },
              }}
            >
              {/* Role */}
              <FormControl
                fullWidth
                error={
                  !!errors.roleId
                }
              >
                <InputLabel>
                  Allowed Role*
                </InputLabel>
                <Select
                  disabled={loading || roleLoading}
                  name="roleId"
                  value={formData.roleId}
                  label="Allowed Role"
                  onChange={handleChange}
                  MenuProps={{
                    PaperProps: {
                      sx: {
                        maxHeight: 250,
                        overflow: "auto",
                      }
                    }
                  }}

                >

                  <MenuItem value="">
                    <em>Select Role</em>
                  </MenuItem>

                  {roles?.map((role) => (
                    <MenuItem
                      key={role.roleId}
                      value={role.roleId}
                    >
                      {role.roleName}
                    </MenuItem>
                  ))}
                </Select>
                <FormHelperText>
                  {errors.roleId
                    ? errors.roleId
                    : "Select the role that will be allowed to process this request."}
                </FormHelperText>

              </FormControl>

              {/* SD */}
              <TextField
                disabled={loading}
                fullWidth
                label="SD Request Number"
                name="sdRequestNumber"
                value={
                  formData.sdRequestNumber
                }
               
                onChange={
                  handleChange
                }
                error={
                  !!errors.sdRequestNumber
                }
                inputProps={{
                  maxLength: 51,
                }}
                helperText={
                  errors.sdRequestNumber
                    ? errors.sdRequestNumber
                    : `Only numbers and commas allowed.  (${formData.sdRequestNumber.length}/50)`

                }
              />
            </Box>

            {/* Description */}
            <TextField
              disabled={loading}
              fullWidth
              multiline
              rows={5}
              label="Description*"
              name="description"
              value={
                formData.description
              }
              onChange={
                handleChange
              }
              error={
                !!errors.description
              }
              inputProps={{
                maxLength: 500,
              }}
              helperText={
                errors.description
                  ? errors.description
                  : ` All characters are allowed .(${formData.description.length}/500)`
              }
            />




            {/* Buttons */}
            <Box
              sx={{
                display: "flex",
                justifyContent:
                  "flex-end",
                gap: 2,
              }}
            >
              <Button
                variant="outlined"
                onClick={
                  handleReset
                }
                disabled={loading}
                sx={{
                  minWidth:
                    "120px",
                  textTransform:
                    "none",
                  borderRadius:
                    "8px",
                  "&:hover":
                  {
                    color:"#fff",
                  },
                }}
              >
                Reset
              </Button>

              <Button
                variant="contained"
                onClick={
                  handleCreate
                }
                disabled={loading}
                sx={{
                  minWidth:
                    "120px",
                  textTransform:
                    "none",
                  borderRadius:
                    "8px",
                }}
              >
                {loading
                  ? "Creating..."
                  : "Create"}
              </Button>
            </Box>
          </Box>
        </Card>

        {/* Success Dialog */}
        <Dialog

          open={openDialog}
          disableEscapeKeyDown
          hideBackdrop=
          {false}
          BackdropProps={{
            sx:{pointerEvents:"auto",},
          }}
          onClose={(event, reason) => {
            if(reason === "backdropClick") {return;}
             
               setOpenDialog(false)
          }
            
          }
          maxWidth="xs"
          fullWidth
        >
          <DialogTitle>
            Voucher Request Created
          </DialogTitle>

          <DialogContent>
            <Typography mb={2}>
              Voucher ID
            </Typography>

            <Box
              sx={{
                display: "flex",
                alignItems:
                  "center",
                justifyContent:
                  "space-between",
                border:
                  "1px solid #ccc",
                borderRadius: 2,
                px: 2,
                py: 1.5,
                background:
                  "#f8f9fa",
              }}
            >
              <Typography
                fontWeight={700}
                color="primary"
              >
                {createdVID}
              </Typography>

              <IconButton
                onClick={() => {
                  navigator.clipboard.writeText(
                    createdVID
                  );

                  setSnackbar({
                    open: true,
                    message:
                      "Voucher ID copied",
                    severity:
                      "success",
                  });
                }}
              >
                <ContentCopyIcon />
              </IconButton>
            </Box>
          </DialogContent>

          <DialogActions
            sx={{
              p: 3,
              pt: 1,
            }}
          >
            <Button
              variant="outlined"
              onClick={() => {
                handleReset();
                setOpenDialog(false);
              }}
            >
              Create New Voucher
            </Button>


            <Button
              variant="contained"
              onClick={() => {
                setOpenDialog(false);

                const viewMenu = findMenuById(menuItems, 262);

                navigate(viewMenu?.route || selectedMenuItem?.route);
              }}
            >
              View Requests
            </Button>




          </DialogActions>
        </Dialog>

        {/* Snackbar */}
        <Snackbar
          open={snackbar.open}
          autoHideDuration={
            4000
          }
          onClose={() =>
            setSnackbar(
              (prev) => ({
                ...prev,
                open: false,
              })
            )
          }
          anchorOrigin={{
            vertical: "top",
            horizontal:
              "center",
          }}
        >
          <Alert
            severity={
              snackbar.severity
            }
            variant="filled"
          >
            {snackbar.message}
          </Alert>
        </Snackbar>
      </Box>
    </Paper>
  );
};

