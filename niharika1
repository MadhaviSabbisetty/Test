        return appConfigRepository.findByConfigKey(REPORTS_START_DATE_KEY)
                .map(AppConfig::getConfigValue)
                .map(LocalDate::parse)
                .orElseThrow(() -> new ResourceNotFoundException("Configuration missing: " + REPORTS_START_DATE_KEY));
    }
