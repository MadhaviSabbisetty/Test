@Slf4j
@Component
@RequiredArgsConstructor
public class ReportServiceClient{

    private final RestClient restClient;

    @Value("${report.service.url}")
    private String reportServiceUrl;
    
    public AttachmentDownloadResponse 
        downloadAttachments(AttachmentDownloadRequest request,String token){
            try{
                log.info("Calling URL: {}",reportServiceUrl+"/api/reports/attachment/download");
            ApiResponse<AttachmentDownloadResponse> response= restClient.post()
                .uri(reportServiceUrl + "/api/reports/attachment/download")
                .header("Authorization",token)
                .contentType(MediaType.APPLICATION_JSON)
                .accept(MediaType.APPLICATION_JSON)
                .body(request)
                .retrieve()
                .body(new ParameterizedTypeReference<ApiResponse
                <AttachmentDownloadResponse>>(){});
            log.info("Raw Response:{}",response);
            if(response==null){
              throw new RuntimeException("response is null");
            }
            log.info("Response data: {}",response.getData());
            return response.getData();
            }
            catch(Exception e){
                log.error("Exception while calling report service",e);
                throw e;
            }
            // log.info("Attachment Count:{}",response.getAttachments().size());
    }

}


