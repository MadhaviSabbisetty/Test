@Override
public AttachmentDownloadResponse downloadAttachments(
        AttachmentDownloadRequest request,
        int userRoleId,
        String userId) throws IOException {

    List<DownloadedAttachment> downloadedFiles = new ArrayList<>();

    for (AttachmentRef ref : request.getAttachments()) {

        String attachmentId = ref.getAttachmentId();

        String reportFolder = ref.getFileName();

        // Extract date from attachmentId
        // Example:
        // balance_compare_report_31032026

        String datePart =
                attachmentId.substring(attachmentId.lastIndexOf("_") + 1);

        LocalDate reportDate =
                LocalDate.parse(
                        datePart,
                        DateTimeFormatter.ofPattern("ddMMyyyy"));

        String formattedDate =
                reportDate.format(DateTimeFormatter.ISO_LOCAL_DATE);

        Path searchDirectory =
                new Path(
                        new Path(reportsBasePath, formattedDate),
                        reportFolder);

        Path filePath =
                new Path(searchDirectory, attachmentId + ".xlsx");

        if (!hdfsFileSystem.exists(filePath)) {
            throw new ResourceNotFoundException(
                    "File not found : " + filePath);
        }

        byte[] bytes;

        try (FSDataInputStream input =
                     hdfsFileSystem.open(filePath)) {

            bytes = input.readAllBytes();
        }

        DownloadedAttachment attachment =
                new DownloadedAttachment();

        attachment.setFileName(filePath.getName());

        attachment.setContentType(
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");

        attachment.setBase64(
                Base64.getEncoder().encodeToString(bytes));

        attachment.setFileSize(bytes.length);

        downloadedFiles.add(attachment);
    }

    return new AttachmentDownloadResponse(downloadedFiles);
}
