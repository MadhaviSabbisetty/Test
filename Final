    @Override
    public AttachmentDownloadResponse downloadAttachments(
            AttachmentDownloadRequest request) {
                log.info("inside download service");
    
        try {
    
            if (request.getAttachments() == null
                    || request.getAttachments().isEmpty()) {
    
                throw new RuntimeException("No attachments received.");
            }
    
            List<DownloadedAttachment> downloadedFiles =
                    new ArrayList<>();
    
            for (AttachmentRef attachment :
                    request.getAttachments()) {
    
                // Path filePath = new Path(attachment.getPath());

                // String attachmentId = attachment.getAttachmentId();
                // String fileName=attachment.getFileName();
                // String date=attachmentId.substring(attachmentId.lastIndexOf("_")+1);
                // String folderDate=date.substring(4,8)+"-"+date.substring(2,4)+"-"+date.substring(0,2);

                // String hdfsPath=reportBasePath+"/"+folderDate+"/"+fileName+"/"+attachmentId+".xlsx";
                // Path filePath=new Path(hdfsPath);
                // log.info("Reading file from HDFS: {}",filePath);
    
                // if (!hdfsFileSystem.exists(filePath)) {
    
                //     throw new RuntimeException(
                //             "Attachment not found : "
                //                     + filePath);
                // }
    
                // if (!filePath.getName().toLowerCase().endsWith(".xlsx")) {
    
                //     throw new RuntimeException(
                //             "Only xlsx files are supported.");
                // }
    
                // FileStatus status =
                //         hdfsFileSystem.getFileStatus(filePath);

                String attachmentId=attachment.getAttachmentId();
                String fileName=attachmentId+".xlsx";
                String path="reports/"+fileName;
                ClassPathResource resource=new ClassPathResource(path);
                log.info("Path of the file: {}",path);
                if(!resource.exists()){
                        throw new RuntimeException("Attachment not found");
                }
                // InputStream inputStream=resource.getInputStream();

                // log.info("File size: {}",status.getLen());
    
                byte[] fileBytes;
    
                try (InputStream inputStream=resource.getInputStream();
                        // FSDataInputStream inputStream =
                        //     hdfsFileSystem.open(filePath);

                    ByteArrayOutputStream outputStream =
                            new ByteArrayOutputStream()) {
                                log.info("Opening HDFS file .............");
    
                    byte[] buffer = new byte[8192];
    
                    int bytesRead;
    
                    while ((bytesRead =
                            inputStream.read(buffer)) != -1) {
    
                        outputStream.write(
                                buffer,
                                0,
                                bytesRead);
                    }
    
                    fileBytes = outputStream.toByteArray();
                    log.info("Read {} bytes",fileBytes.length);
                }
    
                DownloadedAttachment downloaded =
                        new DownloadedAttachment();
    
                // downloaded.setFileName(filePath.getName());
                downloaded.setFileName(fileName);
                downloaded.setContentType(
                        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    
                // downloaded.setFileSize(status.getLen());
                downloaded.setFileSize(resource.contentLength());
    
                downloaded.setBase64(
                        Base64.getEncoder()
                                .encodeToString(fileBytes));
    
                downloadedFiles.add(downloaded);
                log.info("Downloaded file size: {}",downloadedFiles.size());
            }
    
            AttachmentDownloadResponse response =
                    new AttachmentDownloadResponse();
    
            response.setAttachments(downloadedFiles);

        //     log.info("Returning response: {}",response);
        //     log.info("Returning attachments: {}",response.getAttachments());
            log.info("response size : {}",response.getAttachments().size());
    
            return response;
    
        } catch (IOException ex) {
                log.info("IOException while reading HDFS file",ex);
            throw new RuntimeException(
                    "Unable to download attachments.",
                    ex);
        }
    }
}


    
