            log.info("Attachment Type : {}", attachment.getAttachmentType());
            log.info("Content Type    : {}", downloaded.getContentType());
            log.info("File Size       : {} bytes", downloaded.getFileSize());
        }

        AttachmentDownloadResponse response = new AttachmentDownloadResponse();
        response.setAttachments(downloadedFiles);

        
        log.info("------------------------------------------------------------");
        log.info("Attachment Download Completed Successfully");
        log.info("Total Reports Downloaded : {}", downloadedFiles.size());

        return response;
    }
  

