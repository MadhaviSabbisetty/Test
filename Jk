@Override
public AttachmentDownloadResponse downloadAttachments(
        AttachmentDownloadRequest request,
        int userRoleId,
        String userId) throws IOException {

    List<DownloadedAttachment> attachments = new ArrayList<>();

    for (AttachmentRef ref : request.getAttachments()) {

        // Authorization
        reportTypeRepository.findByFileNameAndRoles_roleId(
                ref.getReportName(),
                userRoleId)
                .orElseThrow(() -> new AccessDeniedException(
                        "Access Denied for report : " + ref.getReportName()));

        String formattedDate =
                ref.getDate().format(DateTimeFormatter.ISO_LOCAL_DATE);

        String fileNamePrefix =
                ref.getReportName() + "_" +
                ref.getDate().format(DateTimeFormatter.ofPattern("ddMMyyyy"));

        Path searchDirectory;

        if (ref.getBranchCode() == null || ref.getBranchCode().isBlank()) {

            searchDirectory =
                    new Path(new Path(reportsBasePath, formattedDate),
                            ref.getReportName());

        } else {

            Path reportFolder =
                    new Path(new Path(reportsBasePath, formattedDate),
                            ref.getReportName());

            searchDirectory =
                    new Path(reportFolder, ref.getBranchCode());
        }

        if (!hdfsFileSystem.exists(searchDirectory)) {
            throw new ResourceNotFoundException(
                    "Directory not found : " + searchDirectory);
        }

        FileStatus[] fileStatuses =
                hdfsFileSystem.listStatus(searchDirectory);

        for (FileStatus status : fileStatuses) {

            if (!status.isFile()) {
                continue;
            }

            String actualFileName =
                    status.getPath().getName();

            if (!actualFileName.startsWith(fileNamePrefix)) {
                continue;
            }

            try (FSDataInputStream input =
                         hdfsFileSystem.open(status.getPath())) {

                byte[] bytes =
                        input.readAllBytes();

                DownloadedAttachment attachment =
                        new DownloadedAttachment();

                attachment.setFileName(actualFileName);

                attachment.setBase64(
                        Base64.getEncoder().encodeToString(bytes));

                attachments.add(attachment);
            }
        }
    }

    AttachmentDownloadResponse response =
            new AttachmentDownloadResponse();

    response.setAttachments(attachments);

    return response;
}
