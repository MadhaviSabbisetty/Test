import com.fasterxml.jackson.annotation.JsonIgnoreProperties;
import com.fasterxml.jackson.annotation.JsonInclude;
import lombok.AllArgsConstructor;
import lombok.Builder;
import lombok.Data;
import lombok.NoArgsConstructor;
import java.util.List;
import java.util.Map;

/**
* DTO for all non-OTP Generic Communications.
* Producers construct this and push it to 'fincore.communication.generic'.
*/
@Data
@Builder
@NoArgsConstructor
@AllArgsConstructor
@JsonInclude(JsonInclude.Include.NON_EMPTY) // Strips out nulls and empty lists for a lightweight payload
@JsonIgnoreProperties(ignoreUnknown = true) // Forward-compatibility if producers add new fields
public class GenericCommunicationEvent {

  // --- Traceability ---
  private String eventId;
  private String traceId;
  private String correlationId;
  private String producerService;
  private String eventType;
  private String priority; // e.g., HIGH, NORMAL, LOW

  // --- Routing Instructions ---
  private List<String> channels; // e.g., ["EMAIL", "SMS"]
  private Recipients recipients;

  // --- Content ---
  private String templateId;
  private Map<String, Object> payload; // Dynamic FreeMarker variables mapped directly to the template

  // --- Enclosures ---
  private List<AttachmentRef> attachments;
  private List<DeepLinkRef> deepLinks;

  // --- Extra Context ---
  private Map<String, String> metadata; // purely for business logic tracking (e.g., batchId), NOT delivery instructions


  @Data
  @Builder
  @NoArgsConstructor
  @AllArgsConstructor
  @JsonInclude(JsonInclude.Include.NON_EMPTY)
  public static class Recipients {
      private List<String> userIds;
      private List<String> roles;
      private List<String> emails;
      private List<String> mobiles;
  }


  @Data
  @Builder
  @NoArgsConstructor
  @AllArgsConstructor
  public static class AttachmentRef {
      private String attachmentId;   // Passed to RestClient to download the report from the source
      private String attachmentType; // e.g., EOD_SUMMARY, STATEMENT, IMAGE
      private String fileName;       // The name shown to the user in the email
  }


  @Data
  @Builder
  @NoArgsConstructor
  @AllArgsConstructor
  public static class DeepLinkRef {
      private String module;         // e.g., REPORTS, APPROVALS
      private String entityId;       // The business ID for dynamic URL generation
      private String action;         // e.g., VIEW_DASHBOARD, APPROVE_TRANSACTION
  }
}
