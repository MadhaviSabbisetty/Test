width: 48,
  height: 48,
  minWidth: 48,
  minHeight: 48,

  padding: 0,
  margin: 0,

  position: "absolute",
  right:0,
  top:0,

  display: "flex",
  alignItems: "center",
  justifyContent: "center",

  borderRadius: "50%",
  overflow: "hidden",

  flexShrink: 0,
  boxSizing: "border-box",

  backgroundColor: theme.palette.primary.main,

  border: "none",
  boxShadow: "none",

  transition:"width 0.3s ease, min-width 0.3s ease, border-radius 0.3s ease",
 
  // -----------------------------------------
  // DARK PURPLE PLUS CIRCLE
  // -----------------------------------------
  "&::after": {
    content: '""',

    position: "absolute",

    right: 0,
    top: "50%",

    width: 48,
    height: 48,

    borderRadius: "50%",

    backgroundColor: theme.palette.primary.main,
    
    transform:"translateY(-50%)",

    zIndex: 3,

    pointerEvents: "none",
  },

  // -----------------------------------------
  // PLUS ICON
  // -----------------------------------------
  "& .MuiSvgIcon-root": {
    position: "absolute",

    right: 12,
    top: "50%",

    width: 24,
    height: 24,

    minWidth: 24,
    minHeight: 24,

    margin: 0,

    color: "#ffffff",

    transform:"translateY(-50%)",

    zIndex: 4,

    flexShrink: 0,

    pointerEvents:"none",
  },

  // -----------------------------------------
  // CREATE SEGMENT TEXT
  // -----------------------------------------
  "& .create-circle-text": {
    position: "absolute",

    left: 16,
    right: 48,

    top: 0,

    height: 48,

    display: "flex",
    alignItems: "center",

    opacity: 0,

    width: "auto",
    maxWidth: "none",

    margin: 0,
    padding: 0,

    whiteSpace: "nowrap",
    overflow: "hidden",

    color: "#ffffff",

    fontSize: "14px",
    fontWeight: 500,

    lineHeight: 1,

    textAlign: "left",

    zIndex: 2,

    transition:
      "opacity 0.2s ease",

    pointerEvents:"none",
  },

  ".fab-hover-area:hover &":{

    width:180,

    minWidth:180,

    height:48,

    borderRadius:"24px",
    padding:0,
    backgroundImage:`linear-gradient(
      to right,
      ${theme.palette.primary.main} 0%,
      ${lighten(theme.palette.primary.main, 0.08)} 30%,
      ${lighten(theme.palette.primary.main, 0.18)} 60%,
      ${lighten(theme.palette.primary.main, 0.30)} 100%
    ) !important`,

    border:"none",

    boxShadow:` inset 0 0 0 2px ${theme.palette.primary.main}`,

    justifyContent:"flex-start",

  },
  
  ".fab-hover-area:hover & .create-circle-text":{
    opacity:1,
  },
