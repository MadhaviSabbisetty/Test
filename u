const createNewRow = () => ({
  id: crypto.randomUUID ? crypto.randomUUID() : Date.now() + Math.random(),
  branch: null,
  currency: "",
  cgl: null,
  amount: "",
  txnType: "",
  remarks: "",
  productCode: "",
});

const formatDateTime = (dateVal) => {
  if (!dateVal) return "N/A";
  // Formats to: "19 Jun 2026, 12:58 pm"
  return dayjs(dateVal).format("DD MMM YYYY, hh:mm a").toLowerCase();
};

const ExpandableDescription = ({ description }) => {
  const [isExpanded, setIsExpanded] = useState(false);
  const desc = description || "No description provided for this voucher configuration.";
  const isLongDesc = desc.length > 100 || desc.split(/\r?\n/).length > 2;

  return (
    <Box sx={{ position: "relative" }}>
      <Collapse in={!isLongDesc || isExpanded} collapsedSize={20}>
        <Typography variant="body2" color="text.secondary" sx={{ whiteSpace: "pre-wrap", wordBreak: "break-word", overflowWrap: "break-word" }}>
          {desc}
        </Typography>
      </Collapse>
      {isLongDesc && (
        <Box sx={{ display: "flex", justifyContent: "flex-start", mt: 0.5 }}>
          <Button
            size="small"
            disableRipple
            onClick={(e) => {
              e.stopPropagation(); // Prevents the main row from collapsing when clicked
              setIsExpanded(!isExpanded);
            }}
            endIcon={isExpanded ? <KeyboardArrowUpIcon /> : <KeyboardArrowDownIcon />}
            sx={{
              p: 0,
              minWidth: "auto",
              textTransform: "none",
              fontWeight: 600,
              color: "primary.main",
              "&:hover": { background: "transparent", textDecoration: "underline" }
            }}
          >
            {isExpanded ? "Read Less" : "Read More"}
          </Button>
        </Box>
      )}
    </Box>
  );
};


export default function VoucherPosting() {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();
  const navigate = useNavigate();
  const menus = useSelector((state) => state.menus);
  const menuItems = useSelector((state) => state.menus.menus);
  const selectedMenuItem = menus.selectedMenuItem;
  const getStatusMenu = findMenuById(menuItems, 32);

  const user = useSelector((state) => state.auth?.user || null);

  const lockedVidRef = useRef(null);
  // --- INTERNAL WIZARD STATE ---
  const [activeStep, setActiveStep] = useState(0);
  const [entryMethod, setEntryMethod] = useState("MANUAL");

  const [submittedBatchId, setSubmittedBatchId] = useState(null);
  const [showSchedulePicker, setShowSchedulePicker] = useState(false);
  const [isApplyingSchedule, setIsApplyingSchedule] = useState(false);
  const [isExecutingImmediately, setIsExecutingImmediately] = useState(false);
  const [routingChoice, setRoutingChoice] = useState(null); // 'IMMEDIATE' or 'SCHEDULE'
  const [isFinalizing, setIsFinalizing] = useState(false);

  const [isConfirmModalOpen, setIsConfirmModalOpen] = useState(false);


  // --- VOUCHER TABLE STATE ---
  const [voucherList, setVoucherList] = useState([]);
  const [selectedVoucher, setSelectedVoucher] = useState(null);
  const [expandedRow, setExpandedRow] = useState(null); // Tracks which row is clicked open
  const [page, setPage] = useState(0);
  const [rowsPerPage, setRowsPerPage] = useState(5);

  const isMounted = useRef(true);
  const [currentUserId, setCurrentUserId] = useState(null);
  // --- STEPPER & WIZARD STATE ---
  const steps = ['Select Voucher', 'Entry Method', 'Data Entry'];

  const [groupedVouchers, setGroupedVouchers] = useState({});
  const [scheduledTime, setScheduledTime] = useState(() =>
    dayjs().add(30, 'minute').startOf('minute')
  );


  const [rows, setRows] = useState([createNewRow(), createNewRow()]);

  const handleResetRows = () => {
    setRows([createNewRow(), createNewRow()]);
    setBranchInputValues({});
    setCglInputValues({});
    setCommonBatchRemarks("");
    setChecked(false);
  };

  const [currencyOptions, setCurrencyOptions] = useState([]);

  const [isSubmitting, setIsSubmitting] = useState(false);

  const [commonBatchRemarks, setCommonBatchRemarks] = useState("");
  const [postingDate, setPostingDate] = useState("");

  const [checked, setChecked] = useState(false);

  const [isPageLoading, setIsPageLoading] = useState(true);
  const [isEodRunning, setIsEodRunning] = useState(false);

  // Replaces anything that is NOT an alphabet, number, or space
  const REMARKS_REPLACE_REGEX = /[^a-zA-Z0-9 ]/g;

  // Replaces anything that is NOT a digit (CGL is strictly digits)
  const CGL_REPLACE_REGEX = /[^0-9]/g;

  // Replaces anything that is NOT alphanumeric (Branch is strictly alphanumeric)
  const BRANCH_REPLACE_REGEX = /[^0-9]/g;


  const [currentRoleId, setCurrentRoleId] = useState(null);


  // Track input values to prevent empty dropdown tray on focus
  const [branchInputValues, setBranchInputValues] = useState({});
  const [cglInputValues, setCglInputValues] = useState({});

  const [branchSearch, setBranchSearch] = useState({
    loadingId: null,
    options: [],
  });
  const [cglSearch, setCglSearch] = useState({
    loadingId: null,
    options: []
  });

  useEffect(() => {
    const handleBeforeUnload = (e) => {
      // 1. INSTANT TAB-CLOSE RELEASE (Guaranteed to work on tab close)
      if (lockedVidRef.current) {
        let token = "";
        try {
          // Grab the token from Redux/Session
          const auth = sessionStorage.getItem("persist:auth") || localStorage.getItem("persist:auth");
          if (auth) {
            const parsedAuth = JSON.parse(auth);
            // Extract the token (adjust 'token' to whatever key your JWT is stored under)
            token = parsedAuth.token || JSON.parse(parsedAuth.auth)?.token || ""; 
          }
        } catch (err) {}

        // THE FIX: Use 'fetch' with 'keepalive: true'. 
        // This forces the browser to send the HTTP request EVEN IF the tab is already closing!
        fetch(`/JS/voucher/unlock/${lockedVidRef.current}`, {
          method: 'POST',
          headers: { 
             'Authorization': `Bearer ${token}`,
             'Content-Type': 'application/json'
          },
          keepalive: true
        }).catch(() => {}); // Catch prevents console errors as the window dies
      }

      // 2. THE WARNING: If they are on Step 3 and haven't clicked submit
      if (activeStep === 3 && !isFinalizing) {
        e.preventDefault();
        e.returnValue = "You have an unfinalized batch. If you leave, it will not be sent for approval!";
      }
    };

    window.addEventListener("beforeunload", handleBeforeUnload);

    return () => {
      window.removeEventListener("beforeunload", handleBeforeUnload);
    };
  }, [activeStep, isFinalizing]); 



  useEffect(() => {
    // Cleanup function runs when the component is destroyed (e.g., navigating away via sidebar)
    return () => {
      if (lockedVidRef.current) {
        // Fire and forget unlock on unmount
        callApi(`/JS/voucher/unlock/${lockedVidRef.current}`, null, "POST").catch(() => { });
      }
    };
  }, [callApi]);



  useEffect(() => {
    isMounted.current = true;
    
    // Use the Redux 'user' object instead of parsing local storage!
    if (user) {
      if (user.userId) setCurrentUserId(String(user.userId));
      
      // Look for roleId or role or ROLE_ID based on your auth structure
      const actualRoleId = user.roleId || user.role || user.ROLE_ID;
      if (actualRoleId) setCurrentRoleId(actualRoleId);
    }
    
    return () => { isMounted.current = false; };
  }, [user]); // Add 'user' to the dependency array


  useEffect(() => {
    const fetchInitialData = async () => {
      try {
        setIsPageLoading(true);

          // Grab the role synchronously directly from the Redux user object
        const actualRoleId = user?.roleId || user?.role || user?.ROLE_ID;

        if (!actualRoleId) {
          showSnackBar("User Role ID not found in session. Cannot fetch VIDs.", "error");
          setIsPageLoading(false);
          return; 
        }

        // Passes the guaranteed correct role ID to the backend
        const vouchersResponse = await callApi(`/JS/voucher/active?roleId=${actualRoleId}`, null, "GET");

        // Defensively extract the array whether your callApi unwraps the { data: [...] } or not
        if (vouchersResponse && Array.isArray(vouchersResponse.data)) {
          setVoucherList(vouchersResponse.data);
        } else if (Array.isArray(vouchersResponse)) {
          setVoucherList(vouchersResponse);
        } else {
          setVoucherList([]); // Safe fallback
        }

        // 1. FIRST: Check the EOD Status from your new API
        const eodResponse = await callApi("/JS/voucher/eod_status", null, "GET");

        // The API returns an array: [{ "eodStatus": 0 }]
        if (eodResponse && Array.isArray(eodResponse) && eodResponse.length > 0) {
          if (eodResponse[0].eodStatus === 1) {
            setIsEodRunning(true);
            setIsPageLoading(false);
            return; // STOP loading everything else, block the screen
          }
        }

        // 2. IF EOD IS NOT RUNNING: Continue loading the normal page data
        const dateResponse = await callApi("/JS/voucher/current-posting-date", null, "GET");

        if (dateResponse) {
          try {
            const [year, month, day] = dateResponse.split("-");
            const formattedDate = `${day}-${month}-${year}`;
            setPostingDate(formattedDate);
          } catch (e) {
            console.error("Could not parse date:", dateResponse, e);
            setPostingDate(dateResponse);
          }
        } else {
          showSnackBar("Failed to load posting date.", "error");
          setPostingDate("Error");
        }

        const currencyResponse = await callApi("/JS/voucher/currencies", null, "GET");
        const currencyData = currencyResponse?.data || currencyResponse;

        if (Array.isArray(currencyData)) {
          let uniqueCurrencies = [...new Set(currencyData)];

          // Sort the array so "INR" is always at index 0, and the rest are alphabetical
          uniqueCurrencies.sort((a, b) => {
            if (a === "INR") return -1;
            if (b === "INR") return 1;
            return a.localeCompare(b);
          });

          setCurrencyOptions(uniqueCurrencies);
        } else {
          showSnackBar("Failed to load currencies.", "error");
        }
      } catch (error) {
        console.error("Error fetching initial data:", error);
        showSnackBar("An error occurred while loading page data.", "error");
      } finally {
        setIsPageLoading(false);
      }
    };

    fetchInitialData();
  }, [callApi, showSnackBar]);

  const handleNext = async () => {
    if (activeStep === 0) {
      if (!selectedVoucher) {
        showSnackBar("Please select a voucher from the list first.", "warning");
        return;
      }

      // --- ONLY LOCK WHEN THEY CLICK "NEXT" ---
      const vidToLock = selectedVoucher.vid || selectedVoucher.VID;
      setIsPageLoading(true);

      try {
        await callApi(`/JS/voucher/lock/${vidToLock}`, null, "POST");
        lockedVidRef.current = vidToLock;
        setActiveStep((prevStep) => prevStep + 1);
      } catch (error) {
        // --- THIS FIXES THE DEADLOCK ---
        const errMsg = error?.response?.data?.message || "This VID is already in use.";
        showSnackBar(errMsg, "warning");

        // 1. Clear the selection so they don't think they still have it
        setSelectedVoucher(null);

        // 2. Automatically refresh the table so the VID disappears/updates status
        const vouchersResponse = await callApi(`/JS/voucher/active?roleId=${currentRoleId}`, null, "GET");
        setVoucherList(vouchersResponse?.data || vouchersResponse || []);
      } finally {
        setIsPageLoading(false);
      }
    } else {
      setActiveStep((prevStep) => prevStep + 1);
    }
  };

  const releaseLock = useCallback(async (vid) => {
    if (vid) {
      try {
        await callApi(`/JS/voucher/unlock/${vid}`, null, "POST");
        lockedVidRef.current = null; // Clear the ref
      } catch (e) {
        console.error("Failed to release VID lock", e);
      }
    }
  }, [callApi]);

  const handleMethodSelection = (method) => {
    setEntryMethod(method);
    handleNext();
  };



  const handleResetWizard = () => {

    // If the wizard is completely reset/cancelled, release the lock!
    if (lockedVidRef.current) {
      releaseLock(lockedVidRef.current);
    }


    setSelectedVoucher(null);
    setEntryMethod("MANUAL");
    setRows([createNewRow()]);
    setCommonBatchRemarks("");
    setScheduledTime(null);
    setChecked(false);
    setSubmittedBatchId(null);
    setShowSchedulePicker(false);
    navigate(getStatusMenu.route || selectedMenuItem.route)

  };

  const handleFinalizeRouting = async () => {
    setIsFinalizing(true);
    let formattedSchedule = null;

    // Default to the manual batch ID (since it's already created in Step 2)
    let finalDisplayBatchId = submittedBatchId;

    try {
      if (routingChoice === "SCHEDULE") {
        if (!scheduledTime || !scheduledTime.isValid()) {
          showSnackBar("Please select a valid time.", "warning");
          setIsFinalizing(false);
          return;
        }

        const today = dayjs();
        const finalSchedule = scheduledTime
          .year(today.year())
          .month(today.month())
          .date(today.date());

        const minAllowed = dayjs().add(28, 'minute');
        const maxAllowed = dayjs().endOf('day');

        if (finalSchedule.isBefore(minAllowed)) {
          showSnackBar("Schedule time must be at least 30 minutes from now.", "warning");
          setIsFinalizing(false);
          return;
        }
        if (finalSchedule.isAfter(maxAllowed)) {
          showSnackBar("Schedule time cannot exceed today's end of day (11:59 PM).", "warning");
          setIsFinalizing(false);
          return;
        }
        formattedSchedule = finalSchedule.format('YYYY-MM-DD HH:mm:ss');
      }

      if (entryMethod === "BULK") {
        // For Bulk, submittedBatchId actually holds the UUID. Create the batch NOW.
        const [day, month, year] = postingDate.split("-");
        const formattedBackendDate = `${day}/${month}/${year}`;

        const response = await callApi("/JS/voucher/create-batch-from-cache", {
          requestId: submittedBatchId,
          postingDate: formattedBackendDate,
          vid: selectedVoucher.vid,
          commonBatchRemarks: "Voucher created successfully",
          scheduledTime: formattedSchedule
        }, "POST");

        // SAFELY EXTRACT THE REAL ORACLE BATCH ID
        finalDisplayBatchId = response?.[0]?.batchId || response?.batchId || (typeof response === 'string' ? response : "N/A");

      } else {
        // For Manual, the batch is already created, just update the schedule.
        await callApi("/JS/voucher/update-schedule", {
          batchId: submittedBatchId,
          scheduledTime: formattedSchedule
        }, "POST");
      }

      // SHOWS THE OFFICIAL SUBMISSION MESSAGE WITH THE CORRECT BATCH ID
      showSnackBar(`Success! Your batch ${finalDisplayBatchId} is initialized and processing.`, "success");
      handleResetWizard();

    } catch (error) {
      const serverMsg = error?.response?.data?.message
        || error?.response?.data?.error
        || (typeof error?.response?.data === 'string' ? error.response.data : null)
        || error?.message;

      const errMsg = serverMsg || "Unable to finalize execution routing. Please try again.";
      showSnackBar(errMsg, "error");
    } finally {
      setIsFinalizing(false);
    }
  };



  const handleChangePage = (event, newPage) => {
    setPage(newPage);
  };

  const handleChangeRowsPerPage = (event) => {
    setRowsPerPage(parseInt(event.target.value, 10));
    setPage(0);
  };

  const handleRowExpand = (id) => {
    setExpandedRow(expandedRow === id ? null : id);
  };
  const handleBack = () => {
    // If returning from Step 1 back to the Voucher Selection table, release the lock!
    if (activeStep === 1 && lockedVidRef.current) {
      releaseLock(lockedVidRef.current);
    }
    setActiveStep((prevStep) => prevStep - 1);
  };

  const filterRemarks = (val) => {
    let filtered = val.replace(/[^a-zA-Z0-9 ]/g, ""); // Allow only alphanumeric and spaces
    filtered = filtered.replace(/^\s+/, ""); // Remove leading spaces
    filtered = filtered.replace(/\s{2,}/g, " "); // Replace multiple consecutive spaces with a single space
    return filtered;
  };


  // 1. Common remarks can be empty. If filled, must be 2-30.
  const isCommonRemarksValid = (val) => val.trim().length === 0 || (val.trim().length >= 2 && val.trim().length <= 30);

  // 2. Row remarks are STRICTLY compulsory (2-30 chars).
  const isRowRemarksValid = (val) => val.trim().length >= 2 && val.trim().length <= 30;
 const filterAndWarn = (val) => {
    let filtered = val;
    let hasError = false;
    let msg = "Only alphanumeric characters and single spaces are allowed.";

    // 1. Corrected Regex: Allows ONLY Alphanumeric and Spaces
    const invalidCharRegex = /[^a-zA-Z0-9 ]/g;

    if (invalidCharRegex.test(filtered)) {
      hasError = true;
      filtered = filtered.replace(invalidCharRegex, "");
    }

    // 2. Strip leading space and collapse double spaces
    const beforeSpaceTrim = filtered;
    filtered = filtered.replace(/^\s+/, "").replace(/\s{2,}/g, " ");

    if (beforeSpaceTrim !== filtered && !hasError) {
      hasError = true;
      msg = "Remark should not start with a space or contain consecutive spaces.";
    }

    if (hasError) {
      showSnackBar(msg, "warning");
    }

    return filtered;
  };

  // Both Common Batch Remarks and Row Remarks are now strictly compulsory (2-30 chars)
  const isRemarksValid = (val) => val.trim().length >= 2 && val.trim().length <= 30;
  const handleAddRow = () => {
    const lastRow = rows[rows.length - 1];

    if (
      !lastRow.branch ||
      !lastRow.currency ||
      !lastRow.cgl ||
      !lastRow.amount ||
      !lastRow.txnType ||
      !isRowRemarksValid(lastRow.remarks)
    ) {
      showSnackBar(
        "Please fill all required fields (*) in the current row before adding a new one.",
        "warning"
      );
      return;
    }

    const newRow = {
      ...createNewRow(),
      remarks: checked ? commonBatchRemarks : "",
    };
    setRows([...rows, newRow]);
  };

  const handleRemarksSync = (event) => {
    const isChecked = event.target.checked;
    setChecked(isChecked);

    if (isChecked) {
      const newRows = rows.map((row) => ({
        ...row,
        remarks: commonBatchRemarks,
      }));
      setRows(newRows);
    } else {
      const newRows = rows.map((row) => ({
        ...row,
        remarks: "",
      }));
      setRows(newRows);
    }
  };

  const handleDeleteRow = (id) => {
    if (rows.length > 2) {
      setRows(rows.filter((row) => row.id !== id));
      // Cleanup input tracking
      const newBranchInputs = { ...branchInputValues };
      delete newBranchInputs[id];
      setBranchInputValues(newBranchInputs);
      const newCglInputs = { ...cglInputValues };
      delete newCglInputs[id];
      setCglInputValues(newCglInputs);
    } else {
      showSnackBar("A minimum of two rows is required.", "warning");
    }
  };

  const handleRowChange = (id, field, value) => {
    setRows((prevRows) =>
      prevRows.map((row) => {
        if (row.id === id) {
          return { ...row, [field]: value };
        }
        return row;
      })
    );
  };

  const searchBranches = useCallback(
    debounce(async (query, rowId) => {
      if (!query || query.trim().length < 3) {
        setBranchSearch({ loadingId: null, options: [] });
        return;
      }
      setBranchSearch((prev) => ({ ...prev, loadingId: rowId }));
      try {
        const response = await callApi(
          `/JS/branches-journal/search?query=${encodeURIComponent(query)}`,
          null,
          "GET"
        );

        setBranchSearch({ loadingId: null, options: response || [] });
      } catch (error) {
        showSnackBar("Branch search failed.", "error");
        setBranchSearch({ loadingId: null, options: [] });
      }
    }, 300),
    [callApi, showSnackBar]
  );

  const searchCgls = useCallback(
    debounce(async (query, rowId) => {
      // Changed from === 0 to < 3 to enforce the minimum character limit
      if (!query || query.trim().length < 3) {
        setCglSearch({ loadingId: null, options: [] });
        return;
      }
      setCglSearch((prev) => ({ ...prev, loadingId: rowId }));

      try {
        const response = await callApi(
          `/JS/cgl-journal/search?query=${encodeURIComponent(query)}`,
          null,
          "GET"
        );

        setCglSearch({ loadingId: null, options: response || [] });
      } catch (error) {
        showSnackBar("CGL search failed.", "error");
        setCglSearch({ loadingId: null, options: [] });
      }
    }, 300),
    [callApi, showSnackBar]
  );


  const isFormReadyToSubmit = rows.length >= 2 && rows.every(
    (row) =>
      row.branch &&
      row.currency &&
      row.cgl &&
      row.amount &&
      parseFloat(row.amount) > 0 &&
      row.txnType &&
      isRowRemarksValid(row.remarks)
  );

  const handleValidateClick = async () => {
    if (!isCommonRemarksValid(commonBatchRemarks)) {
      showSnackBar("Common Batch Remarks must be 2-30 characters if provided.", "error");
      return;
    }

    const branchCurrencyTotals = new Map();
    const branchEntryCheck = new Map();

    for (const [index, row] of rows.entries()) {
      if (
        !row.branch || !row.currency || !row.cgl || !row.amount ||
        parseFloat(row.amount) === 0 || !row.txnType || !isRowRemarksValid(row.remarks)
      ) {
        showSnackBar(
          `Row ${index + 1} is incomplete or has a zero amount. Amount must be greater than 0, and remarks must be 2-30 characters.`,
          "error"
        );
        return;
      }

      const branchCode = row.branch.code;
      const currency = row.currency;

      const cglNumber = String(row.cgl.cglNumber);
      const isMemo = cglNumber.startsWith("5");
      const type = isMemo ? "MEMO" : "NORMAL";

      const [integerPart = "0", fractionalPart = "0"] = (row.amount || "0").split(".");
      const fractionalPadded = fractionalPart.substring(0, 4).padEnd(4, "0");
      const amountAsBigInt = BigInt(integerPart + fractionalPadded);

      const compositeKey = `${branchCode}-${currency}-${type}`;

      if (!branchCurrencyTotals.has(compositeKey)) {
        branchCurrencyTotals.set(compositeKey, { totalDebit: 0n, totalCredit: 0n });
      }
      const currencyTotals = branchCurrencyTotals.get(compositeKey);

      if (row.txnType === "Debit") {
        currencyTotals.totalDebit += amountAsBigInt;
      } else if (row.txnType === "Credit") {

        currencyTotals.totalCredit += amountAsBigInt;
      }

      if (!branchEntryCheck.has(branchCode)) {
        branchEntryCheck.set(branchCode, { hasDebit: false, hasCredit: false });
      }
      const branchCheck = branchEntryCheck.get(branchCode);

      if (row.txnType === "Debit" && amountAsBigInt > 0n) branchCheck.hasDebit = true;
      else if (row.txnType === "Credit" && amountAsBigInt > 0n) branchCheck.hasCredit = true;
