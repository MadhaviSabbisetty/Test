package com.fincore.CommunicationService.client;

import com.fincore.CommunicationService.dto.ApiResponse;
import com.fincore.CommunicationService.dto.attachment.AttachmentDownloadRequest;
import com.fincore.CommunicationService.dto.attachment.AttachmentDownloadResponse;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.core.ParameterizedTypeReference;
import org.springframework.stereotype.Component;
import org.springframework.web.client.RestClient;

@Slf4j
@Component
@RequiredArgsConstructor
/**
 * REST client used to communicate with Report Service
 * for attachment download requests
 */
public class ReportServiceClient {

    private final RestClient restClient;

    @Value("${report.service.url}")
    private String reportServiceUrl;

    @Value("${report.service.internal-token}")
    private String reportServiceInternalToken;

    /**
     * Invokes Report Service to download attachment content
     * 
     * @param request Attachment download request
     * @return Downloaded attachments
     */

    public AttachmentDownloadResponse downloadAttachments(
            AttachmentDownloadRequest request) {

        try {

            log.info("Calling Report Service : {}",
                    reportServiceUrl + "/api/reports/attachment/download");

            ApiResponse<AttachmentDownloadResponse> response =
            //Invoke report Service attachment download endpoint
                    restClient.post()
                            .uri(reportServiceUrl + "/api/reports/attachment/download")
                            .header("X-Internal-Token", reportServiceInternalToken)
                            .body(request)
                            .retrieve()
                            .body(new ParameterizedTypeReference<ApiResponse<AttachmentDownloadResponse>>() {});

            //Validate response received from Report Service

            if (response == null) {
                throw new RuntimeException("No response received from Report Service");
            }

            if (!response.isSuccess()) {
                throw new RuntimeException(response.getMessage());
            }

            if (response.getData() == null) {
                throw new RuntimeException("Attachment response is empty");
            }

            log.info("Report Service returned {} attachment(s)",
                    response.getData().getAttachments().size());

            return response.getData();

        } catch (Exception ex) {

            log.error("Error while downloading attachments from Report Service", ex);

            throw ex;
        }
    }
}              
