import React, { useState } from "react";
import { DataGrid } from "@mui/x-data-grid";
import {
  Box,
  Paper,
  IconButton,
  Tooltip,
  Chip,
  Menu,
  MenuItem,
  ListItemIcon,
  ListItemText,
  Alert,
  Stack,
} from "@mui/material";

import MoreVertIcon from "@mui/icons-material/MoreVert";
import VisibilityIcon from "@mui/icons-material/Visibility";
import EditIcon from "@mui/icons-material/Edit";
import DeleteIcon from "@mui/icons-material/Delete";
import HistoryIcon from "@mui/icons-material/History";
import DownloadIcon from "@mui/icons-material/Download";
import CheckCircleIcon from "@mui/icons-material/CheckCircle";
import PauseCircleIcon from "@mui/icons-material/PauseCircle";
import DraftsIcon from "@mui/icons-material/Drafts";

import TemplateViewDialog from "../../common/TemplateViewDialog";
import DeleteConfirmDialog from "./DeleteConfirmDialog";
import StatusChangeDialog from "./StatusChangeDialog";
import VersionHistoryDialog from "./VersionHistoryDialog";
import QuickExportMenu from "./QuickExportMenu";

import { templateApi } from "../api/templateApi";
import useCustomSnackbar from "../../../utils/useCustomSnackbar";
import useApi from "../../../hooks/useApi";
import RemarksDialog from "./RemarksDialog";

const TemplateTable = ({ data, onRefresh, onEditClick }) => {
  const [selectedTemplate, setSelectedTemplate] = useState(null);
  const [anchorEl, setAnchorEl] = useState(null);
  const [exportAnchor, setExportAnchor] = useState(null);

  const [openView, setOpenView] = useState(false);
  const [openDelete, setOpenDelete] = useState(false);
  const [openStatus, setOpenStatus] = useState(false);
  const [openVersions, setOpenVersions] = useState(false);
  const [newStatus, setNewStatus] = useState(null);
  const [processing, setProcessing] = useState(false)

  const { callApi } = useApi();
  const snackbar = useCustomSnackbar();

  const handleMenuOpen = (event, template) => {
    setAnchorEl(event.currentTarget);
    setSelectedTemplate(template);
  };

  const handleMenuClose = () => {
    setAnchorEl(null);
  };

  const handleAction = (actionType) => {
    handleMenuClose();
    switch (actionType) {
      case "view":
        setOpenView(true);
        break;
      case "edit":
        // Navigate to editor with template ID
        onEditClick(selectedTemplate);
        break;
      case "delete":
        setOpenDelete(true);
        break;
      case "status":
        setOpenStatus(true);
        break;
      case "versions":
        setOpenVersions(true);
        break;
      case "export":
        // Quick export is handled separately
        break;
      default:
        break;
    }
  };

  // const handleExportClick = (event, template) => {
  //   setExportAnchor(event.currentTarget);
  //   setSelectedTemplate(template);
  // };

  const closeAllDialogs = () => {
    setOpenView(false);
    setOpenDelete(false);
    setOpenStatus(false);
    setOpenVersions(false);
    setSelectedTemplate(null);
  };

  const handleDeleteSuccess = () => {
    snackbar("Template deleted successfully", "success");
    onRefresh();
    closeAllDialogs();
  };

  const handleStatusChange = async (remarks) => {
    try {
      setProcessing(true);
      const payload = {
        status: newStatus,
        remarks: remarks,
        templateId: selectedTemplate?.templateId,
        targetId: selectedTemplate?.reportId,
        template: {
          templateMeta: {
            templateId: selectedTemplate.templateId,
            version: selectedTemplate.versionNo,
          },
          reportMeta: {
            reportId: selectedTemplate.reportId,
            reportName: selectedTemplate.templateName
          }
        }
      }

      await templateApi.updateTemplateStatus(
        callApi,
        selectedTemplate.templateId,
        payload
      );

      setNewStatus(null);
      snackbar(`Request for status update created successfully.`, "success");
      onRefresh();
      closeAllDialogs();
    } catch (error) {
      setNewStatus(null);
      snackbar(error.message ?? "Failed to create request for status update!", "error");
    } finally {
      setProcessing(false)
    }
  };

  const statusChangeConfirm = (newStatus) => {
    setOpenStatus(false);
    setNewStatus(newStatus)
  }

  const handleRollback = async (version, remarks) => {
    try {
      const payload = {
        rollbackTo: version,
        remarks: remarks,
        targetId: selectedTemplate?.reportId,
        template: {
          templateMeta: {
            templateId: selectedTemplate.templateId,
            version: selectedTemplate.versionNo,
          },
          reportMeta: {
            reportId: selectedTemplate.reportId,
            reportName: selectedTemplate.templateName
          }
        }
      }
      await templateApi.rollbackToVersion(
        callApi,
        payload
      );
      snackbar(`Request for template rollback created successfully.`, "success");
      onRefresh();
      closeAllDialogs();
    } catch (error) {
      snackbar(error.message ?? "Failed to create request for template rollback!", "error");
    }
  };

  // Status chip styling
  const getStatusConfig = (status) => {
    const configs = {
      ACTIVE: {
        color: "#0F6A3A",
        bg: "#ECFDF5",
        icon: CheckCircleIcon,
      },
      INACTIVE: {
        color: "#6b7280",
        bg: "#f3f4f6",
        icon: PauseCircleIcon,
      },
      DRAFT: {
        color: "#0B4DA0",
        bg: "#E6F0FF",
        icon: DraftsIcon,
      },
    };
    return configs[status] || configs.INACTIVE;
  };

  const columns = [
    {
      field: "templateId",
      headerName: "Template ID",
      width: 130,
      headerClassName: "table-header",
      renderCell: (params) => (
        <Box
          sx={{
            // fontFamily: "JetBrains Mono, monospace",
            // fontSize: "0.875rem",
            // color: "#6b7280",
            ml: 1,
            fontWeight: 500,
          }}
        >
          {params.value}
        </Box>
      ),
    },
    {
      field: "reportId",
      headerName: "Report ID",
      width: 200,
      headerClassName: "table-header",
      renderCell: (params) => (
        <Box
          sx={{
            fontWeight: 500,
          }}
        >
          {params.value}
        </Box>
      ),
    },
    {
      field: "templateName",
      headerName: "Report Name",
      flex: 1,
      width: 250,
      headerClassName: "table-header",
      renderCell: (params) => (
        <Box
          sx={{
            fontWeight: 600,
            // color: "#111827",
            // fontSize: "0.9375rem",
          }}
        >
          {params.value}
        </Box>
      ),
    },
    {
      field: "description",
      headerName: "Description",
      flex: 1.5,
      width: 250,
      headerClassName: "table-header",
      renderCell: (params) => (
        <Box
          sx={{
            // color: "#6b7280",
            // fontSize: "0.875rem",
            overflow: "hidden",
            textOverflow: "ellipsis",
            whiteSpace: "nowrap",
          }}
        >
          {params.value || "—"}
        </Box>
      ),
    },
    {
      field: "versionNo",
      headerName: "Version",
      width: 100,
      headerClassName: "table-header",
      renderCell: (params) => (
        <Chip
          label={`v ${params.value || "1"}`}
          size="small"
          sx={{
            fontWeight: 600,
            // fontSize: "0.75rem",
            // bgcolor: "#ede9fe",
            // color: "#7c3aed",
            // border: "1px solid #c4b5fd",
          }}
        />
      ),
    },
    {
      field: "status",
      headerName: "Status",
      width: 140,
      headerClassName: "table-header",
      renderCell: (params) => {
        const config = getStatusConfig(params.value);
        const StatusIcon = config.icon;

        return (
          <Chip
            icon={<StatusIcon sx={{ fontSize: "1rem !important" }} />}
            label={params.value}
            size="small"
            sx={{
              bgcolor: config.bg,
              color: config.color,
              fontWeight: 600,
              // fontSize: "0.8125rem",
              border: `1px solid ${config.color}25`,
              "& .MuiChip-icon": {
                color: config.color,
              },
            }}
          />
        );
      },
    },

    {
      field: "actions",
      headerName: "Actions",
      width: 160,
      sortable: false,
      headerClassName: "table-header",
      renderCell: (params) => (
        <Stack
          direction="row"
          spacing={1}
          justifyContent="left"
          alignItems="center"
          sx={{ mt: 0.8 }}
        >
          <Tooltip title="Quick View">
            <IconButton
              size="small"
              onClick={() => {
                setSelectedTemplate(params.row);
                setOpenView(true);
              }}
              sx={
                {
                  // color: "#3b82f6",
                  // "&:hover": { bgcolor: "#dbeafe" },
                }
              }
            >
              <VisibilityIcon fontSize="small" />
            </IconButton>
          </Tooltip>

          {/* <Tooltip title="Quick Export">
            <IconButton
              size="small"
              onClick={(e) => handleExportClick(e, params.row)}
              sx={
                {
                  // color: "#10b981",
                  // "&:hover": { bgcolor: "#d1fae5" },
                }
              }
            >
              <DownloadIcon fontSize="small" />
            </IconButton>
          </Tooltip> */}

          <Tooltip title="Version History">
            <IconButton
              size="small"
              onClick={() => {
                setSelectedTemplate(params.row);
                setOpenVersions(true);
              }}
              sx={
                {
                  // color: "#8b5cf6",
                  // "&:hover": { bgcolor: "#ede9fe" },
                }
              }
            >
              <HistoryIcon fontSize="small" />
            </IconButton>
          </Tooltip>

          <Tooltip title="More Actions">
            <IconButton
              size="small"
              onClick={(e) => handleMenuOpen(e, params.row)}
              sx={
                {
                  // color: "#6b7280",
                  // "&:hover": { bgcolor: "#f3f4f6" },
                }
              }
            >
              <MoreVertIcon fontSize="small" />
            </IconButton>
          </Tooltip>
        </Stack>
      ),
    },
  ];

  return (
    <Paper
      elevation={0}
      sx={{
        width: "100%",
        overflow: "hidden",
      }}
    >
      <DataGrid
        rows={data}
        columns={columns}
        getRowId={(row) => row.templateId}
        initialState={{
          pagination: { paginationModel: { pageSize: 10 } },
        }}
        pageSizeOptions={[5, 10, 25, 50]}
        disableRowSelectionOnClick
        sx={{
          minHeight: 400,
        }}
      />
      {/* Actions Menu */}
      <Menu
        anchorEl={anchorEl}
        open={Boolean(anchorEl)}
        onClose={handleMenuClose}
      >
        <Box>
          <MenuItem onClick={() => handleAction("edit")}>
            <ListItemIcon>
              <EditIcon
                fontSize="small"
                sx={
                  {
                    /* color: "#3b82f6" */
                  }
                }
              />
            </ListItemIcon>
            <ListItemText>Edit Report</ListItemText>
          </MenuItem>
          <MenuItem onClick={() => handleAction("status")}>
            <ListItemIcon>
              <CheckCircleIcon
                fontSize="small"
                sx={
                  {
                    /* color: "#10b981" */
                  }
                }
              />
            </ListItemIcon>
            <ListItemText>Change Status</ListItemText>
          </MenuItem>
          <MenuItem
            onClick={() => handleAction("delete")}
            sx={{
              /* color: "#ef4444" */
              color: "error.main",
            }}
          >
            <ListItemIcon>
              <DeleteIcon
                fontSize="small"
                sx={{
                  /* color: "#ef4444" */
                  color: "error.main",
                }}
              />
            </ListItemIcon>
            <ListItemText>Delete Report</ListItemText>
          </MenuItem>
        </Box>
      </Menu>
      {/* Quick Export Menu */}
      <QuickExportMenu
        anchorEl={exportAnchor}
        open={Boolean(exportAnchor)}
        onClose={() => setExportAnchor(null)}
        template={selectedTemplate}
        onSuccess={(msg) => snackbar(msg, "success")}
        onError={(msg) => snackbar(msg, "error")}
      />

      {(newStatus == null) && selectedTemplate && (
        <>
          <TemplateViewDialog
            open={openView}
            handleClose={closeAllDialogs}
            template={selectedTemplate}
          />

          <DeleteConfirmDialog
            open={openDelete}
            template={selectedTemplate}
            onClose={closeAllDialogs}
            onConfirm={handleDeleteSuccess}
          />

          <StatusChangeDialog
            open={openStatus}
            template={selectedTemplate}
            onClose={closeAllDialogs}
            onConfirm={statusChangeConfirm}
          />

          <VersionHistoryDialog
            open={openVersions}
            template={selectedTemplate}
            onClose={closeAllDialogs}
            onRollback={handleRollback}
          />
        </>
      )}
      {(newStatus != null) &&
        <RemarksDialog
          open={newStatus != null}
          onConfirm={handleStatusChange}
          onClose={() => { setNewStatus(null), closeAllDialogs() }}
          saving={processing}
        />
      }
    </Paper>
  );
};

export default TemplateTable;
