@PostMapping("/attachment/download")
public ResponseEntity<ApiResponse<List<String>>> download(
        @RequestBody AttachmentDownloadRequest request) {

    log.info(
            "Download request received from controller call to test download");

    File zipFile = null;

    try {

        zipFile =
                attachmentPreparationService
                        .prepareAttachments(
                                request.getAttachments());

        List<String> attachmentNames =
                request.getAttachments()
                        .stream()
                        .map(attachment ->
                                attachment.getAttachmentId()
                                        + ".xlsx")
                        .toList();

        return ResponseEntity.ok(
                ApiResponse.success(
                        attachmentNames,
                        "Attachments downloaded successfully"));

    } catch (IllegalArgumentException ex) {

        return ResponseEntity.badRequest()
                .body(
                        ApiResponse.error(
                                ex.getMessage()));

    } catch (Exception ex) {

        log.error(
                "Error while downloading attachments",
                ex);

        return ResponseEntity
                .internalServerError()
                .body(
                        ApiResponse.error(
                                "Unable to download attachments"));

    } finally {

        if (zipFile != null
                && zipFile.exists()) {

            boolean deleted =
                    zipFile.delete();

            log.debug(
                    "Temporary ZIP deleted: {}",
                    deleted);
        }
    }
}
