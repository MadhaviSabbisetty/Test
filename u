@PostMapping("/attachment/download")
public ResponseEntity<?> download(
        @RequestBody AttachmentDownloadRequest request) {

    try {

        log.info(
                "Download request received from controller call to test download");

        File zipFile =
                attachmentPreparationService.prepareAttachments(
                        request.getAttachments());

        return ResponseEntity.ok()
                .header(
                        HttpHeaders.CONTENT_DISPOSITION,
                        "attachment; filename=\"attachments.zip\"")
                .contentType(MediaType.APPLICATION_OCTET_STREAM)
                .body(new FileSystemResource(zipFile));

    } catch (IllegalArgumentException ex) {

        log.error(
                "Invalid attachment download request: {}",
                ex.getMessage());

        return ResponseEntity.badRequest()
                .body(
                        ApiResponse.error(
                                ex.getMessage()));

    } catch (ResourceNotFoundException ex) {

        log.error(
                "Attachment not found: {}",
                ex.getMessage());

        return ResponseEntity.status(HttpStatus.NOT_FOUND)
                .body(
                        ApiResponse.error(
                                ex.getMessage()));

    } catch (Exception ex) {

        log.error(
                "Attachment download failed",
                ex);

        return ResponseEntity.status(
                        HttpStatus.INTERNAL_SERVER_ERROR)
                .body(
                        ApiResponse.error(
                                "Attachment download failed"));
    }
}


