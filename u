@Override
public Resource prepareAttachments(
        List<AttachmentRef> attachments) throws IOException {

    log.debug(
            "Initiating attachment preparation for {} items.",
            attachments == null ? 0 : attachments.size());

    if (attachments == null || attachments.isEmpty()) {
        return null;
    }

    if (attachments.size() != 3) {

        throw new IllegalArgumentException(
                "Exactly 3 attachments are required");
    }

    AttachmentDownloadRequest request =
            AttachmentDownloadRequest.builder()
                    .attachments(attachments)
                    .build();

    Resource resource =
            reportServiceClient.downloadAttachments(request);

    if (resource == null) {

        log.warn(
                "Report Service returned an empty attachment response.");

        return null;
    }

    log.debug(
            "Attachment ZIP received from Report Service.");

    return resource;
}


