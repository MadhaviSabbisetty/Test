export default function MyCurrencyRequestsTab({ permissions = {} }) {
  const [rows, setRows] = useState([]);
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();
  const selectedMenuItem = useSelector((state) => state.menus.selectedMenuItem);
  const [confirmDialog, setConfirmDialog] = useState(false);
  const [requestId, setRequestId] = useState(null);
  const [isLoading, setIsLoading] = useState(true);
  const [viewOpen, setViewOpen] = useState(false);
  const [viewData, setViewData] = useState(null);

  const fetchData = async () => {
    setIsLoading(true);
    try {
      const payload = { requestType: selectedMenuItem.requestType };
      const response = await callApi("/CR/my-requests", payload, "POST");
      if (response) {
        const result = response.data?.map((row) => {
          let parsedPayload = {};
          parsedPayload = row.payload ? row.payload : {};
          parsedPayload = {
            ...parsedPayload,
            id: row.id,
            reqStatus: row.reqStatus,
            reqDate: row.reqDate,
            creatorId: row.creatorId,
            executionDate: row.executionDate,
            executorId: row.executorId,
            executorRemarks: row.executorRemarks,
            reqType: row.requestType,
            changeType: row.changeType,
          };
          return { ...parsedPayload };
        });
        result.sort((a, b) => {
          if (a.reqStatus === "PENDING" && b.reqStatus !== "PENDING") return -1;
          if (a.reqStatus !== "PENDING" && b.reqStatus === "PENDING") return 1;
          return new Date(b.reqDate) - new Date(a.reqDate);
        });
        setRows(result);
      } else {
        setRows([]);
      }
    } catch (error) {
      console.error("Something went wrong", error);
    } finally {
      setIsLoading(false);
    }
  };

  const handleCancelRequest = async () => {
    try {
      const payload = {
        requestId,
        remarks: "User cancelled this Request",
      };

      const response = await callApi("/CR/cancel-request", payload, "PATCH");
      console.log(response);
      if (response?.success) {
        showSnackBar("Request Cancelled Successfully.", "success");
      } else {
        showSnackBar(
          response?.message
            ? response?.message
            : "Failed to process your cancel request, Kindly try again",
          "error",
        );
      }
    } catch (error) {
      console.log(error);
    } finally {
      fetchData();
      setConfirmDialog(false);
    }
  };

  const handleViewClick = (data) => {
    console.log(data);

    const { yearStartDate, yearEndDate, remarks } = data;

    const showData = {
      //payload
      yearStartDate,
      yearEndDate,
      remarks,
    };

    data.showData = showData;
    setViewData(data);
    setViewOpen(true);
  };

  useEffect(() => {
    fetchData();
  }, []);

  const columns = useMemo(
    () => [
      {
        field: "yearStartDate",
        headerName: "Year StartDate",
        flex: 1,
        minWidth: 150,
        sortable: true,
      },
      {
        field: "yearEndDate",
        headerName: "Year End Date",
        flex: 1.5,
        minWidth: 150,
        sortable: true,
      },
      {
        field: "remarks",
        headerName: "Remarks",
        flex: 1,
        minWidth: 130,
        sortable: true,
      },
      {
        field: "reqStatus",
        headerName: "Status",
        flex: 1,
        minWidth: 130,
        filterable: false,
        sortable: false,
        disableColumnMenu: true,
        renderCell: (params) => (
          <Box
            // sx={{
            //   color:
            //     params.value === "REJECTED"
            //       ? "error.main"
            //       : params.value === "ACCEPTED"
            //         ? "success.dark"
            //         : "warning.main",
            //   // fontWeight: "bold",
            // }}
          >
            <CustomChip
              variant="outlined"
              icon={
                params.value === "REJECTED" ? (
                  <BlockFlippedIcon />
                ) : params.value === "ACCEPTED" ? (
                  <CheckCircleIcon />
                ) : params.value === "CANCELLED" ? (
                  <GppBadIcon />
                ) : (
                  <PendingActionsIcon />
                )
              }
              label={
                params.value === "REJECTED"
                  ? "Rejected"
                  : params.value === "ACCEPTED"
                    ? "Approved"
                    : params.value === "CANCELLED"
                      ? "Cancelled"
                      : "Pending"
              }
              sx={{
              width:120,
              justifyContent:"flex-start",
                color:
                  params.value === "REJECTED"
                    ? "error.dark"
                    : params.value === "ACCEPTED"
                      ? "success.dark"
                      : params.value === "CANCELLED"
                        ? "primary.dark"
                        : "warning.main",

                "& .MuiChip-icon": {
                  color:
                    params.value === "REJECTED"
                      ? "error.dark"
                      : params.value === "ACCEPTED"
                        ? "success.dark"
                        : params.value === "CANCELLED"
                          ? "primary.dark"
                          : "warning.main",
                },
              }}
            />
          </Box>
        ),
      },
      {
        field: "action",
        headerName: "Action",
        flex: 0.5,
        minWidth: 130,
        filterable: false,
        sortable: false,
        disableColumnMenu: true,
        renderCell: (params) => {
          return (
            <Stack
              direction="row"
              spacing={1}
              justifyContent="left"
              alignItems="left"
              sx={{ height: "100%", pl: 1 }}
            >
              {permissions.view && (
                <Tooltip title="View">
                  <IconButton
                    color="primary"
                    onClick={() => handleViewClick(params.row)}
                  >
                    <VisibilityIcon />
                  </IconButton>
                </Tooltip>
              )}

              {params.row.reqStatus === "PENDING" && permissions.cancel && (
                <Tooltip title={"Cancel Request"}>
                  <IconButton
                    onClick={() => {
                      setConfirmDialog(true);
                      setRequestId(params.row.id);
                    }}
                  >
                    <CancelIcon fontSize="inherit" />
                  </IconButton>
                </Tooltip>
              )}
            </Stack>
          );
        },
      },
    ],
    [],
  );

  const filteredColumns = useMemo(() => {
    if (permissions.view || permissions.cancel) {
      return columns;
    }
    // Otherwise, filter out the column where field name is 'action'.
    else {
      return columns.filter((column) => column.field !== "action");
    }
  }, [permissions.cancel]);

  return (
    <>
      <Box sx={{ p:1 }}>
        <DataGrid
          rows={rows}
          loading={isLoading}
          columns={filteredColumns}
          disableRowSelectionOnClick
          pageSizeOptions={[5, 10, 25, 50]}
          initialState={{
            pagination: { paginationModel: { pageSize: 10, page: 0 } },
            // sorting: { sortModel: [{ field: "reqDate", sort: "asc" }] },
          }}
          getRowId={(row) => row.id}
          slots={{
            noRowsOverlay: CustomNoRowsOverlay,
          }}
           sx={{
          minHeight: 700,
          width: "100%",
         "& .MuiDataGrid-columnHeaders": {
          backgroundColor: "#f5f5f5 !important",
          fontWeight: 700,
          borderBottom: "2px solid rgba(88, 70, 159, 0.2)",
          position: 'sticky',
          top: 0,
          zIndex: 1,
          },
          }}
        />
      </Box>

      {/* View Dialog */}
      <ViewMyRequestDialog
        open={viewOpen}
        handleClose={() => setViewOpen(false)}
        data={viewData}
      />

      {/* Cancel Dialog */}
      <Dialog
        open={confirmDialog}
        onClose={() => {
          setConfirmDialog(false);
        }}
        maxWidth="sm"
        fullWidth
      >
        <DialogTitle sx={{ fontWeight: 600 }}>Cancel Request</DialogTitle>
        <DialogContent>
          <Typography sx={{ p: 1 }}>
            Are you sure you want to cancel this request Please confirm ?
          </Typography>
        </DialogContent>
        <DialogActions>
          <Button
            onClick={() => {
              setConfirmDialog(false);
            }}
            variant="outlined"
            sx=
          {{
            "&:hover":
            {
              color:"#fff",
            },
            }}
          >
            Cancel
          </Button>
          <Button
            onClick={handleCancelRequest}
            color="error"
            variant="contained"
          >
            Confirm
          </Button>
        </DialogActions>
      </Dialog>
    </>
  );
}
