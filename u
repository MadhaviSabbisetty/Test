/**
 * Generic communication event consumed by the Communication Service.
 *
 * Producer services publish this event to the
 * 'fincore.communication.generic' Kafka topic.
 *
 * The Communication Service is responsible for resolving recipients,
 * generating communication content, downloading attachments and
 * dispatching notifications through the requested channels.
 *
 * @author SHUBHANKAR
 * @since 2026-07
 */
@Data
@Builder
@NoArgsConstructor
@AllArgsConstructor
@JsonInclude(JsonInclude.Include.NON_EMPTY)
@JsonIgnoreProperties(ignoreUnknown = true)
public class GenericCommunicationEvent {

    private String eventId;

    private String traceId;

    private String correlationId;

    private String producerService;

    private String eventType;

    private String priority;

    private List<String> channels;

    private Recipients recipients;

    private String templateId;

    private Map<String, Object> payload;

    private List<AttachmentRef> attachments;

    private List<DeepLinkRef> deepLinks;

    private Map<String, String> metadata;

    /**
     * Recipient details supplied by the producer service.
     * Communication Service resolves UserIds and Roles into
     * Email and Mobile recipients.
     */
    @Data
    @Builder
    @NoArgsConstructor
    @AllArgsConstructor
    @JsonInclude(JsonInclude.Include.NON_EMPTY)
    public static class Recipients {

        private List<String> userIds;

        private List<String> roles;

        private List<String> emails;

        private List<String> mobiles;
    }

    /**
     * Reference to an attachment.
     *
     * Files are never sent through Kafka. The AttachmentService
     * downloads the file using this information.
     */
    @Data
    @Builder
    @NoArgsConstructor
    @AllArgsConstructor
    public static class AttachmentRef {

        private String attachmentId;

        private String attachmentType;

        private String fileName;
    }

    /**
     * Reference used by the DeepLinkGenerator to create
     * application-specific URLs.
     */
    @Data
    @Builder
    @NoArgsConstructor
    @AllArgsConstructor
    public static class DeepLinkRef {

        private String module;

        private String entityId;

        private String action;
    }
}

/**
 * <p>
 * Central orchestration component responsible for processing all
 * Generic Communication Events consumed from Kafka.
 * </p>
 *
 * <p>
 * Responsibilities:
 * <ol>
 * <li>Resolve Recipients.</li>
 * <li>Prepare Email Attachments.</li>
 * <li>Dispatch Email.</li>
 * <li>Dispatch SMS.</li>
 * </ol>
 *
 * <p>
 * This class contains no vendor specific implementation.
 * All communication logic is delegated to the respective services.
 * </p>
 *
 * @author Jailabdin [V1023042]
 * @since 2026-07
 */
@Slf4j
@Service
@RequiredArgsConstructor
public class CommunicationOrchestrator {

    private final RecipientResolver recipientResolver;

    private final AttachmentPreparationService attachmentPreparationService;

    private final EmailService emailService;

    private final SmsService smsService;

    /**
     * Executes the Generic Communication flow.
     *
     * @param event Generic Communication Event
     */
    public void process(GenericCommunicationEvent event) {

        log.info("Started processing Generic Communication Event. EventId={}",
                event.getEventId());

        /*
         * Step-1
         * Resolve Recipients.
         */
        List<ResolvedRecipient> recipients = recipientResolver.resolveRecipients(event.getRecipients());

        log.info("Resolved {} recipient(s).", recipients.size());

        /*
         * Step-2
         * Prepare Attachments.
         *
         * Downloads reports from Report Service,
         * creates ZIP if required,
         * returns prepared files.
         */
        PreparedAttachmentResponse attachmentResponse = null;

        if (event.getAttachments() != null
                && !event.getAttachments().isEmpty()) {

            log.info(
                    "Preparing {} attachment(s).",
                    event.getAttachments().size());

            AttachmentDownloadRequest request =
                    AttachmentDownloadRequest.builder()
                            .attachments(event.getAttachments())
                            .build();

            try{
                attachmentResponse =
                    attachmentPreparationService.prepareAttachments(request);

            }
            catch(Exception e){
                log.error("attachment preparation failes",e);
                throw new RuntimeException("Unable to prepare attachments",e);
            }
            log.info(
                    "Prepared {} attachment(s). Zip Created : {}",
                    attachmentResponse.getAttachmentCount(),
                    attachmentResponse.isZip());
        }

        /*
         * Step-3
         * Dispatch Communication.
         */
        try {

            for (String channel : event.getChannels()) {

                switch (channel.toUpperCase()) {

                    case "EMAIL" -> {

                        log.info("Dispatching Email Communication.");


                        // EmailResponse response =
                        //         emailService.sendGenericEmail(
                        //                 recipients,
                        //                 event.getTemplateId(),
                        //                 event.getPayload(),
                        //                 attachmentResponse);

                        // log.info(
                        //         "Email dispatch completed. Response : {}",
                        //         response);
                        log.info( "Email dispatch completed");
                    }

                    case "SMS" -> {

                        log.info("Dispatching SMS Communication.");

                        // SmsResponseDTO response =
                        //         smsService.sendGenericSms(
                        //                 recipients,
                        //                 event.getTemplateId(),
                        //                 event.getPayload());

                        // log.info(
                        //         "SMS dispatch completed. Response : {}",
                        //         response);
                        log.info( "SMS dispatch completed");
                    }

                    default ->
                            log.warn(
                                    "Unsupported Communication Channel : {}",
                                    channel);
                }
            }

        } finally {

            if (attachmentResponse != null) {

                attachmentPreparationService.deleteTemporaryFiles(
                        attachmentResponse.getFiles());
            }
        }

        log.info("Completed Generic Communication Event. EventId={}",
                event.getEventId());
    }
}
