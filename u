import * as React from "react";
import PropTypes from "prop-types";
import Tab from "@mui/material/Tab";
import CircleMasterTab1 from "./CircleMasterTab";
import CircleMasterTab2 from "./MyCircleRequestsTab";
import ConnectWithoutContactIcon from "@mui/icons-material/ConnectWithoutContact";
import PendingActionsIcon from "@mui/icons-material/PendingActions";

import {
  CircleMasterTabs,
  CircleTabContainer,
  CircleMastermainBox,
} from "./CircleMasterStyle";
import { Box, Paper } from "@mui/material";

function CustomTabPanel(props) {
  const { children, value, index, ...other } = props;

  return (
    <div
      role="tabpanel"
      hidden={value !== index}
      id={`simple-tabpanel-${index}`}
      aria-labelledby={`simple-tab-${index}`}
      {...other}
    >
      {value === index && <CircleMastermainBox>{children}</CircleMastermainBox>}
    </div>
  );
}

CustomTabPanel.propTypes = {
  children: PropTypes.node,
  index: PropTypes.number.isRequired,
  value: PropTypes.number.isRequired,
};

function a11yProps(index) {
  return {
    id: `simple-tab-${index}`,
    "aria-controls": `simple-tabpanel-${index}`,
  };
}

export default function CircleMaster() {
  const [value, setValue] = React.useState(0);

  const handleChange = (event, newValue) => {
    setValue(newValue);
  };

  return (
    <>
      <CircleTabContainer fullWidth={"true"}>
        <CircleMasterTabs
          value={value}
          onChange={handleChange}
          aria-label="basic tabs example"
          variant="fullWidth"
        >
          <Tab
            label="Manage Circles"
            icon={<ConnectWithoutContactIcon />}
            iconPosition="start"
            {...a11yProps(0)}
          />
          <Tab
            icon={<PendingActionsIcon />}
            iconPosition="start"
            label="My Requests"
            {...a11yProps(1)}
          />
        </CircleMasterTabs>
      </CircleTabContainer>
      <CustomTabPanel value={value} index={0}>
        <CircleMasterTab1 />
      </CustomTabPanel>
      <CustomTabPanel value={value} index={1}>
        <CircleMasterTab2 />
      </CustomTabPanel>
    </>
  );
}


