import {
  Box,
  Button,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  Stack,
  Typography,
  Tooltip,
  IconButton,
  Chip,
} from "@mui/material";
import React, { useEffect, useMemo, useState } from "react";
import InfoIcon from "@mui/icons-material/Info";
import useApi from "../../hooks/useApi";
import VisibilityIcon from "@mui/icons-material/Visibility";
import CheckCircleIcon from "@mui/icons-material/CheckCircle";
import PendingActionsIcon from "@mui/icons-material/PendingActions";
import BlockFlippedIcon from "@mui/icons-material/BlockFlipped";
import DateRangeIcon from "@mui/icons-material/DateRange";
import CancelIcon from "@mui/icons-material/Cancel";
import { useSelector } from "react-redux";
import CustomChip from "../../utils/CustomChip";
import GppBadIcon from "@mui/icons-material/GppBad";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import {
  StateMastertab2Chip,
  StateMastertab2DataGrid,
} from "./StateMasterStyle";

import ViewMyRequestDialog from "../common/ViewMyRequestDialog";
import {
  getPermissions,
  timeStampFormatter,
} from "../../utils/CommonUtilities";
function CustomNoRowsOverlay() {
  return (
    <Stack height="100%" alignItems="center" justifyContent="center">
      <InfoIcon sx={{ fontSize: 48, color: "text.secondary", mb: 2 }} />
      <Typography variant="h6">No State Requests Found</Typography>
      <Typography>You have not created any State requests.</Typography>
    </Stack>
  );
}

export default function MyStateRequestsTab() {
  const selectedMenuItem = useSelector((s) => s.menus.selectedMenuItem);
  const [rows, setRows] = useState([]);
  const [confirmDialog, setConfirmDialog] = useState(false);
  const permissions = getPermissions(selectedMenuItem);
  const [requestId, setRequestId] = useState(null);
  const [viewOpen, setViewOpen] = useState(false);
  const [viewData, setViewData] = useState(null);
  const { callApi } = useApi();
  const snackbar = useCustomSnackbar();

  const fetchData = async () => {
    const payload = { requestType: "STATE" };
    const response = await callApi("/CR/my-requests", payload, "POST");
    if (response) {
      const result = response.data?.map((row) => {
        let parsedPayload = {};
        parsedPayload = row.payload ? row.payload : {};
        parsedPayload = {
          ...parsedPayload,
          id: row.id,
          reqStatus: row.reqStatus,
          reqDate: row.reqDate,
        };

        return {
          ...parsedPayload,
        };
      });
      result.sort((a, b) => {
        if (a.reqStatus === "PENDING" && b.reqStatus !== "PENDING") return -1;
        if (a.reqStatus !== "PENDING" && b.reqStatus === "PENDING") return 1;
        return new Date(b.reqDate) - new Date(a.reqDate);
      });
      setRows(result);
    } else {
      setRows([]);
    }
  };

  useEffect(() => {
    fetchData();
  }, []);
  const handleCancelRequest = async () => {
    try {
      const payload = {
        requestId,
        remarks: "User canceled this Request",
      };

      const response = await callApi("/CR/cancel-request", payload, "PATCH");
      if (response?.success) {
        snackbar("Request Cancelled Successfully.", "success");
      } else {
        snackbar(
          response?.message
            ? response?.message
            : "Failed to process your cancel request, Kindly try again",
          "error",
        );
      }
    } catch (error) {
      console.error(error);
    } finally {
      fetchData();
      setConfirmDialog(false);
    }
  };
  const handleViewClick = (data) => {
    const { stateCode, stateName } = data;
    const showData = {
      stateCode,
      stateName,
    };

    data.showData = showData;
    setViewData(data);
    setViewOpen(true);
  };

  const columns = useMemo(
    () => [
      { field: "id", headerName: "Request Id", flex: 0.5, minWidth: 150 },
      {
        field: "stateCode",
        headerName: "State Code",
        flex: 0.5,
        minWidth: 150,
        sortable: true,
      },

      {
        field: "stateName",
        headerName: "State Name",
        flex: 2,
        minWidth: 150,
        sortable: true,
      },

      {
        field: "reqDate",
        headerName: "Date of Submition",
        flex: 1,
        minWidth: 200,
        sortable: true,
        // align: "center",
        // headerAlign: "center",
        renderCell: (params) => (
          <Box>
            <Chip
              sx={{ color: "text.secondary" }}
              icon={<DateRangeIcon />}
              label={params.value.split("T")[0]}
            />
          </Box>
        ),
      },
      {
        field: "reqStatus",
        headerName: "Status",
        flex: 1,
        minWidth: 150,
        // align: "center",
        // headerAlign: "center",
        filterable: false,
        sortable: false,
        disableColumnMenu: true,
        renderCell: (params) => (
          <Box
            sx={{
              color:
                params.value === "REJECTED"
                  ? "error.main"
                  : params.value === "ACCEPTED"
                    ? "success.dark"
                    : "warning.main",
              // fontWeight: "bold",
            }}
          >
            <CustomChip
              variant="outlined"
              icon={
                params.value === "REJECTED" ? (
                  <BlockFlippedIcon />
                ) : params.value === "ACCEPTED" ? (
                  <CheckCircleIcon />
                ) : params.value === "CANCELLED" ? (
                  <GppBadIcon />
                ) : (
                  <PendingActionsIcon />
                )
              }
              label={
                params.value === "REJECTED"
                  ? "Rejected"
                  : params.value === "ACCEPTED"
                    ? "Approved"
                    : params.value === "CANCELLED"
                      ? "Cancelled"
                      : "Pending"
              }
              sx={{
              width:120,
              justifyContent:"flex-start",
                color:
                  params.value === "REJECTED"
                    ? "error.dark"
                    : params.value === "ACCEPTED"
                      ? "success.dark"
                      : params.value === "CANCELLED"
                        ? "primary.dark"
                        : "warning.main",

                "& .MuiChip-icon": {
                  color:
                    params.value === "REJECTED"
                      ? "error.dark"
                      : params.value === "ACCEPTED"
                        ? "success.dark"
                        : params.value === "CANCELLED"
                          ? "primary.dark"
                          : "warning.main",
                },
              }}
            />
          </Box>
        ),
      },
      {
        field: "action",
        headerName: "Action",
        flex: 0.6,
        minWidth: 150,
        // align: "left",
        // headerAlign: "center",
        filterable: false,
        sortable: false,
        disableColumnMenu: true,
        renderCell: (params) => {
          return (
            <Stack
              direction="row"
              spacing={1}
              justifyContent="left"
              alignItems="left"
              sx={{ height: "100%" }}
            >
              {permissions.view && (
                <Tooltip title="View">
                  <IconButton
                    // color="primary"
                    onClick={() => handleViewClick(params.row)}
                  >
                    <VisibilityIcon />
                  </IconButton>
                </Tooltip>
              )}

              {params.row.reqStatus === "PENDING" && permissions.cancel && (
                <Tooltip title={"Cancel Request"}>
                  <IconButton
                    onClick={() => {
                      setConfirmDialog(true);
                      setRequestId(params.row.id);
                    }}
                  >
                    <CancelIcon fontSize="inherit" />
                  </IconButton>
                </Tooltip>
              )}
            </Stack>
          );
        },
      },
    ],
    [],
  );
  const filteredColumns = useMemo(() => {
    if (permissions.view || permissions.cancel) {
      return columns;
    }
    // Otherwise, filter out the column where field name is 'action'.
    else {
      return columns.filter((column) => column.field !== "action");
    }
  }, [columns, permissions]);

  return (
    <>
      <Box>
        <Box>
          <StateMastertab2DataGrid
            rows={rows}
            columns={filteredColumns}
            disableRowSelectionOnClick
            pageSizeOptions={[5, 10, 25, 50]}
            initialState={{
              pagination: { paginationModel: { pageSize: 10, page: 0 } },
              // sorting: { sortModel: [{ field: "stateCode", sort: "asc" }] },
            }}
            getRowId={(row) => row.stateCode}
            slots={{
              noRowsOverlay: CustomNoRowsOverlay,
            }}
          sx={{
          minHeight: 760,
          width: "100%",
         "& .MuiDataGrid-columnHeaders": {
          backgroundColor: "#f5f5f5 !important",
          fontWeight: 700,
          borderBottom: "2px solid rgba(88, 70, 159, 0.2)",
          position: 'sticky',
          top: 0,
          zIndex: 1,
          },
          }}
          />
        </Box>
      </Box>
      <ViewMyRequestDialog
        open={viewOpen}
        handleClose={() => setViewOpen(false)}
        data={viewData}
      />

      {/* Cancel Dialog */}
      <Dialog
        open={confirmDialog}
        onClose={() => {
          setConfirmDialog(false);
        }}
        maxWidth="sm"
        fullWidth
      >
        <DialogTitle sx={{ fontWeight: 600 }}>Cancel Request</DialogTitle>
        <DialogContent>
          <Typography sx={{ p: 1 }}>
            Are you sure you want to cancel this request Please confirm ?
          </Typography>
        </DialogContent>
        <DialogActions>
          <Button
            onClick={() => {
              setConfirmDialog(false);
            }}
            variant="outlined"
            sx=
          {{
            "&:hover":
            {
              color:"#fff",
            },
            }}
          >
            Cancel
          </Button>
          <Button
            onClick={handleCancelRequest}
            color="error"
            variant="contained"
          >
            Confirm
          </Button>
        </DialogActions>
      </Dialog>
    </>
  );
}
