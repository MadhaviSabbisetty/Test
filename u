finally {
    if (attachmentFile != null) {
        try {
            if (attachmentFile.exists()) {

                boolean deleted =
                        attachmentFile.delete();

                log.debug(
                        "Temporary attachment ZIP deleted for Event: {} | Result: {}",
                        eventId,
                        deleted);
            }
        } catch (Exception e) {
            log.error(
                    "Failed to delete temporary attachment ZIP for Event: {}",
                    eventId,
                    e);
        }
    }
}
