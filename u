public File downloadAttachments(
        AttachmentDownloadRequest request) {

    try {

        log.debug(
                "Initiating upstream request to Report Service: {}",
                reportServiceUrl + "/api/reports/attachment/download");

        return restClient.post()
                .uri(reportServiceUrl + "/api/reports/attachment/download")
                .header(
                        "X-Internal-Token",
                        reportServiceInternalToken)
                .body(request)
                .exchange((clientRequest, clientResponse) -> {

                    if (!clientResponse.getStatusCode().is2xxSuccessful()) {

                        throw new RuntimeException(
                                "Report Service returned HTTP status: "
                                        + clientResponse.getStatusCode());
                    }

                    File tempZip =
                            File.createTempFile(
                                    "attachments_",
                                    ".zip");

                    try (
                            InputStream inputStream =
                                    clientResponse.getBody();

                            OutputStream outputStream =
                                    new FileOutputStream(tempZip)
                    ) {

                        byte[] buffer = new byte[32 * 1024];

                        int bytesRead;

                        while ((bytesRead =
                                inputStream.read(buffer)) != -1) {

                            outputStream.write(
                                    buffer,
                                    0,
                                    bytesRead);
                        }

                        outputStream.flush();
                    }

                    log.info(
                            "Attachment ZIP received successfully: {}",
                            tempZip.getAbsolutePath());

                    return tempZip;
                });

    } catch (Exception ex) {

        log.error(
                "Upstream HTTP failure communicating with Report Service.",
                ex);

        throw new RuntimeException(
                "Unable to download attachments from Report Service",
                ex);
    }}

import java.io.File;
import java.io.FileOutputStream;
import java.io.InputStream;
import java.io.OutputStream;
