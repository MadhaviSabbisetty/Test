@PostMapping("/attachment/download")
public ResponseEntity<Resource> download(
        @RequestBody AttachmentDownloadRequest request)
        throws IOException {

    log.info(
            "Download request received from controller call to test download");

    File zipFile =
            attachmentPreparationService.prepareAttachments(
                    request.getAttachments());

    Resource resource =
            new FileSystemResource(zipFile);

    return ResponseEntity.ok()
            .header(
                    HttpHeaders.CONTENT_DISPOSITION,
                    "attachment; filename=\"attachments.zip\"")
            .contentType(
                    MediaType.APPLICATION_OCTET_STREAM)
            .contentLength(zipFile.length())
            .body(resource);
}

import java.io.File;

import org.springframework.core.io.FileSystemResource;
import org.springframework.core.io.Resource;
import org.springframework.http.HttpHeaders;
import org.springframework.http.MediaType;
import org.springframework.http.ResponseEntity;
