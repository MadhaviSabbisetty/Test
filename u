      case "CANCELLED": return { color: "error", icon: <Cancel />, label: "Cancelled" };
      default: return { color: "warning", icon: <PendingActions />, label: "Pending" };
    }
  };

  const generateProps = (value) => {
    let props = {};
    switch (value) {
      case "ADD": {
        props = {
          ...props,
          icon: <AddBoxIcon />,
          label: "Added",
          color: "success"
        }
        break;
      };
      case "DELETE": {
        props = {
          ...props,
          icon: <AutoDeleteIcon />,
          label: "Deleted",
          color: "error"
        }
        break;
      }
      case "STATUS": {
        props = {
          ...props,
          icon: <ChangeCircleSharpIcon />,
          label: "Status-change",
          color: "info"
        }
        break;
      }
      case "UPDATE": {
        props = {
          ...props,
          icon: <EditDocumentIcon />,
          label: "Modified",
          color: "info"
        }
        break;
      }

      case "ROLLBACK": {
        props = {
          ...props,
          icon: <RestoreIcon />,
          label: "Rollback",
          color: "success"
        }
        break;
      }
    }
    return props;
  }

  const allColumns = useMemo(() => [
    { field: "reportId", headerName: "Report Id", flex: 0.5 },
    { field: "reportName", headerName: "Report Name", flex: 1.2 },
    {
      field: "changeType", headerName: "Request Type", flex: 0.6,
      renderCell: (p) => (
        <CustomChip
          // icon={p.value === "ADD" ? <AddBoxIcon /> : p.value === "DELETE" ? <AutoDeleteIcon /> : <EditDocumentIcon />}
          // label={p.value === "ADD" ? "Added" : p.value === "DELETE" ? "Deleted" : "Modified"}
          // color={p.value === "ADD" ? "success" : p.value === "DELETE" ? "error" : "info"}
          {...generateProps(p.value)}
          size="small" variant="outlined"
        />
      ),
    },
    {
      field: "reqStatus", headerName: "Status", flex: 0.8,
      renderCell: (p) => {
        const { color, icon, label } = getStatusDetails(p.value);
        return <CustomChip icon={icon} size="small" color={color} label={label} variant="outlined" />;
      },
    },
    {
      field: "reqDate", headerName: "Submitted Date", flex: 1,
      renderCell: (p) => <Typography variant="body2">{timeStampFormatter(p.value)}</Typography>,
    },
    {
      field: "actions", headerName: "Actions", flex: 0.5,
      renderCell: (p) => (
        <Stack direction="row" spacing={1} alignItems="center" justifyContent="flex-start">
          <Tooltip title="View Request Details">
            <IconButton color="primary" onClick={() => handleViewClick(p.row)}>
              <Visibility />
            </IconButton>
            {/* <IconButton color="primary" onClick={() => handleViewClick(p.row)}>
              <Visibility />
            </IconButton> */}
          </Tooltip>
          {p.row.reqStatus === "PENDING" &&
            <Tooltip title="Cancel Request">
              <IconButton color="primary" onClick={() => { setOpenRemarks(true), setSelectedRequestId(p.row.id) }}>
                <CancelRounded />
              </IconButton>
            </Tooltip>
          }
          {((p.row.changeType === "ADD" || p.row.changeType === "UPDATE") && (p.row.reqStatus === "PENDING" || p.row.reqStatus === "REJECTED")) &&
            <Tooltip title="Modify Request">
              {/* <IconButton color="primary" onClick={() => handleEditClick(p.row)}> */}
              <IconButton color="primary" onClick={() => editHandler(p.row.id)}>
                <EditSquare />
              </IconButton>
            </Tooltip>
          }
        </Stack>
      ),
    },
  ], []);

  return (
    <>
      <Box>
        <TemplateRequestAnalytics data={rows} />
        <DataGrid
          rows={rows} columns={allColumns} loading={dataGridLoading} disableRowSelectionOnClick
          pageSizeOptions={[5, 10, 25, 50]}
          initialState={{ pagination: { paginationModel: { pageSize: 5 } }, sorting: { sortModel: [{ field: "reqDate", sort: "desc" }] } }}
          getRowId={(row) => row.id} sx={styles.dataGrid}
          slots={{
            noRowsOverlay: () => (
              <Stack height="100%" alignItems="center" justifyContent="center">
                <InfoIcon sx={{ fontSize: 48, color: "text.secondary", mb: 2 }} />
                <Typography variant="h6">No Requests Found</Typography>
                <Typography variant="body2" color="text.secondary">You have not created any requests yet.</Typography>
              </Stack>
            ),
          }}
        />

        <ViewRequestDialog open={viewOpen} handleClose={() => { setViewOpen(false); setViewData(null); }} data={viewData} />
        <RemarksDialog
          open={openRemarks}
          onClose={() => setOpenRemarks(false)}
          onConfirm={handleCancelClick}
          saving={loading}
          title={"Cancel Request"}
          submitLabel={"Cancel Request"}
        />
        {/* <CompareTemplateDialog open={compareOpen} requestId={selectedRequestId} onClose={() => { setCompareOpen(false); setSelectedRequestId(null); }} /> */}
      </Box>
      {/* <Dialog
        open={edit}
        onClose={() => { setEdit(false), setSelectedRequestId(null) }}
        fullWidth
        maxWidth="xl">
        <DialogContent>
          <ReportBuilderComponent
            templateId={selectedTemplateId}
            onBack={() => { setEdit(false), setSelectedRequestId(null) }}
            modify={true}
          />
        </DialogContent>
        <DialogActions>
          <Button onClick={() => { setEdit(false), setSelectedRequestId(null) }}>Cancel</Button>
        </DialogActions>
      </Dialog> */}
    </>
  );
}
