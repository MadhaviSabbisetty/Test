                        <Grid item size={{ xl: 2, lg: 2.8 }}>
                          <Tooltip title="" placement="top-start">
                            <TextField
                              label="Amount *"
                              type="text"
                              value={row.amount}
                              InputLabelProps={{ shrink: true }}
                              fullWidth
                              placeholder="0.0000"
                              inputProps={{ style: { textAlign: "right" } }}
                              // Checks if input is not empty AND equals zero numerically
                              error={row.amount !== "" && parseFloat(row.amount) === 0}
                              onChange={(e) => {
                                const rawVal = e.target.value;
                                if (/[^0-9.]/.test(rawVal)) {
                                  showSnackBar("Only numbers and decimal point are allowed.", "warning"); return;
                                }
                                if (rawVal === "" || /^\d{0,16}(\.\d{0,4})?$/.test(rawVal)) {
                                  handleRowChange(row.id, "amount", rawVal);
                                }
                                else {
                                  showSnackBar("Exceeded maximum digits or decimal places.", "warning");
                                }
                              }}

                              onPaste={(e) => { e.preventDefault(); showSnackBar("Pasting is not allowed here.", "warning"); }}
                              onCopy={(e) => e.preventDefault()}
                            />
                          </Tooltip>
                          <Typography
                            variant="caption"
                            // Turns the caption red if the error state is triggered
                            sx={{ ...jpStyles.captionText, color: (row.amount !== "" && parseFloat(row.amount) === 0) ? 'error.main' : 'text.secondary' }}
                          >
                            {(row.amount !== "" && parseFloat(row.amount) === 0) ? "Amount cannot be zero" : "Max 16 digits, 4 decimals"}
                          </Typography>
                        </Grid>


                        {/* Txn Type */}
                        <Grid item size={{ xl: 1, lg: 1.5 }}>
                          <Tooltip title="" placement="top-start">
                            <TextField
                              select
                              label="Type *"
                              value={row.txnType}
                              fullWidth
                              InputLabelProps={{ shrink: true }}
                              onChange={(e) => handleRowChange(row.id, "txnType", e.target.value)}
                              onPaste={(e) => { e.preventDefault(); showSnackBar("Pasting is not allowed here.", "warning"); }}
                              onCopy={(e) => e.preventDefault()}
                              onKeyDown={(e) => {
                                // Intercept keystrokes to auto-select
                                const key = e.key.toLowerCase();
                                if (key === 'd') {
                                  e.preventDefault(); // Prevents standard browser behavior
                                  handleRowChange(row.id, "txnType", "Debit");
                                } else if (key === 'c') {
                                  e.preventDefault();
                                  handleRowChange(row.id, "txnType", "Credit");
                                }
                              }}
                              SelectProps={{
                                displayEmpty: true,
                                renderValue: (selected) => !selected ? <span style={{ color: 'gray', opacity: 0.8 }}>Type</span> : selected,
                                MenuProps: {
                                  // The marginTop guarantees it clears the tooltip completely
                                  PaperProps: { style: { maxHeight: 250, marginTop: '8px' } },
                                  anchorOrigin: { vertical: "bottom", horizontal: "left" },
                                  transformOrigin: { vertical: "top", horizontal: "left" }
                                }
                              }}
                            >
                              <MenuItem value="Credit">Credit</MenuItem>
                              <MenuItem value="Debit">Debit</MenuItem>

                            </TextField>
                          </Tooltip>
                        </Grid>

                        {/* Remarks (Individual) */}
                        <Grid item size={{ xl: 2.2, lg: 3.2 }}>
                          <Tooltip title="" placement="top-start">
                            <TextField
                              label="Remarks *"
                              value={row.remarks}
                              InputLabelProps={{ shrink: true }}
                              onPaste={(e) => { e.preventDefault(); showSnackBar("Pasting is not allowed here.", "warning"); }}
                              onCopy={(e) => e.preventDefault()}
                              placeholder="Enter remarks..."
                              fullWidth
                              inputProps={{ minLength: 2, maxLength: 30 }}
                              disabled={checked}
                              error={row.remarks.length > 0 && !isRowRemarksValid(row.remarks)}
                              onChange={(e) => {
                                const val = filterAndWarn(e.target.value);
                                if (val.length <= 30) {
                                  handleRowChange(row.id, "remarks", val);
                                }
                              }}
                              helperText="Allowed 2-30 chars: Alphanumeric and single spaces only"
                            />
                          </Tooltip>
                        </Grid>
                        {/* Product Code */}
                        <Grid item
                          // xs={12} md={2}
                          size={{ xl: 1, lg: 1.5 }} >
                          <Tooltip title="" placement="top-start">
                            <TextField label="Product Code" value={row.productCode} InputLabelProps={{ shrink: true }} placeholder="Product Code.." fullWidth inputProps={{ maxLength: 8 }} onChange={(e) => { const rawVal = e.target.value; const cleanVal = rawVal.replace(/[^0-9]/g, ""); if (rawVal !== cleanVal) { showSnackBar("Only digits are allowed.", "warning"); } if (cleanVal.length <= 8) { handleRowChange(row.id, "productCode", cleanVal); } }} />
                          </Tooltip>
                          <Typography variant="caption" sx={jpStyles.captionText}>Max 8 digits</Typography>
                        </Grid>

                        {/* Delete Action */}
                        <Grid item size={{ xl: 0.5, lg: 0.8 }} sx={{ textAlign: "center", display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
                          {/* ONLY ALLOW DELETION IF THERE ARE MORE THAN 2 ROWS */}
                          {rows.length > 2 && (
                            <Tooltip title="Delete row" arrow>
                              <IconButton
                                onClick={() => handleDeleteRow(row.id)}
                                aria-label="delete row"
                                sx={jpStyles.deleteIconButton}
                              >
                                <DeleteIcon />
                              </IconButton>
                            </Tooltip>
                          )}
                        </Grid>
                      </Grid> {/* <--- THIS IS THE MISSING TAG THAT CRASHED REACT! */}

                      {index < rows.length - 1 && (<Box sx={jpStyles.rowDivider} />)}
                    </React.Fragment>
                  );
                })}

                {/* ACTION BUTTONS */}
                <Box sx={jpStyles.actionButtonsWrapper}>
                  <Button variant="outlined" startIcon={<ArrowBackIcon />} onClick={handleBack}>
                    Previous
                  </Button>

                  <Box sx={{ display: "flex", gap: 2 }}>
                    {/* NEW RESET BUTTON */}
                    <Button variant="outlined" onClick={handleResetRows} 
                    sx=
                    {{
                      "&:hover":
                      {
                        color:"#fff",
                      },
                      }}>
                      Reset
                    </Button>

                    <Button variant="contained" startIcon={<AddIcon />} onClick={handleAddRow}>
                      Add Row
                    </Button>

                    <Tooltip title={rows.length < 2 ? "Minimum 2 rows required" : "Submit batch"} placement="top">
                      <span>
                        <Button
                          variant="contained"
                          color="success"
                          onClick={handleValidateClick}
                          disabled={isSubmitting || !isCommonRemarksValid(commonBatchRemarks) || !isFormReadyToSubmit}
                        >
                          {isSubmitting ? <CircularProgress size={24} color="inherit" /> : "Validate"}
                        </Button>
                      </span>
                    </Tooltip>
                  </Box>
                </Box>
              </Box>
            </Box>
          </Box>
        )
      }

      {/* EXTERNAL STEP 2: BULK UPLOAD EXCEL COMPONENT */}
      {
        activeStep === 2 && entryMethod === "BULK" && (
          <JournalBulkUpload
            selectedVoucher={selectedVoucher}
            onBack={handleBack}
            onReset={handleResetWizard}
            // Triggered automatically when Bulk Excel completes
            onSuccessSubmit={(batchId) => {
              setSubmittedBatchId(batchId);
              setActiveStep(3);
            }}
          />
        )
      }

      {/* NEW STEP 3: POST-SUBMISSION SUCCESS & SCHEDULING SCREEN */}
      {
        activeStep === 3 && (
          <Box sx={{ p: 4, display: 'flex', justifyContent: 'center' }}>
            <Paper elevation={3} sx={{ p: 4, borderRadius: 3, maxWidth: 650, width: '100%', textAlign: 'center' }}>
              <Typography variant="h6" fontWeight="bold" color="text.primary" gutterBottom>
                Set Execution Preference
              </Typography>
              <Typography variant="h5" fontWeight="bold" gutterBottom>
                Your batch is validated and ready to submit.
              </Typography>

              <Divider sx={{ my: 3 }} />


              <Typography variant="body2" color="text.secondary" sx={{ mb: 4 }}>
                Please select how you want this batch to be executed after the final approval.
              </Typography>

              {/* SELECTION CARDS */}
              <Grid container spacing={3} sx={{ mb: 4, textAlign: 'left' }}>
                <Grid item xs={12} sm={6}>
                  <Box
                    onClick={() => setRoutingChoice("IMMEDIATE")}
                    sx={{
                      p: 2.5, border: "2px solid", borderRadius: 2, cursor: "pointer", transition: "all 0.2s ease",
                      borderColor: routingChoice === "IMMEDIATE" ? "primary.main" : "divider",
                      backgroundColor: routingChoice === "IMMEDIATE" ? "primary.50" : "transparent",
                      display: "flex", flexDirection: "column", alignItems: "center", gap: 1, textAlign: "center",
                      "&:hover": { borderColor: routingChoice !== "IMMEDIATE" ? "primary.light" : "primary.main", transform: "translateY(-2px)", boxShadow: 2 }
                    }}
                  >
                    <BoltIcon color={routingChoice === "IMMEDIATE" ? "primary" : "action"} sx={{ fontSize: 36 }} />
                    <Typography variant="subtitle1" fontWeight="bold" color={routingChoice === "IMMEDIATE" ? "primary.main" : "text.primary"}>
                      Execute Immediately
                    </Typography>
                    <Typography variant="caption" color="text.secondary">
                      Post automatically upon final approval
                    </Typography>
                  </Box>
                </Grid>
                <Grid item xs={12} sm={6}>
                  <Box
                    onClick={() => {
                      setRoutingChoice("SCHEDULE");
                      setScheduledTime(dayjs().add(30, 'minute').startOf('minute'));
                    }}
                    sx={{
                      p: 2.5, border: "2px solid", borderRadius: 2, cursor: "pointer", transition: "all 0.2s ease",
                      borderColor: routingChoice === "SCHEDULE" ? "primary.main" : "divider",
                      backgroundColor: routingChoice === "SCHEDULE" ? "primary.50" : "transparent",
                      display: "flex", flexDirection: "column", alignItems: "center", gap: 1, textAlign: "center",
                      "&:hover": { borderColor: routingChoice !== "SCHEDULE" ? "primary.light" : "primary.main", transform: "translateY(-2px)", boxShadow: 2 }
                    }}
                  >
                    <ScheduleIcon color={routingChoice === "SCHEDULE" ? "primary" : "action"} sx={{ fontSize: 36 }} />
                    <Typography variant="subtitle1" fontWeight="bold" color={routingChoice === "SCHEDULE" ? "primary.main" : "text.primary"}>
                      Schedule Execution
                    </Typography>
                    <Typography variant="caption" color="text.secondary">
                      Delay posting to a future time today
                    </Typography>
                  </Box>
                </Grid>
              </Grid>

              {/* SMOOTH COLLAPSE FOR TIMEPICKER */}
              <Collapse in={routingChoice === "SCHEDULE"}>
                <Box sx={{ p: 3, mb: 4, border: '1px solid', borderColor: 'divider', borderRadius: 2 }}>
                  <Typography variant="subtitle2" fontWeight="bold" align="left" gutterBottom>
                    Select Time
                  </Typography>
                  <LocalizationProvider dateAdapter={AdapterDayjs}>
                    <TimePicker
                      value={scheduledTime}
                      onChange={(newValue) => setScheduledTime(newValue)}
                      // --- THE FIX IS HERE ---
                      // .startOf('minute') forces seconds to :00 so it perfectly matches the UI selection
                      minTime={dayjs().add(30, 'minute').startOf('minute')}
                      maxTime={dayjs().endOf('day')}
                      timeSteps={{ minutes: 1 }}
                      slotProps={{
                        textField: {
                          size: 'medium',
                          fullWidth: true,
                          sx: { caretColor: 'transparent' },
                          helperText: "Execution must be scheduled at least 30 minutes from now, before 11:59 PM today.",
                          onKeyDown: (e) => e.preventDefault(),
                          onPaste: (e) => e.preventDefault(),
                          inputProps: { readOnly: true }
                        }
                      }}
                    />
                  </LocalizationProvider>
                </Box>
              </Collapse>

              {/* FINAL SUBMIT BUTTON */}
              <Button
                variant="contained"
                size="large"
                fullWidth
                disabled={!routingChoice || (routingChoice === 'SCHEDULE' && !scheduledTime) || isFinalizing}
                onClick={handleFinalizeRouting}
                sx={{ py: 1.5, fontSize: '1.1rem', fontWeight: 'bold', borderRadius: 2 }}
              >
                {isFinalizing ? <CircularProgress size={28} color="inherit" /> : "Submit"}
              </Button>

            </Paper>
          </Box>
        )
      }

    </Paper >

  );
}
