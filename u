import React, { useState } from "react";
import { DataGrid } from "@mui/x-data-grid";
import {
  Box,
  Paper,
  IconButton,
  Tooltip,
  Stack,
} from "@mui/material";

import VisibilityIcon from "@mui/icons-material/Visibility";

import TemplateViewDialog from "../../common/TemplateViewDialog";

const TemplateTable = ({ data }) => {
  const [selectedTemplate, setSelectedTemplate] = useState(null);
  const [openView, setOpenView] = useState(false);

  const closeAllDialogs = () => {
    setOpenView(false);
    setSelectedTemplate(null);
  };

  const columns = [
    {
      field: "templateId",
      headerName: "Template ID",
      width: 130,
      headerClassName: "table-header",
      renderCell: (params) => (
        <Box
          sx={{
            ml: 1,
            fontWeight: 500,
          }}
        >
          {params.value}
        </Box>
      ),
    },

    {
      field: "reportId",
      headerName: "Report ID",
      width: 130,
      headerClassName: "table-header",
      renderCell: (params) => (
        <Box
          sx={{
            fontWeight: 500,
          }}
        >
          {params.value}
        </Box>
      ),
    },

    {
      field: "templateName",
      headerName: "Report Name",
      flex: 1,
      minWidth: 310,
      headerClassName: "table-header",
      renderCell: (params) => (
        <Box
          sx={{
            fontWeight: 600,
          }}
        >
          {params.value}
        </Box>
      ),
    },

    {
      field: "description",
      headerName: "Description",
      flex: 1.5,
      minWidth: 300,
      headerClassName: "table-header",
      renderCell: (params) => (
        <Box
          sx={{
            overflow: "hidden",
            textOverflow: "ellipsis",
            whiteSpace: "nowrap",
          }}
        >
          {params.value || "—"}
        </Box>
      ),
    },

    {
      field: "actions",
      headerName: "Actions123",
      width: 180,
      sortable: false,
      headerClassName: "table-header",

      renderCell: (params) => (
        <Stack
          direction="row"
          spacing={1}
          justifyContent="center"
          alignItems="center"
          sx={{
            height: "100%",
          }}
        >
          <Tooltip title="Quick View">
            <IconButton
              size="small"
              onClick={() => {
                setSelectedTemplate(params.row);
                setOpenView(true);
              }}
              sx={{
                width: 42,
                height: 42,
                minWidth: 42,
                minHeight: 42,
                padding: 0,
                borderRadius: "50%",
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
              }}
            >
              <VisibilityIcon sx={{ fontSize: 24 }} />
            </IconButton>
          </Tooltip>
        </Stack>
      ),
    },
  ];

  return (
    <Paper
      elevation={0}
      sx={{
        display: "flex",
        flexDirection: "column",

        width: "100%",
        height: "calc(100vh - 140px)",
        maxHeight: "calc(100vh - 140px)",
        minHeight: 0,

        p: 2,
        boxSizing: "border-box",

        borderRadius: 2,
        overflow: "hidden",
        bgcolor: "background.paper",
      }}
    >
      <Box
        sx={{
          width: "100%",
          height: "100%",
          flex: 1,
          minHeight: 0,

          display: "flex",
          flexDirection: "column",

          overflow: "hidden",
        }}
      >
        <DataGrid
          rows={data}
          columns={columns}
          getRowId={(row) => row.templateId}
          initialState={{
            pagination: {
              paginationModel: {
                pageSize: 10,
                page: 0,
              },
            },
          }}
          pageSizeOptions={[5, 10, 25, 50]}
          disableRowSelectionOnClick
          sx={{
            width: "100%",
            height: "100%",
            flex: 1,
            minHeight: 0,

            border: "none",

            "& .MuiDataGrid-columnHeaders": {
              backgroundColor: "#f5f5f5 !important",
              fontWeight: 700,
              borderBottom:
                "2px solid rgba(88, 70, 159, 0.2)",
              position: "sticky",
              top: 0,
              zIndex: 1,
            },

            "& .MuiDataGrid-virtualScroller": {
              overflowY: "hidden",
            },

            "& .MuiDataGrid-main": {
              minHeight: 0,
            },
          }}
        />

        {selectedTemplate && (
          <TemplateViewDialog
            open={openView}
            handleClose={closeAllDialogs}
            template={selectedTemplate}
          />
        )}
      </Box>
    </Paper>
  );
};

export default TemplateTable;
