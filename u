public File downloadAttachments(
        AttachmentDownloadRequest request) {

    File zipFile = null;

    try {

        log.debug(
                "Initiating upstream request to Report Service: {}",
                reportServiceUrl +
                        "/api/reports/attachment/download");

        zipFile = File.createTempFile(
                "attachments_",
                ".zip");

        File finalZipFile = zipFile;

        restClient.post()
                .uri(
                        reportServiceUrl +
                                "/api/reports/attachment/download")
                .header(
                        "X-Internal-Token",
                        reportServiceInternalToken)
                .body(request)
                .exchange((clientRequest, clientResponse) -> {

                    if (!clientResponse
                            .getStatusCode()
                            .is2xxSuccessful()) {

                        throw new RuntimeException(
                                "Report Service returned HTTP status: "
                                        + clientResponse.getStatusCode());
                    }

                    try (InputStream inputStream =
                                 clientResponse.getBody();
                         OutputStream outputStream =
                                 new FileOutputStream(finalZipFile)) {

                        byte[] buffer =
                                new byte[32 * 1024];

                        int bytesRead;

                        while ((bytesRead =
                                inputStream.read(buffer)) != -1) {

                            outputStream.write(
                                    buffer,
                                    0,
                                    bytesRead);
                        }
                    }

                    return null;
                });

        log.info(
                "Attachment ZIP downloaded successfully: {}",
                zipFile.getAbsolutePath());

        return zipFile;

    } catch (Exception ex) {

        if (zipFile != null && zipFile.exists()) {
            zipFile.delete();
        }

        log.error(
                "Unable to download attachments from Report Service",
                ex);

        throw new RuntimeException(
                "Unable to download attachments from Report Service",
                ex);
    }
}



import java.io.File;
import java.io.FileOutputStream;
import java.io.InputStream;
import java.io.OutputStream;
