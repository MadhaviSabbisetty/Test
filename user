log.info("ZIP required for attachments.");

File zipFile = zipService.createZip(response.getAttachments());

DownloadedAttachment zipAttachment = new DownloadedAttachment();

zipAttachment.setFileName("attachments.zip");
zipAttachment.setContentType("application/zip");
zipAttachment.setFileSize(zipFile.length());

byte[] zipBytes = Files.readAllBytes(zipFile.toPath());

zipAttachment.setBase64(
        Base64.getEncoder().encodeToString(zipBytes));

AttachmentDownloadResponse zipResponse =
        new AttachmentDownloadResponse();

zipResponse.setAttachments(
        Collections.singletonList(zipAttachment));

return zipResponse;
