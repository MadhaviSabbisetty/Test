// src/pages/DashboardPage.jsx
import React, { useEffect, useState } from "react";
import { Box, Card, CardContent, Typography, Stack } from "@mui/material";
import Grid from "@mui/material/Grid";
import LeaderboardIcon from "@mui/icons-material/Leaderboard";
import DataExplorationIcon from "@mui/icons-material/DataExploration";
import DonutSmallIcon from "@mui/icons-material/DonutSmall";
import AutoGraphIcon from "@mui/icons-material/AutoGraph";
import InsertChartIcon from "@mui/icons-material/InsertChart";
import {
  ResponsiveContainer,
  BarChart,
  Bar,
  XAxis,
  YAxis,
  Tooltip,
  Legend,
  CartesianGrid,
} from "recharts";
import useApi from "../../hooks/useApi";
import { DashboardHead } from "./components/DashboardHead";
import DashboardCustomChart from "./components/DashboardCustomChart";
import { DashboardRecentActivity } from "./components/DashboardRecentActivity";
import { DashboardAnnouncements } from "./components/DashboardAnnouncements";
import DashboardFrequencyStats from "./components/DashboardFrequencyStats";
import { toPascalKebabCase } from "../../utils/CommonUtilities";

const COLOR_SET_A = [
  "hsl(220, 45%, 75%)", // light blue
  "hsl(220, 45%, 55%)",
  "hsl(220, 45%, 40%)",
  "hsl(220, 45%, 25%)", // deep navy blue
];

const COLOR_SET_B = [
  "hsl(145, 45%, 75%)", // light green
  "hsl(145, 45%, 55%)",
  "hsl(145, 45%, 40%)",
  "hsl(145, 45%, 25%)", // deep forest green
];

const COLOR_SET_C = [
  "hsl(220, 25%, 65%)",
  "hsl(220, 25%, 45%)",
  "hsl(220, 25%, 30%)",
  "hsl(220, 25%, 20%)",
];

const COLOR_SET_D = [
  "hsl(30, 70%, 75%)", // light orange
  "hsl(30, 70%, 55%)",
  "hsl(30, 70%, 40%)",
  "hsl(30, 70%, 25%)", // deep burnt orange
];

const COLOR_SET_E = [
  "hsl(215, 15%, 80%)", // light grey-blue
  "hsl(215, 15%, 60%)",
  "hsl(215, 15%, 40%)",
  "hsl(215, 15%, 25%)", // deep slate
];
const COLOR_SET_F = [
  "hsl(0, 60%, 75%)", // soft red
  "hsl(0, 60%, 55%)",
  "hsl(0, 60%, 40%)",
  "hsl(0, 60%, 25%)", // deep red
];

function mapLabelMap(key) {
  const labelMap = {
    BRANCH: "Branch",
    CURRENCY: "Currency",
    ROLE_MANAGEMENT: "Role Management",
    SEGMENT: "Segment",
    CGL: "CGL",
    STATE: "State",
    USER_MANAGEMENT: "User Management",
    CALENDER: "Calendar",
    CIRCLE: "Circle",
  };
  return labelMap[key] || key;
}

const DashboardPage = () => {
  const { callApi } = useApi();
  const [rawData, setRawData] = useState(null);

  useEffect(() => {
    const load = async () => {
      try {
        const res = await callApi("/DS/dashboard/init", null, "GET");
        const payload = res?.data ? res.data : res;
        if (payload?.success || payload?.stats) {
          const data = payload.data ? payload.data : payload;
          setRawData(data);
        }
      } catch (e) {
        console.error("Failed to load dashboard", e);
      }
    };
    load();
  }, [callApi]);

  const stats = rawData?.stats || {};

  // transform functions
  const buildPieFromDetailObj = (detailObj) =>
    Object.entries(detailObj || {}).map(([k, v]) => ({
      label: mapLabelMap(k),
      value: Number(v) || 0,
    }));

  const myPendingPie = buildPieFromDetailObj(stats.myPendingDetails);
  const myApprovedPie = buildPieFromDetailObj(stats.myApprovedDetails);
  const myRejectedPie = buildPieFromDetailObj(stats.myRejectedDetails);
  const pendingForMePie = buildPieFromDetailObj(stats.pendingForMeDetails);

  // bar data: Pending vs Approved vs Rejected (module-wise)
  const allModules = new Set([
    ...Object.keys(stats.myPendingDetails || {}),
    ...Object.keys(stats.myApprovedDetails || {}),
    ...Object.keys(stats.myRejectedDetails || {}),
  ]);
  const statusByModule = Array.from(allModules).map((m) => ({
    module: toPascalKebabCase(mapLabelMap(m) || ""),
    pending: stats.myPendingDetails?.[m] || 0,
    approved: stats.myApprovedDetails?.[m] || 0,
    rejected: stats.myRejectedDetails?.[m] || 0,
  }));

  console.log("statusByModule", statusByModule);

  return (
    <Box p={3}>
      {/* Rows 1 & 2 */}
      <DashboardHead />

      {/* Row 3: Module-wise bar chart */}
      <Grid container spacing={2} mb={3}>
        <Grid size={{ xs: 12 }}>
          <Card variant="outlined" sx={{ borderRadius: 3 }}>
            <CardContent>
              <Typography
                variant="subtitle2"
                fontWeight={600}
                mb={1}
              ></Typography>

              <Stack direction="row" spacing={1} alignItems="center" mb={1}>
                <Box
                  sx={{
                    width: 44,
                    height: 44,
                    borderRadius: 2,
                    bgcolor: "rgba(0,0,0,0.06)",
                    display: "flex",
                    alignItems: "center",
                    justifyContent: "center",
                  }}
                >
                  <LeaderboardIcon />
                </Box>

                <Typography variant="subtitle1" fontWeight={700}>
                  Pending vs Approved vs Rejected (Module-wise)
                </Typography>
              </Stack>

              <Box sx={{ width: "100%", height: 320 }}>
                <ResponsiveContainer width="100%" height="100%">
                  <BarChart data={statusByModule}>
                    <CartesianGrid
                      strokeDasharray="3 3"
                      stroke="rgba(255,255,255,0.3)"
                    />
                    <XAxis
                      dataKey="module"
                      // stroke="white"
                      // fontSize={10}
                      tickMargin={4}
                    />
                    <YAxis fontSize={10} />
                    <Tooltip />
                    <Legend />
                    <Bar dataKey="pending" name="Pending" fill="#6a5acd" />
                    <Bar dataKey="approved" name="Approved" fill="#20b2aa" />
                    <Bar dataKey="rejected" name="Rejected" fill="#d87093" />
                  </BarChart>
                </ResponsiveContainer>
              </Box>
            </CardContent>
          </Card>
        </Grid>
      </Grid>

      {/* Row 4: Four small charts using DashboardCustomChart */}
      <Grid container spacing={2} mb={3}>
        <Grid size={{ xs: 12, md: 6 }}>
          <DashboardCustomChart
            title="My Approved (Module-wise)"
            icon={<DataExplorationIcon />}
            seriesData={myApprovedPie}
            colors={COLOR_SET_B}
          />
        </Grid>

        <Grid size={{ xs: 12, md: 6 }}>
          <DashboardCustomChart
            title="My Rejected (Module-wise)"
            icon={<InsertChartIcon />}
            seriesData={myRejectedPie}
            colors={COLOR_SET_F}
          />
        </Grid>
        <Grid size={{ xs: 12, md: 6 }}>
          <DashboardCustomChart
            title="My Pending (Module-wise)"
            icon={<DonutSmallIcon />}
            seriesData={myPendingPie}
            colors={COLOR_SET_D}
          />
        </Grid>

        <Grid size={{ xs: 12, md: 6 }}>
          <DashboardCustomChart
            title="Pending For My Approval (Module-wise)"
            icon={<AutoGraphIcon />}
            seriesData={pendingForMePie}
            colors={COLOR_SET_C}
          />
        </Grid>
      </Grid>

      <Grid container spacing={2} mb={3}>
        {/* Row 5:  Announcements */}
        <Grid item size={{ xs: 12, md: 6 }}>
          <DashboardAnnouncements announcements={rawData?.announcements} />
        </Grid>

        {/* Row 6: Recent Activity */}
        <Grid item size={{ xs: 12, md: 6 }}>
          <DashboardRecentActivity recentActivity={rawData?.recentActivity} />
        </Grid>
      </Grid>

      {/* Row 7: Frequency of request status */}
      <Grid container spacing={2} mb={3}>
        <Grid item size={{ xs: 12 }}>
          <DashboardFrequencyStats frequencyStats={rawData?.frequencyStats} />
        </Grid>
      </Grid>
    </Box>
  );
};

export default DashboardPage;
