import React, { useState, useEffect } from "react";
import { Autocomplete, TextField } from "@mui/material";
import { debounce } from "lodash";
import useApi from "../../hooks/useApi";

const hasFlag = (reason, flag) => {
  if (!reason) return false;
  return reason
    .split(",")
    .map((x) => x.trim())
    .includes(flag);
};

const isEditable = (row, type) => {
  const reason = row.reason;

  if (type === "branchCode") return hasFlag(reason, "B");
  if (type === "currency") return hasFlag(reason, "C");
  if (type === "cgl") return hasFlag(reason, "G");

  return false;
};

const EditableCell = ({
  type,
  row,
  editingId,
  editedRow,
  onChange,
  validatedFields,
  error,
}) => {
  const { callApi } = useApi();
  const [options, setOptions] = useState([]);
  const [inputValue, setInputValue] = useState("");
  useEffect(() => {
    if (editingId === row.id) {
      if (editedRow[type] !== undefined) {
        setInputValue(editedRow[type]);
      } else {
        setInputValue(row[type] || "");
      }
    }
  }, [editingId]);

  const fetchOptions = debounce(async (value) => {
    if (!value || value.length < 3) return;

    const res = await callApi(
      `/CM/gl-invalid/lookup/${type}?q=${value}`,
      null,
      "GET",
    );

    setOptions(res?.data || []);
  }, 300);

  if (editingId !== row.id || !isEditable(row, type)) {
    return row[type];
  }
  //   const selectedValue =
  //     options.find((x) => x.code === inputValue) ||
  //     (inputValue ? { code: inputValue, name: "" } : null);
  const getFieldStatus = () => {
    const reason = row.reason || "";

    const invalidInitially =
      (type === "branchCode" && reason.includes("B")) ||
      (type === "currency" && reason.includes("C")) ||
      (type === "cgl" && reason.includes("G"));

    if (!invalidInitially) {
      return "normal";
    }

    return validatedFields?.[type] ? "valid" : "invalid";
  };

  const status = getFieldStatus();
  return (
    <Autocomplete
      size="small"
      options={options}
      inputValue={inputValue}
      //   value={selectedValue}
      autoHighlight
      clearOnBlur={false}
      handleHomeEndKeys
      filterOptions={(x) => x}
      getOptionLabel={(opt) => opt?.code || ""}
      renderOption={(props, option) => (
        <li {...props}>
          {option.code} - {option.name}
        </li>
      )}
      onInputChange={(e, value, reason) => {
        // if (reason === "reset") {
        //   return;
        // }
        // onChange(type, value, false);
        setInputValue(value);
        if (reason == "input") {
          fetchOptions(value);
        }
      }}
      onChange={(e, value) => {
        const code = value?.code || "";

        setInputValue(code);

        onChange(type, code, true);
      }}
      sx={{
        "& .MuiOutlinedInput-root": {
          ...(error && {
            "& fieldset": {
              borderColor: "red",
            },
          }),
        },
      }}
      renderInput={(params) => (
        <TextField
          {...params}
          error={!!error}
          title={error || ""}
          sx={{
            width: "100%",

            "& .MuiOutlinedInput-root": {
              ...(status === "invalid" && {
                "& fieldset": {
                  borderColor: "#d32f2f !important",
                  borderWidth: "1.5px",
                },

                backgroundColor: "#fff5f5",
              }),

              ...(status === "valid" && {
                "& fieldset": {
                  borderColor: "#2e7d32 !important",
                  borderWidth: "1.5px",
                },

                backgroundColor: "#f1fff3",
              }),
            },
          }}
        />
      )}
    />
  );
};

export default EditableCell;

