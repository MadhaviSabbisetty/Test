export default function CglView() {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();

  const [inputValue, setInputValue] = useState("");
  const [searchValue, setSearchValue] = useState("");
  const [options, setOptions] = useState([]);
  const [selected, setSelected] = useState(null);
  const [loading, setLoading] = useState(false);

  // ---- Trigger Search only when user is typing (searchValue) ----
  useEffect(() => {
    const text = searchValue.trim();

    if (text.length < 3) {
      setOptions([]);
      return;
    }

    const fetch = async () => {
      try {
        setLoading(true);
        const res = await callApi(
          "/CM/common-master/view-cgl",
          { cglCodeOrDesc: text },
          "GET",
        );
        setOptions(res?.data?.data || []);
      } catch (error) {
        console.error("Something went wrong while fetching CGL", error);
        showSnackBar(
          "Something went wrong while fetching CGL's, Kindly try again after sometime",
          "warning",
        );
      } finally {
        setLoading(false);
      }
    };

    fetch();
  }, [searchValue, callApi, showSnackBar]);

  const classification = selected
    ? ACCOUNT_CLASSIFICATIONS[selected.acClassification]
    : null;

  const handleInputChange = (_, value, reason) => {
    // Keep UI value always in sync
    setInputValue(value);

    if (reason === "input") {
      // Only when user types -> update searchValue (fires API)
      setSearchValue(value);
    } else if (reason === "clear") {
      setSearchValue("");
      setOptions([]);
    }
    // reason === "reset" -> selection from option; do NOT trigger API again
  };

  const handleChange = (_, newValue) => {
    setSelected(newValue);
    console.log(newValue);
  };

  return (
    <Paper
        elevation={2}
        sx={{
          display:"flex",
          flexDirection:"column",
          borderRadius:2,
          overflow:"hidden",
          minHeight:"calc(100vh - 210px)",
          width:"100%",
        }}>
    <Box
      sx={{
        p: 3,
        display: "flex",
        justifyContent: "center",
      }}
    >
      <Box sx={{ width: "100%", maxWidth: 1200 }}>
        {/* PAGE HEADING */}
        <Box sx={{ mb: 2 }}>
          <Typography variant="h5" sx={{ fontWeight: 700, mb: 0.5 }}>
            CGL Master Lookup
          </Typography>
          <Typography variant="body2" color="text.secondary">
            Search CGL by number or description and view key account details in
            a clean, readable layout.
          </Typography>
        </Box>

        {/* SEARCH CARD */}
        <Card
          sx={{
            p: 2.5,
            mb: 3,
            display: "flex",
            flexDirection: "column",
            gap: 1,
          }}
        >
          <Typography
            variant="h5"
            sx={{ fontWeight: 600, color: "text.secondary", mb: 0.5 }}
          >
            Search CGL
          </Typography>
          <Autocomplete
            fullWidth
            value={selected}
            loading={loading}
            options={options}
            onChange={handleChange}
            inputValue={inputValue}
            onInputChange={handleInputChange}
            getOptionLabel={(o) =>
              o ? `${o.cglNumber} - ${o.description}` : ""
            }
            noOptionsText={
              inputValue.trim().length < 3
                ? "Type at least 3 characters..."
                : "No CGLs found for given input"
            }
            slotProps={{
              paper: {
                elevation: 3,
              },
              popper: {
                sx: {
                  zIndex: (theme) => theme.zIndex.modal + 1,
                },
              },
            }}
            renderInput={(params) => (
              <TextField
                {...params}
                label="Search CGL by Number or Description"
                placeholder="e.g. 1234567890 or Savings Account"
                size="small"
                // Max length 50 for autocomplete input
                inputProps={{
                  ...params.inputProps,
                  maxLength: 50,
                }}
                InputProps={{
                  ...params.InputProps,
                  endAdornment: (
