import React, { useState, useEffect } from "react";
import {
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  TextField,
  Button,
  Box,
  Checkbox,
  Typography,
  Stack,
  Divider,
  Paper,
  FormLabel,
  ToggleButtonGroup,
  ToggleButton,
  Chip,
} from "@mui/material";
import { LocalizationProvider, DateTimePicker } from "@mui/x-date-pickers";
import { AdapterDayjs } from "@mui/x-date-pickers/AdapterDayjs";
import dayjs from "dayjs";
import InfoOutlinedIcon from "@mui/icons-material/InfoOutlined";
import WarningAmberOutlinedIcon from "@mui/icons-material/WarningAmberOutlined";
import ErrorOutlineOutlinedIcon from "@mui/icons-material/ErrorOutlineOutlined";

export default function AnnouncementFormDialog({
  open,
  onClose,
  onSave,
  initialData,
  roles,
}) {
  const [form, setForm] = useState({
    title: "",
    message: "",
    severity: "INFO",
    targetRoles: [],
    start_date: dayjs().add(5, "minute").second(0).millisecond(0),
    expiry_date: null,
  });

  const [errors, setErrors] = useState({});

  useEffect(() => {
    if (open) {
      if (initialData) {
        setForm({
          id: initialData.id,
          title: initialData.title || "",
          message: initialData.message || "",
          severity: initialData.severity || "INFO",
          targetRoles:
            initialData.targetRoles === "ALL"
              ? roles.map((r) => r.id)
              : Array.isArray(initialData.targetRoles)
                ? initialData.targetRoles.map(String)
                : [],
          start_date: initialData.startDate
            ? dayjs(initialData.startDate)
            : dayjs().add(5, "minute").second(0).millisecond(0),
          expiry_date: initialData.expiryDate
            ? dayjs(initialData.expiryDate)
            : null,
        });
      } else {
        setForm({
          title: "",
          message: "",
          severity: "INFO",
          targetRoles: [],
          start_date: dayjs().add(5, "minute").second(0).millisecond(0),
          expiry_date: null,
        });
      }
      setErrors({});
    }
  }, [open, initialData, roles]);

  const handleChange = (e) => {
    setForm((prev) => ({ ...prev, [e.target.name]: e.target.value }));
    if (errors[e.target.name])
      setErrors((prev) => ({ ...prev, [e.target.name]: null }));
  };

  const handleSeverityChange = (event, newSeverity) => {
    if (newSeverity !== null) {
      setForm((prev) => ({ ...prev, severity: newSeverity }));
    }
  };

  const toggleRole = (id) => {
    setForm((prev) => {
      const updatedRoles = prev.targetRoles.includes(id)
        ? prev.targetRoles.filter((r) => r !== id)
        : [...prev.targetRoles, id];

      if (errors.targetRoles && updatedRoles.length > 0) {
        setErrors((errs) => ({ ...errs, targetRoles: null }));
      }
      return { ...prev, targetRoles: updatedRoles };
    });
  };

  const selectAll = () => {
    setForm((p) => ({ ...p, targetRoles: roles.map((r) => r.id) }));
    setErrors((errs) => ({ ...errs, targetRoles: null }));
  };

  const clearRoles = () => setForm((p) => ({ ...p, targetRoles: [] }));

  const validate = () => {
    let newErrors = {};

    // 1. Core Text Validations
    if (!form.title.trim()) newErrors.title = "Announcement Title is required";
    if (!form.message.trim()) newErrors.message = "Message is required";

    // 2. Role Validation
    if (form.targetRoles.length === 0) {
      newErrors.targetRoles = "At least one target role must be selected";
    }

    // 3. Date Validations
    if (!form.start_date) {
      newErrors.start_date = "Start date is required";
    } else if (!initialData) {
      // If creating new, start date cannot be in the past
      if (form.start_date.isBefore(dayjs(), "minute")) {
        newErrors.start_date = "Start date cannot be in the past";
      }
    }

    if (!form.expiry_date) {
      newErrors.expiry_date = "Expiry date is required";
    } else if (form.start_date && form.expiry_date.isBefore(form.start_date)) {
      newErrors.expiry_date = "Expiry date must be after the start date";
    }

    setErrors(newErrors);
    return Object.keys(newErrors).length === 0;
  };

  const handleSubmit = () => {
    if (!validate()) return;

    const payload = {
      ...(form.id && { id: form.id }),
      title: form.title.trim(),
      message: form.message.trim(),
      severity: form.severity,
      targetRoles:
        form.targetRoles.length === roles.length
          ? ["ALL"]
          : form.targetRoles.map((id) => (isNaN(Number(id)) ? id : Number(id))),
      startDate: form.start_date
        ? form.start_date.format("YYYY-MM-DD HH:mm:ss")
        : null,
      expiryDate: form.expiry_date
        ? form.expiry_date.format("YYYY-MM-DD HH:mm:ss")
        : null,
      isActive: initialData?.isActive ?? "Y",
    };

    onSave(payload);
  };

  return (
    <Dialog
      open={open}
      onClose={onClose}
      maxWidth="md"
      fullWidth
      PaperProps={{
        sx: {
          borderRadius: 3,
        },
      }}
    >
      {/* HEADER */}
      <Box sx={{ bgcolor: "primary.main", color: "white", px: 4, py: 3 }}>
        <Typography variant="h5" fontWeight="700">
          {initialData ? "Edit Announcement" : "Create New Announcement"}
        </Typography>
        <Typography variant="body2" sx={{ mt: 0.5, opacity: 0.8 }}>
          Fill in the mandatory fields (*) below to broadcast a message to your
          users.
        </Typography>
      </Box>

      <DialogContent>
        <Stack spacing={4}>
          {/* GROUP 1: Core Info & Severity */}
          <Paper
            elevation={0}
            sx={{ p: 3, borderRadius: 2, border: "1px solid #e2e8f0" }}
          >
            <Stack spacing={3}>
              <TextField
                required
                label="Announcement Title"
                name="title"
                fullWidth
                value={form.title}
                onChange={handleChange}
                error={Boolean(errors.title)}
                helperText={errors.title}
                variant="outlined"
              />

              <TextField
                required
                label="Message Content"
                name="message"
                fullWidth
                multiline
                minRows={4}
                value={form.message}
                onChange={handleChange}
                error={Boolean(errors.message)}
                helperText={errors.message}
              />

              <Box>
                <FormLabel
                  required
                  component="legend"
                  sx={{ mb: 1, fontWeight: 600, color: "text.primary" }}
                >
                  Severity Level
                </FormLabel>
                <ToggleButtonGroup
                  value={form.severity}
                  exclusive
                  onChange={handleSeverityChange}
                  fullWidth
                  size="medium"
                  sx={{ mt: 0.5 }}
                >
                  <ToggleButton
                    value="INFO"
                    color="info"
                    sx={{ fontWeight: 600 }}
                  >
                    <InfoOutlinedIcon sx={{ mr: 1 }} fontSize="small" />{" "}
                    Information
                  </ToggleButton>
                  <ToggleButton
                    value="WARN"
                    color="warning"
                    sx={{ fontWeight: 600 }}
                  >
                    <WarningAmberOutlinedIcon sx={{ mr: 1 }} fontSize="small" />{" "}
                    Warning
                  </ToggleButton>
                  <ToggleButton
                    value="CRITICAL"
                    color="error"
                    sx={{ fontWeight: 600 }}
                  >
                    <ErrorOutlineOutlinedIcon sx={{ mr: 1 }} fontSize="small" />{" "}
                    Critical
                  </ToggleButton>
                </ToggleButtonGroup>
              </Box>
            </Stack>
          </Paper>

          {/* GROUP 2: Scheduling */}
          <Paper
            elevation={0}
            sx={{ p: 3, borderRadius: 2, border: "1px solid #e2e8f0" }}
          >
            <Typography fontWeight={600} color="text.primary" mb={2}>
              Schedule Details *
            </Typography>
            <LocalizationProvider dateAdapter={AdapterDayjs}>
              <Stack direction={{ xs: "column", sm: "row" }} spacing={3}>
                <DateTimePicker
                  label="Start Date & Time (Default time)"
                  value={form.start_date}
                  // Prevent selecting past dates on the calendar only if creating new
                  minDateTime={!initialData ? dayjs() : undefined}
                  onChange={(val) => {
                    setForm((prev) => ({ ...prev, start_date: val }));
                    setErrors((prev) => ({ ...prev, start_date: null }));
                  }}
                  slotProps={{
                    textField: {
                      fullWidth: true,
                      required: true,
                      error: Boolean(errors.start_date),
                      helperText: errors.start_date,
                    },
                  }}
                />
                <DateTimePicker
                  label="Expiry Date & Time"
                  value={form.expiry_date}
                  // Prevent selecting an expiry date before the start date
                  minDateTime={form.start_date ? form.start_date : undefined}
                  onChange={(val) => {
                    setForm((prev) => ({ ...prev, expiry_date: val }));
                    setErrors((prev) => ({ ...prev, expiry_date: null }));
                  }}
                  slotProps={{
                    textField: {
                      fullWidth: true,
                      required: true,
                      error: Boolean(errors.expiry_date),
                      helperText: errors.expiry_date,
                    },
                  }}
                />
              </Stack>
            </LocalizationProvider>
          </Paper>

          {/* GROUP 3: Targeting Roles */}
          <Paper
            elevation={0}
            sx={{
              p: 3,
              borderRadius: 2,
              border: "1px solid",
              borderColor: errors.targetRoles ? "error.main" : "#e2e8f0",
            }}
          >
            <Stack
              direction="row"
              justifyContent="space-between"
              alignItems="center"
              mb={1}
            >
              <Box>
                <Typography
                  fontWeight={600}
                  color={errors.targetRoles ? "error.main" : "text.primary"}
                >
                  Target Roles *
                </Typography>
                <Typography
                  variant="caption"
                  color={errors.targetRoles ? "error.main" : "text.secondary"}
                >
                  {errors.targetRoles
                    ? errors.targetRoles
                    : form.targetRoles.length === roles.length
                      ? "All roles selected"
                      : `${form.targetRoles.length} role(s) selected`}
                </Typography>
              </Box>

              <Stack direction="row" spacing={1}>
                <Button size="small" variant="outlined" onClick={selectAll}>
                  Select All
                </Button>
                <Button
                  size="small"
                  variant="text"
                  color="error"
                  onClick={clearRoles}
                >
                  Clear
                </Button>
              </Stack>
            </Stack>

            {/* Responsive Grid for Checkboxes */}
            <Box
              sx={{
                maxHeight: 220,
                overflowY: "auto",
                display: "grid",
                gridTemplateColumns: { xs: "1fr", sm: "1fr 1fr" },
                gap: 1,
                mt: 2,
                mb: form.targetRoles.length > 0 ? 2 : 0,
                pr: 1,
              }}
            >
              {roles.map((role) => {
                const isSelected = form.targetRoles.includes(role.id);
                return (
                  <Paper
                    key={role.id}
                    variant="outlined"
                    onClick={() => toggleRole(role.id)}
                    sx={{
                      display: "flex",
                      alignItems: "center",
                      p: 0.5,
                      cursor: "pointer",
                      transition: "0.2s",
                      bgcolor: isSelected ? "primary.50" : "transparent",
                      borderColor: isSelected ? "primary.main" : "divider",
                      "&:hover": { bgcolor: "action.hover" },
                    }}
                  >
                    <Checkbox
                      checked={isSelected}
                      disableRipple
                      color="primary"
                    />
                    <Typography
                      variant="body2"
                      fontWeight={isSelected ? 600 : 400}
                    >
                      {role.name}
                    </Typography>
                  </Paper>
                );
              })}
            </Box>

            {/* Selected Roles Chips */}
            {form.targetRoles.length > 0 && (
              <>
                <Divider sx={{ my: 2 }} />
                <Box display="flex" gap={1} flexWrap="wrap">
                  {form.targetRoles.map((id) => {
                    const role = roles.find((r) => r.id === id);
                    return (
                      <Chip
                        key={id}
                        label={role?.name ?? id}
                        onDelete={() => toggleRole(id)}
                        color="primary"
                        variant="outlined"
                        size="small"
                        sx={{ fontWeight: 500 }}
                      />
                    );
                  })}
                </Box>
              </>
            )}
          </Paper>
        </Stack>
      </DialogContent>

      <Divider />

      <DialogActions sx={{ p: 3, justifyContent: "flex-end" }}>
        <Button
          onClick={onClose}
          sx={{ color: "text.secondary", px: 3, fontWeight: 600 }}
        >
          Cancel
        </Button>
        <Button
          variant="contained"
          onClick={handleSubmit}
          sx={{
            px: 4,
            py: 1.2,
            borderRadius: 2,
            boxShadow: 2,
            fontWeight: 600,
          }}
        >
          {initialData ? "Save Changes" : "Publish Announcement"}
        </Button>
      </DialogActions>
    </Dialog>
  );
}
import React, { useState, useEffect, useRef } from "react";
import {
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  TextField,
  Button,
  MenuItem,
  Select,
  InputLabel,
  FormControl,
  Box,
} from "@mui/material";

import useApi from "../../../hooks/useApi";

import { LocalizationProvider } from "@mui/x-date-pickers/LocalizationProvider";
import { AdapterDayjs } from "@mui/x-date-pickers/AdapterDayjs";
import dayjs from "dayjs";
import CustomChip from "../../../utils/CustomChip";
import { DateTimePicker } from "@mui/x-date-pickers/DateTimePicker";
import { date } from "zod";

export default function CreateAnnouncementDialog({ open, onClose, onSave }) {
  const { callApi } = useApi();

  const initialForm = {
    title: "",
    message: "",
    severity: "INFO",
    target_roles: [],
    start_date: null,
    expiry_date: null,
  };

  const [form, setForm] = useState(initialForm);
  const formRef = useRef(form);
  useEffect(() => {
    formRef.current = form;
  }, [form]);
  const [errors, setErrors] = useState({
    title: null,
    message: null,
    date: null,
  });
  const [roles, setRoles] = useState([]);
  const [loadingRoles, setLoadingRoles] = useState(false);

  useEffect(() => {
    if (open) {
      fetchRoles();
    } else {
      setForm(initialForm);
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [open]);

  async function fetchRoles() {
    setLoadingRoles(true);
    try {
      const res = await callApi("/UM/role/get-roles", null, "GET");
      const rolesData = res?.result?.roles ?? [];
      const activeRoles = rolesData.filter((r) => r.roleStatus === "ACTIVE");
      const normalized = activeRoles.map((r) => ({
        id: String(r.roleId),
        name: r.roleName,
      }));
      setRoles(normalized);
    } catch (err) {
      console.error("fetchRoles error", err);
      setRoles([]);
    } finally {
      setLoadingRoles(false);
    }
  }
  function changeText(e) {
    setForm((prev) => ({ ...prev, [e.target.name]: e.target.value }));
  }
  function setStartDate(v) {
    setForm((prev) => ({ ...prev, start_date: v }));
    setErrors((prev) => ({ ...prev, date: null }));
  }
  function setExpiryDate(v) {
    setForm((prev) => ({ ...prev, expiry_date: v }));
    setErrors((prev) => ({ ...prev, date: null }));
  }

  function validateAll() {
    const next = { title: null, message: null, date: null };
    let ok = true;
    if (!form.title || !String(form.title).trim()) {
      next.title = "Title is Required";
      ok = false;
    }
    if (!form.message || !String(form.message).trim()) {
      next.message = "Message is Required";
      ok = false;
    }
    if (form.start_date && form.expiry_date) {
      const s = dayjs(form.start_date);
      const e = dayjs(form.expiry_date);
      if (!e.isAfter(s)) {
        next.date = "Expiry date must be after Start date";
        ok = false;
      }
    }
    setErrors(next);
    return ok;
  }

  function handleSave() {
    const currentForm = formRef.current;
    if (!validateAll()) return;

    // format dates to "YYYY-MM-DD HH:mm:ss"
    const payload = {
      title: currentForm.title,
      message: currentForm.message,
      severity: currentForm.severity,
      // send array of role ids; if none selected, use "ALL"
      targetRoles:
        currentForm.target_roles && currentForm.target_roles.length > 0
          ? currentForm.target_roles
          : "ALL",
      startDate: currentForm.start_date
        ? dayjs(currentForm.start_date).format("YYYY-MM-DD HH:mm:ss")
        : null,
      expiryDate: currentForm.expiry_date
        ? dayjs(currentForm.expiry_date).format("YYYY-MM-DD HH:mm:ss")
        : null,
      isActive: "Y",
    };

    onSave(payload);
  }

  const isFormvalid =
    !form.title?.trim() || !form.message?.trim() || Boolean(errors.date);

  return (
    <Dialog open={open} onClose={onClose} maxWidth="sm" fullWidth>
      <DialogTitle>Create Announcement</DialogTitle>

      <DialogContent dividers>
        <TextField
          margin="dense"
          autoFocus
          label="Title*"
          name="title"
          fullWidth
          value={form.title}
          onChange={changeText}
          error={Boolean(errors.title)}
          helperText={errors.title}
        />

        <TextField
          margin="dense"
          label="Message*"
          name="message"
          fullWidth
          multiline
          minRows={3}
          value={form.message}
          onChange={changeText}
          error={Boolean(errors.message)}
          helperText={errors.message}
        />

        <TextField
          select
          margin="dense"
          fullWidth
          label="Severity"
          name="severity"
          value={form.severity}
          onChange={changeText}
        >
          <MenuItem value="INFO">INFO</MenuItem>
          <MenuItem value="WARN">WARN</MenuItem>
          <MenuItem value="CRITICAL">CRITICAL</MenuItem>
        </TextField>

        <FormControl fullWidth margin="dense">
          <InputLabel>Target Roles</InputLabel>
          <Select
            multiple
            label="Target Roles"
            name="target_roles"
            value={form.target_roles}
            onChange={(e) =>
              setForm((prev) => ({ ...prev, target_roles: e.target.value }))
            }
            renderValue={(selected) => (
              <Box sx={{ display: "flex", flexWrap: "wrap", gap: 0.5 }}>
                {selected.map((val) => {
                  const role = roles.find((r) => String(r.id) === String(val));
                  const label = role ? role.name : String(val);
                  return (
                    <CustomChip variant="outlined" key={val} label={label} />
                  );
                })}
              </Box>
            )}
          >
            {roles.map((role) => (
              <MenuItem key={role.id} value={role.id}>
                {role.name}
              </MenuItem>
            ))}
          </Select>
        </FormControl>

        <LocalizationProvider dateAdapter={AdapterDayjs}>
          <DateTimePicker
            label="Start Date & Time"
            value={form.start_date}
            onChange={setStartDate}
            slotProps={{ textField: { fullWidth: true, margin: "dense" } }}
          />

          <DateTimePicker
            label="Expiry Date & Time"
            value={form.expiry_date}
            onChange={setExpiryDate}
            slotProps={{ textField: { fullWidth: true, margin: "dense" } }}
          />
          {errors.date && (
            <Box sx={{ color: "error.main", mt: 1, fontSize: 13 }}>
              {errors.date}
            </Box>
          )}
        </LocalizationProvider>
      </DialogContent>

      <DialogActions>
        <Button onClick={onClose}>Cancel</Button>
        <Button variant="contained" onClick={handleSave} disabled={isFormvalid}>
          Save
        </Button>
      </DialogActions>
    </Dialog>
  );
}
import React, { useState, useEffect, useRef } from "react";
import {
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  TextField,
  Button,
  MenuItem,
  FormControl,
  InputLabel,
  Select,
  Box,
} from "@mui/material";
import dayjs from "dayjs";

import useApi from "../../../hooks/useApi";

import { LocalizationProvider } from "@mui/x-date-pickers/LocalizationProvider";
import { AdapterDayjs } from "@mui/x-date-pickers/AdapterDayjs";
import { DateTimePicker } from "@mui/x-date-pickers/DateTimePicker";
import CustomChip from "../../../utils/CustomChip";

export default function EditAnnouncementDialog({
  open,
  record,
  onClose,
  onSave,
}) {
  const { callApi } = useApi();

  const [form, setForm] = useState({
    id: null,
    title: "",
    message: "",
    severity: "INFO",
    targetRoles: [],
    start_date: null,
    expiry_date: null,
    isActive: "Y",
  });

  const formRef = useRef(form);
  useEffect(() => {
    formRef.current = form;
  }, [form]);
  const [errors, setErrors] = useState({
    title: null,
    message: null,
    date: null,
  });
  const [roles, setRoles] = useState([]);
  const [loadingRoles, setLoadingRoles] = useState(false);

  useEffect(() => {
    if (!open) return;

    fetchRoles();

    if (record) {
      setForm({
        id: record.id ?? record.announcementId ?? null,
        title: record.title ?? "",
        message: record.message ?? "",
        severity: record.severity ?? "INFO",
        targetRoles: record.targetRoles ?? record.targetRole ?? [],
        start_date: record.startDate ?? record.start_date ?? null,
        expiry_date: record.expiryDate ?? record.expiry_date ?? null,
        isActive: record.isActive ?? record.is_active ?? "Y",
      });
    }
  }, [open, record]);

  async function fetchRoles() {
    setLoadingRoles(true);
    try {
      const res = await callApi("/UM/role/get-roles", null, "GET");
      const rolesData = res?.result?.roles ?? [];
      const activeRoles = rolesData.filter((r) => r.roleStatus === "ACTIVE");
      const normalized = activeRoles.map((r) => ({
        id: String(r.roleId),
        name: r.roleName,
      }));
      setRoles(normalized);
    } catch (err) {
      console.error("fetchRoles error", err);
      setRoles([]);
    } finally {
      setLoadingRoles(false);
    }
  }
  function change(e) {
    setForm((prev) => ({ ...prev, [e.target.name]: e.target.value }));
  }
  function setStartDate(v) {
    setForm((prev) => ({ ...prev, start_date: v }));
    setErrors((prev) => ({ ...prev, date: null }));
  }
  function setExpiryDate(v) {
    setForm((prev) => ({ ...prev, expiry_date: v }));
    setErrors((prev) => ({ ...prev, date: null }));
  }

  function validateAll() {
    const next = { title: null, message: null, date: null };
    let ok = true;
    if (!form.title || !String(form.title).trim()) {
      next.title = "Title is Required";
      ok = false;
    }
    if (!form.message || !String(form.message).trim()) {
      next.message = "Message is Required";
      ok = false;
    }
    if (form.start_date && form.expiry_date) {
      const s = dayjs(form.start_date);
      const e = dayjs(form.expiry_date);
      if (!e.isAfter(s)) {
        next.date = "Expiry date must be after Start date";
        ok = false;
      }
    }
    setErrors(next);
    return ok;
  }

  async function handleSave() {
    // latest snapshot (keeps up-to-date values)
    const currentForm = formRef.current;
    console.log("[handleSave] currentForm:", JSON.stringify(currentForm));

    // run UI validation (validateAll reads `form` state to populate errors)
    if (!validateAll()) return;

    // defensive date check on the snapshot as well
    if (currentForm.start_date && currentForm.expiry_date) {
      if (
        !dayjs(currentForm.expiry_date).isAfter(dayjs(currentForm.start_date))
      ) {
        setErrors((prev) => ({
          ...prev,
          date: "Expiry must be later than Start",
        }));
        return;
      }
    }

    // build payload from the snapshot (use currentForm, not form)
    const payload = {
      // id: currentForm.id ?? null,
      title: String(currentForm.title ?? "").trim(),
      message: String(currentForm.message ?? "").trim(),
      severity: currentForm.severity ?? "INFO",
      // backend expects numbers for role ids — convert where possible
      targetRoles: Array.isArray(currentForm.targetRoles)
        ? currentForm.targetRoles.map((v) => (isNaN(Number(v)) ? v : Number(v)))
        : currentForm.targetRoles ?? "ALL",
      startDate: currentForm.start_date
        ? dayjs(currentForm.start_date).format("YYYY-MM-DD HH:mm:ss")
        : null,
      expiryDate: currentForm.expiry_date
        ? dayjs(currentForm.expiry_date).format("YYYY-MM-DD HH:mm:ss")
        : null,
      isActive: currentForm.isActive ?? "Y",
    };

    console.log("[handleSave] payload:", payload);

    // setIsSubmitting(true);
    try {
      // assume parent onSave handles API call (PUT) and closing
      await onSave(payload);
      // if parent doesn't close the dialog, you may call onClose() here
    } catch (err) {
      console.error("[handleSave] save error:", err);
      // setIsSubmitting(false);
    }
  }
  const isFormvalid =
    !form.title?.trim() || !form.message?.trim() || Boolean(errors.date);

  return (
    <Dialog open={open} onClose={onClose} maxWidth="sm" fullWidth>
      <DialogTitle>Edit Announcement</DialogTitle>

      <DialogContent dividers>
        <TextField
          margin="dense"
          autoFocus
          label="Title*"
          fullWidth
          name="title"
          value={form.title ?? ""}
          onChange={change}
          error={Boolean(errors.title)}
          helperText={errors.title}
        />

        <TextField
          margin="dense"
          label="Message*"
          fullWidth
          multiline
          minRows={3}
          name="message"
          value={form.message ?? ""}
          onChange={change}
        />

        <TextField
          select
          margin="dense"
          fullWidth
          label="Severity"
          name="severity"
          value={form.severity ?? "INFO"}
          onChange={change}
        >
          <MenuItem value="INFO">INFO</MenuItem>
          <MenuItem value="WARN">WARN</MenuItem>
          <MenuItem value="CRITICAL">CRITICAL</MenuItem>
        </TextField>
        <FormControl fullWidth margin="dense">
          <InputLabel>Target Roles</InputLabel>
          <Select
            multiple
            label="Target Roles"
            name="target_roles"
            value={form.targetRoles}
            onChange={(e) =>
              setForm((prev) => ({ ...prev, target_roles: e.target.value }))
            }
            renderValue={(selected) => (
              <Box sx={{ display: "flex", flexWrap: "wrap", gap: 0.5 }}>
                {selected.map((val) => {
                  const role = roles.find((r) => String(r.id) === String(val));
                  const label = role ? role.name : String(val);
                  return (
                    <CustomChip variant="outlined" key={val} label={label} />
                  );
                })}
              </Box>
            )}
          >
            {roles.map((role) => (
              <MenuItem key={role.id} value={role.id}>
                {role.name}
              </MenuItem>
            ))}
          </Select>
        </FormControl>

        <LocalizationProvider dateAdapter={AdapterDayjs}>
          <DateTimePicker
            label="Start Date & Time"
            value={
              form.start_date
                ? dayjs.isDayjs(form.start_date)
                  ? form.start_date
                  : dayjs(form.start_date)
                : null
            }
            onChange={setStartDate}
            slotProps={{ textField: { fullWidth: true, margin: "dense" } }}
          />

          <DateTimePicker
            label="Expiry Date & Time"
            value={
              form.expiry_date
                ? dayjs.isDayjs(form.expiry_date)
                  ? form.expiry_date
                  : dayjs(form.expiry_date)
                : null
            }
            onChange={setExpiryDate}
            slotProps={{ textField: { fullWidth: true, margin: "dense" } }}
          />
          {errors.date && (
            <Box sx={{ color: "error.main", mt: 1, fontSize: 13 }}>
              {errors.date}
            </Box>
          )}
        </LocalizationProvider>
      </DialogContent>

      <DialogActions>
        <Button onClick={onClose}>Cancel</Button>
        <Button variant="contained" onClick={handleSave} disabled={isFormvalid}>
          Save
        </Button>
      </DialogActions>
    </Dialog>
  );
}
