  const lastFilterRef = useRef("");
  const lastQueryRef = useRef("");

  /* ================= FETCH DATA ================= */

  const fetchRows = useCallback(async () => {
    if (!requestType) return;

    const sortField = sortModel[0]?.field;
    const sortOrder = sortModel[0]?.sort;

    const filters = filterModel.items
      .filter(
        (f) =>
          f.operator &&
          f.value !== undefined &&
          f.value !== null &&
          f.value !== "",
      )
      .map((f) => ({
        field: f.field,
        operator: f.operator,
        value: f.value,
      }));

    const querySignature = JSON.stringify({
      page: paginationModel.page,
      size: paginationModel.pageSize,
      sortField,
      sortOrder,
      filters,
    });

    // PREVENT DUPLICATE API CALL
    if (lastQueryRef.current === querySignature) return;
    lastQueryRef.current = querySignature;

    try {
      setLoading(true);
      const payload = {
        // requestType,
        page: paginationModel.page,
        size: paginationModel.pageSize,
        sortField: sortField || "cglNumber",
        sortOrder: sortOrder || "asc",
        filters,
      };
      const resp = await callApi("/CM/common-master/cgls", payload, "POST");

      setRows(resp?.data?.data || []);
      setRowCount(resp?.data?.totalElements || 0);
    } catch (err) {
      snackbar(err?.message || "Failed to load CGLs", "error");
      setRows([]);
      setRowCount(0);
    } finally {
      setLoading(false);
    }
  }, [callApi, requestType, snackbar, paginationModel, sortModel, filterModel]);

