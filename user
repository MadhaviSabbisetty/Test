import {
  Box,
  Button,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  Stack,
  Typography,
  Tooltip,
  IconButton,
  Paper,
} from "@mui/material";
import { DataGrid } from "@mui/x-data-grid";
import React, { useCallback, useEffect, useMemo, useState } from "react";
import useApi from "../../hooks/useApi";
import CancelIcon from "@mui/icons-material/Cancel";
import VisibilityIcon from "@mui/icons-material/Visibility";
import AddBoxIcon from "@mui/icons-material/AddBox";
import AutoDeleteIcon from "@mui/icons-material/AutoDelete";
import EditDocumentIcon from "@mui/icons-material/EditDocument";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import PendingActionsIcon from "@mui/icons-material/PendingActions";
import BlockFlippedIcon from "@mui/icons-material/BlockFlipped";
import CheckCircleIcon from "@mui/icons-material/CheckCircle";
import GppBadIcon from "@mui/icons-material/GppBad";
import SecurityIcon from "@mui/icons-material/Security";
import {
  timeStampFormatter,
  toPascalKebabCase,
} from "../../utils/CommonUtilities";
import CustomChip from "../../utils/CustomChip";
import InfoIcon from "@mui/icons-material/Info";
import RoleRequestView from "./components/RoleRequestView";

function CustomNoRowsOverlay() {
  return (
    <Stack height="100%" alignItems="center" justifyContent="center">
      <InfoIcon sx={{ fontSize: 48, color: "text.secondary", mb: 2 }} />
      <Typography variant="h6">No Role Requests Found</Typography>
      <Typography>You have not created any Role requests.</Typography>
    </Stack>
  );
}

export default function RoleManagementTab2({ permissions = {} }) {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();
  const [isLoading, setIsLoading] = useState(true);
  const [rows, setRows] = useState([]);
  const [confirmDialog, setConfirmDialog] = useState(false);
  const [requestId, setRequestId] = useState(null);
  const [viewOpen, setViewOpen] = useState(false);
  const [viewData, setViewData] = useState(null);
  const [roleAccessList, setRoleAccessList] = useState([]);

  const fetchData = useCallback(async () => {
    setIsLoading(true);
    try {
      const response = await callApi("/UM/role/my-role-requests", null, "GET");
      if (response?.result) {
        const result = response?.result?.myRequests || [];

        const processedResult = result.map((row, index) => {
          let parsed = {};
          try {
            if (row.requestPayload) {
              parsed = JSON.parse(row.requestPayload);
            }
          } catch (e) {
            console.error("Failed to parse requestPayload", e);
          }

          return {
            ...row,
            ...parsed,
            gridRowId: row.requestId || `fallback-id-${Date.now()}-${index}`,
          };
        });
        setRows(processedResult);
      } else {
        showSnackBar("No requests found", "warning");
        setRows([]);
      }
    } catch (error) {
      console.error("Something went wrong", error);
    } finally {
      setIsLoading(false);
    }
  }, [callApi, showSnackBar]);

  const fetchRoleAccessList = useCallback(async () => {
    try {
      const response = await callApi(
        "/UM/role/get-role-access-list",
        {},
        "GET",
      );
      const list = response?.result?.roleAccessList ?? [];
      setRoleAccessList(list);
    } catch (error) {
      console.error("Something went wrong", error);
      setRoleAccessList([]);
    }
  }, [callApi]);

  useEffect(() => {
    fetchData();
    fetchRoleAccessList();
  }, [fetchData, fetchRoleAccessList]);

  const handleCancelRequest = async () => {
    try {
      const payload = {
        requestId,
        actionFlag: "CANCEL",
        remarks: "User canceled this Request",
      };
      const response = await callApi(
        "/UM/role/cancel-role-request",
        payload,
        "POST",
      );
      if (response?.result?.status) {
        showSnackBar(
          `Request Id ${requestId} Cancelled Successfully.`,
          "success",
        );
      } else {
        showSnackBar(
          response?.message
            ? response?.message
            : "Failed to process your cancel request, Kindly try again",
          "error",
        );
      }
    } catch (error) {
      console.error(error);
    } finally {
      fetchData();
      setConfirmDialog(false);
    }
  };

  const handleViewClick = useCallback(
    (data) => {
      // Fix: robust string match
      const access = roleAccessList?.find(
        (item) =>
          String(item.accessFlag).trim() === String(data.roleAccess).trim(),
      );
      const newData = { ...data, ...access };
      setViewData(newData);
      setViewOpen(true);
    },
    [roleAccessList],
  );

  const columns = useMemo(
    () => [
      {
        field: "requestId",
        headerName: "Request Id",
        flex: 0.5,
        minWidth: 150,
      },
      { field: "roleName", headerName: "Role Name", flex: 0.7, minWidth: 150 },
      {
        field: "description",
        headerName: "Role Description",
        flex: 1.5,
        minWidth: 200,
      },
      {
        field: "roleAccess",
        headerName: "Access Level",
        flex: 0.7,
        headerAlign: "center",
        align: "center",
        sortable: true,
        filterable: false,
        disableColumnMenu: true,
        renderCell: (params) => {
          // Fix: robust string match
          const access = roleAccessList?.find(
            (item) =>
              String(item.accessFlag).trim() ===
              String(params.row.roleAccess).trim(),
          );

          return (
            <Tooltip title={access?.accessDescription || ""} placement="top">
              {/* Fix: span prevents tooltip ref errors */}
              <span>
                <CustomChip
                // sx={{
                //     width:115,
                //     justifyContent:"flex-start",
                //   }}
                  variant="outlined"
                  size="sm"
                  icon={<SecurityIcon sx={{ width: 15, height: 15 }} />}
                  label={access?.accessName || params.row.roleAccess || "NA"}
                />
              </span>
            </Tooltip>
          );
        },
      },
      {
        field: "requestType",
        headerName: "Request Type",
        flex: 0.5,
        minWidth: 150,
        align: "center",
        headerAlign: "center",
        filterable: false,
        sortable: false,
        disableColumnMenu: true,
        renderCell: (params) => {
          const val = params.value;
          const color =
            val === "CREATE"
              ? "success"
              : val === "DELETE"
                ? "error"
                : "warning";
          const icon =
            val === "CREATE" ? (
              <AddBoxIcon />
            ) : val === "DELETE" ? (
              <AutoDeleteIcon />
            ) : (
              <EditDocumentIcon />
            );
          return (
            <CustomChip
            sx={{
              width:105,
              justifyContent:"flex-start",
            }}
              variant="outlined"
              icon={icon}
              label={
                val === "CREATE"
                  ? "Added"
                  : val === "DELETE"
                    ? "Deleted"
                    : "Modified"
              }
              color={color}
            />
          );
        },
      },
      {
        field: "requestDate",
        headerName: "Requested Date",
        flex: 1,
        minWidth: 200,
        renderCell: (params) => (
          <Typography
            variant="body1"
            component="span"
            sx={{ fontSize: "0.9rem" }}
          >
            {timeStampFormatter(params.value)}
          </Typography>
        ),
      },
      {
        field: "requestStatus",
        headerName: "Status",
        minWidth: 150,
        flex: 0.6,
        align: "center",
        headerAlign: "center",
        filterable: false,
        sortable: false,
        disableColumnMenu: true,
        renderCell: (params) => (
          <Box>
            <CustomChip
              icon={
                params.value === "ACCEPTED" ? (
                  <CheckCircleIcon />
                ) : params.value === "REJECTED" ? (
                  <BlockFlippedIcon />
                ) : params.value === "CANCELED" ? (
                  <GppBadIcon />
                ) : (
                  <PendingActionsIcon />
                )
              }
              variant="outlined"
              label={toPascalKebabCase(params.value)}
              sx={{
                width:120,
                justifyContent:"flex-start",
                color:
                  params.value === "REJECTED"
                    ? "error.dark"
                    : params.value === "ACCEPTED"
                      ? "success.dark"
                      : params.value === "CANCELLED"
                        ? "primary.dark"
                        : "warning.dark",
                "& .MuiChip-icon": {
                  color:
                    params.value === "REJECTED"
                      ? "error.dark"
                      : params.value === "ACCEPTED"
                        ? "success.dark"
                        : params.value === "CANCELLED"
                          ? "primary.dark"
                          : "warning.dark",
                },
              }}
            />
          </Box>
        ),
      },
      {
        field: "action",
        headerName: "Actions",
        flex: 0.6,
        minWidth: 120,
        align: "center",
        headerAlign: "center",
        filterable: false,
        sortable: false,
        disableColumnMenu: true,
        renderCell: (params) => (
          <Stack
            direction="row"
            spacing={1}
            justifyContent="center"
            alignItems="center"
            sx={{ height: "100%" }}
          >
            {permissions.view && (
              <Tooltip title="View">
                <IconButton onClick={() => handleViewClick(params.row)}>
                  <VisibilityIcon />
                </IconButton>
              </Tooltip>
            )}
            {params.row.requestStatus === "PENDING" && permissions.cancel && (
              <Tooltip title={"Cancel Request"}>
                <IconButton
                  onClick={() => {
                    setConfirmDialog(true);
                    setRequestId(params.row.requestId);
                  }}
                >
                  <CancelIcon fontSize="inherit" />
                </IconButton>
              </Tooltip>
            )}
          </Stack>
        ),
      },
    ],
    [handleViewClick, permissions.cancel, permissions.view, roleAccessList],
  );

  const filteredColumns = useMemo(() => {
    if (permissions.view || permissions.cancel) {
      return columns;
    }
    return columns.filter((column) => column.field !== "action");
  }, [columns, permissions]);

  return (
    <>
        <DataGrid
          rows={rows}
          loading={isLoading}
          columns={filteredColumns}
          disableRowSelectionOnClick
          pageSizeOptions={[5, 10, 25, 50]}
          initialState={{
            pagination: { paginationModel: { pageSize: 10, page: 0 } },
            sorting: { sortModel: [{ field: "reqDate", sort: "desc" }] },
          }}
          getRowId={(row) => row.gridRowId}
          slots={{
            noRowsOverlay: CustomNoRowsOverlay,
          }}
          sx={{
          minHeight: 760,
          width: "100%",
         "& .MuiDataGrid-columnHeaders": {
          backgroundColor: "#f5f5f5 !important",
          fontWeight: 700,
          borderBottom: "2px solid rgba(88, 70, 159, 0.2)",
          position: 'sticky',
          top: 0,
          zIndex: 1,
          },
          }}
        />

      <RoleRequestView
        open={viewOpen}
        handleClose={() => setViewOpen(false)}
        data={viewData}
      />

      <Dialog
        open={confirmDialog}
        onClose={() => {
          setConfirmDialog(false);
        }}
        maxWidth="sm"
        fullWidth
      >
        <DialogTitle sx={{ fontWeight: 600 }}>
          Cancel Request ID: {requestId}
        </DialogTitle>
        <DialogContent>
          <Typography sx={{ p: 1 }}>
            Are you sure you want to cancel this request? Please confirm.
          </Typography>
        </DialogContent>
        <DialogActions>
          <Button
            onClick={() => {
              setConfirmDialog(false);
            }}
            variant="outlined"
            sx=
          {{
            "&:hover":
            {
              color:"#fff",
            },
            }}
          >
            Cancel
          </Button>
          <Button
            onClick={handleCancelRequest}
            color="error"
            variant="contained"
          >
            Confirm
          </Button>
        </DialogActions>
      </Dialog>
    </>
  );
}
