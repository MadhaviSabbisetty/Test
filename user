import {
  Box,
  Button,
  Chip,
  Typography,
  Stack,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  Tooltip,
  IconButton,
} from "@mui/material";
import { DataGrid } from "@mui/x-data-grid";
import React, { useEffect, useMemo, useState } from "react";

import useApi from "../../hooks/useApi";
import CheckCircleIcon from "@mui/icons-material/CheckCircle";
import BlockFlippedIcon from "@mui/icons-material/BlockFlipped";
import DateRangeIcon from "@mui/icons-material/DateRange";
import VisibilityIcon from "@mui/icons-material/Visibility";
import PendingActionsIcon from "@mui/icons-material/PendingActions";
import { currencyFormatterWith6Decimals } from "../../utils/NumberFormat";
import CancelIcon from "@mui/icons-material/Cancel";
import ViewMyRequestDialog from "../common/ViewMyRequestDialog";
import GppBadIcon from "@mui/icons-material/GppBad";
import CustomChip from "../../utils/CustomChip";
import {
  StyledDateChip,
  StyledStatusChip,
  StyledStatusBox,
  StyledRequestDataGrid,
  StyledRequestContainerBox,
} from "./CurrencyRateChangeStyles";
import { useSelector } from "react-redux";
import InfoIcon from "@mui/icons-material/Info";
import useCustomSnackbar from "../../utils/useCustomSnackbar";

function CustomNoRowsOverlay() {
  return (
    <Stack height="100%" alignItems="center" justifyContent="center">
      <InfoIcon sx={{ fontSize: 48, color: "text.secondary", mb: 2 }} />
      <Typography variant="h6">No Currency Rate Requests Found</Typography>
      <Typography>You have not created any Currency Rate requests.</Typography>
    </Stack>
  );
}
export default function MyCurrencyRequestsTab({ permissions = {} }) {
  const [rows, setRows] = useState([]);
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();
  const selectedMenuItem = useSelector((state) => state.menus.selectedMenuItem);
  const [confirmDialog, setConfirmDialog] = useState(false);
  const [requestId, setRequestId] = useState(null);
  const [isLoading, setIsLoading] = useState(true);
  const [viewOpen, setViewOpen] = useState(false);
  const [viewData, setViewData] = useState(null);

  const fetchData = async () => {
    setIsLoading(true);
    try {
      const payload = { requestType: selectedMenuItem.requestType };
      const response = await callApi("/CR/my-requests", payload, "POST");
      if (response) {
        const result = response.data?.map((row) => {
          let parsedPayload = {};
          parsedPayload = row.payload ? row.payload : {};
          parsedPayload = {
            ...parsedPayload,
            id: row.id,
            reqStatus: row.reqStatus,
            reqDate: row.reqDate,
            creatorId: row.creatorId,
            executionDate: row.executionDate,
            executorId: row.executorId,
            executorRemarks: row.executorRemarks,
            reqType: row.requestType,
            changeType: row.changeType,
          };
          return { ...parsedPayload };
        });
        result.sort((a, b) => {
          if (a.reqStatus === "PENDING" && b.reqStatus !== "PENDING") return -1;
          if (a.reqStatus !== "PENDING" && b.reqStatus === "PENDING") return 1;
          return new Date(b.reqDate) - new Date(a.reqDate);
        });
        setRows(result);
      } else {
        setRows([]);
      }
    } catch (error) {
      console.error("Something went wrong", error);
    } finally {
      setIsLoading(false);
    }
  };

  const handleCancelRequest = async () => {
    try {
      const payload = {
        requestId,
        remarks: "User cancelled this Request",
      };

      const response = await callApi("/CR/cancel-request", payload, "PATCH");
      if (response?.success) {
        showSnackBar(
          `Request Id ${requestId} Cancelled Successfully.`,
          "success",
        );
      } else {
        showSnackBar(
          response?.message
            ? response?.message
            : "Failed to process your cancel request, Kindly try again",
          "error",
        );
      }
    } catch (error) {
      console.error(error);
    } finally {
      fetchData();
      setConfirmDialog(false);
    }
  };

  const handleViewClick = (data) => {
    const { currencyCode, currencyRate, existingCurrencyRate } = data;

    const showData = {
      currencyCode,
      existingCurrencyRate:
        currencyFormatterWith6Decimals("INR").format(existingCurrencyRate),
      updatedCurrencyRate:
        currencyFormatterWith6Decimals("INR").format(currencyRate),
    };

    data.showData = showData;
    setViewData(data);
    setViewOpen(true);
  };

  useEffect(() => {
    fetchData();
  }, []);

  const columns = useMemo(
    () => [
      { field: "id", headerName: "Request Id", flex: 0.5, minWidth: 150 },
      {
        field: "currencyCode",
        headerName: "Currency Code",
        flex: 1,
        minWidth: 150,
        sortable: true,
      },
      {
        field: "currencyRate",
        headerName: "Currency Rate",
        flex: 1,
        minWidth: 150,
        sortable: true,
        align: "right",
        headerAlign: "right",
        renderCell: (params) =>
          currencyFormatterWith6Decimals("INR").format(params.value),
      },
      {
        field: "reqDate",
        headerName: "Date of Submission",
        flex: 1.5,
        minWidth: 250,
        sortable: true,

        renderCell: (params) => (
          <Box>
            <StyledDateChip
              icon={<DateRangeIcon />}
              label={params.value.split("T")[0]}
            />
          </Box>
        ),
      },
      {
        field: "reqStatus",
        headerName: "Status",
        flex: 1,
        minWidth: 150,

        filterable: false,
        sortable: false,
        disableColumnMenu: true,
        renderCell: (params) => (
          <Box
            // sx={{
            //   color:
            //     params.value === "REJECTED"
            //       ? "error.main"
            //       : params.value === "ACCEPTED"
            //         ? "success.dark"
            //         : "warning.main",
            //   // fontWeight: "bold",
            // }}
          >
            <CustomChip
              variant="outlined"
              icon={
                params.value === "REJECTED" ? (
                  <BlockFlippedIcon />
                ) : params.value === "ACCEPTED" ? (
                  <CheckCircleIcon />
                ) : params.value === "CANCELLED" ? (
                  <GppBadIcon />
                ) : (
                  <PendingActionsIcon />
                )
              }
              label={
                params.value === "REJECTED"
                  ? "Rejected"
                  : params.value === "ACCEPTED"
                    ? "Approved"
                    : params.value === "CANCELLED"
                      ? "Cancelled"
                      : "Pending"
              }
              sx={{
                color:
                  params.value === "REJECTED"
                    ? "error.dark"
                    : params.value === "ACCEPTED"
                      ? "success.dark"
                      : params.value === "CANCELLED"
                        ? "primary.dark"
                        : "warning.main",

                "& .MuiChip-icon": {
                  color:
                    params.value === "REJECTED"
                      ? "error.dark"
                      : params.value === "ACCEPTED"
                        ? "success.dark"
                        : params.value === "CANCELLED"
                          ? "primary.dark"
                          : "warning.main",
                },
              }}
            />
          </Box>
        ),
      },
      {
        field: "action",
        headerName: "Action",
        flex: 0.6,
        minWidth: 150,
        filterable: false,
        sortable: false,
        disableColumnMenu: true,
        renderCell: (params) => {
          return (
            <Stack
              direction="row"
              spacing={1}
              justifyContent="left"
              alignItems="left"
              sx={{ height: "100%", pl: 3 }}
            >
              {permissions.view && (
                <Tooltip title="View">
                  <IconButton
                    // color="primary"
                    onClick={() => handleViewClick(params.row)}
                  >
                    <VisibilityIcon />
                  </IconButton>
                </Tooltip>
              )}

              {params.row.reqStatus === "PENDING" && permissions.cancel && (
                <Tooltip title={"Cancel Request"}>
                  <IconButton
                    onClick={() => {
                      setConfirmDialog(true);
                      setRequestId(params.row.id);
                    }}
                  >
                    <CancelIcon fontSize="inherit" />
                  </IconButton>
                </Tooltip>
              )}
            </Stack>
          );
        },
      },
    ],
    [],
  );

  const filteredColumns = useMemo(() => {
    if (permissions.view || permissions.cancel) {
      return columns;
    }
    // Otherwise, filter out the column where field name is 'action'.
    else {
      return columns.filter((column) => column.field !== "action");
    }
  }, [columns, permissions.cancel, permissions.view]);

  return (
    <>
      <Box sx={{ p: { xs: 2, md: 3 } }}>
        <DataGrid
          rows={rows}
          loading={isLoading}
          columns={filteredColumns}
          disableRowSelectionOnClick
          pageSizeOptions={[5, 10, 25, 50]}
          initialState={{
            pagination: { paginationModel: { pageSize: 10, page: 0 } },
            sorting: { sortModel: [{ field: "reqDate", sort: "desc" }] },
          }}
          getRowId={(row) => row.id ?? row.requestId}
          slots={{
            noRowsOverlay: CustomNoRowsOverlay,
          }}
          sx={{
              "& .MuiDataGrid-columnHeaders": {
              backgroundColor: "#f5f5f5 !important",
             border:"none",
             },
            }}
        />
      </Box>

      {/* View Dialog */}
      <ViewMyRequestDialog
        open={viewOpen}
        handleClose={() => setViewOpen(false)}
        data={viewData}
      />

      {/* Cancel Dialog */}
      <Dialog
        open={confirmDialog}
        onClose={() => {
          setConfirmDialog(false);
        }}
        maxWidth="sm"
        fullWidth
      >
        <DialogTitle sx={{ fontWeight: 600 }}>
          Cancel Request ID: {requestId}
        </DialogTitle>
        <DialogContent>
          <Typography sx={{ p: 1 }}>
            Are you sure you want to cancel this request Please confirm ?
          </Typography>
        </DialogContent>
        <DialogActions>
          <Button
            onClick={() => {
              setConfirmDialog(false);
            }}
            variant="outlined"
          >
            Cancel
          </Button>
          <Button
            onClick={handleCancelRequest}
            color="error"
            variant="contained"
          >
            Confirm
          </Button>
        </DialogActions>
      </Dialog>
    </>
  );
}
