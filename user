import React, { useEffect, useMemo, useState, useCallback } from "react";
import { Box, Paper, Button } from "@mui/material";
import useApi from "../../../hooks/useApi";

//import LogsSearchFilters from "../components/LogsSearchFilter";
//import LogsHeader from "../components/LogsHeader";
import LogsTable from "../components/LogsTable";
import LogsDialog from "../components/LogsDialog";
import DeleteConfirmDialog from "../components/DeleteConfirmDialog";
import useCustomSnackbar from "../../../utils/useCustomSnackbar";
import KeyboardReturnIcon from "@mui/icons-material/KeyboardReturn";
import { useNavigate } from "react-router-dom";

const API_URL = import.meta.env?.VITE_USERS_API_URL || "";

export default function UserLogs({ errorText, filteredCount }) {
  const { callApi, loading, error: apiError } = useApi();
  const navigate = useNavigate();
  // ---- server data ----
  const [rows, setRows] = useState([
    {
      LOG_ID: 234356,
      ACTION_TYPE: "PASSWORD_CHANGED",
      CHANGE_TYPE: "USER",
      ACTION_TIME: "2022-04-17 11:25:12.345",
      USER_ID: 325447,
      OLD_VALUE: {
        USERID: "1017860",
        PHONE_NUMBER: "34234234",
        FIRST_NAME: "Sampath",
        LAST_NAME: "Test",
        BRANCH: 12345,
        ROLE_ID: 51,
        ROLE_NAME: "UCO",
        ACCOUNT_STATUS: "ACTIVE",
        EMAIL: "b",
      },
      NEW_VALUE: {},
      IP_ADDRESS: "10.9.19.235",
    },
  ]);
  const [roles, setRoles] = useState([]);
  const [uiError, setUiError] = useState("");
  const [selectedRow, setSelectedRow] = useState();
  // ---- server query (accordion) ----
  const [reqUserid, setReqUserid] = useState("");

  const [reqAction, setreqAction] = useState("");

  // ---- client filters / selection ----
  const [query, setQuery] = useState("");
  const [filterRole, setFilterRole] = useState("");
  const [selection, setSelection] = useState([]);

  const [openEdit, setOpenEdit] = useState(false);

  // ---- delete dialog ----
  const [deleteTarget, setDeleteTarget] = useState(null);

  const snackbar = useCustomSnackbar();

  // ---- helpers ----
  const makePayload = useCallback(
    () => ({
      id: reqUserid || undefined,

      LogId: reqAction || undefined,
    }),
    [reqUserid, reqAction]
  );

  const normalizeUsers = useCallback((users = []) => {
    return users.map((u, idx) => {
      const USER_ID = u?.USER_ID ?? u?.USER_ID ?? "";

      const LogIdRaw = u?.LOG_ID ?? u?.LogId ?? "";
      const parsedLogId =
        typeof LogIdRaw === "number"
          ? LogIdRaw
          : Number.isNaN(parseInt(LogIdRaw, 10))
          ? LogIdRaw
          : parseInt(LogIdRaw, 10);

      return {
        id: USER_ID || String(idx + 1),
        USER_ID,
        EMAIL: (u?.EMAIL ?? u?.email ?? "").toString(),
        PHONE_NUMBER: (u?.PHONE_NUMBER ?? u?.phone ?? "").toString(),
        ROLE_NAME: (u?.ROLE_NAME ?? u?.roleName ?? "").toString().trim(),
        LOG_ID: parsedLogId,
        BRANCH: (u?.BRANCH ?? u?.branch ?? "").toString(),
        __name: name || USER_ID || "(unknown)",
        ACCOUNT_STATUS: u?.ACCOUNT_STATUS,
      };
    });
  }, []);

  const fetchUsers = useCallback(async () => {
    setUiError("");
    try {
      const data = await callApi(API_URL, makePayload(), "GET");
      const users = data?.result?.users ?? [];
      setRows(normalizeUsers(users));
    } catch (e) {
      console.error(e);
      setRows([]);
      setUiError(
        "Failed to fetch users. Check network, CORS, or API availability."
      );
    }
  }, [callApi, makePayload, normalizeUsers]);

  const fetchRoles = useCallback(async () => {
    try {
      const data = await callApi("/UM/role/get-roles", {}, "GET");
      const raw = data?.result?.roles ?? [];
      setRoles(
        raw.map((r) => ({
          id: r?.LogId,
          name: (r?.roleName ?? "").trim(),
          description: r?.description ?? "",
        }))
      );
    } catch (e) {
      console.error("Error while fetching roles", e);
    }
  }, [callApi]);

  const findRole = useCallback(
    (id) => roles.find((r) => String(r.id) === String(id)),
    [roles]
  );

  useEffect(() => {
    // fetchUsers();
    fetchRoles();
  }, [fetchUsers, fetchRoles]);

  // ---- client filtering ----
  const filteredRows = useMemo(() => {
    const q = query.trim().toLowerCase();
    return rows.filter((r) => {
      const okQ =
        !q ||
        r.__name?.toLowerCase().includes(q) ||
        r.EMAIL?.toLowerCase().includes(q) ||
        String(r.USER_ID ?? "")
          .toLowerCase()
          .includes(q) ||
        String(r.PHONE_NUMBER ?? "")
          .toLowerCase()
          .includes(q);

      const okRole =
        !filterRole ||
        String(r.LOG_ID) === String(filterRole) ||
        r.ROLE_NAME === (findRole(filterRole)?.name ?? "");

      return okQ && okRole;
    });
  }, [rows, query, filterRole, findRole]);

  const removeUser = useCallback(
    (id) => setRows((prev) => prev.filter((r) => r.id !== id)),
    []
  );

  const removeBulk = useCallback(
    () => setRows((prev) => prev.filter((r) => !selection.includes(r.id))),
    [selection]
  );

  // ---- export CSV ----
  const csvEscape = (v) => {
    const s = (v ?? "").toString();
    return /[",\n]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
  };
  const exportCSV = useCallback(() => {
    if (!filteredRows.length) return;
    const header =
      "{LOG_ID,ACTION_TYPE,CHANGE_TYPE,ACTION_TIME,USER_ID,OLD_VALUE ,NEW_VALUE,IP_ADDRESS ";
    const body = filteredRows.map((r) =>
      [
        csvEscape(r.LOG_ID),
        csvEscape(r.ACTION_TYPE),
        csvEscape(r.CHANGE_TYPE),
        csvEscape(r.ACTION_TIME),
        csvEscape(r.USER_ID),
        csvEscape(r.OLD_VALUE),
        csvEscape(r.NEW_VALUE),
        csvEscape(r.IP_ADDRESS),
      ].join(",")
    );
    const csv = [header, ...body].join("\n");
    const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = "usersLog.csv";
    a.click();
    URL.revokeObjectURL(url);
  }, [filteredRows]);

  const effectiveError =
    apiError?.response?.data?.message || apiError?.message || uiError || "";

  if (effectiveError !== "") {
    snackbar(
      apiError?.response?.data?.message || apiError?.message || uiError,
      "error"
    );
  }

  return (
    <Box sx={{ p: { xs: 2, md: 3 } }}>
      <Button
        size="small"
        variant="outlined"
        startIcon={<KeyboardReturnIcon />}
        onClick={() => navigate(-1)}
        //disabled={filteredCount === 0 || loading || errorText}
      >
        Back
      </Button>
      {/* Server-side filters */}
      {/* {!effectiveError && !loading && (
        <LogsSearchFilters
          roles={roles}
          reqUserid={reqUserid}
          reqAction={reqAction}
          onChangeUserid={setReqUserid}
          onChangeRole={setreqAction}
          loading={loading}
          errorText={effectiveError}
          onSearch={fetchUsers}
        />
      )} */}

      <Paper variant="outlined" sx={{ mt: 2 }}>
        {/* Header strip */}
        {/* {!effectiveError && !loading && (
          <LogsHeader
            roles={roles}
            filterRole={filterRole}
            onFilterRoleChange={setFilterRole}
            query={query}
            onQueryChange={setQuery}
            totalCount={rows.length}
            filteredCount={filteredRows.length}
            selectionCount={selection.length}
            onBulkDelete={removeBulk}
            onExport={exportCSV}
            loading={loading}
            errorText={effectiveError}
          />
        )} */}
          <Paper
    elevation={2}
    sx={{
      display:"flex",
      flexDirection:"column",
      borderRadius:2,
      overflow:"hidden",
      width:"100%",
      p:2,
    }}>
        <LogsTable
          rows={rows}
          roles={roles}
          loading={loading}
          onSelectionChange={setSelection}
          onViewRow={(row) => {
            const matched = findRole(row.LOG_ID);
            // setForm({
            //   ...row,
            //   LOG_ID: matched ? matched.id : row.LOG_ID,
            //   ROLE_NAME: matched ? matched.name : row.ROLE_NAME,
            // });
            setSelectedRow(row);
            setOpenEdit(true);
          }}
          onDeleteRow={(row) => setDeleteTarget(row)}
          errorText={effectiveError}
        />
        </Paper>

        {/* Grid */}

        {selectedRow && (
          <LogsDialog
            open={openEdit}
            onClose={() => setOpenEdit(false)}
            selectedRow={selectedRow}
          />
        )}

        <DeleteConfirmDialog
          open={!!deleteTarget}
          name={deleteTarget?.__name || deleteTarget?.USER_ID}
          onCancel={() => setDeleteTarget(null)}
          onConfirm={() => {
            if (deleteTarget?.id) removeUser(deleteTarget.id);
            setDeleteTarget(null);
          }}
        />
      </Paper>
    </Box>
  );
}
