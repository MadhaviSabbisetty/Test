// DashboardFrequencyStats.jsx
import React, { useMemo } from "react";
import PropTypes from "prop-types";
import { useTheme } from "@mui/material/styles";
import Card from "@mui/material/Card";
import CardContent from "@mui/material/CardContent";
import Chip from "@mui/material/Chip";
import Typography from "@mui/material/Typography";
import Stack from "@mui/material/Stack";
import Box from "@mui/material/Box";
import { LineChart } from "@mui/x-charts/LineChart";

/**
 * DashboardFrequencyStats
 *
 * Props:
 * - frequencyStats: {
 *     createdToday, approvedToday, rejectedToday,
 *     createdThisWeek, approvedThisWeek, rejectedThisWeek
 *   }
 * - title (optional)
 * - height (optional)
 *
 * Renders:
 * - top chips showing today's counts
 * - small 7-day generated sparkline (created/approved/rejected) using weekly totals if available,
 *   otherwise using today's numbers distributed across last 7 days.
 */
export default function DashboardFrequencyStats({
  frequencyStats = {},
  title = "Requests Frequency",
  height = 180,
}) {
  const theme = useTheme();

  // defensive defaults
  const {
    createdToday = 0,
    approvedToday = 0,
    rejectedToday = 0,
    createdThisWeek,
    approvedThisWeek,
    rejectedThisWeek,
  } = frequencyStats || {};

  // generate 7 labels D-6 .. D-0
  const days = 7;
  const labels = Array.from({ length: days }, (_, i) => `D-${days - 1 - i}`); // D-6 ... D-0 (D-0 is today)

  // helper: distribute a total across 7 days, heavier weight to most recent day
  const distribute = (total) => {
    if (!total || total <= 0) {
      // return zeros but keep last point as today's value if available
      return Array.from({ length: days }, (_, i) => 0);
    }

    // weights: older days smaller, recent day slightly larger
    const baseWeights = [0.7, 0.8, 0.9, 1, 1.1, 1.2, 1.8]; // sum ~8.5
    const sum = baseWeights.reduce((s, w) => s + w, 0);
    const arr = baseWeights.map((w) => Math.round((w / sum) * total));
    // adjust rounding difference
    const diff = total - arr.reduce((s, v) => s + v, 0);
    if (diff !== 0) {
      arr[arr.length - 1] += diff;
    }
    return arr;
  };

  // choose weekly totals if available, otherwise fall back to today * 7
  const createdTotal =
    typeof createdThisWeek === "number"
      ? createdThisWeek
      : Math.max(createdToday * days, createdToday);
  const approvedTotal =
    typeof approvedThisWeek === "number"
      ? approvedThisWeek
      : Math.max(approvedToday * days, approvedToday);
  const rejectedTotal =
    typeof rejectedThisWeek === "number"
      ? rejectedThisWeek
      : Math.max(rejectedToday * days, rejectedToday);

  // memoize series arrays
  const [createdSeries, approvedSeries, rejectedSeries] = useMemo(() => {
    return [
      distribute(createdTotal),
      distribute(approvedTotal),
      distribute(rejectedTotal),
    ];
  }, [createdTotal, approvedTotal, rejectedTotal]);

  // prepare series objects for LineChart
  const series = [
    {
      id: "created",
      label: "Created",
      data: createdSeries,
      area: true,
      curve: "linear",
      showMark: false,
      stack: "total",
    },
    {
      id: "approved",
      label: "Approved",
      data: approvedSeries,
      area: true,
      curve: "linear",
      showMark: false,
      stack: "total",
    },
    {
      id: "rejected",
      label: "Rejected",
      data: rejectedSeries,
      area: true,
      curve: "linear",
      showMark: false,
      stack: "total",
    },
  ];

  const colorPalette = [
    theme.palette.primary.light,
    theme.palette.primary.main,
    theme.palette.error.main,
  ];

  // small helper text for caption
  const summaryText = `Showing last ${days} days (generated from weekly totals)`;

  return (
    <Card variant="outlined" sx={{ borderRadius: 3 }}>
      <CardContent>
        <Stack
          direction="row"
          justifyContent="space-between"
          alignItems="center"
          mb={1}
        >
          <Typography component="h2" variant="subtitle2">
            {title}
          </Typography>

          <Stack direction="row" spacing={1} alignItems="center">
            <Chip size="small" label={`Created: ${createdToday}`} />
            <Chip
              size="small"
              color="success"
              label={`Approved: ${approvedToday}`}
            />
            <Chip
              size="small"
              color="error"
              label={`Rejected: ${rejectedToday}`}
            />
          </Stack>
        </Stack>

        <Typography
          variant="caption"
          color="text.secondary"
          display="block"
          mb={1}
        >
          {summaryText}
        </Typography>

        <Box sx={{ width: "100%", height }}>
          <LineChart
            colors={colorPalette}
            xAxis={[
              {
                scaleType: "point",
                data: labels,
                tickInterval: (index, i) => (i + 1) % 2 === 0, // show every other tick by default
                height: 24,
              },
            ]}
            yAxis={[{ width: 48 }]}
            series={series}
            height={height}
            margin={{ left: 0, right: 12, top: 6, bottom: 0 }}
            grid={{ horizontal: true }}
            hideLegend
          />
        </Box>
      </CardContent>
    </Card>
  );
}

DashboardFrequencyStats.propTypes = {
  frequencyStats: PropTypes.shape({
    createdToday: PropTypes.number,
    approvedToday: PropTypes.number,
    rejectedToday: PropTypes.number,
    createdThisWeek: PropTypes.number,
    approvedThisWeek: PropTypes.number,
    rejectedThisWeek: PropTypes.number,
  }),
  title: PropTypes.string,
  height: PropTypes.number,
};
