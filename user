export default GLRectificationSummary;
import React, { useEffect, useState } from "react";
import { Box, Chip, Typography } from "@mui/material";
import GLRectificationTable from "./GLRectificationTable";
import useApi from "../../hooks/useApi";
import downloadFile from "../../utils/DownloadUtils";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import GLRectificationSummary from "./GLRectificationSummary";
import GLInvalidGroups from "./GLInvalidGroups";
import { Button, Dialog, DialogTitle, DialogContent } from "@mui/material";

import FilterListIcon from "@mui/icons-material/FilterList";

const GLRectificationPage = () => {
  const { callApi } = useApi();
  const [summary, setSummary] = useState({});
  const showSnackBar = useCustomSnackbar();

  const [rows, setRows] = useState([]);
  const [page, setPage] = useState(0);
  const [pageSize, setPageSize] = useState(25);
  const [totalElements, setTotalElements] = useState(0);
  const [groups, setGroups] = useState({});
  const [groupDialogOpen, setGroupDialogOpen] = useState(false);

  const [selectedGroup, setSelectedGroup] = useState(null);

  const fetchData = async (
    pageNo = 0,
    size = pageSize,
    filter = selectedGroup,
  ) => {
    try {
      let url = `/CM/gl-invalid?page=${pageNo}&size=${size}`;

      if (filter) {
        url += `&type=${filter.type}` + `&value=${filter.invalidValue}`;
      }

      const res = await callApi(url, null, "GET");

      const data = res?.data;

      setRows(data?.data || []);

      setPage(data?.currentPage || 0);

      setTotalElements(data?.totalElements || 0);
    } catch {
      showSnackBar("Failed to fetch data");
    }
  };

  const fetchGroups = async () => {
    try {
      const res = await callApi("/CM/gl-invalid/groups", null, "GET");

      setGroups(res || {});
    } catch {
      showSnackBar("Failed to load groups");
    }
  };

  const fetchSummary = async () => {
    try {
      const res = await callApi("/CM/gl-invalid/summary", null, "GET");

      setSummary(res || {});
    } catch {
      showSnackBar("Failed to fetch summary");
    }
  };
  const handleDownload = async () => {
    try {
      const res = await callApi(
        "/CM/gl-invalid/download",
        null,
        "POST",
        "arraybuffer",
      );

      if (res?.byteLength) {
        downloadFile(res, "excel", "gl_rectification");
      }
    } catch {
      showSnackBar("Failed to download excel");
    }
  };

  useEffect(() => {
    fetchData(0);

    fetchSummary();

    fetchGroups();
  }, []);

  return (
    <Box
      sx={{
        p: 2,
        display: "flex",
        flexDirection: "column",
        gap: 2,
        height: "100%",
        overflow: "hidden",
      }}
    >
      <GLRectificationSummary summary={summary} />
      <Box
        sx={{
          display: "flex",
          justifyContent: "space-between",
          alignItems: "center",
          mb: 2,
        }}
      >
        <Button
          variant="outlined"
          startIcon={<FilterListIcon />}
          onClick={() => setGroupDialogOpen(true)}
          sx={{
            borderRadius: 3,
            textTransform: "none",
            fontWeight: 700,
          }}
        >
          Filter Invalid Groups
        </Button>

        <Button variant="contained" onClick={handleDownload}>
          Download Excel
        </Button>

        {selectedGroup && (
          <Chip
            label={`${selectedGroup.type} : ${selectedGroup.invalidValue}`}
            color="primary"
            onDelete={() => {
              setSelectedGroup(null);

              fetchData(0, pageSize, null);
            }}
          />
        )}
      </Box>

      <GLRectificationTable
        rows={rows}
        page={page}
        setPage={setPage}
        pageSize={pageSize}
        setPageSize={setPageSize}
        totalElements={totalElements}
        fetchData={fetchData}
        fetchSummary={fetchSummary}
        fetchGroups={fetchGroups}
        selectedGroup={selectedGroup}
        groups={groups}
      />
      <Dialog
        open={groupDialogOpen}
        onClose={() => setGroupDialogOpen(false)}
        maxWidth="lg"
        fullWidth
      >
        <DialogTitle
          sx={{
            fontWeight: 800,
          }}
        >
          Invalid Groups
        </DialogTitle>

        <DialogContent>
          <GLInvalidGroups
            groups={groups}
            selectedGroup={selectedGroup}
            setSelectedGroup={(group) => {
              setSelectedGroup(group);

              fetchData(0, pageSize, group);

              setGroupDialogOpen(false);
            }}
          />
        </DialogContent>
      </Dialog>
    </Box>
  );
};

export default GLRectificationPage;
import React from "react";

import { Box, Typography, Paper, Chip } from "@mui/material";

const Section = ({ title, data, color, onSelect, selectedValue }) => {
  return (
    <Box mb={3}>
      <Typography
        sx={{
          fontSize: 12,
          fontWeight: 800,
          mb: 1.2,
          color: "#6b7280",
          textTransform: "uppercase",
          letterSpacing: 0.5,
        }}
      >
        {title}
      </Typography>

      <Box
        sx={{
          display: "flex",
          gap: 1.5,
          overflowX: "auto",
          pb: 1,

          "&::-webkit-scrollbar": {
            height: 6,
          },

          "&::-webkit-scrollbar-thumb": {
            background: "#d1d5db",
            borderRadius: 10,
          },
        }}
      >
        {data.map((item) => {
          const selected = selectedValue === item.invalidValue;

          return (
            <Paper
              key={item.invalidValue}
              elevation={0}
              onClick={() => onSelect(item)}
              sx={{
                minWidth: 150,
                p: 1.5,
                borderRadius: 3,
                cursor: "pointer",
                flexShrink: 0,

                border: selected ? `2px solid ${color}` : "1px solid #ececec",

                backgroundColor: selected ? `${color}12` : "#fff",

                transition: "all 0.2s ease",

                "&:hover": {
                  borderColor: color,
                  transform: "translateY(-1px)",
                  boxShadow: "0 4px 12px rgba(0,0,0,0.06)",
                },
              }}
            >
              <Typography
                sx={{
                  fontSize: 15,
                  fontWeight: 700,
                  color: "#111827",
                }}
              >
                {item.invalidValue}
              </Typography>

              <Typography
                sx={{
                  fontSize: 11,
                  color: "#6b7280",
                  mt: 0.5,
                }}
              >
                Click to filter
              </Typography>

              <Chip
                label={`${item.count} rows`}
                size="small"
                sx={{
                  mt: 1.2,
                  backgroundColor: `${color}15`,
                  color,
                  fontWeight: 700,
                }}
              />
            </Paper>
          );
        })}
      </Box>
    </Box>
  );
};

const GLInvalidGroups = ({ groups, selectedGroup, setSelectedGroup }) => {
  return (
    <Box
      sx={{
        p: 2,
        mb: 2,
      }}
    >
      <Typography
        sx={{
          fontSize: 18,
          fontWeight: 800,
          color: "#111827",
          mb: 0.5,
        }}
      >
        Invalid Groups
      </Typography>

      <Typography
        sx={{
          fontSize: 13,
          color: "#6b7280",
          mb: 2.5,
        }}
      >
        Select a group to filter records
      </Typography>

      <Section
        title="Invalid Branches"
        data={groups?.branches || []}
        color="#dc2626"
        selectedValue={selectedGroup?.invalidValue}
