@Service
@RequiredArgsConstructor
@Slf4j
public class AsciiFileServiceImpl implements AsciiFileService {

    private final AsciiMasterRepository asciiMasterRepository;

    private final AsciiConfigRepository asciiConfigRepository;

    private final AsciiConfigTbRepository asciiConfigTbRepository;

    private final HdfsService hdfsService;

    @Value("${glif.reports.base-path}");
    private String hdfsBasePath;

    private static final Pattern SAFE_PATH_PATTERN = Pattern.compile("^[a-zA-Z0-9/_\\-\\.]+$");

    @Override
    public List<AsciiTypeResponse> getAsciiTypes(){

        log.info("API called - into service");
        List<AsciiTypeResponse> response=asciiMasterRepository.findAll()
            .stream()
            .map(a->
                    new AsciiTypeResponse(
                        a.getId(),
                        a.getReportName()
                    ))
                    .toList();
                    if(response.isEmpty()){
                        throw new IllegalArgumentException("No ASCII file types found");
                    }
                    return response;
    }

    // To view the ASCII file types
    @Override
    public AsciiFileResponse viewAscii(AsciiFileRequest request) {

        try {

            AsciiMaster master =
                    asciiMasterRepository.findById(request.getId())
                            .orElseThrow(() ->
                                    new IllegalArgumentException("Invalid ASCII ID"));

            String hdfsPath = buildFilePath(master, request);

            FileSystem fs = hdfsService.getFs();

            // Path path = new Path(hdfsPath);

            Path path = Path.getPathWithoutSchemeAndAuthority(new Path(hdfsPath));

            Path normalizedPath = Path.getPathWithoutSchemeAndAuthority(path);

            if (!normalizedPath.toString().equals(path.toString())) {
                throw new SecurityException("Invalid HDFS path");
            }

            // boolean fileExists=fs.exists(path);

            log.info("checking hdfs path: {}",path);
            log.info("Exists: {}",fs.exists(path));

            if (!fs.exists(path)) {
               throw new IllegalArgumentException("ASCII File not found");
            }

            StringBuilder content = new StringBuilder();

            // try (FSDataInputStream inputStream = fs.open(path);
            try (FSDataInputStream inputStream = fs.open(normalizedPath);
                 BufferedReader reader = new BufferedReader(new InputStreamReader(inputStream))) {

                String line;

                while ((line = reader.readLine()) != null) {
                    content.append(line)
                           .append(System.lineSeparator());
                }
            }

            AsciiFileResponse response = new AsciiFileResponse();

            response.setId(request.getId());
            response.setReportDate(request.getReportDate());
            response.setSearchBy(request.getSearchBy());

            if ("branch".equalsIgnoreCase(request.getSearchBy())) {
                response.setBranchCode(request.getBranchCode());
            }

            response.setContent(content.toString());

            return response;

        } catch (Exception e) {

            log.error("Error while viewing ascii file", e);

            throw new IllegalArgumentException("Invalid normalized path");
        }
    }

    //To download the ASCII files
    @Override
    public ResponseEntity<byte[]> downloadAscii(AsciiFileRequest request) {
        try {
            AsciiMaster master = asciiMasterRepository.findById(request.getId())
                    .orElseThrow(() -> new IllegalArgumentException("Invalid ASCII ID"));

            String hdfsPath = buildFilePath(master, request);

            FileSystem fs = hdfsService.getFs();
            // Path path = new Path(hdfsPath);
            Path path = Path.getPathWithoutSchemeAndAuthority(new Path(hdfsPath));

            Path normalizedPath = Path.getPathWithoutSchemeAndAuthority(path);

            if (!normalizedPath.equals(path)) {
                throw new SecurityException("Invalid HDFS path");
            }


            if (!fs.exists(path)) {
                throw new IllegalArgumentException("Failed to download. ASCII File not found");
            }

            // Sink: Fortify flags this line because hdfsPath contains DB data
            // FSDataInputStream inputStream = fs.open(path);
            
            // FSDataInputStream inputStream = fs.open(normalizedPath);

            // byte[] fileContent = inputStream.readAllBytes();
            // inputStream.close();

            byte[] fileContent;

            try (FSDataInputStream inputStream = fs.open(normalizedPath)) {

                fileContent = inputStream.readAllBytes();
            }

            String fileName = path.getName();

            HttpHeaders headers = new HttpHeaders();
            headers.setContentType(MediaType.TEXT_PLAIN);
            // headers.add(HttpHeaders.CONTENT_DISPOSITION, "attachment; filename=\"" + fileName + ".txt\"");

            
            headers.setContentDisposition(
                    ContentDisposition.attachment()
                            .filename(fileName + ".txt", StandardCharsets.UTF_8)
                            .build());


            headers.setContentLength(fileContent.length);
            headers.add(HttpHeaders.ACCESS_CONTROL_EXPOSE_HEADERS, HttpHeaders.CONTENT_DISPOSITION);

            return new ResponseEntity<>(fileContent, headers, HttpStatus.OK);

        } catch (IllegalArgumentException | IOException e) {
            // log.error("Error while downloading ascii file", e);
            throw new IllegalArgumentException("Unable to view ASCII file.");
        }
    }

    // To build the final path
    private String buildFilePath(AsciiMaster master,AsciiFileRequest request) {

        if("branch".equalsIgnoreCase(request.getSearchBy())
        && (request.getBranchCode()==null
        || request.getBranchCode().isBlank())){
            throw new IllegalArgumentException("Branch code is mandatory for branch search");
        }

        
        if (request.getReportDate() == null
                || !request.getReportDate().matches("\\d{2}-\\d{2}-\\d{4}")) {

            throw new IllegalArgumentException("Invalid report date");
        }


        LocalDate reportDate=LocalDate.parse(request.getReportDate(),
        DateTimeFormatter.ofPattern("dd-MM-yyyy"));

        log.info("Parsed report date: {}",reportDate);

        String dateFolder= reportDate.format(DateTimeFormatter.ofPattern("yyyy-MM-dd"));

        String fileDate= reportDate.format(DateTimeFormatter.ofPattern("yyyyMMdd"));

        // 1. Sanitize the location from DB
        String rawLocation = master.getLocation().replace("{date}", dateFolder);

        if (rawLocation.contains("..")) {
            throw new SecurityException("Invalid report location");
        }


        String safeLocation = sanitizePathSegment(rawLocation);
        if (safeLocation.contains("..")) {
            throw new SecurityException("Directory traversal detected");
        }

        String branchCode = "bank".equalsIgnoreCase(request.getSearchBy())
                        ? "00000" : request.getBranchCode();

                
        if (!branchCode.matches("\\d{5}")) {
            throw new IllegalArgumentException("Invalid branch code");
        }
              


        String fileName;
        

        if (request.getId() >= 101 && request.getId() <= 104) {

            AsciiConfig config = asciiConfigRepository.findById(request.getId())
                            .orElseThrow(() ->
                                    new IllegalArgumentException("ASCII Config not found"));

            String safeOutputName = sanitizePathSegment(config.getOutputFileName());
            String safeFileType = config.getFileType() != null && !config.getFileType().isBlank()
                    ? sanitizePathSegment(config.getFileType())
                    : null;

            if (safeFileType != null) {
                fileName = branchCode + "." + safeOutputName + "." + fileDate + "." + safeFileType;
            } else {
                fileName = branchCode + "." + safeOutputName + "." + fileDate;
            }

            if (!fileName.matches("[A-Za-z0-9._-]+")) {
                throw new SecurityException("Invalid file name");
            }

        }
        else if (request.getId() >= 105 && request.getId() <= 107) {

            AsciiConfigTb configTb = asciiConfigTbRepository.findById(request.getId())
                            .orElseThrow(() ->
                                    new IllegalArgumentException("ASCII Config TB not found"));

            String safeFileIdentifier = sanitizePathSegment(configTb.getFileIdentifier());
            fileName = branchCode + "." + safeFileIdentifier + "." + fileDate;
        }
        else {

            throw new IllegalArgumentException("Invalid ASCII ID");
        }
        // String finalPath = "/" + safeLocation + "/" + fileName;
                
        Path finalHdfsPath = new Path( hdfsBasePath+"/"+safeLocation, fileName);
        String finalPath = finalHdfsPath.toString();
        if (!SAFE_PATH_PATTERN.matcher(finalPath).matches() || finalPath.contains("..")) {
            throw new SecurityException("Invalid path detected: Path manipulation attempt blocked.");
        }

        log.info("final path: {}", finalPath);
        return finalPath;
    }

    /**
     * Removes any character that is not explicitly allowed in a file path segment.
     * This breaks any traversal sequences stored in the DB.
     */
    // private String sanitizePathSegment(String input) {
    //     if (input == null || input.isBlank()) {
    //         return "";
    //     }
    //     // Replace any invalid character with an underscore (or throw exception)
    //     // This ensures Fortify sees the data as "sanitized"
    //     return input.replaceAll("[^a-zA-Z0-9/_\\-\\.]", "_");
    // }

    private String sanitizePathSegment(String input) {

        if (input == null || input.isBlank()) {
            throw new IllegalArgumentException("Invalid path");
        }

        String sanitized = input.trim();

        if (sanitized.contains("..")) {
            throw new SecurityException("Directory traversal detected");
        }

        if (!SAFE_PATH_PATTERN.matcher(sanitized).matches()) {
            throw new SecurityException("Invalid characters in path");
        }

        return sanitized;
    }
}
