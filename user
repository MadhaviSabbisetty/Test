package com.fincore.CommunicationService.controller;

import com.fincore.CommunicationService.dto.attachment.AttachmentDownloadRequest;
import com.fincore.CommunicationService.dto.attachment.AttachmentDownloadResponse;
import com.fincore.CommunicationService.dto.attachment.PreparedAttachmentResponse;
import com.fincore.CommunicationService.attachment.AttachmentPreparationService;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.web.bind.annotation.*;
import java.io.IOException;

@Slf4j
@RestController
@RequiredArgsConstructor
@RequestMapping("/api/reports")
public class AttachmentController{
    private final AttachmentPreparationService attachmentPreparationService;
    
    @PostMapping("/attachment/download")
    public AttachmentDownloadResponse download(@RequestBody AttachmentDownloadRequest request,@RequestHeader("Authorization") String token)throws IOException{
        log.info("Download request received");
        
        return attachmentPreparationService.prepareAttachments(request,token);

    }
}
