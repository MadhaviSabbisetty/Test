          value: a.value, // A, L, I, E, M
          label: a.label,
        })),
        renderCell: (params) => {
          const found = ACCOUNT_CLASSIFICATIONS.find(
            (x) => x.value === params.value,
          );
          return (
            <CustomChip
              label={found?.label}
              icon={found?.icon}
              variant="outlined"
            />
          );
        },
      },

      {
        field: "balCompare",
        headerName: "Balance Compare",
        flex: 1,
        minWidth: 150,
        headerAlign: "center",
        align: "center",
        filterable: false,
        sortable: false,
        disableColumnMenu: true,
        renderCell: (params) => (
          <CustomChip
            size="small"
            variant="outlined"
            icon={
              params.row.balCompare ? (
                <BookmarkAddedIcon />
              ) : (
                <BookmarkRemoveIcon />
              )
            }
            label={params.row.balCompare ? "Include" : "Exclude"}
            row={params.row}
          />
        ),
      },

      {
        field: "manualPosting",
        headerName: "Manual Posting",
        flex: 1,
        minWidth: 150,
        headerAlign: "center",
        align: "center",
        filterable: false,
        sortable: false,
        disableColumnMenu: true,
        renderCell: (params) => (
          <CustomChip
            size="small"
            variant="outlined"
            icon={params.row.manualPosting ? <GppGoodIcon /> : <GppBadIcon />}
            label={params.row.manualPosting ? "Allowed" : "Not Allowed"}
