export default function SegmentMasterTab() {
  const selectedMenuItem = useSelector((s) => s.menus.selectedMenuItem);
  const requestType = selectedMenuItem?.requestType || "";
  const permissions = getPermissions(selectedMenuItem);
  const [rows, setRows] = useState([]);
  const [open, setOpen] = useState(false);
  const { callApi } = useApi();
  const [originalData, setOriginalData] = useState(null); // New state for original data
  const [isDataSame, setIsDataSame] = useState(true);
  const [editingId, setEditingId] = useState(null);
  const [segmentData, setSegmentData] = useState({
    segmentCode: "",
    description: "",
  });
  const [errors, setErrors] = useState({});
  const checkDataEquality = (current, original) => {
    if (!original) return true; // If no original data, assume they are "same" initially for disable state
    return (
      current.description === original.description
      // currencyCode is excluded as it is the ID and likely read-only
    );
  };
  const snackbar = useCustomSnackbar();

  // --- throttle snackbars so they don't spam while typing ---
  const snackGateRef = useRef(true);
  const notifyOnce = (msg, variant = "warning") => {
    if (!snackGateRef.current) return;
    snackGateRef.current = false;
    snackbar(msg, variant);
    setTimeout(() => (snackGateRef.current = true), 800);
  };

  const fetchData = async () => {
    const payload = { requestType: "SEGMENT_CODE" };
    const response = await callApi(
      "/CM/common-master/segment-codes",
      payload,
      "GET",
    );
    setRows(response ? (response.data ?? []) : []);
  };

  useEffect(() => {
    fetchData();
  }, []);

  useEffect(() => {
    if (editingId && originalData) {
      setIsDataSame(checkDataEquality(segmentData, originalData));
    }
  }, [segmentData, originalData, editingId]);

  // --- validators ---
  const reDigits = /^[0-9]*$/;
  // const reDesc = /^[a-zA-Z0-9\s/&()-.]*$/;
  const reDesc = /^(?!.* {2})[a-zA-Z0-9\s/&(),-]*$/;

  const validateField = (name, value) => {
    let err = "";

    if (name === "segmentCode") {
      if (!value.trim()) err = "Segment Code is required";
      else if (!reDigits.test(value)) err = "Only digits allowed";
      else if (value.length !== 4) err = "Must be 4 digits";
    }

    if (name === "description") {
      if (!value) err = "Description is required";
      else if (!reDesc.test(value))
        err =
          "Invalid Format, Only alphabets, numbers, spaces(single spaces only between words) and ,()&/- are allowed!";
      else if (value?.length < 5)
        err = "Description must be at least 5 characters";
    }

    return err;
  };

  const isFormValid = () => {
    return (
      !validateField("segmentCode", segmentData.segmentCode) &&
      !validateField("description", segmentData.description)
    );
  };

  // --- live validation on change + snackbars for bad keystrokes ---
  const handleChange = (e) => {
    const { name, value } = e.target;

    // Allow soft typing for segmentCode: block invalid keystroke immediately
    if (name === "segmentCode") {
      if (!reDigits.test(value)) {
        notifyOnce("Segment Code accepts digits only");
        return; // block update
      }
      if (value.length > 4) {
        notifyOnce("Segment Code must be 4 digits");
        return; // block update
      }
    }

    if (name === "description") {
      if (value && !/^[A-Za-z0-9]$/.test(value[0])) {
        notifyOnce("Should not start with special character");
        return;
      }
      // soft block invalid characters
      if (!reDesc.test(value)) {
        notifyOnce(
          "Invalid Format, Only alphabets, spaces(single spaces only between words) and ,()&/- are allowed!",
        );
        return;
      }
    }

    setSegmentData((prev) => ({ ...prev, [name]: value }));

    // update error for just this field
    setErrors((prev) => ({
      ...prev,
      [name]: validateField(name, value),
    }));
  };

  const validateFormAndSet = () => {
    const newErrors = {
      segmentCode: validateField("segmentCode", segmentData.segmentCode),
      description: validateField("description", segmentData.description),
    };
    setErrors(newErrors);
    const ok = !newErrors.segmentCode && !newErrors.description;
    if (!ok) notifyOnce("Please fix validation errors", "error");
    return ok;
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    if (!validateFormAndSet()) return;

    if (editingId && isDataSame) {
      snackbar("No Changes Detected!", "warning");
      return; // Stop submission
    }

    const isEditing = editingId;
    if (!isEditing) {
      const segmentExists = rows.some(
        (row) => row.segmentCode === segmentData.segmentCode,
      );
      if (segmentExists) {
        snackbar("Segment code already exist", "warning");
        return;
      }
    }

    const payloadData = {
      requestType,
      changeType: editingId ? "UPDATE" : "ADD",
      targetId: segmentData.segmentCode,
      payload: {
        segmentCode: segmentData.segmentCode.trim(),
        description: segmentData.description.trim(),
      },
    };

    try {
      const response = await callApi("/CR/create-request", payloadData, "POST");
      if (response) {
        snackbar(
          editingId
            ? "Segment update request submitted successfully with request id " +
                response?.data?.id
            : "Segment creation request submitted successfully with request id " +
                response?.data?.id,
          "success",
        );
        handleClose();
        fetchData();
      }
    } catch (error) {
      snackbar(error?.message || "Request failed", "error");
    }
  };

  const columns = useMemo(
    () => [
      {
        field: "segmentCode",
        headerName: "Segment Code",
        flex: 1,
        minWidth: 180,
        sortable: true,
      },
      {
        field: "description",
        headerName: "Description",
        flex: 3,
        minWidth: 200,
        sortable: true,
      },
      {
        field: "actions",
        headerName: "Actions",
        flex: 0.6,
        minWidth: 150,
        headerAlign: "center",
        align: "center",
        filterable: false,
        sortable: false,
        disableColumnMenu: true,
        renderCell: (params) => (
          <Box
            direction="row"
            spacing={1}
            alignItems="center"
            justifyContent="center"
            sx={{ Height: "100%" }}
          >
            <Tooltip title="Approve">
              <IconButton
                size="small"
                color="primary"
                onClick={() => handleEdit(params.row)}
              >
                <EditIcon />
              </IconButton>
            </Tooltip>
          </Box>
        ),
      },
    ],
    [],
  );

  const filteredColumns = useMemo(() => {
    if (permissions.modify || permissions.block || permissions.unblock) {
      return columns;
    }
    // Otherwise, filter out the column where field name is 'action'.
    else {
      return columns.filter((column) => column.field !== "action");
    }
  }, [columns, permissions.block, permissions.modify, permissions.unblock]);

  const resetForm = () => {
    setSegmentData({ segmentCode: "", description: "" });
    setOriginalData(null); // Clear original data on close
    setErrors({});
    setEditingId(null);
    setIsDataSame(true);
  };

  const handleEdit = (row) => {
    const initialData = {
      segmentCode: String(row.segmentCode ?? ""),
      description: String(row.description ?? ""),
    };
    setSegmentData(initialData);
    setOriginalData(initialData); // Store the original data here
    setEditingId(row.segmentCode);
    setOpen(true);
    setIsDataSame(true);
  };

  const handleClose = () => {
    setOpen(false);
    resetForm();
  };

  return (
    <Box>
      <DataGrid
        rows={rows}
        columns={filteredColumns}
        disableRowSelectionOnClick
