export default function MyCGLRequestsTab() {
  const [cglList, setCglList] = useState([]);
  const [isLoading, setIsLoading] = useState(true);
  const [confirmDialog, setConfirmDialog] = useState(false);
  const [requestId, setRequestId] = useState(null);
  const [viewOpen, setViewOpen] = useState(false);
  const [viewData, setViewData] = useState(null);
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();
  const selectedMenuItem = useSelector((state) => state.menus.selectedMenuItem);
  const permissions = getPermissions(selectedMenuItem);

  const fetchData = async () => {
    try {
      setIsLoading(true);
      const payload = { requestType: "CGL_CODE" };
      const response = await callApi("/CR/my-requests", payload, "POST");
      const result = response.data?.map((row) => {
        let parsedPayload = {};
        parsedPayload = row.payload ? row.payload : {};
        const { comp1 = "", segmentCode = "", comp2 = "" } = parsedPayload;
        parsedPayload = {
          ...parsedPayload,
          ...row,
        };
        return {
          ...parsedPayload,
          cglNumber: `${comp1}${segmentCode}${comp2}`,
        };
      });
      setCglList(result);
    } catch (error) {
      console.error(
        "Something went wrong, Kindly try again after sometime.",
        error,
      );
    } finally {
      setIsLoading(false);
    }
  };

  useEffect(() => {
    fetchData();
  }, []);

  const handleCancelRequest = async () => {
    try {
      const payload = {
        requestId,
        remarks: "User canceled this Request",
      };

      const response = await callApi("/CR/cancel-request", payload, "PATCH");
      if (response?.success) {
        showSnackBar(
          `Request Id ${requestId} Cancelled Successfully.`,
          "success",
        );
      } else {
        showSnackBar(
          response?.message
            ? response?.message
            : "Failed to process your cancel request, Kindly try again",
          "error",
        );
      }
    } catch (error) {
      console.error(error);
    } finally {
      fetchData();
      setConfirmDialog(false);
    }
  };

  const handleViewClick = (data) => {
    const {
      comp1,
      segmentCode,
      comp2,
      description,
      acClassification,
      balFwd,
      defBalType,
      status,
      balCompare,
      manualPosting,
    } = data;

    const accountClassifications = ACCOUNT_CLASSIFICATIONS.find(
      (x) => x.value === acClassification,
    );

    const balanceForward = balFwd == "1" ? "Yes" : "No";

    const defaultBalanceType =
      defBalType == "C" ? "Credit" : defBalType == "D" ? "Debit" : "Memo";

    const cglStatus = status == "1" ? "Active" : "Inactive";

    const balanceCompare = balCompare == "1" ? "Include" : "Exclude";

    const manualPostingAllowed = manualPosting == "1" ? "Yes" : "No";

    const showData = {
      "CGL Code": comp1 + segmentCode + comp2,
      description,
      accountClassification: accountClassifications.label,
      comp1,
      segmentCode,
      comp2,
      balanceForward,
      // defaultBalanceType,
      "CGL Status": cglStatus,
      balanceCompare,
      manualPostingAllowed,
    };

    data.showData = showData;
    setViewData(data);
    setViewOpen(true);
  };

  const columns = useMemo(
    () => [
      { field: "id", headerName: "Request Id", flex: 0.5, minWidth: 150 },
      {
        field: "cglNumber",
        headerName: "CGL Code",
        flex: 1,
        minWidth: 150,
        renderCell: (params) => (
          <Box
            // sx={{
            //   fontFamily: "Monospace",
            //   letterSpacing: "0.08em",
            //   fontWeight: 700,
            // }}
          >
            {params.value}
          </Box>
        ),
      },
      {
        field: "description",
        headerName: "Description",
        flex: 2,
        minWidth: 300,
        sortable: true,
      },
      {
        field: "changeType",
        headerName: "Request Type",
        flex: 0.5,
        minWidth: 150,
        headerAlign: "center",
        align: "center",
        filterable: false,
        sortable: false,
        disableColumnMenu: true,
        renderCell: (params) => {
          const val = params.value;
          const color =
            val === "ADD" ? "success" : val === "DELETE" ? "error" : "warning";
          const icon =
            val === "ADD" ? (
              <AddBoxIcon />
            ) : val === "DELETE" ? (
              <AutoDeleteIcon />
            ) : (
              <EditDocumentIcon />
            );
          return (
            <CustomChip
            sx={{
              width:105,
              justifyContent:"flex-start",
            }}
              icon={icon}
              label={
                val === "ADD"
                  ? "Added"
                  : val === "DELETE"
                    ? "Deleted"
                    : "Modified"
              }
              color={color}
              variant="outlined"
            />
          );
        },
      },

      {
        field: "reqDate",
        headerName: "Requested Date",
        flex: 1,
        minWidth: 200,
        filterable: false,
        disableColumnMenu: true,
        renderCell: (params) => timeStampFormatter(params.value),
      },
      {
        field: "reqStatus",
        headerName: "Status",
        flex: 1,
        minWidth: 150,
        headerAlign: "center",
        align: "center",
        filterable: false,
        sortable: false,
        disableColumnMenu: true,
        renderCell: (params) => (
          <Box
            sx={{
              color:
                params.value === "REJECTED"
                  ? "error.main"
                  : params.value === "ACCEPTED"
                    ? "success.dark"
                    : "warning.main",
              // fontWeight: "bold",
            }}
          >
            <CustomChip
              variant="outlined"
              icon={
                params.value === "REJECTED" ? (
                  <BlockFlippedIcon />
                ) : params.value === "ACCEPTED" ? (
                  <CheckCircleIcon />
                ) : params.value === "CANCELLED" ? (
                  <GppBadIcon />
                ) : (
                  <PendingActionsIcon />
                )
              }
              label={
                params.value === "REJECTED"
                  ? "Rejected"
                  : params.value === "ACCEPTED"
                    ? "Approved"
                    : params.value === "CANCELLED"
                      ? "Cancelled"
                      : "Pending"
              }
              sx={{
              width:120,
              justifyContent:"flex-start",
                color:
                  params.value === "REJECTED"
                    ? "error.dark"
                    : params.value === "ACCEPTED"
                      ? "success.dark"
                      : params.value === "CANCELLED"
                        ? "primary.dark"
                        : "warning.main",

                "& .MuiChip-icon": {
                  color:
                    params.value === "REJECTED"
                      ? "error.dark"
                      : params.value === "ACCEPTED"
                        ? "success.dark"
                        : params.value === "CANCELLED"
                          ? "primary.dark"
                          : "warning.main",
                },
              }}
            />
           </Box>
        ),
      },
      {
        field: "action",
        headerName: "Action",
        flex: 0.6,
        minWidth: 150,
        headerAlign: "center",
        align: "center",
        filterable: false,
        sortable: false,
        disableColumnMenu: true,
        renderCell: (params) => {
          return (
            <Stack
              direction="row"
              spacing={1}
              justifyContent="center"
              alignItems="center"
              height="100%"
            >
              {permissions.view && (
                <Tooltip title="View">
                  <IconButton
                    // color="primary"
                    onClick={() => handleViewClick(params.row)}
                  >
                    <VisibilityIcon />
                  </IconButton>
                </Tooltip>
              )}

              {params.row.reqStatus === "PENDING" && permissions.cancel && (
                <Tooltip title={"Cancel Request"}>
                  <IconButton
                    onClick={() => {
                      setConfirmDialog(true);
                      setRequestId(params.row.id);
                    }}
                  >
                    <CancelIcon fontSize="inherit" />
                  </IconButton>
                </Tooltip>
              )}
            </Stack>
          );
        },
      },
    ],
    [permissions.cancel, permissions.view],
  );

  const filteredColumns = useMemo(() => {
    if (permissions.view || permissions.cancel) {
      return columns;
    }
    // Otherwise, filter out the column where field name is 'action'.
    else {
      return columns.filter((column) => column.field !== "action");
    }
  }, [columns, permissions]);

  return (
    <>
      <Box>
        <Box>
          <DataGrid
            loading={isLoading}
            rows={cglList}
            columns={filteredColumns}
            getRowId={(row) => row.id}
            disableRowSelectionOnClick
            pageSizeOptions={[5, 10, 25, 50]}
            initialState={{
              pagination: { paginationModel: { pageSize: 10, page: 0 } },
              sorting: { sortModel: [{ field: "reqDate", sort: "desc" }] },
            }}
            slots={{
              noRowsOverlay: CustomNoRowsOverlay,
            }}
          sx={{
          minHeight: 700,
          width: "100%",
          "& .MuiDataGrid-columnHeaders": {
          backgroundColor: "#f5f5f5 !important",
          fontWeight: 700,
          borderBottom: "2px solid rgba(88, 70, 159, 0.2)",
          position: 'sticky',
          top: 0,
          zIndex: 1,
          },
          }}
          />
        </Box>
      </Box>

      {/* View Dialog */}
      <ViewMyRequestDialog
        open={viewOpen}
        handleClose={() => setViewOpen(false)}
        data={viewData}
      />

      {/* Cancel Dialog */}
      <Dialog
        open={confirmDialog}
        // onClose={() => {
        //   setConfirmDialog(false);
        // }}
        maxWidth="sm"
        fullWidth
      >
        <DialogTitle sx={{ fontWeight: 600 }}>
          Cancel Request ID: {requestId}
        </DialogTitle>
        <DialogContent>
          <Typography sx={{ p: 1 }}>
            Are you sure you want to cancel this request, please confirm ?
          </Typography>
        </DialogContent>
        <DialogActions>
          <Button
            onClick={() => {
              setConfirmDialog(false);
            }}
            variant="outlined"
            sx=
          {{
            "&:hover":
            {
              color:"#fff",
            },
            }}
          >
            Cancel
          </Button>
          <Button
            onClick={handleCancelRequest}
            color="error"
            variant="contained"
          >
            Confirm
          </Button>
        </DialogActions>
      </Dialog>
    </>
  );
}
