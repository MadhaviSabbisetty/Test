 {/* CGL */}
                        <Grid item size={{ xl: 2.3, lg: 3.1 }} >
                          <Autocomplete
                            autoHighlight
                            popupIcon={null}
                            options={
                              (cglInputValues[row.id] || "").length < 3
                                ? []
                                : (row.cgl && !cglSearch.options.some((o) => o.cglNumber === row.cgl.cglNumber)
                                  ? [row.cgl, ...cglSearch.options]
                                  : cglSearch.options)
                            }
                            slotProps={{
                              popper: {
                                placement: 'bottom-start',
                                modifiers: [
                                  { name: 'flip', enabled: false },
                                  { name: 'preventOverflow', enabled: false }
                                ],
                              },
                            }}
                            // SHOW CODE AND DESCRIPTION INSIDE THE TEXTBOX
                            getOptionLabel={(option) => option && option.cglNumber ? `${option.cglNumber} - ${option.description}` : ""}
                            renderOption={(props, option) => (
                              <li {...props} key={option.cglNumber}>
                                <Typography noWrap sx={{ textOverflow: 'ellipsis', overflow: 'hidden', whiteSpace: 'nowrap' }}>
                                  {option.cglNumber} - {option.description}
                                </Typography>
                              </li>
                            )}
                            value={row.cgl || null}
                            onChange={(event, newValue) => handleRowChange(row.id, "cgl", newValue)}
                            inputValue={cglInputValues[row.id] || ""}
                            onInputChange={(event, newInputValue, reason) => {
                              if (reason === 'input') {
                                const cleanInput = newInputValue.replace(CGL_REPLACE_REGEX, "").substring(0, 10);
                                setCglInputValues(prev => ({ ...prev, [row.id]: cleanInput }));
                                searchCgls(cleanInput, row.id);
                              } else {
                                setCglInputValues(prev => ({ ...prev, [row.id]: newInputValue }));
                              }
                            }}
                            onKeyDown={(e) => {
                              if ((e.key === 'Tab' || e.key === 'Enter') && !row.cgl && cglSearch.options?.length > 0) {
                                handleRowChange(row.id, "cgl", cglSearch.options[0]);
                              }
                            }}
                            onBlur={() => {
                              const typedValue = cglInputValues[row.id];
                              if (!row.cgl && typedValue && typedValue.length === 10) {
                                const match = cglSearch.options.find(opt => String(opt.cglNumber) === typedValue) ||
                                  (cglSearch.options.length > 0 ? cglSearch.options[0] : null);
                                if (match) {
                                  handleRowChange(row.id, "cgl", match);
                                }
                              }
                            }}
                            loading={cglSearch.loadingId === row.id}
                            filterOptions={(x) => x}
                            isOptionEqualToValue={(option, value) => String(option?.cglNumber) === String(value?.cglNumber)}
                            noOptionsText={
                              (cglInputValues[row.id] || "").length < 3
                                ? "Enter 3 Digits to Search"
                                : "CGL not found"
                            }
                            renderInput={(params) => (
                              <Tooltip title={row.cgl ? `${row.cgl.cglNumber} - ${row.cgl.description}` : "Search by CGL Number"} placement="top-start">
                                <TextField
                                  {...params}
                                  label="CGL *"
                                  placeholder="CGL"
                                  InputLabelProps={{ shrink: true }}
                                  // Prevents text from breaking out of the box
                                  inputProps={{ ...params.inputProps, style: { textOverflow: 'ellipsis', whiteSpace: 'nowrap', overflow: 'hidden' } }}
                                  InputProps={{
                                    ...params.InputProps,
                                    endAdornment: (
                                      <Box sx={{ display: 'flex', alignItems: 'center', gap: 0.5 }}>
                                        {/* SMALL MEMO CHIP INSIDE THE TEXTBOX */}
                                        {row.cgl && String(row.cgl.cglNumber).startsWith("5") && (
                                          <Chip label="MEMO" size="small" color="warning" sx={{ height: 18, fontSize: '0.65rem', fontWeight: 'bold' }} />
                                        )}
                                        {cglSearch.loadingId === row.id ? <CircularProgress color="inherit" size={20} /> : null}
                                        {params.InputProps.endAdornment}
                                      </Box>
                                    )
                                  }}
                                  onPaste={(e) => { e.preventDefault(); showSnackBar("Pasting is not allowed here.", "warning"); }}
                                  onCopy={(e) => e.preventDefault()}
                                />
                              </Tooltip>
                            )}
                          />
                        </Grid>



                        {/* Amount */}
                        <Grid item size={{ xl: 2, lg: 2.8 }}>
                          <Tooltip title="" placement="top-start">
                            <TextField
                              label="Amount *"
                              type="text"
                              value={row.amount}
                              InputLabelProps={{ shrink: true }}
                              fullWidth
                              placeholder="0.0000"
                              inputProps={{ style: { textAlign: "right" } }}
                              // Checks if input is not empty AND equals zero numerically
                              error={row.amount !== "" && parseFloat(row.amount) === 0}
                              onChange={(e) => {
                                const rawVal = e.target.value;
                                if (/[^0-9.]/.test(rawVal)) {
                                  showSnackBar("Only numbers and decimal point are allowed.", "warning"); return;
                                }
                                if (rawVal === "" || /^\d{0,16}(\.\d{0,4})?$/.test(rawVal)) {
                                  handleRowChange(row.id, "amount", rawVal);
                                }
                                else {
                                  showSnackBar("Exceeded maximum digits or decimal places.", "warning");
                                }
                              }}

                              onPaste={(e) => { e.preventDefault(); showSnackBar("Pasting is not allowed here.", "warning"); }}
                              onCopy={(e) => e.preventDefault()}
                            />
                          </Tooltip>
                          <Typography
                            variant="caption"
                            // Turns the caption red if the error state is triggered
                            sx={{ ...jpStyles.captionText, color: (row.amount !== "" && parseFloat(row.amount) === 0) ? 'error.main' : 'text.secondary' }}
                          >
                            {(row.amount !== "" && parseFloat(row.amount) === 0) ? "Amount cannot be zero" : "Max 16 digits, 4 decimals"}
                          </Typography>
                        </Grid>


                        {/* Txn Type */}
                        <Grid item size={{ xl: 1, lg: 1.5 }}>
                          <Tooltip title="" placement="top-start">
                            <TextField
                              select
                              label="Type *"
                              value={row.txnType}
                              fullWidth
                              InputLabelProps={{ shrink: true }}
                              onChange={(e) => handleRowChange(row.id, "txnType", e.target.value)}
                              onPaste={(e) => { e.preventDefault(); showSnackBar("Pasting is not allowed here.", "warning"); }}
                              onCopy={(e) => e.preventDefault()}
                              onKeyDown={(e) => {
                                // Intercept keystrokes to auto-select
                                const key = e.key.toLowerCase();
                                if (key === 'd') {
                                  e.preventDefault(); // Prevents standard browser behavior
                                  handleRowChange(row.id, "txnType", "Debit");
                                } else if (key === 'c') {
                                  e.preventDefault();
                                  handleRowChange(row.id, "txnType", "Credit");
                                }
                              }}
                              SelectProps={{
                                displayEmpty: true,
                                renderValue: (selected) => !selected ? <span style={{ color: 'gray', opacity: 0.8 }}>Type</span> : selected,
                                MenuProps: {
                                  // The marginTop guarantees it clears the tooltip completely
                                  PaperProps: { style: { maxHeight: 250, marginTop: '8px' } },
                                  anchorOrigin: { vertical: "bottom", horizontal: "left" },
                                  transformOrigin: { vertical: "top", horizontal: "left" }
                                }
                              }}
                            >
                              <MenuItem value="Credit">Credit</MenuItem>
                              <MenuItem value="Debit">Debit</MenuItem>

                            </TextField>
                          </Tooltip>
                        </Grid>

                        {/* Remarks (Individual) */}
                        <Grid item size={{ xl: 2.2, lg: 3.2 }}>
                          <Tooltip title="" placement="top-start">
                            <TextField
                              label="Remarks *"
                              value={row.remarks}
                              InputLabelProps={{ shrink: true }}
                              onPaste={(e) => { e.preventDefault(); showSnackBar("Pasting is not allowed here.", "warning"); }}
                              onCopy={(e) => e.preventDefault()}
                              placeholder="Enter remarks..."
                              fullWidth
                              inputProps={{ minLength: 2, maxLength: 30 }}
                              disabled={checked}
                              error={row.remarks.length > 0 && !isRowRemarksValid(row.remarks)}
                              onChange={(e) => {
                                const val = filterAndWarn(e.target.value);
                                if (val.length <= 30) {
                                  handleRowChange(row.id, "remarks", val);
                                }
                              }}
                              helperText="Allowed 2-30 chars: Alphanumeric and single spaces only"
                            />
                          </Tooltip>
                        </Grid>
                        {/* Product Code */}
                        <Grid item
                          // xs={12} md={2}
                          size={{ xl: 1, lg: 1.5 }} >
                          <Tooltip title="" placement="top-start">
                            <TextField label="Product Code" value={row.productCode} InputLabelProps={{ shrink: true }} placeholder="Product Code.." fullWidth inputProps={{ maxLength: 8 }} onChange={(e) => { const rawVal = e.target.value; const cleanVal = rawVal.replace(/[^0-9]/g, ""); if (rawVal !== cleanVal) { showSnackBar("Only digits are allowed.", "warning"); } if (cleanVal.length <= 8) { handleRowChange(row.id, "productCode", cleanVal); } }} />
                          </Tooltip>
                          <Typography variant="caption" sx={jpStyles.captionText}>Max 8 digits</Typography>
                        </Grid>

                        {/* Delete Action */}
                        <Grid item size={{ xl: 0.5, lg: 0.8 }} sx={{ textAlign: "center", display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
                          {/* ONLY ALLOW DELETION IF THERE ARE MORE THAN 2 ROWS */}
                          {rows.length > 2 && (
                            <Tooltip title="Delete row" arrow>
                              <IconButton
                                onClick={() => handleDeleteRow(row.id)}
                                aria-label="delete row"
                                sx={jpStyles.deleteIconButton}
                              >
                                <DeleteIcon />
                              </IconButton>
                            </Tooltip>
                          )}
                        </Grid>
                      </Grid> {/* <--- THIS IS THE MISSING TAG THAT CRASHED REACT! */}

                      {index < rows.length - 1 && (<Box sx={jpStyles.rowDivider} />)}
                    </React.Fragment>
                  );
                })}

                {/* ACTION BUTTONS */}
                <Box sx={jpStyles.actionButtonsWrapper}>
                  <Button variant="outlined" startIcon={<ArrowBackIcon />} onClick={handleBack}>
                    Previous
                  </Button>

                  <Box sx={{ display: "flex", gap: 2 }}>
                    {/* NEW RESET BUTTON */}
                    <Button variant="outlined" onClick={handleResetRows} 
                    sx=
                    {{
                      "&:hover":
                      {
                        color:"#fff",
                      },
                      }}>
                      Reset
                    </Button>

                    <Button variant="contained" startIcon={<AddIcon />} onClick={handleAddRow}>
                      Add Row
                    </Button>

                    <Tooltip title={rows.length < 2 ? "Minimum 2 rows required" : "Submit batch"} placement="top">
                      <span>
                        <Button
                          variant="contained"
                          color="success"
                          onClick={handleValidateClick}
                          disabled={isSubmitting || !isCommonRemarksValid(commonBatchRemarks) || !isFormReadyToSubmit}
                        >
                          {isSubmitting ? <CircularProgress size={24} color="inherit" /> : "Validate"}
                        </Button>
                      </span>
                    </Tooltip>
                  </Box>
                </Box>
              </Box>
            </Box>
          </Box>
        )
      }

      {/* EXTERNAL STEP 2: BULK UPLOAD EXCEL COMPONENT */}
      {
        activeStep === 2 && entryMethod === "BULK" && (
          <JournalBulkUpload
            selectedVoucher={selectedVoucher}
            onBack={handleBack}
            onReset={handleResetWizard}
            // Triggered automatically when Bulk Excel completes
            onSuccessSubmit={(batchId) => {
              setSubmittedBatchId(batchId);
              setActiveStep(3);
            }}
          />
        )
      }

      {/* NEW STEP 3: POST-SUBMISSION SUCCESS & SCHEDULING SCREEN */}
      {
        activeStep === 3 && (
          <Box sx={{ p: 4, display: 'flex', justifyContent: 'center' }}>
            <Paper elevation={3} sx={{ p: 4, borderRadius: 3, maxWidth: 650, width: '100%', textAlign: 'center' }}>
              <Typography variant="h6" fontWeight="bold" color="text.primary" gutterBottom>
                Set Execution Preference
              </Typography>
              <Typography variant="h5" fontWeight="bold" gutterBottom>
                Your batch is validated and ready to submit.
              </Typography>

              <Divider sx={{ my: 3 }} />


              <Typography variant="body2" color="text.secondary" sx={{ mb: 4 }}>
                Please select how you want this batch to be executed after the final approval.
              </Typography>

              {/* SELECTION CARDS */}
              <Grid container spacing={3} sx={{ mb: 4, textAlign: 'left' }}>
                <Grid item xs={12} sm={6}>
                  <Box
                    onClick={() => setRoutingChoice("IMMEDIATE")}
                    sx={{
                      p: 2.5, border: "2px solid", borderRadius: 2, cursor: "pointer", transition: "all 0.2s ease",
                      borderColor: routingChoice === "IMMEDIATE" ? "primary.main" : "divider",
                      backgroundColor: routingChoice === "IMMEDIATE" ? "primary.50" : "transparent",
                      display: "flex", flexDirection: "column", alignItems: "center", gap: 1, textAlign: "center",
                      "&:hover": { borderColor: routingChoice !== "IMMEDIATE" ? "primary.light" : "primary.main", transform: "translateY(-2px)", boxShadow: 2 }
                    }}
                  >
                    <BoltIcon color={routingChoice === "IMMEDIATE" ? "primary" : "action"} sx={{ fontSize: 36 }} />
                    <Typography variant="subtitle1" fontWeight="bold" color={routingChoice === "IMMEDIATE" ? "primary.main" : "text.primary"}>
                      Execute Immediately
                    </Typography>
                    <Typography variant="caption" color="text.secondary">
                      Post automatically upon final approval
                    </Typography>
                  </Box>
                </Grid>
                <Grid item xs={12} sm={6}>
                  <Box
                    onClick={() => {
                      setRoutingChoice("SCHEDULE");
                      setScheduledTime(dayjs().add(30, 'minute').startOf('minute'));
                    }}
                    sx={{
                      p: 2.5, border: "2px solid", borderRadius: 2, cursor: "pointer", transition: "all 0.2s ease",
                      borderColor: routingChoice === "SCHEDULE" ? "primary.main" : "divider",
                      backgroundColor: routingChoice === "SCHEDULE" ? "primary.50" : "transparent",
                      display: "flex", flexDirection: "column", alignItems: "center", gap: 1, textAlign: "center",
                      "&:hover": { borderColor: routingChoice !== "SCHEDULE" ? "primary.light" : "primary.main", transform: "translateY(-2px)", boxShadow: 2 }
                    }}
                  >
                    <ScheduleIcon color={routingChoice === "SCHEDULE" ? "primary" : "action"} sx={{ fontSize: 36 }} />
                    <Typography variant="subtitle1" fontWeight="bold" color={routingChoice === "SCHEDULE" ? "primary.main" : "text.primary"}>
                      Schedule Execution
                    </Typography>
                    <Typography variant="caption" color="text.secondary">
                      Delay posting to a future time today
                    </Typography>
                  </Box>
                </Grid>
              </Grid>

              {/* SMOOTH COLLAPSE FOR TIMEPICKER */}
              <Collapse in={routingChoice === "SCHEDULE"}>
                <Box sx={{ p: 3, mb: 4, border: '1px solid', borderColor: 'divider', borderRadius: 2 }}>
                  <Typography variant="subtitle2" fontWeight="bold" align="left" gutterBottom>
                    Select Time
                  </Typography>
                  <LocalizationProvider dateAdapter={AdapterDayjs}>
                    <TimePicker
                      value={scheduledTime}
                      onChange={(newValue) => setScheduledTime(newValue)}
                      // --- THE FIX IS HERE ---
                      // .startOf('minute') forces seconds to :00 so it perfectly matches the UI selection
                      minTime={dayjs().add(30, 'minute').startOf('minute')}
                      maxTime={dayjs().endOf('day')}
                      timeSteps={{ minutes: 1 }}
                      slotProps={{
                        textField: {
                          size: 'medium',
                          fullWidth: true,
                          sx: { caretColor: 'transparent' },
                          helperText: "Execution must be scheduled at least 30 minutes from now, before 11:59 PM today.",
                          onKeyDown: (e) => e.preventDefault(),
                          onPaste: (e) => e.preventDefault(),
                          inputProps: { readOnly: true }
                        }
                      }}
                    />
                  </LocalizationProvider>
                </Box>
              </Collapse>

              {/* FINAL SUBMIT BUTTON */}
              <Button
                variant="contained"
                size="large"
                fullWidth
                disabled={!routingChoice || (routingChoice === 'SCHEDULE' && !scheduledTime) || isFinalizing}
                onClick={handleFinalizeRouting}
                sx={{ py: 1.5, fontSize: '1.1rem', fontWeight: 'bold', borderRadius: 2 }}
              >
                {isFinalizing ? <CircularProgress size={28} color="inherit" /> : "Submit"}
              </Button>

            </Paper>
          </Box>
        )
      }

    </Paper >

  );
}
import React, { useState, useRef, useEffect } from "react";
import dayjs from "dayjs";
import {
  Box,
  Typography,
  Paper,
  TextField,
  Button,
  CircularProgress,
  Chip,
  Alert,
  Stack,
  Stepper,
  Step,
  StepLabel,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  TablePagination,
  IconButton,
  Tooltip,
  Collapse,
  Grid
} from "@mui/material";
import {
  CloudUpload as CloudUploadIcon,
  RestartAlt as RestartAltIcon,
  Description as DescriptionIcon,
  Send as SendIcon,
  FileDownload as FileDownloadIcon,
  ArrowBack as ArrowBackIcon,
  Close as CloseIcon,
  TaskAlt as TaskAltIcon,
  KeyboardArrowUp,
  KeyboardArrowDown
} from "@mui/icons-material";
import { alpha } from "@mui/material/styles";

import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";

import { jbuStyles } from "./VoucherBulkStyle";
import { useSelector } from "react-redux";

// --- STYLES ---
const mainContainerStyle = { padding: 3, height: "100%", width: "100%" };
const ALLOWED_FILE_TYPES = [".xlsx"];

const mainSteps = ["Upload & Validate", "Preview & Submit"];
const validationSteps = [
  "Format Validation",
  "Database Validation",
  "Balance Validation",
];

const VoucherBulkUpload = ({ selectedVoucher, onBack, onReset, onSuccessSubmit }) => {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();
  
  const user = useSelector((state) => state.auth?.user || null);

  const [activeStep, setActiveStep] = useState(0);
  const [selectedDate, setSelectedDate] = useState(null);
  const [file, setFile] = useState(null);
  const fileInputRef = useRef(null);
  const [requestId, setRequestId] = useState(null);
  const [isProcessing, setIsProcessing] = useState(false);
  const [isDebouncing, setIsDebouncing] = useState(false);
  const [isDragging, setIsDragging] = useState(false);

  const [validationStage, setValidationStage] = useState(0);
  const [resultStatus, setResultStatus] = useState(null);
  const [resultMsg, setResultMsg] = useState("");
  const [autoDlTriggered, setAutoDlTriggered] = useState(false);
  const [downloadMsg, setDownloadMsg] = useState("Downloading error report...");
  const [isErrorDownloaded, setIsErrorDownloaded] = useState(false);
  const [previewRows, setPreviewRows] = useState([]);
  const [totalRows, setTotalRows] = useState(0);

  const [page, setPage] = useState(0);
  const [rowsPerPage, setRowsPerPage] = useState(50);
  const [isCreatingBatch, setIsCreatingBatch] = useState(false);
  const [batchCreated, setBatchCreated] = useState(false);
  const [isDescExpanded, setIsDescExpanded] = useState(false);
  const [isPageLoading, setIsPageLoading] = useState(true);
  const [isEodRunning, setIsEodRunning] = useState(false);
  useEffect(() => {
    const fetchInitialData = async () => {
      try {
        setIsPageLoading(true);

        // 1. Check EOD Status First
        const eodResponse = await callApi("/JS/voucher/eod_status", null, "GET");
        if (eodResponse && Array.isArray(eodResponse) && eodResponse.length > 0) {
          if (eodResponse[0].eodStatus === 1) {
            setIsEodRunning(true);
            return; // Stop loading anything else, block the screen
          }
        }

        // 2. Fetch the Official Posting Date
        const dateResponse = await callApi("/JS/voucher/current-posting-date", null, "GET");
        if (dateResponse) {
          // Parse the YYYY-MM-DD date perfectly into DayJS for the calendar
          const parsedDate = dayjs(dateResponse, "YYYY-MM-DD");
          if (parsedDate.isValid()) {
            setSelectedDate(parsedDate);
          } else {
            showSnackBar("Failed to parse official posting date.", "error");
          }
        } else {
          showSnackBar("Failed to load official posting date.", "error");
        }

      } catch (error) {
        console.error("Failed to fetch initial data:", error);
      } finally {
        setIsPageLoading(false);
      }
    };

    fetchInitialData();
  }, [callApi, showSnackBar]);


  useEffect(() => {
    const checkEodStatus = async () => {
      try {
        setIsPageLoading(true);
        const eodResponse = await callApi("/JS/voucher/eod_status", null, "GET");

        // The API returns an array: [{ "eodStatus": 0 }]
        if (eodResponse && Array.isArray(eodResponse) && eodResponse.length > 0) {
          if (eodResponse[0].eodStatus === 1) {
            setIsEodRunning(true);
          }
        }
      } catch (error) {
        console.error("Failed to check EOD status:", error);
      } finally {
        setIsPageLoading(false);
      }
    };

    checkEodStatus();
  }, [callApi]);

  const triggerDebounce = () => {
    setIsDebouncing(true);
    setTimeout(() => {
      setIsDebouncing(false);
    }, 3000);
  };

  const validateAndSetFile = (selected) => {
    if (!selected) return;
    const fileName = selected.name.toLowerCase();
    const fileSize = selected.size;

    const isValidExt = ALLOWED_FILE_TYPES.some((ext) => fileName.endsWith(ext));

    if (fileName.length > 100) {
      showSnackBar(`File name is too long! Please rename it to be under 100 characters.`, "error");
      clearInput();
      return;
    }

    const MAX_SIZE_MB = 50;
    if (fileSize > MAX_SIZE_MB * 1024 * 1024) {
      showSnackBar(`File too large! Maximum allowed size is ${MAX_SIZE_MB}MB.`, "error");
      clearInput();
      return;
    }

    if (fileSize === 0) {
      showSnackBar("The selected file is empty. Please upload a valid file.", "error");
      clearInput();
      return;
    }



    setFile(selected);
    setResultStatus(null);
    setResultMsg("");
    setValidationStage(0);
    setPreviewRows([]);
    setTotalRows(0);
    setRequestId(null);
    setAutoDlTriggered(false);
    setIsProcessing(false);
    setIsErrorDownloaded(false);
    setDownloadMsg("Downloading error report...");
  };

  const handleFileSelect = (e) => {
    if (e.target.files[0]) {
      validateAndSetFile(e.target.files[0]);
    }
  };

  const handleDragOver = (e) => {
    e.preventDefault();
    e.stopPropagation();
    setIsDragging(true);
  };

  const handleDragLeave = (e) => {
    e.preventDefault();
    e.stopPropagation();
    setIsDragging(false);
  };

  const handleDrop = (e) => {
    e.preventDefault();
    e.stopPropagation();
    setIsDragging(false);
    if (e.dataTransfer.files && e.dataTransfer.files.length > 0) {
      validateAndSetFile(e.dataTransfer.files[0]);
      e.dataTransfer.clearData();
    }
  };

  const clearInput = () => {
    if (fileInputRef.current) fileInputRef.current.value = "";
  };

  const handleClearFile = (e) => {
    if (e) e.stopPropagation();
    setFile(null);
    clearInput();
    setResultStatus(null);
    setResultMsg("");
    setValidationStage(0);
    setIsProcessing(false);
    setIsErrorDownloaded(false);
    setBatchCreated(false);
  };
  const resetAll = () => {
    setRequestId(null);
    setResultStatus(null);
    setValidationStage(0);
    setResultMsg("");
    setPreviewRows([]);
    setTotalRows(0);
    setIsProcessing(false);
    setAutoDlTriggered(false);
    setIsErrorDownloaded(false);
    setBatchCreated(false);
    setFile(null);
    setPage(0);
    setDownloadMsg("Downloading error report...");
    clearInput();
    if (onReset) onReset(); // Tells JournalPosting.jsx to go back to Step 0
  };
  const handleBackNavigation = () => {
    if (onBack) onBack(); // Tells JournalPosting.jsx to go back to Step 1
  };

  const handleBack = () => {
    setActiveStep(0);
    setResultStatus(null);
    setValidationStage(0);
    setResultMsg("");
    setIsProcessing(false);
    setAutoDlTriggered(false);
    setDownloadMsg("Downloading error report...");
  };

  const downloadFileHelper = async (url, filename) => {
    try {
      const response = await callApi(url, null, "GET", "blob", null, {}, false);
      const blobData = response.data || response;
      if (!blobData) throw new Error("Empty response data");

      const blob = new Blob([blobData], {
        type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      });

      const link = document.createElement("a");
      const objectUrl = window.URL.createObjectURL(blob);
      link.href = objectUrl;
      link.setAttribute("download", filename);
      document.body.appendChild(link);
      link.click();
      link.remove();
      window.URL.revokeObjectURL(objectUrl);
      return true;
    } catch (e) {
      showSnackBar("File download failed.", "error");
      return false;
    }
  };

